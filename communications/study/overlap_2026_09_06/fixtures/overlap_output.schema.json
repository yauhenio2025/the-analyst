{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "overlap-output/v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "fixture_only": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "side_report",
              "single_person",
              "cross_person",
              "period",
              "fidelity",
              "metadata"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "person_uids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "author_uids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "row_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_doc_key": {
                  "type": "string",
                  "minLength": 1
                },
                "locus": {
                  "type": "object"
                },
                "voice": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "text",
                "source_doc_key",
                "locus",
                "voice"
              ],
              "additionalProperties": false
            }
          },
          "metadata_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "dimension",
          "kind",
          "claim",
          "person_uids",
          "author_uids",
          "row_refs",
          "anchors",
          "metadata_refs"
        ],
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "metadata_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "value",
                "finding_ids",
                "metadata_refs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "cells"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "revision",
    "fixture_only",
    "findings",
    "tables"
  ],
  "additionalProperties": false
}
