            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/App.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"/home/evgeny/projects/aoi-canary/src/App.css\"\nconst __vite__css = \".app-shell {\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  padding: 2.5rem 1.5rem 4rem;\\n  color: #1a1d23;\\n}\\n\\n.app-header {\\n  display: flex;\\n  justify-content: space-between;\\n  gap: 2rem;\\n  align-items: flex-start;\\n  margin-bottom: 1.5rem;\\n}\\n\\n.eyebrow {\\n  margin: 0 0 0.5rem;\\n  font-size: 0.8rem;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n  color: #8b4c4f;\\n  font-weight: 700;\\n}\\n\\n.app-header h1 {\\n  margin: 0;\\n  font-size: 2.3rem;\\n  line-height: 1.1;\\n  font-family: Georgia, 'Times New Roman', serif;\\n}\\n\\n.lede {\\n  max-width: 62ch;\\n  margin: 0.75rem 0 0;\\n  color: #5b6470;\\n  line-height: 1.6;\\n}\\n\\n.mode-controls {\\n  display: grid;\\n  gap: 1rem;\\n  min-width: 320px;\\n}\\n\\n.mode-toggle {\\n  display: inline-flex;\\n  border: 1px solid #d8dde5;\\n  border-radius: 999px;\\n  padding: 0.2rem;\\n  background: #f5f7fa;\\n}\\n\\n.mode-toggle button,\\n.debug-toggle {\\n  border: none;\\n  background: transparent;\\n  cursor: pointer;\\n  font: inherit;\\n}\\n\\n.mode-toggle button {\\n  padding: 0.55rem 1rem;\\n  border-radius: 999px;\\n  color: #64748b;\\n  font-weight: 600;\\n}\\n\\n.mode-toggle button.active {\\n  background: #1f2937;\\n  color: #fff;\\n}\\n\\n.mode-toggle button:disabled {\\n  cursor: not-allowed;\\n  opacity: 0.5;\\n}\\n\\n.job-input {\\n  display: grid;\\n  gap: 0.4rem;\\n  color: #64748b;\\n  font-size: 0.9rem;\\n  font-weight: 600;\\n}\\n\\n.job-input input {\\n  border: 1px solid #d8dde5;\\n  border-radius: 12px;\\n  padding: 0.8rem 0.9rem;\\n  font: inherit;\\n  background: #fff;\\n}\\n\\n.job-input small {\\n  color: #7c8795;\\n  font-weight: 500;\\n}\\n\\n.proof-selector {\\n  display: grid;\\n  gap: 0.45rem;\\n  color: #64748b;\\n  font-size: 0.9rem;\\n  font-weight: 600;\\n}\\n\\n.proof-selector__buttons {\\n  display: inline-flex;\\n  gap: 0.5rem;\\n  flex-wrap: wrap;\\n}\\n\\n.proof-selector__buttons button {\\n  border: 1px solid #d8dde5;\\n  border-radius: 999px;\\n  background: #fff;\\n  color: #475569;\\n  cursor: pointer;\\n  font: inherit;\\n  font-weight: 600;\\n  padding: 0.55rem 0.95rem;\\n}\\n\\n.proof-selector__buttons button.active {\\n  background: #7f1d1d;\\n  border-color: #7f1d1d;\\n  color: #fff;\\n}\\n\\n.status-row,\\n.meta-grid {\\n  display: grid;\\n  gap: 1rem;\\n  margin-bottom: 1.25rem;\\n}\\n\\n.status-row {\\n  grid-template-columns: repeat(3, minmax(0, 1fr));\\n}\\n\\n.meta-grid {\\n  grid-template-columns: repeat(4, minmax(0, 1fr));\\n}\\n\\n.status-card,\\n.meta-card,\\n.strategy-card,\\n.canary-surface,\\n.debug-card {\\n  border: 1px solid #e5e7eb;\\n  border-radius: 18px;\\n  background: #fff;\\n  box-shadow: 0 8px 32px rgba(15, 23, 42, 0.06);\\n}\\n\\n.status-card,\\n.meta-card {\\n  padding: 1rem 1.1rem;\\n}\\n\\n.status-wide {\\n  min-width: 0;\\n}\\n\\n.status-label,\\n.meta-card span {\\n  display: block;\\n  margin-bottom: 0.35rem;\\n  font-size: 0.78rem;\\n  letter-spacing: 0.04em;\\n  text-transform: uppercase;\\n  color: #7c8795;\\n}\\n\\n.strategy-card {\\n  padding: 1.1rem 1.2rem;\\n  margin-bottom: 1.5rem;\\n}\\n\\n.strategy-card p {\\n  margin: 0;\\n  color: #344152;\\n  line-height: 1.6;\\n}\\n\\n.canary-surface {\\n  padding: 1.25rem;\\n  margin-bottom: 1.5rem;\\n}\\n\\n.empty-state {\\n  border: 1px dashed #d1d5db;\\n  border-radius: 14px;\\n  padding: 2rem;\\n  background: #f8fafc;\\n}\\n\\n.empty-state h2 {\\n  margin-top: 0;\\n}\\n\\n.tab-shell {\\n  --tab-accent-color: #7f1d1d;\\n  display: grid;\\n  gap: 1rem;\\n}\\n\\n.tab-list {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.65rem;\\n}\\n\\n.tab-button {\\n  paddin