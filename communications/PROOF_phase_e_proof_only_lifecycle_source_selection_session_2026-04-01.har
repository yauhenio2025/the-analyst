card-cell-badge--medium,.card-cell-badge--moderate{color:#92400e;background:#fffbeb;border-color:#fde68a}.card-cell-badge--low,.card-cell-badge--minor{color:#166534;background:#f0fdf4;border-color:#bbf7d0}.card-cell-evidence{border-left:2px solid var(--color-border);background:var(--color-surface-alt);border-radius:0 var(--radius-sm) var(--radius-sm) 0;color:var(--color-text-muted);font-size:var(--type-label);font-family:var(--font-body);-webkit-line-clamp:5;-webkit-box-orient:vertical;margin:0 0 10px;padding:8px 12px;font-style:italic;line-height:1.55;display:-webkit-box;overflow:hidden}.ar-grid-card.expanded .card-cell-evidence{-webkit-line-clamp:unset;overflow:visible}.card-cell-tags{flex-wrap:wrap;gap:6px;margin-top:8px;display:flex}.card-cell-tag{background:var(--color-surface-alt);border:1px solid var(--color-border-light);border-radius:var(--radius-sm);font-size:.6875rem;font-family:var(--font-sans);color:var(--color-text-muted);padding:2px 8px;line-height:1.5;display:inline-block}.card-cell-tag-label{font-weight:var(--weight-semibold);color:var(--color-text);margin-right:2px}.gen-evidence-toggle{background:var(--color-surface-alt,#f8f9fa);cursor:pointer;width:100%;font-size:inherit;border:none;border-top:1px solid var(--color-border-light);align-items:center;gap:8px;padding:10px 24px;transition:background .2s;display:flex}.gen-evidence-toggle:hover{background:#0000000a}.gen-evidence-toggle-icon{color:var(--color-text-faint);text-align:center;width:12px;font-size:.5rem;transition:transform .25s cubic-bezier(.4,0,.2,1),color .15s;display:inline-block;transform:rotate(90deg)}.gen-evidence-toggle--collapsed .gen-evidence-toggle-icon{transform:rotate(0)}.gen-evidence-toggle-label{font-size:.6rem;font-weight:600;font-family:var(--font-sans);color:var(--color-text-faint);text-transform:uppercase;letter-spacing:.06em;transition:color .15s}.gen-evidence-toggle:hover .gen-evidence-toggle-icon,.gen-evidence-toggle:hover .gen-evidence-toggle-label{color:var(--color-text