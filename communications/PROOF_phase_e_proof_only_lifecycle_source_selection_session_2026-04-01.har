-muted)}.gen-evidence-count{font-size:.6rem;font-family:var(--font-sans);color:var(--color-text-muted);background:#0000000f;border-radius:50%;justify-content:center;align-items:center;min-width:22px;height:22px;margin-left:auto;font-weight:600;transition:color .15s,background .15s;display:flex}.gen-evidence-toggle:hover .gen-evidence-count{color:var(--color-text);background:#0000001a}.gen-evidence-trail{background:var(--color-surface);margin:0;padding:0}.gen-evidence-trail .gen-trail-chain{margin-left:24px;padding-bottom:20px;padding-left:14px;padding-right:24px}.gen-trail-chain{margin-top:4px;padding-left:14px;position:relative}.gen-trail-step{padding-bottom:14px;position:relative}.gen-trail-step:last-child{padding-bottom:0}.gen-trail-marker{align-items:center;gap:8px;margin-bottom:8px;display:flex}.gen-trail-dot{border-radius:50%;flex-shrink:0;width:8px;height:8px;display:inline-block}.gen-trail-dot--prior{background:var(--color-text-faint);box-shadow:0 0 0 2px #94a3b81f}.gen-trail-dot--current{box-shadow:0 0 0 2px #6366f11a}.gen-trail-dot--assessment{background:var(--color-text-muted);box-shadow:0 0 0 2px #4755691a}.gen-trail-label{font-size:.6875rem;font-weight:var(--weight-medium);font-family:var(--font-sans);text-transform:capitalize;letter-spacing:.02em;color:var(--color-text-muted)}.gen-trail-content{margin-left:18px}.gen-trail-connector{opacity:.5;border-radius:1px;width:2px;height:16px;margin-left:4px}.gen-trail-connector--final{opacity:.3}.gen-trail-ref{margin-bottom:8px}.gen-trail-quote{background:var(--color-surface-alt);border-left:2px solid var(--color-border);font-size:.8rem;font-family:var(--font-body);color:var(--color-text-muted);border-radius:0 3px 3px 0;margin:4px 0;padding:6px 12px;line-height:1.55}.gen-trail-quote--current{background:#3b82f608;border-left-color:#3b82f64d}.gen-trail-cite{font-size:.6875rem;font-style:normal;font-family:var(--font-sans);color:var(--color-text-faint);font-weight:var(--weight-medium);margin-top:4px;display:block}.gen-prose-badge{font-size:.65rem;font-weight:var(--weight-bold);font-family:var(--font-sans);letter-spacing:.05em;background:var(--color-accent)!important;color:var(--dt-text-inverse,#fff)!important}.gen-prose-mode-badge{background:var(--color-accent);color:var(--dt-text-inverse,#fff);font-size:.7rem;font-weight:var(--weight-semibold);font-family:var(--font-sans);border-radius:var(--radius-sm);margin-bottom:var(--space-md);letter-spacing:.03em;padding:4px 10px;display:inline-block}.gen-extracting-notice{text-align:center;padding:var(--space-3xl) var(--space-lg);color:var(--color-text-faint)}.gen-extracting-spinner{border:3px solid var(--color-border);border-top-color:var(--color-accent);width:32px;height:32px;margin:0 auto var(--space-md);border-radius:50%;animation:.8s linear infinite gen-spin}.gen-extracting-notice p{font-family:var(--font-sans);margin:8px 0}.gen-extracting-detail{color:var(--color-text-muted);font-size:.85rem}.gen-extraction-error{padding:var(--space-lg);background:var(--color-error-bg-subtle);border:1px solid var(--color-error-border);border-radius:var(--radius-md);color:var(--color-error-text)}.gen-extraction-error p{font-family:var(--font-sans);margin:8px 0}.gen-extraction-fallback{color:var(--color-text-faint);font-size:.85rem}.ar-grid-cards,.ar-grid-cards--variable,.ar-grid-cards--variable{grid-template-columns:1fr}:root{color:#101826;font-synthesis:none;text-rendering:optimizelegibility;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;background:radial-gradient(circle at 0 0,#115e5924,#0000 28%),radial-gradient(circle at 100% 0,#b453091a,#0000 22%),linear-gradient(#f7f4ee 0%,#eef3f6 100%);font-family:IBM Plex Sans,Segoe UI,sans-serif;font-weight:400;line-height:1.5}*{box-sizing:border-box}body{min-width:320px;min-height:100vh;margin:0}button,input,select{font:inherit}a{color:inherit}.app-shell{width:min(1200px,100vw - 32px);margin:0 auto;padding:32px 0 64px}.app-header{gap:20px;margin-bottom:20px;display:grid}.eyebrow{letter-spacing:.16em;text-transform:uppercase;color:#0f766e;margin:0 0 8px;font-size:.78rem}.app-header h1{margin:0;font-size:clamp(2rem,4vw,3.4rem);line-height:1}.lede{color:#465364;max-width:72ch;margin:12px 0 0}.controls{background:#ffffffd1;border:1px solid #1018261a;border-radius:20px;gap:16px;padding:20px;display:grid;box-shadow:0 24px 60px #10182614}.control-row{gap:10px;display:grid}.control-row span{letter-spacing:.08em;text-transform:uppercase;color:#5b6574;font-size:.8rem;font-weight:700}.control-row input{background:#fff;border:1px solid #10182624;border-radius:12px;width:100%;padding:12px 14px}.control-row small{color:#5b6574}.button-row{flex-wrap:wrap;gap:10px;display:flex}.button-row button,.reload-button{color:#0f172a;cursor:pointer;background:#d7e8e6;border:0;border-radius:999px;padding:10px 14px}.button-row button.active,.reload-button{color:#f8fafc;background:#115e59}.status-grid,.meta-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:16px;display:grid}.status-card,.meta-card,.summary-card,.lifecycle-card,.surface-card,.debug-card{background:#ffffffd9;border:1px solid #10182614;border-radius:18px;box-shadow:0 18px 40px #1018260f}.status-card,.meta-card{padding:14px 16px}.status-card span,.meta-card span{letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-size:.76rem;display:block}.status-card strong,.meta-card strong{margin-top:8px;font-size:1rem;display:block}.summary-card,.lifecycle-card,.surface-card,.debug-card{margin-bottom:16px;padding:18px 20px}.summary-card h2,.lifecycle-card h2,.surface-card h2,.debug-card h2{margin:0 0 12px;font-size:1.05rem}.summary-card p,.lifecycle-card p,.surface-card p{color:#465364;margin:0}.debug-card pre{max-height:360px;margin:0;font-size:.78rem;overflow:auto}.surface-card[data-state=ready]{min-height:280px}.surface-frame{margin-top:16px}.lifecycle-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:16px;display:grid}.lifecycle-note{over