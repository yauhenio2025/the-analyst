type:`mini_card_list`},summary:{config:{pull_quote_min_length:90,section_description:`Bounded AOI closeout summary.`},renderer_type:`annotated_prose`}},sections:[{key:`summary`,title:`Summary`},{key:`engagement_pattern`,title:`Engagement Pattern`},{key:`key_divergences`,title:`Key Divergences`},{key:`sin_distribution`,title:`Sin Distribution`},{key:`reading_implications`,title:`Reading Implications`}]},renderer_type:`accordion`,scaffold_hosting_mode:`none`,selection_priority:`secondary`,semantic_scaffold_type:`none`,source_parent_view_key:`aoi_thematic_analysis`,structuring_policy:null,top_level_group:null,view_key:`aoi_thematic_report`,view_name:`Report`}],stage:`consumer_capability_adaptation`}],final_manifest:{artifacts_ready:!1,consumer_key:`aoi-canary`,job_id:`job-abe51e9f629f`,manifest_schema_version:1,plan_id:`plan-37746ee2a2cd`,polish_state:`partial`,prepared_at:`2026-03-14T23:15:42.697049`,presentation_content_hash:`e2d2ed20d54c9a0104451efc4c4ef047edcf75d657107775098bf26c4f5a511e`,presentation_contract_version:1,presentation_hash:`40bafc5e646d408c6f9d6dd16e71e890a0db4a21538ee18ac5cdadb6d079270f`,resolver_version:`bounded-dynamism-phase2`,strategy_summary:`This AOI analysis examines Aaron Benanav's work through the lens of Otto Neurath's political economy — specifically Neurath's theory of in-kind calculation, war economy as a planning model, socialist utility, and the critique of monetary commensuration. The four source corpus texts span Neurath's core arguments: that a socialist economy should operate through calculation in kind rather than money, that war economies demonstrate the feasibility of non-market coordination, that international planning is both necessary and achievable, and that socialist utility is categorically different from capitalist profit calculation. These are tightly clustered, technically dense texts with a distinctive vocabulary (Verwaltungswirtschaft, naturalwirtschaft, in-kind balances) and a polemical edge directed at both market socialists and orthodox Marxists. The analytical task is to determine whether Benanav genuinely engages, partially engages, ignores, or distorts these Neurathian commitments.\n\nBecause all four source documents belong to a single thinker and constitute a coherent, internally cross-referencing corpus, Phase 1.0 (Thematic Synthesis) is the interpretive keystone of the workflow. Neurath's themes are not self-evident to readers unfamiliar with the socialist calculation debate, and his claim-structure involves technical distinctions — between in-kind and monetary calculation, between war-economy planning and market socialism — that must be carefully reconstructed before engagement can be mapped. Standard depth is appropriate throughout: the corpus is substantive but bounded, and the four texts are relatively short and focused. The engagement mapping and sin-finding phases can proceed efficiently once the thematic map is established.`,style_school:`explanatory_narrative`,thinker_name:`Aaron Benanav`,trace_schema_version:1,view_count:5,views:[{child_view_keys:[`aoi_by_sin_type`,`aoi_by_theme`,`aoi_source_documents`,`aoi_thematic_report`],derivation_kind:null,description:`Top-level AOI thematic analysis surface for one selected source thinker. Organizes source documents, theme-led findings, sin-type groupings, and the structured report under one parent container.`,display_parent_view_key:null,legacy_visibility:`if_data_exists`,navigation_state:`normal`,position:1,presentation_stance:`interactive`,promoted_to_top_level:!1,renderer_config:{default_tab:1,show_count_badges:!0,tab_style:`underline`},renderer_type:`tab`,scaffold_hosting_mode:`none`,selection_priority:`primary`,semantic_scaffold_type:`none`,source_parent_view_key:null,structuring_policy:null,top_level_group:null,view_key:`aoi_thematic_analysis`,view_name:`Thematic Analysis`},{child_view_keys:[],derivation_kind:null,description:`Inventory of the selected source thinker's documents used to ground the AOI thematic a