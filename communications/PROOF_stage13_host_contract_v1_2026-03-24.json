        "job_id",
        "consumer_key"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": true,
      "host_local_identity_translation_before_launch": false,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "request_parameter",
      "notes": [
        "Primary result-backed page presentation family for workspace consumption."
      ]
    },
    {
      "family": "result_refresh",
      "owner": "analyzer_direct",
      "canonical_identity": "upstream_v2_job_id",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "analyzer_query_or_path",
      "required_inputs": [
        "job_id",
        "consumer_key"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": true,
      "host_local_identity_translation_before_launch": false,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "request_parameter",
      "notes": [
        "Refresh mutates presenter-owned delivery artifacts upstream, not host-owned state."
      ]
    },
    {
      "family": "run_detail",
      "owner": "analyzer_direct",
      "canonical_identity": "upstream_job_id",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "analyzer_query_or_path",
      "required_inputs": [
        "job_id",
        "consumer_key"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": false,
      "host_local_identity_translation_before_launch": false,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "request_parameter",
      "notes": [
        "Run detail stays upstream-authoritative even when the host holds local continuity aliases."
      ]
    },
    {
      "family": "run_discovery",
      "owner": "analyzer_direct",
      "canonical_identity": "not_applicable",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "analyzer_query_or_path",
      "required_inputs": [
        "project_id",
        "workflow_key",
        "consumer_key"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": false,
      "host_local_identity_translation_before_launch": false,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "request_parameter",
      "notes": [
        "Returns upstream run summaries; host does not synthesize run truth locally."
      ]
    },
    {
      "family": "single_view_fetch",
      "owner": "analyzer_direct",
      "canonical_identity": "upstream_v2_job_id",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "analyzer_query_or_path",
      "required_inputs": [
        "job_id",
        "view_key",
        "consumer_key"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": false,
      "host_local_identity_translation_before_launch": false,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "request_parameter",
      "notes": [
        "Used for lazy-loading individual view payloads from an upstream presentation tree."
      ]
    },
    {
      "family": "source_backed_readiness",
      "owner": "analyzer_direct",
      "canonical_identity": "upstream_v2_job_id",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "analyzer_query_or_path",
      "required_inputs": [
        "job_id",
        "consumer_key",
        "profile|composition_mode"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": false,
      "host_local_identity_translation_before_launch": false,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "request_parameter",
      "notes": [
        "Read-only analyzer-owned feasibility check for AOI profile and genealogy composition-mode followup."
      ]
    },
    {
      "family": "source_backed_transient_launch",
      "owner": "host_proxy",
      "canonical_identity": "upstream_v2_job_id",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "mixed",
      "required_inputs": [
        "project_id",
        "selected_source_thinker_id",
        "variant"
      ],
      "authoritative_response_source": "analyzer_direct",
      "local_snapshot_substitution_allowed": false,
      "host_local_identity_translation_before_launch": true,
      "contract_level": "must_have_v1",
      "consumer_key_contract": "structural_constant",
      "notes": [
        "Host proxy resolves project/thinker-scoped identity before forwarding source-backed transient compose to analyzer-v2.",
        "variant=profile requires profile; variant=selection requires selection and user_intent.",
        "source_analysis_id and source_v2_job_id are optional continuity selectors, not hard launch requirements."
      ]
    },
    {
      "family": "transient_compose_from_intent",
      "owner": "analyzer_direct",
      "canonical_identity": "not_applicable",
      "identity_authority": "upstream_authoritative",
      "scope_channel": "mixed",
      "required_inputs": [
        "workflow_key",
        "consumer_key",
        "sections"
