    {
      "host_surface_key": "genealogy_result_backed_workspace_experience",
      "workflow_key": "intellectual_genealogy",
      "owner": "host_owned_v1",
      "selected_families": [
        "run_discovery",
        "run_detail",
        "result_discovery",
        "result_manifest",
        "result_presentation",
        "result_refresh",
        "single_view_fetch",
