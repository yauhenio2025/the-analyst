  border: 1px solid #b5343a;\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  box-shadow: 0 0 40px rgba(181, 52, 58, 0.2);\n}\n\n/* Loading state */\n.outline-editor-loading {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  color: #b5343a;\n  font-size: 18px;\n}\n\n/* Header */\n.outline-editor-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px 24px;\n  border-bottom: 1px solid #b5343a;\n  background: linear-gradient(135deg, #1a1a1a 0%, rgba(181, 52, 58, 0.05) 100%);\n}\n\n.outline-editor-header h2 {\n  margin: 0;\n  color: #b5343a;\n  font-size: 22px;\n  font-weight: 600;\n}\n\n.outline-editor-header-center {\n  flex: 1 1;\n  display: flex;\n  justify-content: center;\n}\n\n.outline-editor-stats {\n  color: #757575;\n  font-size: 14px;\n}\n\n.outline-editor-header-actions {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.outline-editor-header-actions button {\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  color: #757575;\n  padding: 8px 14px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 13px;\n  transition: all 0.2s;\n}\n\n.outline-editor-header-actions button:hover {\n  background: #e8e5e0;\n  border-color: #b5343a;\n  color: #b5343a;\n}\n\n.outline-editor-header .close-btn {\n  background: none;\n  border: none;\n  color: #b5343a;\n  font-size: 28px;\n  cursor: pointer;\n  padding: 0;\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 4px;\n}\n\n.outline-editor-header .close-btn:hover {\n  background: rgba(181, 52, 58, 0.1);\n}\n\n/* Error display */\n.outline-editor-error {\n  background: rgba(255, 67, 67, 0.15);\n  border-bottom: 1px solid #ff4343;\n  color: #ff6b6b;\n  padding: 10px 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 13px;\n}\n\n.outline-editor-error button {\n  background: none;\n  border: none;\n  color: #ff6b6b;\n  cursor: pointer;\n  font-size: 18px;\n}\n\n/* Body layout */\n.outline-editor-body {\n  display: flex;\n  flex: 1 1;\n  overflow: hidden;\n}\n\n/* Left sidebar */\n.outline-editor-sidebar {\n  width: 300px;\n  min-width: 300px;\n  background: #ffffff;\n  border-right: 1px solid #e0ddd8;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Sidebar tabs */\n.sidebar-tabs {\n  display: flex;\n  border-bottom: 1px solid #e0ddd8;\n  padding: 8px;\n  gap: 4px;\n}\n\n.sidebar-tab {\n  flex: 1 1;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  color: #757575;\n  padding: 8px 12px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 12px;\n  transition: all 0.2s;\n}\n\n.sidebar-tab:hover {\n  background: #e8e5e0;\n  color: #757575;\n}\n\n.sidebar-tab.active {\n  background: rgba(181, 52, 58, 0.2);\n  border-color: #b5343a;\n  color: #b5343a;\n}\n\n/* Sidebar sections */\n.sidebar-sections {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.sidebar-section-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  background: #f5f3f0;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.sidebar-section-item:hover {\n  background: #e8e5e0;\n  border-color: #444;\n}\n\n.sidebar-section-item.selected {\n  background: rgba(181, 52, 58, 0.15);\n  border-color: #b5343a;\n}\n\n.sidebar-section-title {\n  flex: 1 1;\n  color: #4a4a4a;\n  font-size: 13px;\n  font-weight: 500;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.sidebar-section-count {\n  background: #e8e5e0;\n  color: #757575;\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-size: 11px;\n}\n\n.sidebar-section-item.selected .sidebar-section-count {\n  background: rgba(181, 52, 58, 0.3);\n  color: #b5343a;\n}\n\n.sidebar-section-actions {\n  display: none;\n  gap: 4px;\n}\n\n.sidebar-section-item:hover .sidebar-section-actions {\n  display: flex;\n}\n\n.sidebar-section-actions button {\n  background: none;\n  border: none;\n  color: #666;\n  cursor: pointer;\n  font-size: 12px;\n  padding: 2px;\n  transition: color 0.2s;\n}\n\n.sidebar-section-actions button:hover {\n  color: #b5343a;\n}\n\n.sidebar-section-edit-input {\n  flex: 1 1;\n  background: #e8e5e0;\n  border: 1px solid #b5343a;\n  color: #4a4a4a;\n  padding: 4px 8px;\n  border-radius: 3px;\n  font-size: 13px;\n}\n\n/* Section group (for hierarchical display) */\n.sidebar-section-group {\n  display: flex;\n  flex-direction: column;\n}\n\n.sidebar-section-item.has-children {\n  padding-left: 8px;\n}\n\n.sidebar-expand-btn {\n  background: none;\n  border: none;\n  color: #666;\n  cursor: pointer;\n  font-size: 10px;\n  padding: 2px 4px;\n  transition: color 0.2s;\n}\n\n.sidebar-expand-btn:hover {\n  color: #b5343a;\n}\n\n/* Sub-items (top-level TPs in sidebar) */\n.sidebar-subitems {\n  display: flex;\n  flex-direction: column;\n  margin-left: 16px;\n  padding-left: 12px;\n  border-left: 1px solid #e0ddd8;\n  gap: 2px;\n}\n\n.sidebar-subitem {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 10px;\n  border-radius: 3px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.sidebar-subitem:hover {\n  background: rgba(181, 52, 58, 0.1);\n}\n\n.sidebar-subitem.selected {\n  background: rgba(181, 52, 58, 0.2);\n  border-left: 2px solid #b5343a;\n  margin-left: -2px;\n}\n\n.sidebar-subitem-bullet {\n  color: #b5343a;\n  font-size: 10px;\n}\n\n.sidebar-subitem-title {\n  flex: 1 1;\n  color: #aaa;\n  font-size: 12px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.sidebar-subitem.selected .sidebar-subitem-title {\n  color: #b5343a;\n}\n\n.sidebar-subitem-count {\n  background: #e8e5e0;\n  color: #666;\n  padding: 1px 6px;\n  border-radius: 8px;\n  font-size: 10px;\n}\n\n.sidebar-subitem.selected .sidebar-subitem-count {\n  background: rgba(181, 52, 58, 0.3);\n  color: #b5343a;\n}\n\n/* Add section */\n.sidebar-add-section {\n  display: flex;\n  gap: 6px;\n  padding: 8px;\n  background: #f5f3f0;\n  border-radius: 4px;\n}\n\n.sidebar-add-section input {\n  flex: 1 1;\n  background: #e8e5e0;\n  border: 1px solid #444;\n  color: #4a4a4a;\n  padding: 6px 10px;\n  border-radius: 3px;\n  font-size: 12px;\n}\n\n.sidebar-add-section button {\n  background: #b5343a;\n  border: none;\n  color: #1a1a1a;\n  padding: 6px 12px;\n  border-radius: 3px;\n  cursor: pointer;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.sidebar-add-section button:last-child {\n  background: #e8e5e0;\n  color: #757575;\n}\n\n.sidebar-add-section-btn {\n  width: 100%;\n  background: transparent;\n  border: 1px dashed #444;\n  color: #757575;\n  padding: 10px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 13px;\n  transition: all 0.2s;\n}\n\n.sidebar-add-section-btn:hover {\n  border-color: #b5343a;\n  color: #b5343a;\n}\n\n/* Sidebar notes */\n.sidebar-notes {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.notes-hint {\n  color: #757575;\n  font-size: 12px;\n  margin: 0;\n  line-height: 1.5;\n}\n\n.notes-textarea {\n  flex: 1 1;\n  min-height: 200px;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  color: #4a4a4a;\n  padding: 12px;\n  border-radius: 4px;\n  font-family: inherit;\n  font-size: 13px;\n  line-height: 1.5;\n  resize: none;\n}\n\n.notes-textarea:focus {\n  border-color: #b5343a;\n  outline: none;\n}\n\n.notes-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.btn-extract {\n  width: 100%;\n  background: #b5343a;\n  border: none;\n  color: #1a1a1a;\n  padding: 10px 16px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 13px;\n  font-weight: 600;\n  transition: all 0.2s;\n}\n\n.btn-extract:hover:not(:disabled) {\n  background: #9a2c31;\n}\n\n.btn-extract:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.notes-char-count {\n  color: #666;\n  font-size: 11px;\n  text-align: right;\n}\n\n/* Sidebar documents */\n.sidebar-documents {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.document-card {\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  border-radius: 4px;\n  padding: 12px;\n}\n\n.document-card-title {\n  color: #b5343a;\n  font-size: 13px;\n  font-weight: 600;\n  margin-bottom: 8px;\n}\n\n.document-card-summary {\n  color: #999;\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.document-card-meta {\n  color: #666;\n  font-size: 11px;\n  margin-top: 8px;\n}\n\n.document-card-loading {\n  color: #666;\n  font-size: 12px;\n  font-style: italic;\n}\n\n/* Main content area */\n.outline-editor-main {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: #1a1a1a;\n}\n\n.main-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px 24px;\n  border-bottom: 1px solid #e0ddd8;\n  background: #ffffff;\n}\n\n.main-section-header-left {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.main-back-btn {\n  background: #e8e5e0;\n  border: 1px solid #444;\n  color: #757575;\n  padding: 6px 12px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 12px;\n  transition: all 0.2s;\n}\n\n.main-back-btn:hover {\n  background: #444;\n  color: #b5343a;\n  border-color: #b5343a;\n}\n\n/* Parent blurb (summary shown above children) */\n.main-parent-blurb {\n  background: rgba(181, 52, 58, 0.1);\n  border: 1px solid rgba(181, 52, 58, 0.3);\n  border-radius: 8px;\n  padding: 16px 20px;\n  margin-bottom: 20px;\n}\n\n.main-parent-blurb p {\n  margin: 0;\n  color: #4a4a4a;\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n.main-parent-source {\n  display: inline-block;\n  margin-top: 12px;\n  font-size: 12px;\n  color: #757575;\n}\n\n.main-section-header h3 {\n  margin: 0;\n  color: #b5343a;\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.main-section-actions button {\n  background: #b5343a;\n  border: none;\n  color: #1a1a1a;\n  padding: 8px 14px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 13px;\n  font-weight: 600;\n  transition: all 0.2s;\n}\n\n.main-section-actions button:hover {\n  background: #9a2c31;\n}\n\n.main-section-content {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 20px 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.main-empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  gap: 16px;\n  color: #666;\n}\n\n.main-empty-state button {\n  background: #b5343a;\n  border: none;\n  color: #1a1a1a;\n  padding: 10px 20px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 600;\n}\n\n/* Talking point cards */\n.tp-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 14px 16px;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  transition: all 0.2s;\n}\n\n.tp-card:hover {\n  border-color: #b5343a;\n  background: #f5f3f0;\n}\n\n.tp-card.depth-1 {\n  margin-left: 30px;\n  background: #222;\n  border-color: #f5f3f0;\n}\n\n.tp-card.depth-2 {\n  margin-left: 60px;\n  background: #ffffff;\n  border-color: #f5f3f0;\n}\n\n.tp-card-bullet {\n  color: #b5343a;\n  font-size: 14px;\n  padding-top: 2px;\n  flex-shrink: 0;\n}\n\n.tp-card-content {\n  flex: 1 1;\n  min-width: 0;\n}\n\n.tp-card-text {\n  color: #4a4a4a;\n  font-size: 14px;\n  line-height: 1.5;\n  margin-bottom: 6px;\n}\n\n.tp-card-meta {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.tp-source-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border-radius: 3px;\n  font-size: 11px;\n  font-weight: 500;\n}\n\n.tp-source-badge.lines {\n  background: rgba(32, 178, 170, 0.2);\n  color: #20b2aa;\n}\n\n.tp-source-badge.comment {\n  background: rgba(100, 149, 237, 0.2);\n  color: #6495ed;\n}\n\n.tp-source-badge.dictation {\n  background: rgba(186, 85, 211, 0.2);\n  color: #ba55d3;\n}\n\n.tp-source-badge.manual {\n  background: rgba(181, 52, 58, 0.2);\n  color: #b5343a;\n}\n\n.tp-stream-badge {\n  padding: 2px 8px;\n  border-radius: 3px;\n  font-size: 11px;\n  background: #e8e5e0;\n  color: #757575;\n}\n\n.tp-card-actions {\n  display: none;\n  gap: 4px;\n  flex-shrink: 0;\n}\n\n.tp-card:hover .tp-card-actions {\n  display: flex;\n}\n\n.tp-action-btn {\n  background: #e8e5e0;\n  border: 1px solid #444;\n  color: #757575;\n  width: 28px;\n  height: 28px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.2s;\n}\n\n.tp-action-btn:hover {\n  background: #e0ddd8;\n  border-color: #555;\n  color: #757575;\n}\n\n.tp-action-btn.upgrade:hover {\n  border-color: #b5343a;\n  color: #b5343a;\n}\n\n.tp-action-btn.delete:hover {\n  border-color: #ff6b6b;\n  color: #ff6b6b;\n}\n\n.tp-action-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.tp-card-children {\n  margin-top: 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n/* Add talking point card */\n.add-tp-card {\n  padding: 16px;\n  background: #f5f3f0;\n  border: 1px dashed #b5343a;\n  border-radius: 6px;\n}\n\n.add-tp-card textarea {\n  width: 100%;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  color: #4a4a4a;\n  padding: 12px;\n  border-radius: 4px;\n  font-family: inherit;\n  font-size: 14px;\n  line-height: 1.5;\n  resize: vertical;\n  margin-bottom: 10px;\n}\n\n.add-tp-card textarea:focus {\n  border-color: #b5343a;\n  outline: none;\n}\n\n.add-tp-card-actions {\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n}\n\n.add-tp-card-actions button {\n  padding: 8px 16px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 13px;\n  font-weight: 500;\n  transition: all 0.2s;\n}\n\n.add-tp-card-actions button:first-child {\n  background: #b5343a;\n  border: none;\n  color: #1a1a1a;\n}\n\n.add-tp-card-actions button:first-child:hover:not(:disabled) {\n  background: #9a2c31;\n}\n\n.add-tp-card-actions button:first-child:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.add-tp-card-actions button:last-child {\n  background: #e8e5e0;\n  border: 1px solid #444;\n  color: #757575;\n}\n\n.add-tp-card-actions button:last-child:hover {\n  border-color: #555;\n  color: #757575;\n}\n\n/* Scrollbar styling */\n.sidebar-sections::-webkit-scrollbar,\n.sidebar-notes::-webkit-scrollbar,\n.sidebar-documents::-webkit-scrollbar,\n.main-section-content::-webkit-scrollbar {\n  width: 8px;\n}\n\n.sidebar-sections::-webkit-scrollbar-track,\n.sidebar-notes::-webkit-scrollbar-track,\n.sidebar-documents::-webkit-scrollbar-track,\n.main-section-content::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.sidebar-sections::-webkit-scrollbar-thumb,\n.sidebar-notes::-webkit-scrollbar-thumb,\n.sidebar-documents::-webkit-scrollbar-thumb,\n.main-section-content::-webkit-scrollbar-thumb {\n  background: #e8e5e0;\n  border-radius: 4px;\n}\n\n.sidebar-sections::-webkit-scrollbar-thumb:hover,\n.sidebar-notes::-webkit-scrollbar-thumb:hover,\n.sidebar-documents::-webkit-scrollbar-thumb:hover,\n.main-section-content::-webkit-scrollbar-thumb:hover {\n  background: #444;\n}\n\n/* Summary Modal */\n.summary-modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.75);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1100;\n  padding: 1rem;\n}\n\n.summary-modal {\n  background: #e0ddd8;\n  border-radius: 8px;\n  max-width: 700px;\n  width: 100%;\n  max-height: 80vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);\n  border: 1px solid #b5343a;\n}\n\n.summary-modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 1rem 1.5rem;\n  border-bottom: 1px solid #b5343a;\n}\n\n.summary-modal-header h3 {\n  margin: 0;\n  font-size: 1.1rem;\n  color: #b5343a;\n}\n\n.summary-modal-close {\n  background: transparent;\n  border: none;\n  color: #757575;\n  font-size: 1.5rem;\n  cursor: pointer;\n  padding: 0;\n  line-height: 1;\n}\n\n.summary-modal-close:hover {\n  color: #eee;\n}\n\n.summary-modal-body {\n  padding: 1.5rem;\n  overflow-y: auto;\n  flex: 1 1;\n}\n\n.summary-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.summary-form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.summary-form-field label {\n  font-size: 0.9rem;\n  color: #eee;\n  font-weight: 500;\n}\n\n.summary-form-field .required {\n  color: #e74c3c;\n}\n\n.summary-form-field .optional {\n  color: #666;\n  font-weight: normal;\n  font-size: 0.8rem;\n}\n\n.summary-form-field input,\n.summary-form-field textarea {\n  background: #1a1a1a;\n  border: 1px solid #e0ddd8;\n  color: #eee;\n  padding: 0.75rem;\n  border-radius: 6px;\n  font-size: 0.9rem;\n  font-family: inherit;\n}\n\n.summary-form-field input:focus,\n.summary-form-field textarea:focus {\n  outline: none;\n  border-color: #b5343a;\n  box-shadow: 0 0 0 3px rgba(181, 52, 58, 0.2);\n}\n\n.summary-form-field input:disabled,\n.summary-form-field textarea:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.summary-form-field textarea {\n  resize: vertical;\n  min-height: 80px;\n}\n\n.summary-generate-btn {\n  background: linear-gradient(135deg, #b5343a, #9a2c31);\n  border: none;\n  color: white;\n  padding: 0.9rem 1.5rem;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 1rem;\n  transition: all 0.2s;\n  margin-top: 0.5rem;\n}\n\n.summary-generate-btn:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 15px rgba(181, 52, 58, 0.4);\n}\n\n.summary-generate-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  transform: none;\n  box-shadow: none;\n}\n\n.summary-result {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.summary-result h4 {\n  margin: 0;\n  font-size: 1rem;\n  color: #b5343a;\n}\n\n.summary-content {\n  background: #1a1a1a;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  padding: 1rem;\n  max-height: 350px;\n  overflow-y: auto;\n  font-size: 0.9rem;\n  line-height: 1.6;\n  color: #eee;\n}\n\n.summary-content p {\n  margin: 0 0 0.75rem 0;\n}\n\n.summary-content p:last-child {\n  margin-bottom: 0;\n}\n\n.summary-actions {\n  display: flex;\n  gap: 0.75rem;\n  padding-top: 0.5rem;\n}\n\n.summary-actions button {\n  background: transparent;\n  border: 1px solid #e0ddd8;\n  color: #aaa;\n  padding: 0.6rem 1rem;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 0.85rem;\n  transition: all 0.2s;\n}\n\n.summary-actions button:hover {\n  border-color: #b5343a;\n  color: #b5343a;\n  background: rgba(181, 52, 58, 0.1);\n}\n\n/* Summary Section Selection */\n.summary-section-selection {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  background: #1a1a1a;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  padding: 0.75rem;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.summary-section-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  padding-left: 0.5rem;\n  border-left: 2px solid #333;\n  margin-left: 0.5rem;\n}\n\n.summary-section-checkbox {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  cursor: pointer;\n  padding: 0.35rem 0.5rem;\n  border-radius: 4px;\n  transition: background 0.15s;\n}\n\n.summary-section-checkbox:hover {\n  background: rgba(181, 52, 58, 0.1);\n}\n\n.summary-section-checkbox.select-all {\n  font-weight: 600;\n  padding-bottom: 0.5rem;\n  margin-bottom: 0.25rem;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.summary-section-checkbox input[type=\"checkbox\"] {\n  width: 16px;\n  height: 16px;\n  accent-color: #b5343a;\n  cursor: pointer;\n}\n\n.summary-section-checkbox .checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: #eee;\n  font-size: 0.9rem;\n}\n\n.summary-section-checkbox .section-tp-count {\n  color: #757575;\n  font-size: 0.8rem;\n}\n\n.summary-selection-info {\n  font-size: 0.8rem;\n  color: #757575;\n  margin-top: 0.25rem;\n}\n\n/* Wide modal variant for saved summaries */\n.summary-modal.summary-modal-wide {\n  width: 700px;\n  max-width: 90vw;\n}\n\n/* Summary modal tabs */\n.summary-modal-tabs {\n  display: flex;\n  gap: 0.5rem;\n  margin-left: auto;\n  margin-right: 1rem;\n}\n\n.summary-tab {\n  padding: 0.4rem 0.75rem;\n  background: transparent;\n  border: 1px solid #e0ddd8;\n  border-radius: 4px;\n  color: #757575;\n  cursor: pointer;\n  font-size: 0.85rem;\n  transition: all 0.15s;\n}\n\n.summary-tab:hover {\n  color: #eee;\n  border-color: #666;\n}\n\n.summary-tab.active {\n  background: rgba(181, 52, 58, 0.2);\n  border-color: #b5343a;\n  color: #b5343a;\n}\n\n/* Saved summaries list */\n.saved-summaries-list {\n  min-height: 300px;\n}\n\n.saved-summaries-list .loading-state,\n.saved-summaries-list .empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 200px;\n  color: #757575;\n  text-align: center;\n}\n\n.saved-summaries-list .empty-state .hint {\n  font-size: 0.85rem;\n  color: #666;\n  margin-top: 0.5rem;\n}\n\n.summaries-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 1rem;\n}\n\n/* Saved summary card */\n.saved-summary-card {\n  background: #1a1a1a;\n  border: 1px solid #e0ddd8;\n  border-radius: 8px;\n  padding: 1rem;\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.saved-summary-card:hover {\n  border-color: #b5343a;\n  background: #222;\n}\n\n.saved-summary-card .card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 0.5rem;\n}\n\n.saved-summary-card .card-title {\n  font-weight: 600;\n  color: #eee;\n  font-size: 0.95rem;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  max-width: 200px;\n}\n\n.version-badge {\n  background: rgba(181, 52, 58, 0.2);\n  color: #b5343a;\n  padding: 0.15rem 0.4rem;\n  border-radius: 4px;\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n\n.saved-summary-card .card-meta {\n  display: flex;\n  gap: 0.5rem;\n  font-size: 0.8rem;\n  color: #757575;\n  margin-bottom: 0.5rem;\n}\n\n.saved-summary-card .card-preview {\n  font-size: 0.85rem;\n  color: #aaa;\n  line-height: 1.4;\n  max-height: 4.2em;\n  overflow: hidden;\n  margin-bottom: 0.5rem;\n}\n\n.saved-summary-card .card-date {\n  font-size: 0.75rem;\n  color: #666;\n}\n\n/* Summary result header with meta */\n.summary-result-header {\n  margin-bottom: 1rem;\n}\n\n.summary-result-header h4 {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin: 0 0 0.5rem 0;\n}\n\n.summary-result .summary-meta {\n  display: flex;\n  gap: 0.5rem;\n  font-size: 0.8rem;\n  color: #757575;\n}\n\n/* Save button style */\n.summary-actions .save-btn {\n  background: #b5343a;\n  color: #111;\n  font-weight: 600;\n}\n\n.summary-actions .save-btn:hover:not(:disabled) {\n  background: #e67e22;\n}\n\n.summary-actions .save-btn:disabled {\n  background: #666;\n  color: #999;\n}\n\n/* Delete button style */\n.summary-actions .delete-btn {\n  background: transparent;\n  border-color: #dc3545;\n  color: #dc3545;\n}\n\n.summary-actions .delete-btn:hover {\n  background: rgba(220, 53, 69, 0.1);\n}\n\n/* ============================================\n   FULL PAGE MODE STYLES\n   ============================================ */\n\n/* Full page wrapper - fills available space */\n.outline-editor-page {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  height: 100%;\n}\n\n/* Full page panel - no modal constraints */\n.outline-editor-panel.full-page {\n  width: 100%;\n  max-width: none;\n  height: 100%;\n  max-height: none;\n  border-radius: 0;\n  box-shadow: none;\n  border: none;\n  border-top: 1px solid #b5343a;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/OutlineEditorPanel.css\"],\"names\":[],\"mappings\":\"AAAA,6CAA6C;AAC7C,oEAAoE;;AAEpE;EACE,eAAe;EACf,MAAM;EACN,OAAO;EACP,QAAQ;EACR,SAAS;EACT,+BAA+B;EAC/B,aAAa;EACb,aAAa;EACb,mBAAmB;EACnB,uBAAuB;AACzB;;AAEA;EACE,UAAU;EACV,iBAAiB;EACjB,YAAY;EACZ,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,gBAAgB;EAChB,2CAA2C;AAC7C;;AAEA,kBAAkB;AAClB;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,YAAY;EACZ,cAAc;EACd,eAAe;AACjB;;AAEA,WAAW;AACX;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,kBAAkB;EAClB,gCAAgC;EAChC,6EAA6E;AAC/E;;AAEA;EACE,SAAS;EACT,cAAc;EACd,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,SAAO;EACP,aAAa;EACb,uBAAuB;AACzB;;AAEA;EACE,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,aAAa;EACb,SAAS;EACT,mBAAmB;AACrB;;AAEA;EACE,mBAAmB;EACnB,yBAAyB;EACzB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,mBAAmB;EACnB,qBAAqB;EACrB,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,eAAe;EACf,eAAe;EACf,UAAU;EACV,WAAW;EACX,YAAY;EACZ,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,kBAAkB;AACpB;;AAEA;EACE,kCAAkC;AACpC;;AAEA,kBAAkB;AAClB;EACE,mCAAmC;EACnC,gCAAgC;EAChC,cAAc;EACd,kBAAkB;EAClB,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,eAAe;AACjB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,eAAe;EACf,eAAe;AACjB;;AAEA,gBAAgB;AAChB;EACE,aAAa;EACb,SAAO;EACP,gBAAgB;AAClB;;AAEA,iBAAiB;AACjB;EACE,YAAY;EACZ,gBAAgB;EAChB,mBAAmB;EACnB,+BAA+B;EAC/B,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,iBAAiB;AACjB;EACE,aAAa;EACb,gCAAgC;EAChC,YAAY;EACZ,QAAQ;AACV;;AAEA;EACE,SAAO;EACP,mBAAmB;EACnB,yBAAyB;EACzB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,mBAAmB;EACnB,cAAc;AAChB;;AAEA;EACE,kCAAkC;EAClC,qBAAqB;EACrB,cAAc;AAChB;;AAEA,qBAAqB;AACrB;EACE,SAAO;EACP,gBAAgB;EAChB,aAAa;EACb,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,kBAAkB;EAClB,mBAAmB;EACnB,6BAA6B;EAC7B,kBAAkB;EAClB,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,mBAAmB;EACnB,kBAAkB;AACpB;;AAEA;EACE,mCAAmC;EACnC,qBAAqB;A