\n.revise-modal .close-button:hover {\n  background: #e0ddd8;\n  color: #fff;\n}\n\n/* Body */\n.revise-modal .modal-body {\n  padding: 20px;\n  overflow-y: auto;\n  flex: 1 1;\n}\n\n.revise-modal .section {\n  margin-bottom: 24px;\n}\n\n.revise-modal .section:last-child {\n  margin-bottom: 0;\n}\n\n.revise-modal .section h3 {\n  margin: 0 0 12px 0;\n  font-size: 14px;\n  font-weight: 600;\n  color: #4a4a4a;\n}\n\n.revise-modal .section-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 12px;\n}\n\n.revise-modal .section-header h3 {\n  margin: 0;\n}\n\n.revise-modal .select-all-button {\n  background: none;\n  border: 1px solid #e0ddd8;\n  color: #757575;\n  font-size: 12px;\n  padding: 4px 10px;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.revise-modal .select-all-button:hover {\n  border-color: #b5343a;\n  color: #b5343a;\n}\n\n/* Dives List */\n.revise-modal .no-dives {\n  padding: 20px;\n  text-align: center;\n  color: #666;\n  background: #f5f3f0;\n  border-radius: 8px;\n}\n\n.revise-modal .dives-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.revise-modal .dive-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 12px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.revise-modal .dive-item:hover {\n  background: #f5f3f0;\n}\n\n.revise-modal .dive-item.selected {\n  border-color: #b5343a;\n  background: rgba(99, 102, 241, 0.1);\n}\n\n.revise-modal .dive-item input[type=\"checkbox\"] {\n  margin-top: 2px;\n  accent-color: #b5343a;\n}\n\n.revise-modal .dive-info {\n  flex: 1 1;\n}\n\n.revise-modal .dive-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 4px;\n}\n\n.revise-modal .sin-type-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: #4a4a4a;\n  text-transform: capitalize;\n}\n\n.revise-modal .findings-count {\n  font-size: 11px;\n  color: #757575;\n  background: #faf8f5;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.revise-modal .dive-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  color: #666;\n}\n\n.revise-modal .days-pending {\n  color: #eab308;\n}\n\n/* Mode Options */\n.revise-modal .mode-options {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.revise-modal .mode-option {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 12px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.revise-modal .mode-option:hover {\n  background: #f5f3f0;\n}\n\n.revise-modal .mode-option.selected {\n  border-color: #b5343a;\n  background: rgba(99, 102, 241, 0.1);\n}\n\n.revise-modal .mode-option input[type=\"radio\"] {\n  margin-top: 2px;\n  accent-color: #b5343a;\n}\n\n.revise-modal .mode-info {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.revise-modal .mode-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: #4a4a4a;\n}\n\n.revise-modal .mode-description {\n  font-size: 12px;\n  color: #757575;\n  line-height: 1.4;\n}\n\n/* Guidance Input */\n.revise-modal .guidance-input {\n  width: 100%;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  border-radius: 8px;\n  padding: 12px;\n  color: #4a4a4a;\n  font-size: 13px;\n  font-family: inherit;\n  resize: vertical;\n  transition: border-color 0.2s ease;\n}\n\n.revise-modal .guidance-input::placeholder {\n  color: #666;\n}\n\n.revise-modal .guidance-input:focus {\n  outline: none;\n  border-color: #b5343a;\n}\n\n/* Error Message */\n.revise-modal .error-message {\n  padding: 12px;\n  background: rgba(239, 68, 68, 0.15);\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  border-radius: 8px;\n  color: #ef4444;\n  font-size: 13px;\n  margin-top: 16px;\n}\n\n/* Footer */\n.revise-modal .modal-footer {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 12px;\n  padding: 16px 20px;\n  border-top: 1px solid #e0ddd8;\n}\n\n.revise-modal .cancel-button {\n  background: none;\n  border: 1px solid #e0ddd8;\n  color: #757575;\n  font-size: 14px;\n  padding: 10px 20px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.revise-modal .cancel-button:hover:not(:disabled) {\n  border-color: #757575;\n  color: #4a4a4a;\n}\n\n.revise-modal .cancel-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.revise-modal .submit-button {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: #b5343a;\n  border: none;\n  color: #fff;\n  font-size: 14px;\n  font-weight: 500;\n  padding: 10px 20px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.revise-modal .submit-button:hover:not(:disabled) {\n  background: #5558e3;\n}\n\n.revise-modal .submit-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.revise-modal .submit-button .spinner {\n  width: 14px;\n  height: 14px;\n  border: 2px solid rgba(255, 255, 255, 0.3);\n  border-top-color: #fff;\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Responsive */\n@media (max-width: 600px) {\n  .revise-modal {\n    max-height: 90vh;\n  }\n\n  .revise-modal .dives-list {\n    max-height: 150px;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/ReviseReportModal.css\"],\"names\":[],\"mappings\":\"AAAA,0BAA0B;;AAE1B;EACE,eAAe;EACf,MAAM;EACN,OAAO;EACP,QAAQ;EACR,SAAS;EACT,8BAA8B;EAC9B,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,aAAa;EACb,aAAa;AACf;;AAEA;EACE,mBAAmB;EACnB,mBAAmB;EACnB,gBAAgB;EAChB,WAAW;EACX,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,0CAA0C;AAC5C;;AAEA,WAAW;AACX;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,kBAAkB;EAClB,gCAAgC;AAClC;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,WAAW;AACb;;AA