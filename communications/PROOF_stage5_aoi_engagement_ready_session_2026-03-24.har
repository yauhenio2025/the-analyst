nt .step-description {\n  color: #94a3b8;\n}\n\n.step-connector {\n  flex: 1 1;\n  height: 2px;\n  background: #757575;\n  margin: 19px 16px 0;\n  min-width: 40px;\n}\n\n.step-connector.completed {\n  background: #22c55e;\n}\n\n/* Responsive adjustments */\n@media (max-width: 900px) {\n  .wizard-progress {\n    flex-wrap: wrap;\n    gap: 16px;\n  }\n\n  .step-connector {\n    display: none;\n  }\n\n  .step-description {\n    display: none;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/wizard/WizardProgress.css\"],\"names\":[],\"mappings\":\"AAAA,0BAA0B;;AAE1B;EACE,aAAa;EACb,uBAAuB;EACvB,MAAM;EACN,eAAe;EACf,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,uBAAuB;EACvB,SAAS;EACT,cAAc;AAChB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,sBAAsB;AACxB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,kBAAkB;EAClB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,eAAe;EACf,gBAAgB;EAChB,mBAAmB;EACnB,yBAAyB;EACzB,cAAc;EACd,yBAAyB;EACzB,cAAc;AAChB;;AAEA;EACE,qDAAqD;EACrD,qBAAqB;EACrB,YAAY;EACZ,6CAA6C;AAC/C;;AAEA;EACE,mBAAmB;EACnB,qBAAqB;EACrB,YAAY;AACd;;AAEA;EACE,WAAW;EACX,YAAY;AACd;;AAEA;EACE,gBAAgB;AAClB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,mBAAmB;AACrB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,SAAO;EACP,WAAW;EACX,mBAAmB;EACnB,mBAAmB;EACnB,eAAe;AACjB;;AAEA;EACE,mBAAmB;AACrB;;AAEA,2BAA2B;AAC3B;EACE;IACE,eAAe;IACf,SAAS;EACX;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,aAAa;EACf;AACF\",\"sourcesContent\":[\"/* WizardProgress Styles */\\n\\n.wizard-progress {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 0;\\n  padding: 24px 0;\\n  margin-bottom: 32px;\\n}\\n\\n.wizard-step {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  flex: 0 0 auto;\\n}\\n\\n.wizard-step.clickable {\\n  cursor: pointer;\\n}\\n\\n.wizard-step.clickable:hover .step-indicator {\\n  transform: scale(1.05);\\n}\\n\\n.step-indicator {\\n  width: 40px;\\n  height: 40px;\\n  border-radius: 50%;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  font-size: 16px;\\n  font-weight: 600;\\n  background: #faf8f5;\\n  border: 2px solid #757575;\\n  color: #64748b;\\n  transition: all 0.2s ease;\\n  flex-shrink: 0;\\n}\\n\\n.wizard-step.current .step-indicator {\\n  background: linear-gradient(135deg, #b5343a, #b5343a);\\n  border-color: #b5343a;\\n  color: white;\\n  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);\\n}\\n\\n.wizard-step.completed .step-indicator {\\n  background: #22c55e;\\n  border-color: #22c55e;\\n  color: white;\\n}\\n\\n.wizard-step.completed .step-indicator svg {\\n  width: 18px;\\n  height: 18px;\\n}\\n\\n.step-content {\\n  padding-top: 4px;\\n}\\n\\n.step-title {\\n  font-size: 15px;\\n  font-weight: 600;\\n  color: #64748b;\\n  margin-bottom: 2px;\\n  white-space: nowrap;\\n}\\n\\n.wizard-step.current .step-title {\\n  color: #1a1a1a;\\n}\\n\\n.wizard-step.completed .step-title {\\n  color: #22c55e;\\n}\\n\\n.step-description {\\n  font-size: 12px;\\n  color: #475569;\\n  white-space: nowrap;\\n}\\n\\n.wizard-step.current .step-description {\\n  color: #94a3b8;\\n}\\n\\n.step-connector {\\n  flex: 1;\\n  height: 2px;\\n  background: #757575;\\n  margin: 19px 16px 0;\\n  min-width: 40px;\\n}\\n\\n.step-connector.completed {\\n  background: #22c55e;\\n}\\n\\n/* Responsive adjustments */\\n@media (max-width: 900px) {\\n  .wizard-progress {\\n    flex-wrap: wrap;\\n    gap: 16px;\\n  }\\n\\n  .step-connector {\\n    display: none;\\n  }\\n\\n  .step-description {\\n    display: none;\\n  }\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/wizard/WizardSteps.css\"\n/*!**************************