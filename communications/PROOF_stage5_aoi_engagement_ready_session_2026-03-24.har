            "text": "{\"job_id\":\"proof-round5-adaptive-aoi-dossier-final-1774100000\",\"plan_id\":\"plan-proof-round5-aoi-1774100000\",\"workflow_key\":\"anxiety_of_influence_thematic_single_thinker\",\"consumer_key\":\"the-critic\",\"composition_mode\":null,\"result_id\":\"result-d6624e014020099382789673\",\"result_state\":\"ready\",\"corpus_ref\":\"corp-e042b4288275bd5dfe039086\",\"status\":\"completed\",\"presentation_contract_version\":1,\"presentation_hash\":\"ef7e069d3a5dfa95f1e4206e834cb616fe70ab3bbc0e655cc1131a0bf2970063\",\"presentation_content_hash\":\"74bd40ba96015defabe670ee876cf58275a896d8e55b3e72db2b47f7d2370d5d\",\"prepared_at\":\"2026-03-21T03:43:57.232106\",\"artifacts_ready\":false,\"presentation_status\":\"completed\",\"preparation_detail\":\"Presentation ready\",\"presentation_active\":false,\"restore_available\":true,\"restore_reason\":\"presentation_ready\",\"staleness_reasons\":[],\"product_warnings\":[],\"links\":{\"page_url\":\"/v1/presenter/page/proof-round5-adaptive-aoi-dossier-final-1774100000?consumer_key=the-critic\",\"presentation_url\":\"/v1/results/by-job/proof-round5-adaptive-aoi-dossier-final-1774100000/presentation?consumer_key=the-critic\",\"manifest_url\":\"/v1/results/by-job/proof-round5-adaptive-aoi-dossier-final-1774100000?consumer_key=the-critic\",\"trace_url\":\"/v1/presenter/trace/proof-round5-adaptive-aoi-dossier-final-1774100000?consumer_key=the-critic\",\"refresh_presentation_url\":\"/v1/results/by-job/proof-round5-adaptive-aoi-dossier-final-1774100000/refresh-presentation?consumer_key=the-critic\"},\"artifact_families\":[{\"artifact_family\":\"aoi.engagement_map\",\"state\":\"ready\",\"format\":\"structured_json\",\"total_slots\":1,\"ready_slots\":1,\"pending_slots\":0,\"stale_slots\":0,\"unavailable_slots\":0,\"slots\":[{\"slot\":\"default\",\"state\":\"ready\",\"artifact_ref\":\"artifact-b195c20ef7e44e4fc32382aa\",\"source_output_id\":\"po-4644734a6cbf\",\"reuse_state\":null,\"reused_from_job_id\":null}]},{\"artifa