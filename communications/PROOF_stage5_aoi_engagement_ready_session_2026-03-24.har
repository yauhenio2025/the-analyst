t-selector-dropdown {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  margin-top: 4px;\n  min-width: 280px;\n  max-width: 350px;\n  background: #faf8f5;\n  border: 1px solid #757575;\n  border-radius: 12px;\n  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);\n  z-index: 1000;\n  overflow: hidden;\n}\n\n.project-selector-header {\n  padding: 12px 16px;\n  border-bottom: 1px solid #757575;\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: #94a3b8;\n}\n\n.project-selector-list {\n  max-height: 300px;\n  overflow-y: auto;\n  padding: 8px;\n}\n\n.project-selector-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  padding: 12px;\n  background: transparent;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: background 0.15s ease;\n  text-align: left;\n  color: #4a4a4a;\n}\n\n.project-selector-item:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.project-selector-item.active {\n  background: rgba(59, 130, 246, 0.15);\n}\n\n.project-item-content {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n\n.project-item-name {\n  font-weight: 500;\n  font-size: 14px;\n  color: #1a1a1a;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.project-item-authors {\n  font-size: 12px;\n  color: #94a3b8;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.project-item-check {\n  color: #22c55e;\n  font-size: 14px;\n  flex-shrink: 0;\n  margin-left: 8px;\n}\n\n/* Footer */\n.project-selector-footer {\n  padding: 8px;\n  border-top: 1px solid #757575;\n}\n\n.project-selector-manage {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 10px 12px;\n  background: transparent;\n  border: 1px dashed #475569;\n  border-radius: 8px;\n  color: #94a3b8;\n  cursor: pointer;\n  font-size: 13px;\n  transition: all 0.15s ease;\n}\n\n.project-selector-manage:hover {\n  background: rgba(255, 255, 255, 0.05);\n  border-color: #64748b;\n  color: #4a4a4a;\n}\n\n.manage-icon {\n  font-size: 14px;\n}\n\n/* Scrollbar styling */\n.project-selector-list::-webkit-scrollbar {\n  width: 6px;\n}\n\n.project-selector-list::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.project-selector-list::-webkit-scrollbar-thumb {\n  background: #475569;\n  border-radius: 3px;\n}\n\n.project-selector-list::-webkit-scrollbar-thumb:hover {\n  background: #64748b;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/ProjectSelector.css\"],\"names\":[],\"mappings\":\"AAAA,2BAA2B;;AAE3B;EACE,kBAAkB;EAClB,aAAa;EACb,mBAAmB;AACrB;;AAEA;EACE,YAAY;AACd;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,qCAAqC;EACrC,0CAA0C;EAC1C,kBAAkB;EAClB,cAAc;EACd,eAAe;EACf,yBAAyB;EACzB,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,oCAAoC;EACpC,sCAAsC;AACxC;;AAEA;EACE,mCAAmC;EACnC,qCAAqC;AACvC;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,SAAO;EACP,gBAAgB;EAChB,uBAAuB;EACvB,mBAAmB;EACnB,gBAAgB;AAClB;;AAEA;EACE,eAAe;EACf,YAAY;EACZ,cAAc;AAChB;;AAEA,kBAAkB;AAClB;EACE,kBAAkB;EAClB,SAAS;EACT,OAAO;EACP,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,0CAA0C;EAC1C,aAAa;EACb,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,gCAAgC;EAChC,eAAe;EACf,gBAAgB;EAChB,yBAAyB;EACzB,qBAAqB;EACrB,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,gBAAgB;EAChB,YAAY;AACd;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,WAAW;EACX,aAAa;EACb,uBAAuB;EACvB,YAAY;EACZ,kBAAkB;EAClB,eAAe;EACf,iCAAiC;EACjC,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,qCAAqC;AACvC;;AAEA;EACE,oCAAoC;AACtC;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;EACR,YAAY;AACd;;AAEA;EACE,gBAAgB;EAChB,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,uBAAuB;EACvB,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,uBAAuB;EACvB,mBAAmB;AACrB;;AAEA;EACE,cAAc;EACd,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA,WAAW;AACX;EACE,YAAY;EACZ,6BAA6B;AAC/B;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,WAAW;EACX,kBAAkB;EAClB,uBAAuB;EACvB,0BAA0B;EAC1B,kBAAkB;EAClB,c