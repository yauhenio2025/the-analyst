ng: 8px;\\n}\\n\\n.project-selector-item {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  width: 100%;\\n  padding: 12px;\\n  background: transparent;\\n  border: none;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: background 0.15s ease;\\n  text-align: left;\\n  color: #4a4a4a;\\n}\\n\\n.project-selector-item:hover {\\n  background: rgba(255, 255, 255, 0.05);\\n}\\n\\n.project-selector-item.active {\\n  background: rgba(59, 130, 246, 0.15);\\n}\\n\\n.project-item-content {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 2px;\\n  min-width: 0;\\n}\\n\\n.project-item-name {\\n  font-weight: 500;\\n  font-size: 14px;\\n  color: #1a1a1a;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.project-item-authors {\\n  font-size: 12px;\\n  color: #94a3b8;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.project-item-check {\\n  color: #22c55e;\\n  font-size: 14px;\\n  flex-shrink: 0;\\n  margin-left: 8px;\\n}\\n\\n/* Footer */\\n.project-selector-footer {\\n  padding: 8px;\\n  border-top: 1px solid #757575;\\n}\\n\\n.project-selector-manage {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  width: 100%;\\n  padding: 10px 12px;\\n  background: transparent;\\n  border: 1px dashed #475569;\\n  border-radius: 8px;\\n  color: #94a3b8;\\n  cursor: pointer;\\n  font-size: 13px;\\n  transition: all 0.15s ease;\\n}\\n\\n.project-selector-manage:hover {\\n  background: rgba(255, 255, 255, 0.05);\\n  border-color: #64748b;\\n  color: #4a4a4a;\\n}\\n\\n.manage-icon {\\n  font-size: 14px;\\n}\\n\\n/* Scrollbar styling */\\n.project-selector-list::-webkit-scrollbar {\\n  width: 6px;\\n}\\n\\n.project-selector-list::-webkit-scrollbar-track {\\n  background: transparent;\\n}\\n\\n.project-selector-list::-webkit-scrollbar-thumb {\\n  background: #475569;\\n  border-radius: 3px;\\n}\\n\\n.project-selector-list::-webkit-scrollbar-thumb:hover {\\n  background: #64748b;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/ResearchComments.css\"\n/*!****************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/ResearchComments.css ***!\n  \\****************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/* ── Comment Popup (on text selection) ─────────────────── */\n\n.research-comment-popup {\n  position: absolute;\n  z-index: 100;\n  width: 300px;\n  background: linear-gradient(135deg, #1e1b18 0%, #1a1714 100%);\n  border: 1px solid rgba(194, 99, 90, 0.25);\n  border-radius: 10px;\n  padding: 12px;\n  box-shadow:\n    0 8px 24px rgba(0, 0, 0, 0.4),\n    0 0 0 1px rgba(255, 255, 255, 0.04) inset;\n  animation: popup-fade-in 0.15s ease-out;\n}\n\n@keyframes popup-fade-in {\n  from { opacity: 0; transform: translateY(4px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.rcp-quote {\n  font-size: 0.76rem;\n  color: #cec4b8;\n  font-style: italic;\n  margin-bottom: 8px;\n  line-height: 1.4;\n  border-left: 2px solid rgba(194, 99, 90, 0.4);\n  padding-left: 8px;\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n.rcp-textarea {\n  width: 100%;\n  background: rgba(18, 16, 14, 0.6);\n  border: 1px solid rgba(100, 88, 75, 0.4);\n  border-radius: 6px;\n  color: #f5efe6;\n  font-size: 0.82rem;\n  padding: 8px 10px;\n  resize: none;\n  font-family: 'Inter', -apple-system, sans-serif;\n  line-height: 1.5;\n  box-sizing: border-box;\n}\n\n.rcp-textarea:focus {\n  outline: none;\n  border-color: rgba(194, 99, 90, 0.5);\n  box-shadow: 0 0 0 2px rgba(194, 99, 90, 0.1);\n}\n\n.rcp-actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 8px;\n}\n\n.rcp-btn {\n  padding: 5px 14px;\n  border: none;\n  border-radius: 6px;\n  font-size: 0.78rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.rcp-btn-save { background: #c2635a; color: #fff; }\n.rcp-btn-save:hover { background: #d4857e; }\n.rcp-btn-save:disabled { opacity: 0.4; cursor: default; }\n.rcp-btn-cancel { background: rgba(90, 78, 65, 0.5); color: #cec4b8; }\n.rcp-btn-cancel:hover { background: rgba(100, 88, 75, 0.5); }\n.rcp-hint { font-size: 0.68rem; color: #8e867c; margin-left: auto; }\n\n\n/* ── Destination Buttons (Arsenal / Research) ─────────── */\n\n.rcp-divider {\n  height: 1px;\n  background: rgba(100, 88, 75, 0.3);\n  margin: 8px 0 6px;\n}\n\n.rcp-destinations {\n  display: flex;\n  gap: 6px;\n}\n\n.rcp-dest-btn {\n  flex: 1 1;\n  padding: 5px 10px;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  font-size: 0.74rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s;\n  font-family: 'Inter', -apple-system, sans-serif;\n  background: transparent;\n}\n\n.rcp-dest-arsenal {\n  color: #d97706;\n  border-color: rgba(217, 119, 6, 0.25);\n}\n.rcp-dest-arsenal:hover:not(:disabled) {\n  background: rgba(217, 119, 6, 0.1);\n  border-color: rgba(217, 119, 6, 0.45);\n}\n\n.rcp-dest-research {\n  color: #818cf8;\n  border-color: rgba(99, 102, 241, 0.25);\n}\n.rcp-dest-research:hover:not(:disabled) {\n  background: rgba(99, 102, 241, 0.1);\n  border-color: rgba(99, 102, 241, 0.45);\n}\n\n.rcp-dest-btn:disabled {\n  opacity: 0.5;\n  cursor: default;\n}\n\n.rcp-dest-feedback {\n  text-align: center;\n  font-size: 0.76rem;\n  font-weight: 500;\n  padding: 5px 0 2px;\n  font-family: 'Inter', -apple-system, sans-serif;\n  animation: popup-fade-in 0.15s ease-out;\n}\n\n.rcp-dest-feedback-success {\n  color: #4ade80;\n}\n\n.rcp-dest-feedback-error {\n  color: #f87171;\n}\n\n\n/* ── Comment Anchor Marks (in answer text) ────────────── */\n\n/* Default: warm subtle dotted underline to show which text has comments */\n.comment-anchor-mark {\n  background: transparent;\n  color: inherit;\n  border-bottom: 1.5px dotted rgba(180, 160, 120, 0.35);\n  padding: 1px 0;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  border-radius: 1px;\n}\n\n.comment-anchor-mark:hover {\n  background: rgba(232, 197, 115, 0.08);\n  border-bottom: 1.5px solid rgba(232, 197, 115, 0.45);\n}\n\n/* Hover from panel card — warm amber tint */\n.comment-anchor-mark.hover-highlight {\n  background: rgba(232, 197, 115, 0.12);\n  border-bottom: 2px solid rgba(232, 197, 115, 0.5);\n}\n\n/* Click from answer text or panel card — warm gold pulse */\n.comment-anchor-mark.active-highlight {\n  background: rgba(232, 197, 115, 0.22);\n  border-bottom: 2px solid rgba(232, 197, 115, 0.7);\n  animation: anchor-pulse 2s ease-out;\n}\n\n@keyframes anchor-pulse {\n  0% { background: rgba(232, 197, 115, 0.35); }\n  100% { background: rgba(232, 197, 115, 0.22); }\n}\n\n\n/* ── Collapsed Vertical Tab ───────────────────────────── */\n\n.ap-collapsed-tab {\n  position: sticky;\n  top: 8px;\n  width: 26px;\n  flex-shrink: 0;\n  align-self: flex-start;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  background: linear-gradient(180deg, rgba(35, 30, 26, 0.7) 0%, rgba(35, 30, 26, 0.5) 100%);\n  border: 1px solid rgba(194, 99, 90, 0.12);\n  border-left: none;\n  border-radius: 0 6px 6px 0;\n  cursor: pointer;\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n  padding: 14px 0;\n  margin-left: 4px;\n}\n\n.ap-collapsed-tab:hover {\n  background: linear-gradient(180deg, rgba(35, 30, 26, 0.95) 0%, rgba(35, 30, 26, 0.8) 100%);\n  border-color: rgba(194, 99, 90, 0.3);\n  box-shadow: 2px 2px 12px rgba(0, 0, 0, 0.2);\n}\n\n.ap-collapsed-label {\n  writing-mode: vertical-rl;\n  text-orientation: mixed;\n  font-size: 0.58rem;\n  font-weight: 700;\n  color: #9c9488;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  font-family: 'Inter', -apple-system, sans-serif;\n  transition: color 0.2s;\n}\n\n.ap-collapsed-tab:hover .ap-collapsed-label {\n  color: #daa89f;\n}\n\n.ap-collapsed-badge {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  border-radius: 8px;\n  background: rgba(194, 99, 90, 0.2);\n  color: #d4857e;\n  font-size: 0.56rem;\n  font-weight: 700;\n  font-family: 'Inter', -apple-system, sans-serif;\n  transition: all 0.2s;\n}\n\n.ap-collapsed-tab:hover .ap-collapsed-badge {\n  background: rgba(194, 99, 90, 0.3);\n}\n\n\n/* ── Inline Annotations Panel ────────────────────────── */\n\n.ap-inline-panel {\n  position: sticky;\n  top: 8px;\n  align-self: flex-start;\n  width: 280px;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  background: linear-gradient(180deg, rgba(20, 18, 16, 0.92) 0%, rgba(20, 18, 16, 0.88) 100%);\n  border-left: 1px solid rgba(194, 99, 90, 0.12);\n  border-radius: 0 8px 8px 0;\n  max-height: 80vh;\n  margin-left: 6px;\n  box-shadow:\n    -1px 0 0 rgba(194, 99, 90, 0.06),\n    4px 4px 20px rgba(0, 0, 0, 0.15);\n  animation: ap-expand-in 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n}\n\n@keyframes ap-expand-in {\n  from { opacity: 0; transform: translateX(12px); width: 0; }\n  to { opacity: 1; transform: translateX(0); width: 280px; }\n}\n\n/* Header */\n.ap-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 9px 12px;\n  border-bottom: 1px solid rgba(90, 78, 65, 0.3);\n  flex-shrink: 0;\n}\n\n.ap-title {\n  margin: 0;\n  font-size: 0.78rem;\n  font-weight: 600;\n  color: #ebe2d6;\n  font-family: 'Inter', -apple-system, sans-serif;\n  letter-spacing: 0.01em;\n}\n\n.ap-close {\n  margin-left: auto;\n  background: none;\n  border: none;\n  color: #847c72;\n  font-size: 1.1rem;\n  cursor: pointer;\n  padding: 2px 5px;\n  line-height: 1;\n  border-radius: 4px;\n  transition: all 0.15s;\n}\n\n.ap-close:hover {\n  color: #f5efe6;\n  background: rgba(100, 88, 75, 0.3);\n}\n\n/* Filter Tabs */\n.ap-tabs {\n  display: flex;\n  gap: 0;\n  border-bottom: 1px solid rgba(90, 78, 65, 0.25);\n  flex-shrink: 0;\n  padding: 0 4px;\n}\n\n.ap-tab {\n  flex: 1 1;\n  background: none;\n  border: none;\n  border-bottom: 2px solid transparent;\n  color: #847c72;\n  font-size: 0.64rem;\n  font-weight: 600;\n  padding: 6px 0;\n  cursor: pointer;\n  transition: all 0.2s;\n  font-family: 'Inter', -apple-system, sans-serif;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.ap-tab:hover {\n  color: #cec4b8;\n}\n\n.ap-tab-active {\n  color: #daa89f;\n  border-bottom-color: #c2635a;\n}\n\n/* Body */\n.ap-body {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 6px 8px;\n  scrollbar-gutter: stable;\n}\n\n.ap-body::-webkit-scrollbar { width: 3px; }\n.ap-body::-webkit-scrollbar-track { background: transparent; }\n.ap-body::-webkit-scrollbar-thumb {\n  background: rgba(194, 99, 90, 0.12);\n  border-radius: 3px;\n}\n.ap-body::-webkit-scrollbar-thumb:hover {\n  background: rgba(194, 99, 90, 0.25);\n}\n\n.ap-empty {\n  text-align: center;\n  color: #847c72;\n  padding: 20px 10px;\n  font-size: 0.76rem;\n  line-height: 1.6;\n}\n\n.ap-empty-hint {\n  font-size: 0.68rem;\n  color: #7a7268;\n}\n\n\n/* ── Annotation Card ──────────────────────────────────── */\n\n.ap-card {\n  padding: 8px 10px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  background: transparent;\n  margin-bottom: 2px;\n  border-bottom: 1px solid rgba(90, 78, 65, 0.15);\n}\n\n.ap-card:last-child {\n  border-bottom: none;\n}\n\n.ap-card:hover {\n  background: rgba(35, 30, 26, 0.45);\n  border-bottom-color: transparent;\n}\n\n.ap-card-active {\n  background: rgba(232, 197, 115, 0.05);\n  border-bottom-color: transparent;\n}\n\n/* Quote — warm tinted block with left border */\n.ap-card-quote {\n  font-size: 0.72rem;\n  color: #c4bab0;\n  line-height: 1.45;\n  margin-bottom: 5px;\n  padding: 5px 8px;\n  background: rgba(180, 160, 120, 0.04);\n  border-left: 2px solid rgba(180, 160, 120, 0.3);\n  border-radius: 0 4px 4px 0;\n  font-family: 'Source Serif 4', Georgia, serif;\n  font-style: italic;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  transition: border-color 0.2s;\n}\n\n.ap-card:hover .ap-card-quote {\n  border-left-color: rgba(232, 197, 115, 0.5);\n}\n\n.ap-card-active .ap-card-quote {\n  border-left-color: rgba(232, 197, 115, 0.6);\n  background: rgba(232, 197, 115, 0.06);\n}\n\n/* Comment body */\n.ap-card-body {\n  font-size: 0.78rem;\n  color: #e6ddd2;\n  line-height: 1.5;\n  margin-bottom: 5px;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n/* Edit */\n.ap-card-edit {\n  margin-bottom: 5px;\n}\n\n.ap-edit-textarea {\n  width: 100%;\n  background: rgba(18, 16, 14, 0.5);\n  border: 1px solid rgba(194, 99, 90, 0.25);\n  border-radius: 5px;\n  color: #f5efe6;\n  font-size: 0.78rem;\n  padding: 5px 7px;\n  resize: none;\n  font-family: 'Inter', -apple-system, sans-serif;\n  line-height: 1.5;\n  box-sizing: border-box;\n  transition: border-color 0.15s;\n}\n\n.ap-edit-textarea:focus {\n  outline: none;\n  border-color: rgba(194, 99, 90, 0.5);\n  box-shadow: 0 0 0 2px rgba(194, 99, 90, 0.08);\n}\n\n.ap-edit-actions {\n  display: flex;\n  gap: 5px;\n  margin-top: 4px;\n}\n\n/* Footer */\n.ap-card-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.ap-card-time {\n  font-size: 0.62rem;\n  color: #7a7268;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.ap-card-actions {\n  display: flex;\n  gap: 10px;\n  opacity: 0;\n  transition: opacity 0.2s;\n}\n\n.ap-card:hover .ap-card-actions {\n  opacity: 1;\n}\n\n/* Text link actions */\n.ap-action-link {\n  background: none;\n  border: none;\n  color: #9c9488;\n  font-size: 0.64rem;\n  font-weight: 500;\n  cursor: pointer;\n  padding: 0;\n  font-family: 'Inter', -apple-system, sans-serif;\n  transition: color 0.15s;\n  letter-spacing: 0.01em;\n}\n\n.ap-action-link:hover {\n  color: #daa89f;\n}\n\n.ap-action-delete:hover {\n  color: #f87171;\n}\n\n/* Buttons (for edit mode) */\n.ap-btn {\n  padding: 3px 8px;\n  border: none;\n  border-radius: 4px;\n  background: transparent;\n  color: #cec4b8;\n  font-size: 0.72rem;\n  cursor: pointer;\n  transition: all 0.15s;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.ap-btn:hover { background: rgba(100, 88, 75, 0.35); }\n\n.ap-btn-primary {\n  background: #c2635a;\n  color: #fff;\n  font-weight: 500;\n}\n.ap-btn-primary:hover { background: #d4857e; }\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/ResearchComments.css\"],\"names\":[],\"mappings\":\"AAAA,6DAA6D;;AAE7D;EACE,kBAAkB;EAClB,YAAY;EACZ,YAAY;EACZ,6DAA6D;EAC7D,yCAAyC;EACzC,mBAAmB;EACnB,aAAa;EACb;;6CAE2C;EAC3C,uCAAuC;AACzC;;AAEA;EACE,OAAO,UAAU,EAAE,0BAA0B,EAAE;EAC/C,KAAK,UAAU,EAAE,wBAAwB,EAAE;AAC7C;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,kBAAkB;EAClB,gBAAgB;EAChB,6CAA6C;EAC7C,iBAAiB;EACjB,6CAA6C;AAC/C;;AAEA;EACE,WAAW;EACX,iCAAiC;EACjC,wCAAwC;EACxC,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,iBAAiB;EACjB,YAAY;EACZ,+CAA+C;EAC/C,gBAAgB;EAChB,sBAAsB;AACxB;;AAEA;EACE,aAAa;EACb,oCAAoC;EACpC,4CAA4C;AAC9C;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,eAAe;AACjB;;AAEA;EACE,iBAAiB;EACjB,YAAY;EACZ,kBAAkB;EAClB,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,qBAAqB;EACrB,+CAA+C;AACjD;;AAEA,gBAAgB,mBAAmB,EAAE,WAAW,EAAE;AAClD,sBAAsB,mBAAmB,EAAE;AAC3C,yBAAyB,YAAY,EAAE,eAAe,EAAE;AACxD,kBAAkB,iCAAiC,EAAE,cAAc,EAAE;AACrE,wBAAwB,kCAAkC,EAAE;AAC5D,YAAY,kBAAkB,EAAE,cAAc,EAAE,iBAAiB,EAAE;;;AAGnE,4DAA4D;;AAE5D;EACE,WAAW;EACX,kCAAkC;EAClC,iBAAiB;AACnB;;AAEA;EACE,aAAa;EACb,QAAQ;AACV;;AAEA;EACE,SAAO;EACP,iBAAiB;EACjB,6BAA6B;EAC7B,kBAAkB;EAClB,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,qBAAqB;EACrB,+CAA+C;EAC/C,uBAAuB;AACzB;;AAEA;EACE,cAAc;EACd,qCAAqC;AACvC;AACA;EACE,kCAAkC;EAClC,qCAAqC;AACvC;;AAEA;EACE,cAAc;EACd,sCAAsC;AACxC;AACA;EACE,mCAAmC;EACnC,sCAAsC;AACxC;;AAEA;EACE,YAAY;EACZ,eAAe;AACjB;;AAEA;EACE,kBAAkB;EAClB,kBAAkB;EAClB,gBAAgB;EAChB,kBAAkB;EAClB,+CAA+C;EAC/C,uCAAuC;AACzC;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;;AAGA,4DAA4D;;AAE5D,0EAA0E;AAC1E;EACE,uBAAuB;EACvB,cAAc;EACd,qDAAqD;EACrD,cAAc;EACd,eAAe;EACf,yBAAyB;EACzB,kBAAkB;AACpB;;AAEA;EACE,qCAAqC;EACrC,oDAAoD;AACtD;;AAEA,4CAA4C;AAC5C;EACE,qCAAqC;EACrC,iDAAiD;AACnD;;AAEA,2DAA2D;AAC3D;EACE,qCAAqC;EACrC,iDAAiD;EACjD,mCAAmC;AACrC;;AAEA;EACE,KAAK,qCAAqC,EAAE;EAC5C,OAAO,qCAAqC,EAAE;AAChD;;;AAGA,4DAA4D;;AAE5D;EACE,gBAAgB;EAChB,QAAQ;EACR,WAAW;EACX,cAAc;EACd,sBAAsB;EACtB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,uBAAuB;EACvB,QAAQ;EACR,yFAAyF;EACzF,yCAAyC;EACzC,iBAAiB;EACjB,0BAA0B;EAC1B,eAAe;EACf,kDAAkD;EAClD,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,0FAA0F;EAC1F,oCAAoC;EACpC,2CAA2C;AAC7C;;AAEA;EACE,yBAAyB;EACzB,uBAAuB;EACvB,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,sBAAsB;EACtB,yBAAyB;EACzB,+CAA+C;EAC/C,sBAAsB;AACxB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,WAAW;EACX,YAAY;EACZ,kBAAkB;EAClB,kCAAkC;EAClC,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,+CAA+C;EAC/C,oBAAoB;AACtB;;AAEA;EACE,kCAAkC;AACpC;;;AAGA,2DAA2D;;AAE3D;EACE,gBAAgB;EAChB,QAAQ;EACR,sBAAsB;EACtB,YAAY;EACZ,cAAc;EACd,aAAa;EACb,sBAAsB;EACtB,2FAA2F;EAC3F,8CAA8C;EAC9C,0BAA0B;EAC1B,gBAAgB;EAChB,gBAAgB;EAChB;;oCAEkC;EAClC,0DAA0D;EAC1D,2BAA2B;EAC3B,mCAAmC;AACrC;;AAEA;EACE,OAAO,UAAU,EAAE,2BAA2B,EAAE,QAAQ,EAAE;EAC1D,KAAK,UAAU,EAAE,wBAAwB,EAAE,YAAY,EAAE;AAC3D;;AAEA,WAAW;AACX;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,8CAA8C;EAC9C,cAAc;AAChB;;AAEA;EACE,SAAS;EACT,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,+CAA+C;EAC/C,sBAAsB;AACxB;;AAEA;EACE,iBAAiB;EACjB,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,iBAAiB;EACjB,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,qBAAqB;AACvB;;AAEA;EACE,cAAc;EACd,kCAAkC;AACpC;;AAEA,gBAAgB;AAChB;EACE,aAAa;EACb,MAAM;EACN,+CAA+C;EAC/C,cAAc;EACd,cAAc;AAChB;;AAEA;EACE,SAAO;EACP,gBAAgB;EAChB,YAAY;EACZ,oCAAoC;EACpC,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,eAAe;EACf,oBAAoB;EACpB,+CAA+C;EAC/C,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;EACd,4BAA4B;AAC9B;;AAEA,SAAS;AACT;EACE,SAAO;EACP,gBAAgB;EAChB,gBAAgB;EAChB,wBAAwB;AAC1B;;AAEA,8BAA8B,UAAU,EAAE;AAC1C,oCAAoC,uBAAuB,EAAE;AAC7D;EACE,mCAAmC;EACnC,kBAAkB;AACpB;AACA;EACE,mCAAmC;AACrC;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,kBAAkB;EAClB,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,cAAc;AAChB;;;AAGA,4DAA4D;;AAE5D;EACE,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,iDAAiD;EACjD,uBAAuB;EACvB,kBAAkB;EAClB,+CAA+C;AACjD;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,kCAAkC;EAClC,gCAAgC;AAClC;;AAEA;EACE,qCAAqC;EACrC,gCAAgC;AAClC;;AAEA,+CAA+C;AAC/C;EACE,kBAAkB;EAClB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,gBAAgB;EAChB,qCAAqC;EACrC,+CAA+C;EAC/C,0BAA0B;EAC1B,6CAA6C;EAC7C,kBAAkB;EAClB,oBAAoB;EACpB,qBAAqB;EACrB,4BAA4B;EAC5B,gBAAgB;EAChB,6BAA6B;AAC/B;;AAEA;EACE,2CAA2C;AAC7C;;AAEA;EACE,2CAA2C;EAC3C,qCAAqC;AACvC;;AAEA,iBAAiB;AACjB;EACE,kBAAkB;EAClB,cAAc;EACd,gBAAgB;EAChB,kBAAkB;EAClB,+CAA+C;AACjD;;AAEA,SAAS;AACT;EACE,kBAAkB;AACpB;;AAEA;EACE,WAAW;EACX,iCAAiC;EACjC,yCAAyC;EACzC,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,YAAY;EACZ,+CAA+C;EAC/C,gBAAgB;EAChB,sBAAsB;EACtB,8BAA8B;AAChC;;AAEA;EACE,aAAa;EACb,oCAAoC;EACpC,6CAA6C;AAC/C;;AAEA;EACE,aAAa;EACb,QAAQ;EACR,eAAe;AACjB;;AAEA,WAAW;AACX;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;AAChC;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,+CAA+C;AACjD;;AAEA;EACE,aAAa;EACb,SAAS;EACT,UAAU;EACV,wBAAwB;AAC1B;;AAEA;EACE,UAAU;AACZ;;AAEA,sBAAsB;AACtB;EACE,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,UAAU;EACV,+CAA+C;EAC/C,uBAAuB;EACvB,sBAAsB;AACxB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA,4BAA4B;AAC5B;EACE,gBAAgB;EAChB,YAAY;EACZ,kBAAkB;EAClB,uBAAuB;EACvB,cAAc;EACd,kBAAkB;EAClB,eAAe;EACf,qBAAqB;EACrB,+CAA+C;AACjD;;AAEA,gBAAgB,mCAAmC,EAAE;;AAErD;EACE,mBAAmB;EACnB,WAAW;EACX,gBAAgB;AAClB;AACA,wBAAwB,mBAAmB,EAAE\",\"sourcesContent\":[\"/* ── Comment Popup (on text selection) ─────────────────── */\\n\\n.research-comment-popup {\\n  position: absolute;\\n  z-index: 100;\\n  width: 300px;\\n  background: linear-gradient(135deg, #1e1b18 0%, #1a1714 100%);\\n  border: 1px solid rgba(194, 99, 90, 0.25);\\n  border-radius: 10px;\\n  padding: 12px;\\n  box-shadow:\\n    0 8px 24px rgba(0, 0, 0, 0.4),\\n    0 0 0 1px rgba(255, 255, 255, 0.04) inset;\\n  animation: popup-fade-in 0.15s ease-out;\\n}\\n\\n@keyframes popup-fade-in {\\n  from { opacity: 0; transform: translateY(4px); }\\n  to { opacity: 1; transform: translateY(0); }\\n}\\n\\n.rcp-quote {\\n  font-size: 0.76rem;\\n  color: #cec4b8;\\n  font-style: italic;\\n  margin-bottom: 8px;\\n  line-height: 1.4;\\n  border-left: 2px solid rgba(194, 99, 90, 0.4);\\n  padding-left: 8px;\\n  font-family: 'Source Serif 4', Georgia, serif;\\n}\\n\\n.rcp-textarea {\\n  width: 100%;\\n  background: rgba(18, 16, 14, 0.6);\\n  border: 1px solid rgba(100, 88, 75, 0.4);\\n  border-radius: 6px;\\n  color: #f5efe6;\\n  font-size: 0.82rem;\\n  padding: 8px 10px;\\n  resize: none;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  line-height: 1.5;\\n  box-sizing: border-box;\\n}\\n\\n.rcp-textarea:focus {\\n  outline: none;\\n  border-color: rgba(194, 99, 90, 0.5);\\n  box-shadow: 0 0 0 2px rgba(194, 99, 90, 0.1);\\n}\\n\\n.rcp-actions {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  margin-top: 8px;\\n}\\n\\n.rcp-btn {\\n  padding: 5px 14px;\\n  border: none;\\n  border-radius: 6px;\\n  font-size: 0.78rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.15s;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n}\\n\\n.rcp-btn-save { background: #c2635a; color: #fff; }\\n.rcp-btn-save:hover { background: #d4857e; }\\n.rcp-btn-save:disabled { opacity: 0.4; cursor: default; }\\n.rcp-btn-cancel { background: rgba(90, 78, 65, 0.5); color: #cec4b8; }\\n.rcp-btn-cancel:hover { background: rgba(100, 88, 75, 0.5); }\\n.rcp-hint { font-size: 0.68rem; color: #8e867c; margin-left: auto; }\\n\\n\\n/* ── Destination Buttons (Arsenal / Research) ─────────── */\\n\\n.rcp-divider {\\n  height: 1px;\\n  background: rgba(100, 88, 75, 0.3);\\n  margin: 8px 0 6px;\\n}\\n\\n.rcp-destinations {\\n  display: flex;\\n  gap: 6px;\\n}\\n\\n.rcp-dest-btn {\\n  flex: 1;\\n  padding: 5px 10px;\\n  border: 1px solid transparent;\\n  border-radius: 6px;\\n  font-size: 0.74rem;\\n  font-weight: 600;\\n  cursor: pointer;\\n  transition: all 0.15s;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  background: transparent;\\n}\\n\\n.rcp-dest-arsenal {\\n  color: #d97706;\\n  border-color: rgba(217, 119, 6, 0.25);\\n}\\n.rcp-dest-arsenal:hover:not(:disabled) {\\n  background: rgba(217, 119, 6, 0.1);\\n  border-color: rgba(217, 119, 6, 0.45);\\n}\\n\\n.rcp-dest-research {\\n  color: #818cf8;\\n  border-color: rgba(99, 102, 241, 0.25);\\n}\\n.rcp-dest-research:hover:not(:disabled) {\\n  background: rgba(99, 102, 241, 0.1);\\n  border-color: rgba(99, 102, 241, 0.45);\\n}\\n\\n.rcp-dest-btn:disabled {\\n  opacity: 0.5;\\n  cursor: default;\\n}\\n\\n.rcp-dest-feedback {\\n  text-align: center;\\n  font-size: 0.76rem;\\n  font-weight: 500;\\n  padding: 5px 0 2px;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  animation: popup-fade-in 0.15s ease-out;\\n}\\n\\n.rcp-dest-feedback-success {\\n  color: #4ade80;\\n}\\n\\n.rcp-dest-feedback-error {\\n  color: #f87171;\\n}\\n\\n\\n/* ── Comment Anchor Marks (in answer text) ────────────── */\\n\\n/* Default: warm subtle dotted underline to show which text has comments */\\n.comment-anchor-mark {\\n  background: transparent;\\n  color: inherit;\\n  border-bottom: 1.5px dotted rgba(180, 160, 120, 0.35);\\n  padding: 1px 0;\\n  cursor: pointer;\\n  transition: all 0.3s ease;\\n  border-radius: 1px;\\n}\\n\\n.comment-anchor-mark:hover {\\n  background: rgba(232, 197, 115, 0.08);\\n  border-bottom: 1.5px solid rgba(232, 197, 115, 0.45);\\n}\\n\\n/* Hover from panel card — warm amber tint */\\n.comment-anchor-mark.hover-highlight {\\n  background: rgba(232, 197, 115, 0.12);\\n  border-bottom: 2px solid rgba(232, 197, 115, 0.5);\\n}\\n\\n/* Click from answer text or panel card — warm gold pulse */\\n.comment-anchor-mark.active-highlight {\\n  background: rgba(232, 197, 115, 0.22);\\n  border-bottom: 2px solid rgba(232, 197, 115, 0.7);\\n  animation: anchor-pulse 2s ease-out;\\n}\\n\\n@keyframes anchor-pulse {\\n  0% { background: rgba(232, 197, 115, 0.35); }\\n  100% { background: rgba(232, 197, 115, 0.22); }\\n}\\n\\n\\n/* ── Collapsed Vertical Tab ───────────────────────────── */\\n\\n.ap-collapsed-tab {\\n  position: sticky;\\n  top: 8px;\\n  width: 26px;\\n  flex-shrink: 0;\\n  align-self: flex-start;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 8px;\\n  background: linear-gradient(180deg, rgba(35, 30, 26, 0.7) 0%, rgba(35, 30, 26, 0.5) 100%);\\n  border: 1px solid rgba(194, 99, 90, 0.12);\\n  border-left: none;\\n  border-radius: 0 6px 6px 0;\\n  cursor: pointer;\\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\\n  padding: 14px 0;\\n  margin-left: 4px;\\n}\\n\\n.ap-collapsed-tab:hover {\\n  background: linear-gradient(180deg, rgba(35, 30, 26, 0.95) 0%, rgba(35, 30, 26, 0.8) 100%);\\n  border-color: rgba(194, 99, 90, 0.3);\\n  box-shadow: 2px 2px 12px rgba(0, 0, 0, 0.2);\\n}\\n\\n.ap-collapsed-label {\\n  writing-mode: vertical-rl;\\n  text-orientation: mixed;\\n  font-size: 0.58rem;\\n  font-weight: 700;\\n  color: #9c9488;\\n  letter-spacing: 0.14em;\\n  text-transform: uppercase;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  transition: color 0.2s;\\n}\\n\\n.ap-collapsed-tab:hover .ap-collapsed-label {\\n  color: #daa89f;\\n}\\n\\n.ap-collapsed-badge {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  width: 16px;\\n  height: 16px;\\n  border-radius: 8px;\\n  background: rgba(194, 99, 90, 0.2);\\n  color: #d4857e;\\n  font-size: 0.56rem;\\n  font-weight: 700;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  transition: all 0.2s;\\n}\\n\\n.ap-collapsed-tab:hover .ap-collapsed-badge {\\n  background: rgba(194, 99, 90, 0.3);\\n}\\n\\n\\n/* ── Inline Annotations Panel ────────────────────────── */\\n\\n.ap-inline-panel {\\n  position: sticky;\\n  top: 8px;\\n  align-self: flex-start;\\n  width: 280px;\\n  flex-shrink: 0;\\n  display: flex;\\n  flex-direction: column;\\n  background: linear-gradient(180deg, rgba(20, 18, 16, 0.92) 0%, rgba(20, 18, 16, 0.88) 100%);\\n  border-left: 1px solid rgba(194, 99, 90, 0.12);\\n  border-radius: 0 8px 8px 0;\\n  max-height: 80vh;\\n  margin-left: 6px;\\n  box-shadow:\\n    -1px 0 0 rgba(194, 99, 90, 0.06),\\n    4px 4px 20px rgba(0, 0, 0, 0.15);\\n  animation: ap-expand-in 0.25s cubic-bezier(0.4, 0, 0.2, 1);\\n  backdrop-filter: blur(12px);\\n  -webkit-backdrop-filter: blur(12px);\\n}\\n\\n@keyframes ap-expand-in {\\n  from { opacity: 0; transform: translateX(12px); width: 0; }\\n  to { opacity: 1; transform: translateX(0); width: 280px; }\\n}\\n\\n/* Header */\\n.ap-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 9px 12px;\\n  border-bottom: 1px solid rgba(90, 78, 65, 0.3);\\n  flex-shrink: 0;\\n}\\n\\n.ap-title {\\n  margin: 0;\\n  font-size: 0.78rem;\\n  font-weight: 600;\\n  color: #ebe2d6;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  letter-spacing: 0.01em;\\n}\\n\\n.ap-close {\\n  margin-left: auto;\\n  background: none;\\n  border: none;\\n  color: #847c72;\\n  font-size: 1.1rem;\\n  cursor: pointer;\\n  padding: 2px 5px;\\n  line-height: 1;\\n  border-radius: 4px;\\n  transition: all 0.15s;\\n}\\n\\n.ap-close:hover {\\n  color: #f5efe6;\\n  background: rgba(100, 88, 75, 0.3);\\n}\\n\\n/* Filter Tabs */\\n.ap-tabs {\\n  display: flex;\\n  gap: 0;\\n  border-bottom: 1px solid rgba(90, 78, 65, 0.25);\\n  flex-shrink: 0;\\n  padding: 0 4px;\\n}\\n\\n.ap-tab {\\n  flex: 1;\\n  background: none;\\n  border: none;\\n  border-bottom: 2px solid transparent;\\n  color: #847c72;\\n  font-size: 0.64rem;\\n  font-weight: 600;\\n  padding: 6px 0;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  text-transform: uppercase;\\n  letter-spacing: 0.06em;\\n}\\n\\n.ap-tab:hover {\\n  color: #cec4b8;\\n}\\n\\n.ap-tab-active {\\n  color: #daa89f;\\n  border-bottom-color: #c2635a;\\n}\\n\\n/* Body */\\n.ap-body {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 6px 8px;\\n  scrollbar-gutter: stable;\\n}\\n\\n.ap-body::-webkit-scrollbar { width: 3px; }\\n.ap-body::-webkit-scrollbar-track { background: transparent; }\\n.ap-body::-webkit-scrollbar-thumb {\\n  background: rgba(194, 99, 90, 0.12);\\n  border-radius: 3px;\\n}\\n.ap-body::-webkit-scrollbar-thumb:hover {\\n  background: rgba(194, 99, 90, 0.25);\\n}\\n\\n.ap-empty {\\n  text-align: center;\\n  color: #847c72;\\n  padding: 20px 10px;\\n  font-size: 0.76rem;\\n  line-height: 1.6;\\n}\\n\\n.ap-empty-hint {\\n  font-size: 0.68rem;\\n  color: #7a7268;\\n}\\n\\n\\n/* ── Annotation Card ──────────────────────────────────── */\\n\\n.ap-card {\\n  padding: 8px 10px;\\n  border-radius: 6px;\\n  cursor: pointer;\\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\\n  background: transparent;\\n  margin-bottom: 2px;\\n  border-bottom: 1px solid rgba(90, 78, 65, 0.15);\\n}\\n\\n.ap-card:last-child {\\n  border-bottom: none;\\n}\\n\\n.ap-card:hover {\\n  background: rgba(35, 30, 26, 0.45);\\n  border-bottom-color: transparent;\\n}\\n\\n.ap-card-active {\\n  background: rgba(232, 197, 115, 0.05);\\n  border-bottom-color: transparent;\\n}\\n\\n/* Quote — warm tinted block with left border */\\n.ap-card-quote {\\n  font-size: 0.72rem;\\n  color: #c4bab0;\\n  line-height: 1.45;\\n  margin-bottom: 5px;\\n  padding: 5px 8px;\\n  background: rgba(180, 160, 120, 0.04);\\n  border-left: 2px solid rgba(180, 160, 120, 0.3);\\n  border-radius: 0 4px 4px 0;\\n  font-family: 'Source Serif 4', Georgia, serif;\\n  font-style: italic;\\n  display: -webkit-box;\\n  -webkit-line-clamp: 3;\\n  -webkit-box-orient: vertical;\\n  overflow: hidden;\\n  transition: border-color 0.2s;\\n}\\n\\n.ap-card:hover .ap-card-quote {\\n  border-left-color: rgba(232, 197, 115, 0.5);\\n}\\n\\n.ap-card-active .ap-card-quote {\\n  border-left-color: rgba(232, 197, 115, 0.6);\\n  background: rgba(232, 197, 115, 0.06);\\n}\\n\\n/* Comment body */\\n.ap-card-body {\\n  font-size: 0.78rem;\\n  color: #e6ddd2;\\n  line-height: 1.5;\\n  margin-bottom: 5px;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n}\\n\\n/* Edit */\\n.ap-card-edit {\\n  margin-bottom: 5px;\\n}\\n\\n.ap-edit-textarea {\\n  width: 100%;\\n  background: rgba(18, 16, 14, 0.5);\\n  border: 1px solid rgba(194, 99, 90, 0.25);\\n  border-radius: 5px;\\n  color: #f5efe6;\\n  font-size: 0.78rem;\\n  padding: 5px 7px;\\n  resize: none;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  line-height: 1.5;\\n  box-sizing: border-box;\\n  transition: border-color 0.15s;\\n}\\n\\n.ap-edit-textarea:focus {\\n  outline: none;\\n  border-color: rgba(194, 99, 90, 0.5);\\n  box-shadow: 0 0 0 2px rgba(194, 99, 90, 0.08);\\n}\\n\\n.ap-edit-actions {\\n  display: flex;\\n  gap: 5px;\\n  margin-top: 4px;\\n}\\n\\n/* Footer */\\n.ap-card-footer {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n}\\n\\n.ap-card-time {\\n  font-size: 0.62rem;\\n  color: #7a7268;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n}\\n\\n.ap-card-actions {\\n  display: flex;\\n  gap: 10px;\\n  opacity: 0;\\n  transition: opacity 0.2s;\\n}\\n\\n.ap-card:hover .ap-card-actions {\\n  opacity: 1;\\n}\\n\\n/* Text link actions */\\n.ap-action-link {\\n  background: none;\\n  border: none;\\n  color: #9c9488;\\n  font-size: 0.64rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  padding: 0;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  transition: color 0.15s;\\n  letter-spacing: 0.01em;\\n}\\n\\n.ap-action-link:hover {\\n  color: #daa89f;\\n}\\n\\n.ap-action-delete:hover {\\n  color: #f87171;\\n}\\n\\n/* Buttons (for edit mode) */\\n.ap-btn {\\n  padding: 3px 8px;\\n  border: none;\\n  border-radius: 4px;\\n  background: transparent;\\n  color: #cec4b8;\\n  font-size: 0.72rem;\\n  cursor: pointer;\\n  transition: all 0.15s;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n}\\n\\n.ap-btn:hover { background: rgba(100, 88, 75, 0.35); }\\n\\n.ap-btn-primary {\\n  background: #c2635a;\\n  color: #fff;\\n  font-weight: 500;\\n}\\n.ap-btn-primary:hover { background: #d4857e; }\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/ResearchFlagDialog.css\"\n/*!******************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/ResearchFlagDialog.css ***!\n  \\******************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* 