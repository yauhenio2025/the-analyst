;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  background: #f5f3f0;\n  border-radius: 6px;\n  flex-shrink: 0;\n}\n\n.diff-icon {\n  font-size: 16px;\n  font-weight: 700;\n  font-family: monospace;\n}\n\n.diff-icon.added {\n  color: #22c55e;\n}\n\n.diff-icon.removed {\n  color: #ef4444;\n}\n\n.diff-icon.modified {\n  color: #eab308;\n}\n\n.diff-icon.unchanged {\n  color: #666;\n}\n\n/* Diff Info */\n.diff-info {\n  flex: 1 1;\n  min-width: 0;\n}\n\n.diff-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.section-name {\n  font-size: 14px;\n  font-weight: 600;\n  color: #4a4a4a;\n  text-transform: capitalize;\n}\n\n.diff-badge {\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.diff-badge.added {\n  background: rgba(34, 197, 94, 0.2);\n  color: #22c55e;\n}\n\n.diff-badge.removed {\n  background: rgba(239, 68, 68, 0.2);\n  color: #ef4444;\n}\n\n.diff-badge.modified {\n  background: rgba(234, 179, 8, 0.2);\n  color: #eab308;\n}\n\n.diff-badge.unchanged {\n  background: rgba(102, 102, 102, 0.2);\n  color: #757575;\n}\n\n.change-summary {\n  font-size: 12px;\n  color: #757575;\n  margin-top: 4px;\n}\n\n.contributing-dives {\n  color: #b5343a;\n}\n\n/* Expand Toggle */\n.expand-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  flex-shrink: 0;\n}\n\n.expand-toggle .arrow {\n  font-size: 10px;\n  color: #757575;\n  transition: transform 0.2s ease;\n}\n\n.expand-toggle .arrow.expanded {\n  transform: rotate(90deg);\n}\n\n/* Diff Content */\n.diff-content {\n  border-top: 1px solid #e0ddd8;\n  background: #faf8f5;\n}\n\n/* Comparison View (side by side) */\n.comparison-view {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n}\n\n.before-panel,\n.after-panel {\n  overflow: hidden;\n}\n\n.before-panel {\n  border-right: 1px solid #e0ddd8;\n}\n\n.panel-header {\n  padding: 8px 12px;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: #757575;\n  background: #faf8f5;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.before-panel .panel-header {\n  color: #ef4444;\n}\n\n.after-panel .panel-header {\n  color: #22c55e;\n}\n\n.panel-content {\n  padding: 12px;\n  overflow-x: auto;\n}\n\n.panel-content pre {\n  margin: 0;\n  font-size: 12px;\n  font-family: 'Fira Code', 'Monaco', 'Menlo', monospace;\n  color: #757575;\n  white-space: pre-wrap;\n  word-break: break-word;\n  line-height: 1.5;\n}\n\n/* Single View (added or removed) */\n.single-view {\n  overflow: hidden;\n}\n\n.single-view.added .panel-header {\n  color: #22c55e;\n  background: rgba(34, 197, 94, 0.1);\n}\n\n.single-view.removed .panel-header {\n  color: #ef4444;\n  background: rgba(239, 68, 68, 0.1);\n}\n\n.single-view .panel-content {\n  padding: 12px;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .comparison-view {\n    grid-template-columns: 1fr;\n  }\n\n  .before-panel {\n    border-right: none;\n    border-bottom: 1px solid #e0ddd8;\n  }\n\n  .diff-title {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 4px;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/SectionDiffView.css\"],\"names\":[],\"mappings\":\"AAAA,wBAAwB;;AAExB;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,kBAAkB;EAClB,WAAW;EACX,mBAAmB;EACnB,kBAAkB;AACpB;;AAEA,iBAAiB;AACjB;EACE,mBAAmB;EACnB,kBAAkB;EAClB,gBAAgB;EAChB,2BAA2B;AAC7B;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,0BAA0B;EAC1B,YAAY;AACd;;AAEA,gBAAgB;AAChB;EACE,aAAa;EACb,uBAAuB;EACvB,SAAS;EACT,kBAAkB;EAClB,eAAe;EACf,gCAAgC;AAClC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,WAAW;EACX,YAAY;EACZ,mBAAmB;EACnB,kBAAkB;EAClB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,sBAAsB;AACxB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAE