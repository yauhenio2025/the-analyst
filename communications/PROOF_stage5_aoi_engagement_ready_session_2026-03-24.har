AkB;AACpB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA;;iDAEiD;;AAEjD;EACE,gBAAgB;EAChB,6BAA6B;EAC7B,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,eAAe;EACf,cAAc;EACd,yBAAyB;EACzB,qBAAqB;EACrB,yBAAiB;UAAjB,iBAAiB;AACnB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,gBAAgB;EAChB,oBAAoB;EACpB,iBAAiB;EACjB,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,aAAa;EACb,mBAAmB;EACnB,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,eAAe;EACf,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,iBAAiB;EACjB,8BAA8B;EAC9B,oCAAoC;EACpC,0BAA0B;EAC1B,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,qBAAqB;EACrB,sBAAsB;AACxB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,eAAe;EACf,yBAAiB;UAAjB,iBAAiB;AACnB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,YAAY;EACZ,+BAA+B;EAC/B,kBAAkB;EAClB,eAAe;EACf,wCAAwC;EACxC,cAAc;EACd,gBAAgB;EAChB,qBAAqB;EACrB,sBAAsB;EACtB,iBAAiB;EACjB,gBAAgB;AAClB;;AAEA,qDAAqD;AACrD;EACE,oBAAoB;EACpB,mBAAmB;EACnB,QAAQ;EACR,qBAAqB;EACrB,cAAc;EACd,uBAAuB;AACzB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,uBAAuB;AACzB;;AAEA;EACE,cAAc;AAChB;;AAEA,yCAAyC;AACzC;EACE;IACE,0BAA0B;IAC1B,SAAS;EACX;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,YAAY;IACZ,cAAc;IACd,kBAAkB;IAClB,eAAe;IACf,cAAc;IACd,gBAAgB;EAClB;AACF\",\"sourcesContent\":[\"/* ArsenalPage Styles */\\n\\n.arsenal-page {\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  padding: 40px 24px;\\n}\\n\\n.arsenal-loading {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 12px;\\n  padding: 60px;\\n  color: #94a3b8;\\n}\\n\\n/* Header */\\n.arsenal-header {\\n  margin-bottom: 32px;\\n}\\n\\n.arsenal-title {\\n  margin-bottom: 16px;\\n}\\n\\n.arsenal-title h1 {\\n  font-size: 32px;\\n  font-weight: 700;\\n  color: #1a1a1a;\\n  margin: 0 0 8px;\\n}\\n\\n.arsenal-title p {\\n  color: #94a3b8;\\n  font-size: 16px;\\n  margin: 0;\\n}\\n\\n.arsenal-stats {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 12px;\\n  align-items: center;\\n}\\n\\n/* Group Toggle - Ammunition vs Revisions */\\n.arsenal-group-toggle {\\n  display: flex;\\n  gap: 8px;\\n  margin-top: 20px;\\n  padding: 6px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 12px;\\n  width: fit-content;\\n}\\n\\n.group-btn {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 12px 20px;\\n  background: transparent;\\n  border: none;\\n  border-radius: 8px;\\n  color: #757575;\\n  font-size: 14px;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.group-btn:hover:not(:disabled) {\\n  background: #e0ddd8;\\n  color: #1a1a1a;\\n}\\n\\n.group-btn:disabled {\\n  opacity: 0.4;\\n  cursor: not-allowed;\\n}\\n\\n.group-btn.active {\\n  background: #1a1a1a;\\n  color: #ffffff;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\\n}\\n\\n.group-btn.ammunition.active {\\n  background: linear-gradient(135deg, #dc2626, #b91c1c);\\n  color: white;\\n}\\n\\n.group-btn.revisions.active {\\n  background: linear-gradient(135deg, #9a2c31, #15803d);\\n  color: white;\\n}\\n\\n.group-icon {\\n  font-size: 16px;\\n}\\n\\n.stat-total {\\n  font-size: 18px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  padding-right: 12px;\\n  border-right: 1px solid #757575;\\n}\\n\\n.stat-stream {\\n  padding: 4px 10px;\\n  background: rgba(255, 255, 255, 0.05);\\n  border: 1px solid #475569;\\n  border-radius: 6px;\\n  font-size: 13px;\\n  color: #94a3b8;\\n}\\n\\n/* Error */\\n.arsenal-error {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 16px;\\n  padding: 20px;\\n  background: rgba(239, 68, 68, 0.1);\\n  border: 1px solid rgba(239, 68, 68, 0.3);\\n  border-radius: 10px;\\n  color: #ef4444;\\n  margin-bottom: 24px;\\n}\\n\\n.arsenal-error button {\\n  padding: 6px 12px;\\n  background: rgba(239, 68, 68, 0.2);\\n  border: 1px solid rgba(239, 68, 68, 0.4);\\n  border-radius: 6px;\\n  color: #ef4444;\\n  cursor: pointer;\\n}\\n\\n/* Empty State */\\n.arsenal-empty {\\n  text-align: center;\\n  padding: 80px 40px;\\n  background: #faf8f5;\\n  border: 1px dashed #757575;\\n  border-radius: 16px;\\n}\\n\\n.empty-icon {\\n  font-size: 64px;\\n  margin-bottom: 24px;\\n  opacity: 0.5;\\n}\\n\\n.arsenal-empty h2 {\\n  font-size: 24px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  margin: 0 0 12px;\\n}\\n\\n.arsenal-empty p {\\n  color: #94a3b8;\\n  font-size: 16px;\\n  margin: 0;\\n}\\n\\n/* Filters */\\n.arsenal-filters {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 8px;\\n  margin-bottom: 24px;\\n  padding-bottom: 16px;\\n  border-bottom: 1px solid #757575;\\n}\\n\\n.arsenal-page .filter-btn {\\n  padding: 8px 16px;\\n  background: transparent;\\n  border: 1px solid #475569;\\n  border-radius: 8px;\\n  color: #94a3b8;\\n  font-size: 14px;\\n  cursor: pointer;\\n  transition: all 0.15s ease;\\n}\\n\\n.arsenal-page .filter-btn:hover {\\n  border-color: #64748b;\\n  color: #4a4a4a;\\n}\\n\\n.arsenal-page .filter-btn.active {\\n  background: #1a1a1a;\\n  border-color: #1a1a1a;\\n  color: #ffffff;\\n}\\n\\n/* Items List */\\n.arsenal-items {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n\\n.arsenal-item {\\n  background: #faf8f5;\\n  border: 1px solid #757575;\\n  border-left: 4px solid #b5343a;\\n  border-radius: 12px;\\n  padding: 20px;\\n  transition: all 0.2s ease;\\n}\\n\\n.arsenal-item:hover {\\n  border-color: #475569;\\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\\n}\\n\\n.item-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  margin-bottom: 16px;\\n}\\n\\n.stream-badge {\\n  padding: 4px 10px;\\n  border-radius: 6px;\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: white;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.severity-badge {\\n  padding: 4px 8px;\\n  border-radius: 4px;\\n  font-size: 11px;\\n  font-weight: 500;\\n  text-transform: uppercase;\\n}\\n\\n.severity-badge.high {\\n  background: rgba(239, 68, 68, 0.2);\\n  color: #ef4444;\\n}\\n\\n.severity-badge.medium {\\n  background: rgba(251, 191, 36, 0.2);\\n  color: #fbbf24;\\n}\\n\\n.severity-badge.low {\\n  background: rgba(34, 197, 94, 0.2);\\n  color: #22c55e;\\n}\\n\\n.capture-depth-badge-sm {\\n  font-size: 10px;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.04em;\\n  padding: 2px 6px;\\n  border-radius: 3px;\\n  margin-left: 4px;\\n}\\n.capture-depth-badge-sm.depth-L1_section {\\n  background: #312e81;\\n  color: #a5b4fc;\\n}\\n.capture-depth-badge-sm.depth-L2_element {\\n  background: #78350f;\\n  color: #fbbf24;\\n}\\n\\n.item-date {\\n  margin-left: auto;\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n.btn-remove {\\n  width: 28px;\\n  height: 28px;\\n  padding: 0;\\n  background: transparent;\\n  border: 1px solid #475569;\\n  border-radius: 6px;\\n  color: #64748b;\\n  font-size: 18px;\\n  cursor: pointer;\\n  transition: all 0.15s ease;\\n}\\n\\n.btn-remove:hover:not(:disabled) {\\n  background: rgba(239, 68, 68, 0.15);\\n  border-color: #ef4444;\\n  color: #ef4444;\\n}\\n\\n.btn-remove:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n/* Item Content */\\n.item-content {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.finding-field {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.field-label {\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: #64748b;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.field-value {\\n  font-size: 14px;\\n  color: #4a4a4a;\\n  line-height: 1.6;\\n}\\n\\n/* Vulnerability-specific styles */\\n.vulnerability-attack {\\n  background: rgba(239, 68, 68, 0.1);\\n  border-left: 3px solid #ef4444;\\n  padding: 12px;\\n  border-radius: 0 8px 8px 0;\\n  margin: 8px 0;\\n}\\n\\n.vulnerability-attack .field-label {\\n  color: #ef4444;\\n}\\n\\n.vulnerability-revision {\\n  background: rgba(34, 197, 94, 0.1);\\n  border-left: 3px solid #22c55e;\\n  padding: 12px;\\n  border-radius: 0 8px 8px 0;\\n  margin: 8px 0;\\n}\\n\\n.vulnerability-revision .field-label {\\n  color: #22c55e;\\n}\\n\\n.type-badge {\\n  display: inline-block;\\n  padding: 4px 10px;\\n  border-radius: 4px;\\n  font-size: 12px;\\n  font-weight: 500;\\n  background: rgba(99, 102, 241, 0.2);\\n  color: #818cf8;\\n  width: fit-content;\\n}\\n\\n.type-badge.extension {\\n  background: rgba(251, 191, 36, 0.2);\\n  color: #fbbf24;\\n}\\n\\n.type-badge.contradiction {\\n  background: rgba(239, 68, 68, 0.2);\\n  color: #ef4444;\\n}\\n\\n.type-badge.reframe {\\n  background: rgba(139, 92, 246, 0.2);\\n  color: #a78bfa;\\n}\\n\\n.accuracy-badge {\\n  display: inline-block;\\n  padding: 4px 10px;\\n  border-radius: 4px;\\n  font-size: 12px;\\n  font-weight: 500;\\n}\\n\\n.accuracy-badge.accurate {\\n  background: rgba(34, 197, 94, 0.2);\\n  color: #22c55e;\\n}\\n\\n.accuracy-badge.inaccurate {\\n  background: rgba(239, 68, 68, 0.2);\\n  color: #ef4444;\\n}\\n\\n.finding-raw {\\n  font-size: 12px;\\n  color: #94a3b8;\\n  background: rgba(0, 0, 0, 0.2);\\n  padding: 12px;\\n  border-radius: 6px;\\n  overflow-x: auto;\\n  margin: 0;\\n}\\n\\n/* Notes */\\n.item-notes {\\n  margin-top: 12px;\\n  padding-top: 12px;\\n  border-top: 1px solid #757575;\\n}\\n\\n.notes-label {\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: #64748b;\\n  margin-right: 8px;\\n}\\n\\n.notes-text {\\n  font-size: 14px;\\n  color: #94a3b8;\\n  font-style: italic;\\n}\\n\\n/* Loading spinner */\\n.loading-spinner {\\n  width: 20px;\\n  height: 20px;\\n  border: 2px solid #757575;\\n  border-top-color: #b5343a;\\n  border-radius: 50%;\\n  animation: spin 1s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to { transform: rotate(360deg); }\\n}\\n\\n/* ============================================\\n   Vulnerability Before/After Comparison View\\n   ============================================ */\\n\\n.vulnerability-comparison {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n\\n/* Side-by-side comparison grid */\\n.comparison-grid {\\n  display: grid;\\n  grid-template-columns: 1fr auto 1fr;\\n  gap: 16px;\\n  align-items: start;\\n}\\n\\n.comparison-side {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n/* Vulnerability: Before (red) / After (green) */\\n.comparison-side.before {\\n  background: rgba(239, 68, 68, 0.08);\\n  border: 1px solid rgba(239, 68, 68, 0.25);\\n  border-radius: 10px;\\n  padding: 16px;\\n}\\n\\n.comparison-side.after {\\n  background: rgba(34, 197, 94, 0.08);\\n  border: 1px solid rgba(34, 197, 94, 0.25);\\n  border-radius: 10px;\\n  padding: 16px;\\n}\\n\\n/* Ammunition: Flaw (amber) / Counter (blue) */\\n.comparison-side.flaw {\\n  background: rgba(251, 191, 36, 0.08);\\n  border: 1px solid rgba(251, 191, 36, 0.25);\\n  border-radius: 10px;\\n  padding: 16px;\\n}\\n\\n.comparison-side.counter {\\n  background: rgba(59, 130, 246, 0.08);\\n  border: 1px solid rgba(59, 130, 246, 0.25);\\n  border-radius: 10px;\\n  padding: 16px;\\n}\\n\\n.comparison-label {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-size: 13px;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.comparison-side.before .comparison-label {\\n  color: #f87171;\\n}\\n\\n.comparison-side.after .comparison-label {\\n  color: #4ade80;\\n}\\n\\n.comparison-side.flaw .comparison-label {\\n  color: #fbbf24;\\n}\\n\\n.comparison-side.counter .comparison-label {\\n  color: #b5343a;\\n}\\n\\n.label-icon {\\n  font-size: 16px;\\n}\\n\\n.comparison-text {\\n  font-size: 14px;\\n  line-height: 1.7;\\n  color: #4a4a4a;\\n  white-space: pre-wrap;\\n}\\n\\n.comparison-arrow {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  font-size: 24px;\\n  color: #64748b;\\n  padding-top: 40px;\\n}\\n\\n/* Recommendation section - actionable advice */\\n.recommendation-section {\\n  background: linear-gradient(135deg, rgba(168, 85, 247, 0.08), rgba(59, 130, 246, 0.08));\\n  border: 1px solid rgba(168, 85, 247, 0.25);\\n  border-radius: 10px;\\n  padding: 16px;\\n}\\n\\n.recommendation-label {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-size: 13px;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  color: #c084fc;\\n  margin-bottom: 8px;\\n}\\n\\n.recommendation-text {\\n  font-size: 14px;\\n  line-height: 1.7;\\n  color: #4a4a4a;\\n}\\n\\n/* Collapsible details */\\n.comparison-details {\\n  border-top: 1px solid #757575;\\n  padding-top: 12px;\\n}\\n\\n.details-toggle {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 6px;\\n  padding: 8px 12px;\\n  background: rgba(255, 255, 255, 0.05);\\n  border: 1px solid #475569;\\n  border-radius: 6px;\\n  color: #94a3b8;\\n  font-size: 13px;\\n  cursor: pointer;\\n  transition: all 0.15s ease;\\n}\\n\\n.details-toggle:hover {\\n  background: rgba(255, 255, 255, 0.1);\\n  color: #4a4a4a;\\n}\\n\\n.details-content {\\n  margin-top: 16px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.detail-item {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n  padding: 12px;\\n  background: rgba(0, 0, 0, 0.2);\\n  border-radius: 8px;\\n}\\n\\n.detail-label {\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: #94a3b8;\\n}\\n\\n.detail-value {\\n  font-size: 14px;\\n  color: #757575;\\n  line-height: 1.6;\\n}\\n\\n/* ============================================\\n   Source Context (collapsible capture origin)\\n   ============================================ */\\n\\n.arsenal-source-context {\\n  margin-top: 12px;\\n  border-top: 1px solid #e0ddd8;\\n  padding-top: 8px;\\n}\\n\\n.source-context-summary {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: #94a3b8;\\n  cursor: pointer;\\n  padding: 6px 0;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  user-select: none;\\n}\\n\\n.source-context-summary:hover {\\n  color: #64748b;\\n}\\n\\n.source-context-summary::marker {\\n  color: #94a3b8;\\n}\\n\\n.source-context-date {\\n  margin-left: auto;\\n  font-weight: 400;\\n  text-transform: none;\\n  letter-spacing: 0;\\n  font-size: 12px;\\n  color: #94a3b8;\\n}\\n\\n.source-context-body {\\n  margin-top: 8px;\\n  padding: 12px;\\n  background: #f0ede8;\\n  border-radius: 8px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.source-context-breadcrumb {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  flex-wrap: wrap;\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n.breadcrumb-segment {\\n  text-transform: capitalize;\\n}\\n\\n.breadcrumb-sep {\\n  color: #94a3b8;\\n  font-size: 14px;\\n}\\n\\n.source-context-title {\\n  font-size: 13px;\\n  font-weight: 600;\\n  color: #4a4a4a;\\n}\\n\\n.source-context-quote {\\n  margin: 4px 0;\\n  padding: 8px 12px;\\n  border-left: 3px solid #94a3b8;\\n  background: rgba(255, 255, 255, 0.5);\\n  border-radius: 0 6px 6px 0;\\n  font-size: 13px;\\n  line-height: 1.6;\\n  color: #4a4a4a;\\n  font-style: italic;\\n  white-space: pre-wrap;\\n  word-break: break-word;\\n}\\n\\n.source-context-data {\\n  margin-top: 4px;\\n}\\n\\n.source-context-data > summary {\\n  font-size: 11px;\\n  color: #94a3b8;\\n  cursor: pointer;\\n  user-select: none;\\n}\\n\\n.source-context-data > summary:hover {\\n  color: #64748b;\\n}\\n\\n.source-context-data > pre {\\n  margin: 6px 0 0;\\n  padding: 8px;\\n  background: rgba(0, 0, 0, 0.04);\\n  border-radius: 4px;\\n  font-size: 11px;\\n  font-family: 'JetBrains Mono', monospace;\\n  color: #64748b;\\n  overflow-x: auto;\\n  white-space: pre-wrap;\\n  word-break: break-word;\\n  max-height: 200px;\\n  overflow-y: auto;\\n}\\n\\n/* === Deep-link from source context breadcrumb === */\\n.source-context-deeplink {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 4px;\\n  text-decoration: none;\\n  color: inherit;\\n  transition: color 0.15s;\\n}\\n\\n.source-context-deeplink:hover {\\n  color: #6366f1;\\n}\\n\\n.source-context-deeplink:hover .breadcrumb-segment {\\n  text-decoration: underline;\\n}\\n\\n.deeplink-arrow {\\n  font-size: 12px;\\n  color: #94a3b8;\\n  margin-left: 4px;\\n  transition: color 0.15s;\\n}\\n\\n.source-context-deeplink:hover .deeplink-arrow {\\n  color: #6366f1;\\n}\\n\\n/* Responsive: stack on smaller screens */\\n@media (max-width: 900px) {\\n  .comparison-grid {\\n    grid-template-columns: 1fr;\\n    gap: 12px;\\n  }\\n\\n  .comparison-arrow {\\n    display: none;\\n  }\\n\\n  .comparison-side.before::after {\\n    content: '↓';\\n    display: block;\\n    text-align: center;\\n    font-size: 20px;\\n    color: #64748b;\\n    margin-top: 12px;\\n  }\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/BigPicturePage.css\"\n/*!*********************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/BigPicturePage.css ***!\n  \\****************************************************************************************************************************************************************************************************************