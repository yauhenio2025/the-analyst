/* DualAxisView Styles */\n\n.dual-axis-view {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  background: var(--bg-primary, #faf8f5);\n}\n\n.view-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 20px;\n  background: var(--card-bg, #ffffff);\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n  gap: 16px;\n}\n\n.back-btn {\n  background: var(--bg-elevated, #f5f3f0);\n  border: 1px solid var(--border-color, #e0ddd8);\n  color: var(--text-secondary, #757575);\n  padding: 8px 16px;\n  border-radius: 6px;\n  font-size: 13px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.back-btn:hover {\n  background: var(--bg-tertiary, #e0ddd8);\n  color: var(--text-primary, #1a1a1a);\n}\n\n.header-content {\n  flex: 1 1;\n  display: flex;\n  align-items: center;\n  gap: 24px;\n}\n\n.header-content h2 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n}\n\n.view-tabs {\n  display: flex;\n  background: var(--bg-elevated, #f5f3f0);\n  border-radius: 6px;\n  padding: 3px;\n}\n\n.view-tab {\n  padding: 8px 16px;\n  background: none;\n  border: none;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary, #757575);\n  cursor: pointer;\n  border-radius: 4px;\n  transition: all 0.2s ease;\n}\n\n.view-tab:hover {\n  color: var(--text-primary, #1a1a1a);\n}\n\n.view-tab.active {\n  background: var(--accent-color, #b5343a);\n  color: white;\n}\n\n.analyze-btn {\n  background: var(--accent-color, #b5343a);\n  border: none;\n  color: white;\n  padding: 10px 20px;\n  border-radius: 6px;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.analyze-btn:hover:not(:disabled) {\n  background: var(--accent-hover, #9a2c31);\n}\n\n.analyze-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.analysis-progress {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 20px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.progress-indicator {\n  width: 16px;\n  height: 16px;\n  border: 2px solid var(--accent-color, #b5343a);\n  border-top-color: transparent;\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n.analysis-progress span {\n  font-size: 13px;\n  color: var(--accent-color, #b5343a);\n}\n\n.error-banner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 20px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n  color: #8a4a4a;\n  font-size: 13px;\n}\n\n.error-banner button {\n  background: none;\n  border: 1px solid #8a4a4a;\n  color: #8a4a4a;\n  padding: 4px 12px;\n  border-radius: 4px;\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.error-banner button:hover {\n  background: rgba(138, 74, 74, 0.1);\n}\n\n.view-content {\n  display: flex;\n  flex: 1 1;\n  overflow: hidden;\n}\n\n.navigator-panel {\n  width: 360px;\n  flex-shrink: 0;\n  overflow-y: auto;\n  padding: 16px;\n  border-right: 1px solid var(--border-color, #e0ddd8);\n  background: var(--bg-elevated, #f5f3f0);\n}\n\n.detail-panel {\n  flex: 1 1;\n  min-width: 500px;  /* Prevent collapse when showing empty state */\n  overflow: hidden;  /* Let child handle its own scrolling */\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n}\n\n.empty-detail {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  color: var(--text-secondary, #757575);\n}\n\n.empty-detail p {\n  font-size: 14px;\n  text-align: center;\n}\n\n/* Sin Type Content Styles */\n.sin-type-content {\n  background: var(--card-bg, #ffffff);\n  border-radius: 8px;\n  padding: 20px;\n  border: 1px solid var(--border-color, #e0ddd8);\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n}\n\n.sin-type-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.sin-type-info {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.sin-indicator {\n  width: 16px;\n  height: 16px;\n  border-radius: 4px;\n}\n\n.sin-type-header h3 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n}\n\n.findings-count {\n  font-size: 13px;\n  color: var(--text-secondary, #757575);\n  background: var(--bg-elevated, #f5f3f0);\n  padding: 4px 12px;\n  border-radius: 4px;\n}\n\n.sin-description {\n  font-size: 14px;\n  color: var(--text-primary, #1a1a1a);\n  margin: 0 0 12px 0;\n  line-height: 1.5;\n}\n\n.sin-detection {\n  font-size: 13px;\n  color: var(--text-secondary, #757575);\n  margin: 0 0 12px 0;\n  padding: 12px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-radius: 6px;\n  border-left: 3px solid var(--accent-color, #b5343a);\n}\n\n.sin-detection strong {\n  color: var(--text-tertiary, #9a9a9a);\n}\n\n.bloom-reference {\n  font-size: 12px;\n  color: var(--text-tertiary, #9a9a9a);\n  font-style: italic;\n  margin: 0 0 20px 0;\n}\n\n.sin-findings-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-top: 20px;\n}\n\n.sin-type-content .finding-card {\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 0;\n  padding: 16px;\n}\n\n.sin-type-content .finding-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 12px;\n}\n\n.sin-type-content .finding-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n}\n\n.severity-badge {\n  font-size: 10px;\n  font-weight: 700;\n  color: white;\n  padding: 3px 8px;\n  border-radius: 4px;\n  text-transform: uppercase;\n}\n\n.sin-type-content .finding-description {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.6;\n  margin-bottom: 16px;\n}\n\n.finding-evidence {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n\n.finding-evidence .evidence-block {\n  padding: 12px;\n  border-radius: 6px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-left: 3px solid var(--accent-color, #b5343a);\n}\n\n.finding-evidence .evidence-block.source {\n  border-left-color: #5a7a8a;\n}\n\n.finding-evidence label {\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--text-tertiary, #9a9a9a);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n  display: block;\n  margin-bottom: 6px;\n}\n\n.finding-evidence blockquote {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.5;\n  margin: 0;\n  font-style: italic;\n}\n\n.finding-evidence cite {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n  display: block;\n  margin-top: 6px;\n  font-style: normal;\n}\n\n/* Expandable quotes button */\n.expand-quotes-btn {\n  background: transparent;\n  border: none;\n  color: var(--text-secondary, #757575);\n  font-size: 11px;\n  cursor: pointer;\n  padding: 4px 8px;\n  margin-top: 8px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  transition: color 0.15s ease;\n}\n\n.expand-quotes-btn:hover {\n  color: var(--text-primary, #1a1a1a);\n}\n\n/* Additional quotes container */\n.additional-quotes {\n  margin-top: 8px;\n  padding-left: 12px;\n  border-left: 2px solid var(--border-color, #e0ddd8);\n}\n\n.additional-quote {\n  margin-bottom: 10px;\n  opacity: 0.9;\n}\n\n.additional-quote:last-child {\n  margin-bottom: 0;\n}\n\n.additional-quote blockquote {\n  font-size: 12px;\n}\n\n.additional-quote cite {\n  font-size: 10px;\n}\n\n.finding-implication {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  padding: 12px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-radius: 6px;\n  border-left: 3px solid #5a6b7a;\n}\n\n.finding-implication strong {\n  color: var(--text-tertiary, #9a9a9a);\n  text-transform: uppercase;\n  font-size: 10px;\n  letter-spacing: 0.3px;\n}\n\n/* Version Tabs for Deeper Dive */\n.version-tabs {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 16px;\n  padding: 12px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-radius: 8px;\n}\n\n.version-tab {\n  flex: 1 1;\n  padding: 10px 16px;\n  background: var(--bg-tertiary, #e0ddd8);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 6px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary, #757575);\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.version-tab:hover {\n  background: var(--bg-primary, #faf8f5);\n  border-color: var(--accent-color, #b5343a);\n  color: var(--text-primary, #1a1a1a);\n}\n\n.version-tab.active {\n  background: var(--accent-color, #b5343a);\n  border-color: var(--accent-color, #b5343a);\n  color: white;\n}\n\n/* Version Controls Container */\n.version-controls {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n.version-controls .version-tabs {\n  flex: 1 1;\n  margin-bottom: 0;\n}\n\n/* Download Buttons */\n.download-buttons {\n  display: flex;\n  gap: 8px;\n}\n\n.download-btn {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 8px 12px;\n  border-radius: 6px;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  border: 1px solid var(--border-color, #e0ddd8);\n}\n\n.download-btn.download-md {\n  background: var(--bg-elevated, #f5f3f0);\n  color: var(--text-secondary, #757575);\n}\n\n.download-btn.download-md:hover {\n  background: var(--bg-tertiary, #e0ddd8);\n  color: var(--text-primary, #1a1a1a);\n  border-color: #b5343a;\n}\n\n.download-btn.download-pdf {\n  background: var(--bg-elevated, #f5f3f0);\n  color: var(--text-secondary, #757575);\n}\n\n.download-btn.download-pdf:hover {\n  background: var(--bg-tertiary, #e0ddd8);\n  color: var(--text-primary, #1a1a1a);\n  border-color: #b5343a;\n}\n\n/* v2 download buttons */\n.download-btn.v2 {\n  border-color: var(--border-color, #e0ddd8);\n}\n\n.download-btn.v2:hover {\n  border-color: var(--accent-color, #b5343a);\n  background: var(--bg-tertiary, #e0ddd8);\n}\n\n/* Pattern Summary */\n.pattern-summary {\n  background: var(--bg-elevated, #f5f3f0);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-left: 4px solid var(--accent-color, #b5343a);\n  border-radius: 8px;\n  padding: 16px;\n  margin-bottom: 16px;\n}\n\n.pattern-summary h4 {\n  margin: 0 0 12px 0;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--accent-color, #b5343a);\n}\n\n.pattern-summary p {\n  margin: 0;\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.6;\n}\n\n.cumulative-impact {\n  margin-top: 12px !important;\n  padding-top: 12px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.cumulative-impact strong {\n  color: var(--text-secondary, #757575);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.impact-high {\n  color: #8a4a4a;\n  font-weight: 600;\n  text-transform: capitalize;\n}\n\n.impact-medium {\n  color: #7a7a50;\n  font-weight: 600;\n  text-transform: capitalize;\n}\n\n.impact-low {\n  color: #5a7a60;\n  font-weight: 600;\n  text-transform: capitalize;\n}\n\n/* Deeper Dive Progress */\n.deeper-dive-progress {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 16px;\n  background: var(--bg-elevated, #f5f3f0);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 8px;\n  margin-bottom: 16px;\n}\n\n.deeper-dive-progress .progress-indicator {\n  border-color: var(--accent-color, #b5343a);\n  border-top-color: transparent;\n}\n\n.deeper-dive-progress span {\n  font-size: 13px;\n  color: var(--accent-color, #b5343a);\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n  .view-content {\n    flex-direction: column;\n  }\n\n  .navigator-panel {\n    width: 100%;\n    max-height: 300px;\n    border-right: none;\n    border-bottom: 1px solid var(--border-color, #e0ddd8);\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/DualAxisView.css\"],\"names\":[],\"mappings\":\"AAAA,wBAAwB;;AAExB;EACE,aAAa;EACb,sBAAsB;EACtB,YAAY;EACZ,sCAAsC;AACxC;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,kBAAkB;EAClB,mCAAmC;EACnC,qDAAqD;EACrD,SAAS;AACX;;AAEA;EACE,uCAAuC;EACvC,8CAA8C;EAC9C,qCAAqC;EACrC,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,eAAe;EACf,yBAAyB;AAC3B;;AAEA;EACE,uCAAuC;EACvC,mCAAmC;AACrC;;AAEA;EACE,SAAO;EACP,aAAa;EACb,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,mCAAmC;AACrC;;AAEA;EACE,aAAa;EACb,uCAAuC;EACvC,kBAAkB;EAClB,YAAY;AACd;;AAEA;EACE,iBAAiB;EACjB,gBAAgB;EAChB,YAAY;EACZ,eAAe;EACf,gBAAgB;EAChB,qCAAqC;EACrC,eAAe;EACf,kBAAkB;EAClB,yBAAyB;AAC3B;;AAEA;EACE,mCAAmC;AACrC;;AAEA;EACE,wCAAwC;EACxC,YAAY;AACd;;AAEA;EACE,wCAAwC;EACxC,YAAY;EACZ,YAAY;EACZ,kBAAkB;EAClB,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,eAAe;EACf,yBAAyB;AAC3B;;AAEA;EACE,wCAAwC;AAC1C;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,kBAAkB;EAClB,uCAAuC;EACvC,qDAAqD;AACvD;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,8CAA8C;EAC9C,6BAA6B;EAC7B,kBAAkB;EAClB,kCAAkC;AACpC;;AAEA;EACE,KAAK,yBAAyB,EAAE;AAClC;;AAEA;EACE,eAAe;EACf,mCAAmC;AACrC;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,kBAAkB;EAClB,uCAAuC;EACvC,qDAAqD;EACrD,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,gBAAgB;EAChB,yBAAyB;EACzB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,eAAe;AACjB;;AAEA;EACE,kCAAkC;AACpC;;AAEA;EACE,aAAa;EACb,SAAO;EACP,gBAAgB;AAClB;;AAEA;EACE,YAAY;EACZ,cAAc;EACd,gBAAgB;EAChB,aAAa;EACb,oDAAoD;EACpD,uCAAuC;AACzC;;AAEA;EACE,SAAO;EACP,gBAAgB,GAAG,8CAA8C;EACjE,gBAAgB,GAAG,uCAAuC;EAC1D,aAAa;EACb,aAAa;EACb,sBAAsB;AACxB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,YAAY;EACZ,qCAAqC;AACvC;;AAEA;EACE,eAAe;EACf,kBAAkB;AACpB;;AAEA,4BAA4B;AAC5B;EACE,mCAAmC;EACnC,kBAAkB;EAClB,aAAa;EACb,8CAA8C;EAC9C,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EA