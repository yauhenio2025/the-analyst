nd: linear-gradient(135deg, #b5343a 0%, #f5f3f0 100%);\n  border: 1px solid #b5343a;\n  border-radius: 12px;\n  padding: 20px 24px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.continue-card:hover {\n  border-color: #4ade80;\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(74, 222, 128, 0.15);\n}\n\n.continue-label {\n  color: #4ade80;\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  font-weight: 500;\n}\n\n.continue-project {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.continue-project .project-icon {\n  font-size: 1.5rem;\n}\n\n.continue-project .project-name {\n  color: #4a4a4a;\n  font-size: 1.25rem;\n  font-weight: 600;\n}\n\n.continue-btn {\n  background: #4ade80;\n  color: #faf8f5;\n  border: none;\n  border-radius: 6px;\n  padding: 10px 20px;\n  font-size: 0.95rem;\n  font-weight: 600;\n  cursor: pointer;\n  align-self: flex-start;\n  transition: all 0.2s ease;\n}\n\n.continue-btn:hover {\n  background: #22c55e;\n}\n\n/* Projects Section */\n.landing-projects {\n  width: 100%;\n  max-width: 900px;\n  margin-bottom: 40px;\n}\n\n.landing-projects h2 {\n  color: #757575;\n  font-size: 1.1rem;\n  font-weight: 500;\n  margin: 0 0 20px 0;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n/* Loading State */\n.loading-state {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  padding: 40px;\n  color: #757575;\n}\n\n.loading-state .spinner {\n  width: 24px;\n  height: 24px;\n  border: 2px solid #333;\n  border-top-color: #4ade80;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Error State */\n.error-state {\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  border-radius: 8px;\n  padding: 24px;\n  text-align: center;\n  color: #f87171;\n}\n\n.error-state .error-icon {\n  font-size: 1.5rem;\n  display: block;\n  margin-bottom: 8px;\n}\n\n.error-hint {\n  color: #757575;\n  font-size: 0.9rem;\n  margin-top: 12px;\n}\n\n.error-hint code {\n  background: #f5f3f0;\n  padding: 2px 8px;\n  border-radius: 4px;\n  color: #4ade80;\n}\n\n/* Empty State */\n.empty-state {\n  text-align: center;\n  padding: 40px;\n  color: #757575;\n}\n\n.empty-state .empty-icon {\n  font-size: 3rem;\n  display: block;\n  margin-bottom: 16px;\n}\n\n.create-btn {\n  background: #b5343a;\n  color: white;\n  border: none;\n  border-radius: 6px;\n  padding: 12px 24px;\n  font-size: 0.95rem;\n  font-weight: 500;\n  cursor: pointer;\n  margin-top: 16px;\n  transition: all 0.2s ease;\n}\n\n.create-btn:hover {\n  background: #b5343a;\n}\n\n/* Projects Grid */\n.projects-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 20px;\n}\n\n.project-card {\n  background: #faf8f5;\n  border: 1px solid #e0ddd8;\n  border-radius: 12px;\n  padding: 20px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.project-card:hover {\n  border-color: #4ade80;\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n\n.project-card.current {\n  border-color: #4ade80;\n  background: linear-gradient(135deg, #faf8f5 0%, #faf8f5 100%);\n}\n\n.project-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n\n.project-header .project-icon {\n  font-size: 1.5rem;\n}\n\n.project-header h3 {\n  color: #4a4a4a;\n  font-size: 1.1rem;\n  font-weight: 600;\n  margin: 0;\n}\n\n.project-description {\n  color: #757575;\n  font-size: 0.9rem;\n  line-height: 1.4;\n  margin: 0 0 16px 0;\n}\n\n.project-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin-bottom: 16px;\n}\n\n.meta-item {\n  color: #666;\n  font-size: 0.85rem;\n}\n\n.meta-label {\n  color: #757575;\n}\n\n.select-btn {\n  background: #f5f3f0;\n  color: #757575;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  padding: 8px 16px;\n  font-size: 0.9rem;\n  cursor: pointer;\n  width: 100%;\n  transition: all 0.2s ease;\n}\n\n.select-btn:hover {\n  background: #e8e5e0;\n  color: #4a4a4a;\n  border-color: #4ade80;\n}\n\n.project-card.current .select-btn {\n  background: rgba(74, 222, 128, 0.15);\n  color: #4ade80;\n  border-color: #4ade80;\n}\n\n/* Actions */\n.landing-actions {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 40px;\n}\n\n.create-new-btn {\n  background: linear-gradient(135deg, #b5343a, #b5343a);\n  color: white;\n  border: none;\n  border-radius: 8px;\n  padding: 12px 24px;\n  font-size: 0.95rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.create-new-btn:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);\n}\n\n.manage-btn {\n  background: transparent;\n  color: #757575;\n  border: 1px solid #e0ddd8;\n  border-radius: 8px;\n  padding: 12px 24px;\n  font-size: 0.95rem;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.manage-btn:hover {\n  color: #4a4a4a;\n  border-color: #4ade80;\n}\n\n/* Footer */\n.landing-footer {\n  text-align: center;\n  color: #555;\n  font-size: 0.85rem;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/LandingPage.css\"],\"names\":[],\"mappings\":\"AAAA,6CAA6C;;AAE7C;EACE,iBAAiB;EACjB,0EAA0E;EAC1E,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;AACrB;;AAEA,iBAAiB;AACjB;EACE,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,cAAc;EACd,iBAAiB;EACjB,gBAAgB;EAChB,kBAAkB;EAClB,sBAAsB;AACxB;;AAEA;EACE,cAAc;EACd,iBAAiB;EACjB,gBAAgB;EAChB,cAAc;EACd,gBAAgB;AAClB;;AAEA,kCAAkC;AAClC;EACE,mBAAmB;EACnB,WAAW;EACX,gBAAgB;AAClB;;AAEA;EACE,6DAA6D;EAC7D,yBAAyB;EACzB,mBAAmB;EACnB,kBAAkB;EAClB,eAAe;EACf,yBAAyB;EACzB,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,qBAAqB;EACrB,2BAA2B;EAC3B,+CAA+C;AACjD;;AAEA;EACE,cAAc;EACd,kBAAkB;EAClB,yBAAyB;EACzB,qBAAqB;EACrB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;AACX;;