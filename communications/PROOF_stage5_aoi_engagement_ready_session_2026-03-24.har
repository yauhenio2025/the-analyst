 {\n  font-size: 14px;\n  color: #94a3b8;\n  margin: 0;\n}\n\n.aoi-content {\n  /* Content container */\n}\n\n/* =============================================================================\n   THINKER LIST PAGE\n   ============================================================================= */\n\n.anxiety-thinker-list {\n  /* Container for list view */\n}\n\n.grid-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n  padding: 12px 16px;\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 8px;\n}\n\n.status-line {\n  font-size: 14px;\n}\n\n.loading-indicator {\n  color: #b5343a;\n}\n\n.success-indicator {\n  color: #5a7a60;\n  font-weight: 500;\n}\n\n.pending-indicator {\n  color: #94a3b8;\n}\n\n.error-indicator {\n  color: #8a4a4a;\n}\n\n.header-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.add-thinker-btn {\n  padding: 8px 16px;\n  background: var(--bg-elevated, #f5f3f0);\n  color: var(--text-primary, #1a1a1a);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 500;\n  transition: all 0.2s;\n}\n\n.add-thinker-btn:hover {\n  border-color: var(--accent-primary, #b5343a);\n  color: var(--accent-primary, #b5343a);\n}\n\n.refresh-btn {\n  padding: 8px 16px;\n  background: #b5343a;\n  color: white;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n  transition: background 0.2s;\n}\n\n.refresh-btn:disabled {\n  background: #6b7280;\n  cursor: not-allowed;\n}\n\n.refresh-btn:hover:not(:disabled) {\n  background: #b5343a;\n}\n\n/* =============================================================================\n   THINKER GRID\n   ============================================================================= */\n\n.thinkers-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\n  gap: 16px;\n}\n\n.thinker-card {\n  padding: 16px;\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.thinker-card:hover {\n  border-color: #b5343a;\n  transform: translateY(-2px);\n}\n\n.thinker-name-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.thinker-name {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1a1a1a;\n}\n\n.manual-badge,\n.edited-badge {\n  font-size: 10px;\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-weight: 500;\n}\n\n.manual-badge {\n  background: rgba(107, 90, 79, 0.12);\n  color: #6b5a4f;\n}\n\n.edited-badge {\n  background: rgba(90, 107, 122, 0.12);\n  color: #5a6b7a;\n}\n\n.thinker-tradition {\n  font-size: 13px;\n  color: #94a3b8;\n  margin-bottom: 8px;\n}\n\n.thinker-notes {\n  font-size: 12px;\n  color: #64748b;\n  font-style: italic;\n  margin-bottom: 8px;\n}\n\n.thinker-stats {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 12px;\n  font-size: 12px;\n  color: #94a3b8;\n}\n\n.text-indicator.has-texts {\n  color: #5a7a60;\n}\n\n.secondary-indicator {\n  color: #6b5a4f;\n}\n\n.status-badge {\n  display: inline-block;\n  padding: 4px 10px;\n  border-radius: 12px;\n  font-size: 11px;\n  font-weight: 500;\n  color: white;\n  margin-bottom: 8px;\n}\n\n.faithfulness-score {\n  font-size: 12px;\n  color: #94a3b8;\n  margin-bottom: 12px;\n}\n\n.card-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 8px;\n  padding-top: 12px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.card-actions button {\n  padding: 6px 12px;\n  font-size: 12px;\n  border-radius: 4px;\n  border: none;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.upload-btn {\n  background: #faf8f5;\n  color: #94a3b8;\n}\n\n.upload-btn:hover {\n  background: #757575;\n  color: white;\n}\n\n.edit-btn {\n  background: #faf8f5;\n  color: #94a3b8;\n}\n\n.edit-btn:hover {\n  background: #757575;\n  color: white;\n}\n\n.delete-btn {\n  background: rgba(138, 74, 74, 0.1);\n  color: #8a4a4a;\n}\n\n.delete-btn:hover {\n  background: #8a4a4a;\n  color: white;\n}\n\n/* =============================================================================\n   SOURCE DOCUMENTS PANEL\n   ============================================================================= */\n\n.source-documents-panel {\n  margin-bottom: 20px;\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 6px;\n  background: var(--bg-surface, #ffffff);\n}\n\n.source-documents-summary {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 16px;\n  cursor: pointer;\n  -webkit-user-select: none;\n          user-select: none;\n  font-family: var(--font-ui, 'IBM Plex Sans', sans-serif);\n}\n\n.source-documents-summary::-webkit-details-marker {\n  display: none;\n}\n\n.source-documents-summary::before {\n  content: '▸';\n  font-size: 11px;\n  color: var(--text-secondary, #757575);\n  transition: transform 0.15s ease;\n}\n\n.source-documents-panel[open] .source-documents-summary::before {\n  transform: rotate(90deg);\n}\n\n.source-documents-label {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.source-documents-count {\n  font-size: 12px;\n  color: var(--text-secondary, #757575);\n}\n\n.source-documents-content {\n  padding: 0 16px 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.documents-section {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.documents-section-label {\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: var(--text-secondary, #757575);\n  margin: 8px 0 4px;\n  font-family: var(--font-ui, 'IBM Plex Sans', sans-serif);\n}\n\n.documents-section:first-child .documents-section-label {\n  margin-top: 0;\n}\n\n.other-documents {\n  border-top: 1px solid var(--border-color, #e0ddd8);\n  padding-top: 8px;\n  margin-top: 8px;\n  opacity: 0.7;\n}\n\n.document-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-radius: 4px;\n  font-size: 13px;\n}\n\n.document-row.analyzed {\n  border-left: 3px solid var(--accent-primary, #b5343a);\n}\n\n.document-name {\n  flex: 1 1;\n  color: var(--text-primary, #1a1a1a);\n  font-family: var(--font-body, 'Source Serif Pro', serif);\n}\n\n.doc-type-badge {\n  font-size: 10px;\n  font-weight: 600;\n  padding: 2px 8px;\n  border-radius: 3px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n  flex-shrink: 0;\n}\n\n.doc-type-badge.subject {\n  background: rgba(90, 107, 122, 0.12);\n  color: #5a6b7a;\n}\n\n.doc-type-badge.critique {\n  background: rgba(181, 52, 58, 0.1);\n  color: #b5343a;\n}\n\n.doc-type-badge.response {\n  background: rgba(138, 121, 80, 0.12);\n  color: #8a7a50;\n}\n\n.document-author {\n  font-size: 12px;\n  color: var(--text-secondary, #757575);\n  font-style: italic;\n  flex-shrink: 0;\n}\n\n.add-document-btn {\n  align-self: flex-start;\n  margin-top: 4px;\n  padding: 6px 12px;\n  background: none;\n  border: 1px dashed var(--border-color, #e0ddd8);\n  border-radius: 4px;\n  color: var(--text-secondary, #757575);\n  font-size: 12px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.add-document-btn:hover {\n  border-color: var(--accent-primary, #b5343a);\n  color: var(--accent-primary, #b5343a);\n}\n\n/* =============================================================================\n   ADD DOCUMENT MODAL\n   ============================================================================= */\n\n.add-document-form {\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.add-document-form .form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.add-document-form .form-field label {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text-secondary, #757575);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.add-document-form .form-field input,\n.add-document-form .form-field select {\n  padding: 8px 12px;\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 4px;\n  font-size: 14px;\n  font-family: var(--font-body, 'Source Serif Pro', serif);\n  background: var(--bg-surface, #ffffff);\n  color: var(--text-primary, #1a1a1a);\n}\n\n.add-document-form .form-field input:focus,\n.add-document-form .form-field select:focus {\n  outline: none;\n  border-color: var(--accent-primary, #b5343a);\n}\n\n/* =============================================================================\n   THINKER DETAIL PAGE\n   ============================================================================= */\n\n.anxiety-thinker-detail {\n  /* Container */\n}\n\n.anxiety-thinker-detail.full-width {\n  max-width: none;\n}\n\n.anxiety-thinker-detail.loading,\n.anxiety-thinker-detail.error {\n  padding: 40px;\n  text-align: center;\n}\n\n.detail-header {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-bottom: 20px;\n}\n\n.back-btn {\n  padding: 8px 16px;\n  background: #faf8f5;\n  color: #94a3b8;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n  transition: all 0.2s;\n}\n\n.back-btn:hover {\n  background: #757575;\n  color: white;\n}\n\n.thinker-heading {\n  font-size: 24px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.thinker-tradition-badge {\n  font-size: 13px;\n  padding: 4px 12px;\n  background: #faf8f5;\n  color: #94a3b8;\n  border-radius: 16px;\n}\n\n.error-message {\n  color: #8a4a4a;\n  font-size: 16px;\n  margin-top: 20px;\n}\n\n/* =============================================================================\n   TABS NAVIGATION\n   ============================================================================= */\n\n.analysis-mode-tabs {\n  display: flex;\n  gap: 4px;\n  margin-bottom: 20px;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n  padding-bottom: 0;\n}\n\n.analysis-mode-btn {\n  padding: 12px 24px;\n  background: transparent;\n  border: none;\n  border-bottom: 2px solid transparent;\n  color: #94a3b8;\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.analysis-mode-btn:hover {\n  color: #b5343a;\n}\n\n.analysis-mode-btn.active {\n  color: #b5343a;\n  border-bottom-color: #b5343a;\n}\n\n.tab-content {\n  /* Content area */\n}\n\n/* =============================================================================\n   HYPOTHESES PANEL\n   ============================================================================= */\n\n.hypotheses-panel {\n  background: var(--bg-card, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 8px;\n  padding: 20px;\n}\n\n.hypotheses-panel .panel-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.hypotheses-panel .panel-header h3 {\n  font-size: 18px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.generate-btn {\n  padding: 8px 16px;\n  background: var(--accent-primary, #b5343a);\n  color: white;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n  transition: background 0.2s;\n}\n\n.generate-btn:disabled {\n  background: #6b7280;\n  cursor: not-allowed;\n}\n\n.generate-btn:hover:not(:disabled) {\n  background: #9a2c31;\n}\n\n.empty-state {\n  text-align: center;\n  padding: 40px;\n  color: #94a3b8;\n}\n\n.empty-state p {\n  margin: 8px 0;\n}\n\n.hypotheses-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.hypothesis-card {\n  background: #faf8f5;\n  border-radius: 8px;\n  padding: 16px;\n}\n\n.hyp-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n\n.hyp-type {\n  font-size: 12px;\n  font-weight: 600;\n  color: #b5343a;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.hyp-header .edited-badge {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: rgba(90, 107, 122, 0.12);\n  color: #5a6b7a;\n  border-radius: 4px;\n}\n\n.hyp-text {\n  font-size: 14px;\n  color: #4a4a4a;\n  line-height: 1.6;\n  margin-bottom: 12px;\n}\n\n.hyp-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.hyp-actions button {\n  padding: 6px 12px;\n  font-size: 12px;\n  border-radius: 4px;\n  border: none;\n  cursor: pointer;\n  background: #757575;\n  color: #94a3b8;\n  transition: all 0.2s;\n}\n\n.hyp-actions button:hover {\n  background: #475569;\n  color: white;\n}\n\n.edit-mode textarea {\n  width: 100%;\n  padding: 12px;\n  background: #faf8f5;\n  border: 1px solid #757575;\n  border-radius: 6px;\n  color: #4a4a4a;\n  font-size: 14px;\n  line-height: 1.6;\n  resize: vertical;\n  margin-bottom: 12px;\n}\n\n.edit-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.edit-actions button {\n  padding: 8px 16px;\n  font-size: 13px;\n  border-radius: 6px;\n  border: none;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.edit-actions button:first-child {\n  background: var(--accent-primary, #b5343a);\n  color: white;\n}\n\n.edit-actions button:first-child:hover {\n  background: #9a2c31;\n}\n\n.edit-actions button:last-child {\n  background: #475569;\n  color: white;\n}\n\n.panel-footer {\n  margin-top: 20px;\n  padding-top: 20px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n  text-align: right;\n}\n\n.proceed-btn {\n  padding: 10px 24px;\n  background: #b5343a;\n  color: white;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 500;\n  transition: background 0.2s;\n}\n\n.proceed-btn:disabled {\n  background: #6b7280;\n  cursor: not-allowed;\n}\n\n.proceed-btn:hover:not(:disabled) {\n  background: #b5343a;\n}\n\n/* =============================================================================\n   REPORT PANEL\n   ============================================================================= */\n\n.report-panel {\n  background: var(--bg-card, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 8px;\n  padding: 20px;\n}\n\n.report-panel.empty {\n  text-align: center;\n  padding: 60px;\n}\n\n.report-header {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 24px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.report-title-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n}\n\n.report-header h3 {\n  font-size: 20px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.report-meta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.historical-badge {\n  font-size: 12px;\n  padding: 4px 10px;\n  background: #854d0e;\n  color: #fef3c7;\n  border-radius: 12px;\n  font-weight: 500;\n}\n\n.faithfulness-score {\n  font-size: 14px;\n  padding: 6px 12px;\n  background: #faf8f5;\n  border-radius: 6px;\n  color: #b5343a;\n  font-weight: 500;\n}\n\n/* Report Actions */\n.report-actions {\n  display: flex;\n  gap: 10px;\n  margin-top: 12px;\n}\n\n.compare-btn,\n.download-pdf-btn {\n  padding: 8px 16px;\n  border: none;\n  border-radius: 6px;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.compare-btn {\n  background: #faf8f5;\n  color: #94a3b8;\n  border: 1px solid var(--border-color, #e0ddd8);\n}\n\n.compare-btn:hover:not(:disabled) {\n  background: #757575;\n  color: #4a4a4a;\n}\n\n.compare-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.download-pdf-btn {\n  background: #b5343a;\n  color: white;\n}\n\n.download-pdf-btn:hover {\n  background: #b5343a;\n}\n\n.download-pdf-btn.highlighted {\n  background: #6b5a4f;\n}\n\n.download-pdf-btn.highlighted:hover {\n  background: #5a4a3f;\n}\n\n/* Diff Summary Alert */\n.diff-summary-alert {\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);\n  border: 1px solid rgba(59, 130, 246, 0.3);\n  border-radius: 12px;\n  padding: 16px 20px;\n  margin-bottom: 20px;\n}\n\n.diff-summary-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n\n.diff-summary-header strong {\n  color: #4a4a4a;\n  font-size: 15px;\n}\n\n.score-change {\n  font-size: 13px;\n  padding: 4px 10px;\n  border-radius: 6px;\n  font-weight: 600;\n}\n\n.score-change.negative {\n  background: rgba(239, 68, 68, 0.2);\n  color: #fca5a5;\n}\n\n.score-change.positive {\n  background: rgba(34, 197, 94, 0.2);\n  color: #86efac;\n}\n\n.diff-summary-text {\n  font-size: 13px;\n  color: #757575;\n  line-height: 1.6;\n  margin: 0 0 12px 0;\n}\n\n.change-legend {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 12px;\n}\n\n.legend-item {\n  font-size: 12px;\n  color: #94a3b8;\n}\n\n.legend-item.added { color: #5a7a60; }\n.legend-item.modified { color: #8a7a50; }\n.legend-item.strengthened { color: #b5343a; }\n\n.hide-diff-btn {\n  padding: 6px 12px;\n  background: transparent;\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 4px;\n  color: #94a3b8;\n  font-size: 12px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.hide-diff-btn:hover {\n  background: var(--border-color, #e0ddd8);\n  color: white;\n}\n\n/* Inline Highlighting */\n.highlighted-paragraph {\n  position: relative;\n}\n\n.inline-highlight {\n  position: relative;\n  display: inline;\n  transition: all 0.2s;\n}\n\n.inline-highlight:hover {\n  filter: brightness(1.2);\n}\n\n.inline-highlight .highlight-tooltip {\n  display: none;\n  position: absolute;\n  bottom: calc(100% + 8px);\n  left: 0;\n  min-width: 300px;\n  max-width: 400px;\n  background: #faf8f5;\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 8px;\n  padding: 12px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n  z-index: 100;\n  font-style: normal;\n  font-size: 13px;\n  line-height: 1.5;\n  white-space: normal;\n}\n\n.inline-highlight:hover .highlight-tooltip {\n  display: block;\n}\n\n.highlight-tooltip .tooltip-badge {\n  display: inline-block;\n  padding: 3px 8px;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  color: white;\n  margin-bottom: 8px;\n}\n\n.highlight-tooltip .tooltip-text {\n  display: block;\n  color: #757575;\n}\n\n.report-section {\n  margin-bottom: 24px;\n}\n\n.report-section h4 {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin-bottom: 12px;\n}\n\n.report-section p {\n  font-size: 14px;\n  color: #757575;\n  line-height: 1.7;\n  margin-bottom: 16px;\n}\n\n.report-section p:last-child {\n  margin-bottom: 0;\n}\n\n.report-section ul {\n  margin: 0;\n  padding-left: 20px;\n}\n\n.report-section li {\n  font-size: 14px;\n  color: #757575;\n  line-height: 1.7;\n  margin-bottom: 8px;\n}\n\n/* =============================================================================\n   MODALS\n   ============================================================================= */\n\n.modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.75);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 12px;\n  padding: 24px;\n  width: 100%;\n  max-width: 500px;\n  max-height: 90vh;\n  overflow-y: auto;\n}\n\n.modal-content.upload-modal {\n  max-width: 600px;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.modal-header h3 {\n  font-size: 18px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  color: #94a3b8;\n  font-size: 24px;\n  cursor: pointer;\n  padding: 0;\n  line-height: 1;\n}\n\n.close-btn:hover {\n  color: white;\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  font-size: 13px;\n  font-weight: 500;\n  color: #94a3b8;\n  margin-bottom: 8px;\n}\n\n.form-group input[type=\"text\"],\n.form-group textarea,\n.form-group select {\n  width: 100%;\n  padding: 10px 12px;\n  background: #faf8f5;\n  border: 1px solid #757575;\n  border-radius: 6px;\n  color: #4a4a4a;\n  font-size: 14px;\n}\n\n.form-group input[type=\"text\"]:focus,\n.form-group textarea:focus,\n.form-group select:focus {\n  outline: none;\n  border-color: #b5343a;\n}\n\n.form-group small {\n  display: block;\n  margin-top: 4px;\n  font-size: 12px;\n  color: #64748b;\n}\n\n.modal-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 24px;\n  padding-top: 16px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.modal-actions button {\n  padding: 10px 20px;\n  font-size: 14px;\n  border-radius: 6px;\n  border: none;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.modal-actions button[type=\"button\"] {\n  background: #757575;\n  color: #94a3b8;\n}\n\n.modal-actions button[type=\"button\"]:hover {\n  background: #475569;\n  color: white;\n}\n\n.modal-actions button[type=\"submit\"],\n.modal-actions button:not([type]) {\n  background: #b5343a;\n  color: white;\n}\n\n.modal-actions button[type=\"submit\"]:hover,\n.modal-actions button:not([type]):hover {\n  background: #b5343a;\n}\n\n.modal-actions button:disabled {\n  background: #6b7280;\n  cursor: not-allowed;\n}\n\n/* Upload modal specific */\n.existing-texts {\n  background: #faf8f5;\n  border-radius: 8px;\n  padding: 12px;\n  margin-bottom: 16px;\n}\n\n.existing-texts h4 {\n  font-size: 13px;\n  font-weight: 600;\n  color: #94a3b8;\n  margin: 0 0 8px 0;\n}\n\n.existing-texts ul {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.existing-texts li {\n  font-size: 12px;\n  color: #757575;\n  padding: 4px 0;\n  display: flex;\n  justify-content: space-between;\n}\n\n.existing-texts .text-type {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: #757575;\n  border-radius: 4px;\n  color: #94a3b8;\n}\n\n.selected-files {\n  background: #faf8f5;\n  border-radius: 8px;\n  padding: 12px;\n  margin-bottom: 16px;\n}\n\n.selected-files h4 {\n  font-size: 13px;\n  font-weight: 600;\n  color: #5a7a60;\n  margin: 0 0 8px 0;\n}\n\n.selected-files ul {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.selected-files li {\n  font-size: 12px;\n  color: #757575;\n  padding: 4px 0;\n}\n\n.thinker-checkboxes {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 13px;\n  color: #757575;\n  cursor: pointer;\n}\n\n.checkbox-label input[type=\"checkbox\"] {\n  width: auto;\n  cursor: pointer;\n}\n\n/* =============================================================================\n   LOADING STATE\n   ============================================================================= */\n\n.panel-loading {\n  text-align: center;\n  padding: 60px;\n  color: #94a3b8;\n  font-size: 14px;\n}\n\n/* =============================================================================\n   PENDING REVISIONS ALERT\n   ============================================================================= */\n\n.pending-revisions-alert {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 20px;\n  background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);\n  border: 1px solid rgba(99, 102, 241, 0.3);\n  border-radius: 12px;\n  margin-bottom: 20px;\n}\n\n.pending-revisions-alert .alert-content {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.pending-revisions-alert .alert-icon {\n  font-size: 24px;\n  line-height: 1;\n}\n\n.pending-revisions-alert .alert-text {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.pending-revisions-alert .alert-text strong {\n  color: #4a4a4a;\n  font-weight: 600;\n}\n\n.pending-revisions-alert .pending-types {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 4px;\n}\n\n.pending-revisions-alert .pending-type-tag {\n  font-size: 11px;\n  padding: 3px 8px;\n  background: var(--border-color, #e0ddd8);\n  border-radius: 4px;\n  color: var(--text-secondary, #757575);\n}\n\n.pending-revisions-alert .revise-report-btn {\n  padding: 10px 20px;\n  background: var(--accent-primary, #b5343a);\n  border: none;\n  border-radius: 8px;\n  color: white;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: all 0.2s ease;\n  box-shadow: 0 2px 8px rgba(181, 52, 58, 0.2);\n}\n\n.pending-revisions-alert .revise-report-btn:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);\n}\n\n.pending-revisions-alert .revise-report-btn:active {\n  transform: translateY(0);\n}\n\n@media (max-width: 600px) {\n  .pending-revisions-alert {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .pending-revisions-alert .revise-report-btn {\n    width: 100%;\n    text-align: center;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/AnxietyOfInfluencePages.css\"],\"names\":[],\"mappings\":\"AAAA;;EAEE;;AAEF;;kFAEkF;;AAElF;EACE,aAAa;EACb,iBAAiB;EACjB,cAAc;EACd,8EAA8E;AAChF;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,kBAAkB;EAClB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,SAAS;AACX;;AAEA;EACE,sBAAsB;AACxB;;AAEA;;kFAEkF;;AAElF;EACE,4BAA4B;AAC9B;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAmB;EACnB,kBAAkB;EAClB,sCAAsC;EACtC,8CAA8C;EAC9C,kBAAkB;AACpB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,SAAS;AACX;;AAEA;EACE,iBAAiB;EACjB,uCAAuC;EACvC,mCAAmC;EACnC,8CAA8C;EAC9C,kBAAkB;EAClB,eAAe;EACf,eAAe;EACf,gBAAgB;EAChB,oBAAoB;AACtB;;AAEA;EACE,4CAA4C;EAC5C,qCAAqC;AACvC;;AAEA;EACE,iBAAiB;EACjB,mBAAmB;EACnB,YAAY;EACZ,YAAY;EACZ,kBAAkB;EAClB,eAAe;EACf,eAAe;EACf,2BAA2B;AAC7B;;AAEA;EACE,mBAAmB;EACnB,mBAAmB;AACrB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;;kFAEkF;;AAElF;EACE,aAAa;EACb,4DAA4D;EAC5D,SAAS;AACX;;AAEA;EACE