or new fields */\\n.summary-modal-wide {\\n  max-width: 700px;\\n  width: 95%;\\n}\\n\\n.summary-form-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.summary-label {\\n  display: block;\\n  margin-bottom: 0.5rem;\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n}\\n\\n.summary-label .required {\\n  color: #ff6b6b;\\n}\\n\\n.summary-label .optional {\\n  color: var(--lines-text-muted);\\n  font-weight: normal;\\n  font-size: 0.85rem;\\n}\\n\\n.summary-title-input {\\n  width: 100%;\\n  padding: 0.75rem;\\n  border: 1px solid var(--lines-border);\\n  border-radius: 6px;\\n  background: var(--lines-surface);\\n  color: var(--lines-text);\\n  font-size: 1rem;\\n}\\n\\n.summary-title-input:focus {\\n  outline: none;\\n  border-color: var(--lines-accent);\\n  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);\\n}\\n\\n.summary-title-input:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.summary-focus-input {\\n  width: 100%;\\n  padding: 0.75rem;\\n  border: 1px solid var(--lines-border);\\n  border-radius: 6px;\\n  background: var(--lines-surface);\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  font-family: inherit;\\n  resize: vertical;\\n  min-height: 60px;\\n}\\n\\n.summary-focus-input:focus {\\n  outline: none;\\n  border-color: var(--lines-accent);\\n  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);\\n}\\n\\n.summary-focus-input:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.summary-content .saved-indicator {\\n  color: var(--lines-success);\\n  font-size: 0.9rem;\\n  font-weight: normal;\\n}\\n\\n/* Saved summaries list */\\n.saved-summaries-section {\\n  margin-top: 1.5rem;\\n  padding-top: 1rem;\\n  border-top: 1px solid var(--lines-border);\\n}\\n\\n.saved-summaries-section h4 {\\n  margin: 0 0 0.75rem 0;\\n  color: var(--lines-text-muted);\\n  font-size: 0.95rem;\\n}\\n\\n.saved-summaries-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n  max-height: 200px;\\n  overflow-y: auto;\\n}\\n\\n.saved-