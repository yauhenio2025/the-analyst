\\n\\n---\\n\\n' + f.passage_two,\n        suggested: f.suggested_revision,\n        label: 'Conflicting Passages'\n      };\n    case 'logic_gap':\n      return {\n        current: f.vulnerable_passage || f.premise,\n        suggested: f.suggested_revision\n      };\n    case 'unanswered':\n      return {\n        current: f.subject_point,\n        suggested: f.suggested_revision,\n        label: 'Point to Address'\n      };\n    case 'overconcession':\n      return {\n        current: f.concession_passage,\n        suggested: f.suggested_revision\n      };\n    case 'overreach':\n      return {\n        current: f.overreach_passage,\n        suggested: f.defensible_version || f.suggested_revision\n      };\n    case 'undercitation':\n      return {\n        current: f.vulnerable_passage,\n        suggested: f.suggested_revision\n      };\n    case 'weak_authority':\n      return {\n        current: f.authority_passage,\n        suggested: f.suggested_revision\n      };\n    case 'exposed_flank':\n      return {\n        current: f.vulnerable_passage,\n        suggested: f.suggested_revision\n      };\n    default:\n      return {\n        current: f.vulnerable_passage || '',\n        suggested: f.suggested_revision || ''\n      };\n  }\n};\n\n/**\n * Build a deep-link URL from Arsenal back to the analysis view + section.\n * Returns null if the snapshot doesn't have enough info to build a link.\n */\nfunction buildSourceDeepLink(projectId, snapshot) {\n  var _snapshot$parent_cont;\n  if (!snapshot.source_view_key) return null;\n  const wfKey = snapshot.workflow_key || 'intellectual_genealogy';\n  const params = new URLSearchParams();\n  params.set('view', snapshot.source_view_key);\n  const sectionKey = snapshot.source_section_key || ((_snapshot$parent_cont = snapshot.parent_context) === null || _snapshot$parent_cont === void 0 ? void 0 : _snapshot$parent_cont.section_key);\n  if (sectionKey) params.set('section', sectionKey);\n  return `/p/${projectId}/analysis/$