;EAC1C,mCAAmC;AACrC;;AAEA;EACE,wCAAwC;EACxC,0CAA0C;EAC1C,YAAY;AACd;;AAEA,+BAA+B;AAC/B;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,SAAS;EACT,mBAAmB;AACrB;;AAEA;EACE,SAAO;EACP,gBAAgB;AAClB;;AAEA,qBAAqB;AACrB;EACE,aAAa;EACb,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,eAAe;EACf,yBAAyB;EACzB,8CAA8C;AAChD;;AAEA;EACE,uCAAuC;EACvC,qCAAqC;AACvC;;AAEA;EACE,uCAAuC;EACvC,mCAAmC;EACnC,qBAAqB;AACvB;;AAEA;EACE,uCAAuC;EACvC,qCAAqC;AACvC;;AAEA;EACE,uCAAuC;EACvC,mCAAmC;EACnC,qBAAqB;AACvB;;AAEA,wBAAwB;AACxB;EACE,0CAA0C;AAC5C;;AAEA;EACE,0CAA0C;EAC1C,uCAAuC;AACzC;;AAEA,oBAAoB;AACpB;EACE,uCAAuC;EACvC,8CAA8C;EAC9C,mDAAmD;EACnD,kBAAkB;EAClB,aAAa;EACb,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,mCAAmC;AACrC;;AAEA;EACE,SAAS;EACT,eAAe;EACf,mCAAmC;EACnC,gBAAgB;AAClB;;AAEA;EACE,2BAA2B;EAC3B,iBAAiB;EACjB,kDAAkD;AACpD;;AAEA;EACE,qCAAqC;EACrC,eAAe;EACf,yBAAyB;EACzB,qBAAqB;AACvB;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,0BAA0B;AAC5B;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,0BAA0B;AAC5B;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,0BAA0B;AAC5B;;AAEA,yBAAyB;AACzB;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,kBAAkB;EAClB,uCAAuC;EACvC,8CAA8C;EAC9C,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,0CAA0C;EAC1C,6BAA6B;AAC/B;;AAEA;EACE,eAAe;EACf,mCAAmC;AACrC;;AAEA,eAAe;AACf;EACE;IACE,sBAAsB;EACxB;;EAEA;IACE,WAAW;IACX,iBAAiB;IACjB,kBAAkB;IAClB,qDAAqD;EACvD;AACF\",\"sourcesContent\":[\"/* DualAxisView Styles */\\n\\n.dual-axis-view {\\n  display: flex;\\n  flex-direction: column;\\n  height: 100%;\\n  background: var(--bg-primary, #faf8f5);\\n}\\n\\n.view-header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  padding: 16px 20px;\\n  background: var(--card-bg, #ffffff);\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n  gap: 16px;\\n}\\n\\n.back-btn {\\n  background: var(--bg-elevated, #f5f3f0);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  color: var(--text-secondary, #757575);\\n  padding: 8px 16px;\\n  border-radius: 6px;\\n  font-size: 13px;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.back-btn:hover {\\n  background: var(--bg-tertiary, #e0ddd8);\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.header-content {\\n  flex: 1;\\n  display: flex;\\n  align-items: center;\\n  gap: 24px;\\n}\\n\\n.header-content h2 {\\n  margin: 0;\\n  font-size: 18px;\\n  font-weight: 600;\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.view-tabs {\\n  display: flex;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-radius: 6px;\\n  padding: 3px;\\n}\\n\\n.view-tab {\\n  padding: 8px 16px;\\n  background: none;\\n  border: none;\\n  font-size: 13px;\\n  font-weight: 500;\\n  color: var(--text-secondary, #757575);\\n  cursor: pointer;\\n  border-radius: 4px;\\n  transition: all 0.2s ease;\\n}\\n\\n.view-tab:hover {\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.view-tab.active {\\n  background: var(--accent-color, #b5343a);\\n  color: white;\\n}\\n\\n.analyze-btn {\\n  background: var(--accent-color, #b5343a);\\n  border: none;\\n  color: white;\\n  padding: 10px 20px;\\n  border-radius: 6px;\\n  font-size: 13px;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.analyze-btn:hover:not(:disabled) {\\n  background: var(--accent-hover, #9a2c31);\\n}\\n\\n.analyze-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.analysis-progress {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 12px 20px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.progress-indicator {\\n  width: 16px;\\n  height: 16px;\\n  border: 2px solid var(--accent-color, #b5343a);\\n  border-top-color: transparent;\\n  border-radius: 50%;\\n  animation: spin 1s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to { transform: rotate(360deg); }\\n}\\n\\n.analysis-progress span {\\n  font-size: 13px;\\n  color: var(--accent-color, #b5343a);\\n}\\n\\n.error-banner {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  padding: 12px 20px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n  color: #8a4a4a;\\n  font-size: 13px;\\n}\\n\\n.error-banner button {\\n  background: none;\\n  border: 1px solid #8a4a4a;\\n  color: #8a4a4a;\\n  padding: 4px 12px;\\n  border-radius: 4px;\\n  font-size: 12px;\\n  cursor: pointer;\\n}\\n\\n.error-banner button:hover {\\n  background: rgba(138, 74, 74, 0.1);\\n}\\n\\n.view-content {\\n  display: flex;\\n  flex: 1;\\n  overflow: hidden;\\n}\\n\\n.navigator-panel {\\n  width: 360px;\\n  flex-shrink: 0;\\n  overflow-y: auto;\\n  padding: 16px;\\n  border-right: 1px solid var(--border-color, #e0ddd8);\\n  background: var(--bg-elevated, #f5f3f0);\\n}\\n\\n.detail-panel {\\n  flex: 1;\\n  min-width: 500px;  /* Prevent collapse when showing empty state */\\n  overflow: hidden;  /* Let child handle its own scrolling */\\n  padding: 16px;\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n.empty-detail {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  height: 100%;\\n  color: var(--text-secondary, #757575);\\n}\\n\\n.empty-detail p {\\n  font-size: 14px;\\n  text-align: center;\\n}\\n\\n/* Sin Type Content Styles */\\n.sin-type-content {\\n  background: var(--card-bg, #ffffff);\\n  border-radius: 8px;\\n  padding: 20px;\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  flex: 1;\\n  display: flex;\\n  flex-direction: column;\\n  overflow-y: auto;\\n}\\n\\n.sin-type-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 16px;\\n  padding-bottom: 16px;\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.sin-type-info {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n}\\n\\n.sin-indicator {\\n  width: 16px;\\n  height: 16px;\\n  border-radius: 4px;\\n}\\n\\n.sin-type-header h3 {\\n  margin: 0;\\n  font-size: 18px;\\n  font-weight: 600;\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.findings-count {\\n  font-size: 13px;\\n  color: var(--text-secondary, #757575);\\n  background: var(--bg-elevated, #f5f3f0);\\n  padding: 4px 12px;\\n  border-radius: 4px;\\n}\\n\\n.sin-description {\\n  font-size: 14px;\\n  color: var(--text-primary, #1a1a1a);\\n  margin: 0 0 12px 0;\\n  line-height: 1.5;\\n}\\n\\n.sin-detection {\\n  font-size: 13px;\\n  color: var(--text-secondary, #757575);\\n  margin: 0 0 12px 0;\\n  padding: 12px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-radius: 6px;\\n  border-left: 3px solid var(--accent-color, #b5343a);\\n}\\n\\n.sin-detection strong {\\n  color: var(--text-tertiary, #9a9a9a);\\n}\\n\\n.bloom-reference {\\n  font-size: 12px;\\n  color: var(--text-tertiary, #9a9a9a);\\n  font-style: italic;\\n  margin: 0 0 20px 0;\\n}\\n\\n.sin-findings-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n  margin-top: 20px;\\n}\\n\\n.sin-type-content .finding-card {\\n  background: var(--bg-surface, #ffffff);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  border-radius: 0;\\n  padding: 16px;\\n}\\n\\n.sin-type-content .finding-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  margin-bottom: 12px;\\n}\\n\\n.sin-type-content .finding-title {\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.severity-badge {\\n  font-size: 10px;\\n  font-weight: 700;\\n  color: white;\\n  padding: 3px 8px;\\n  border-radius: 4px;\\n  text-transform: uppercase;\\n}\\n\\n.sin-type-content .finding-description {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.6;\\n  margin-bottom: 16px;\\n}\\n\\n.finding-evidence {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n  margin-bottom: 12px;\\n}\\n\\n.finding-evidence .evidence-block {\\n  padding: 12px;\\n  border-radius: 6px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-left: 3px solid var(--accent-color, #b5343a);\\n}\\n\\n.finding-evidence .evidence-block.source {\\n  border-left-color: #5a7a8a;\\n}\\n\\n.finding-evidence label {\\n  font-size: 10px;\\n  font-weight: 600;\\n  color: var(--text-tertiary, #9a9a9a);\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n  display: block;\\n  margin-bottom: 6px;\\n}\\n\\n.finding-evidence blockquote {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.5;\\n  margin: 0;\\n  font-style: italic;\\n}\\n\\n.finding-evidence cite {\\n  font-size: 11px;\\n  color: var(--text-tertiary, #9a9a9a);\\n  display: block;\\n  margin-top: 6px;\\n  font-style: normal;\\n}\\n\\n/* Expandable quotes button */\\n.expand-quotes-btn {\\n  background: transparent;\\n  border: none;\\n  color: var(--text-secondary, #757575);\\n  font-size: 11px;\\n  cursor: pointer;\\n  padding: 4px 8px;\\n  margin-top: 8px;\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n  transition: color 0.15s ease;\\n}\\n\\n.expand-quotes-btn:hover {\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n/* Additional quotes container */\\n.additional-quotes {\\n  margin-top: 8px;\\n  padding-left: 12px;\\n  border-left: 2px solid var(--border-color, #e0ddd8);\\n}\\n\\n.additional-quote {\\n  margin-bottom: 10px;\\n  opacity: 0.9;\\n}\\n\\n.additional-quote:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.additional-quote blockquote {\\n  font-size: 12px;\\n}\\n\\n.additional-quote cite {\\n  font-size: 10px;\\n}\\n\\n.finding-implication {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  padding: 12px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-radius: 6px;\\n  border-left: 3px solid #5a6b7a;\\n}\\n\\n.finding-implication strong {\\n  color: var(--text-tertiary, #9a9a9a);\\n  text-transform: uppercase;\\n  font-size: 10px;\\n  letter-spacing: 0.3px;\\n}\\n\\n/* Version Tabs for Deeper Dive */\\n.version-tabs {\\n  display: flex;\\n  gap: 8px;\\n  margin-bottom: 16px;\\n  padding: 12px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-radius: 8px;\\n}\\n\\n.version-tab {\\n  flex: 1;\\n  padding: 10px 16px;\\n  background: var(--bg-tertiary, #e0ddd8);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  border-radius: 6px;\\n  font-size: 13px;\\n  font-weight: 500;\\n  color: var(--text-secondary, #757575);\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.version-tab:hover {\\n  background: var(--bg-primary, #faf8f5);\\n  border-color: var(--accent-color, #b5343a);\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.version-tab.active {\\n  background: var(--accent-color, #b5343a);\\n  border-color: var(--accent-color, #b5343a);\\n  color: white;\\n}\\n\\n/* Version Controls Container */\\n.version-controls {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 16px;\\n  margin-bottom: 16px;\\n}\\n\\n.version-controls .version-tabs {\\n  flex: 1;\\n  margin-bottom: 0;\\n}\\n\\n/* Download Buttons */\\n.download-buttons {\\n  display: flex;\\n  gap: 8px;\\n}\\n\\n.download-btn {\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n  padding: 8px 12px;\\n  border-radius: 6px;\\n  font-size: 12px;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  border: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.download-btn.download-md {\\n  background: var(--bg-elevated, #f5f3f0);\\n  color: var(--text-secondary, #757575);\\n}\\n\\n.download-btn.download-md:hover {\\n  background: var(--bg-tertiary, #e0ddd8);\\n  color: var(--text-primary, #1a1a1a);\\n  border-color: #b5343a;\\n}\\n\\n.download-btn.download-pdf {\\n  background: var(--bg-elevated, #f5f3f0);\\n  color: var(--text-secondary, #757575);\\n}\\n\\n.download-btn.download-pdf:hover {\\n  background: var(--bg-tertiary, #e0ddd8);\\n  color: var(--text-primary, #1a1a1a);\\n  border-color: #b5343a;\\n}\\n\\n/* v2 download buttons */\\n.download-btn.v2 {\\n  border-color: var(--border-color, #e0ddd8);\\n}\\n\\n.download-btn.v2:hover {\\n  border-color: var(--accent-color, #b5343a);\\n  background: var(--bg-tertiary, #e0ddd8);\\n}\\n\\n/* Pattern Summary */\\n.pattern-summary {\\n  background: var(--bg-elevated, #f5f3f0);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  border-left: 4px solid var(--accent-color, #b5343a);\\n  border-radius: 8px;\\n  padding: 16px;\\n  margin-bottom: 16px;\\n}\\n\\n.pattern-summary h4 {\\n  margin: 0 0 12px 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: var(--accent-color, #b5343a);\\n}\\n\\n.pattern-summary p {\\n  margin: 0;\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.6;\\n}\\n\\n.cumulative-impact {\\n  margin-top: 12px !important;\\n  padding-top: 12px;\\n  border-top: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.cumulative-impact strong {\\n  color: var(--text-secondary, #757575);\\n  font-size: 11px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n}\\n\\n.impact-high {\\n  color: #8a4a4a;\\n  font-weight: 600;\\n  text-transform: capitalize;\\n}\\n\\n.impact-medium {\\n  color: #7a7a50;\\n  font-weight: 600;\\n  text-transform: capitalize;\\n}\\n\\n.impact-low {\\n  color: #5a7a60;\\n  font-weight: 600;\\n  text-transform: capitalize;\\n}\\n\\n/* Deeper Dive Progress */\\n.deeper-dive-progress {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 12px 16px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  border-radius: 8px;\\n  margin-bottom: 16px;\\n}\\n\\n.deeper-dive-progress .progress-indicator {\\n  border-color: var(--accent-color, #b5343a);\\n  border-top-color: transparent;\\n}\\n\\n.deeper-dive-progress span {\\n  font-size: 13px;\\n  color: var(--accent-color, #b5343a);\\n}\\n\\n/* Responsive */\\n@media (max-width: 1024px) {\\n  .view-content {\\n    flex-direction: column;\\n  }\\n\\n  .navigator-panel {\\n    width: 100%;\\n    max-height: 300px;\\n    border-right: none;\\n    border-bottom: 1px solid var(--border-color, #e0ddd8);\\n  }\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/influence/HelicopterDashboard.css\"\n/*!*****************************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/influence/HelicopterDashboard.css ***!\n  \\*****************************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PU