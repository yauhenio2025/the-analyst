gBAAgB;EAChB,iBAAiB;AACnB;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,YAAY;EACZ,gBAAgB;EAChB,kBAAkB;EAClB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,mCAAmC;EACnC,SAAO;AACT;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,YAAY;EACZ,gBAAgB;EAChB,kBAAkB;EAClB,yBAAyB;AAC3B;;AAEA;EACE,eAAe;EACf,oCAAoC;EACpC,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,cAAc;EACd,kDAAkD;AACpD;;AAEA;EACE,eAAe;EACf,mCAAmC;EACnC,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;EACT,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,kBAAkB;AACpB;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,oCAAoC;EACpC,yBAAyB;EACzB,qBAAqB;AACvB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,uCAAuC;EACvC,8CAA8C;EAC9C,mCAAmC;EACnC,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,uCAAuC;EACvC,0CAA0C;AAC5C;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,aAAa;EACb,kBAAkB;AACpB;;AAEA;EACE,uCAAuC;EACvC,mDAAmD;AACrD;;AAEA;EACE,uCAAuC;EACvC,8BAA8B;AAChC;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,oCAAoC;EACpC,cAAc;EACd,kBAAkB;EAClB,yBAAyB;EACzB,qBAAqB;AACvB;;AAEA;EACE,eAAe;EACf,mCAAmC;EACnC,gBAAgB;EAChB,SAAS;EACT,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,oCAAoC;EACpC,cAAc;EACd,eAAe;EACf,kBAAkB;AACpB;;AAEA;;EAEE,gBAAgB;AAClB;;AAEA;;EAEE,eAAe;EACf,gBAAgB;EAChB,oCAAoC;EACpC,cAAc;EACd,kBAAkB;EAClB,yBAAyB;EACzB,qBAAqB;AACvB;;AAEA;;EAEE,eAAe;EACf,mCAAmC;EACnC,gBAAgB;EAChB,SAAS;EACT,aAAa;EACb,uCAAuC;EACvC,kBAAkB;AACpB;;AAEA;EACE,mDAAmD;AACrD;;AAEA;EACE,8BAA8B;AAChC\",\"sourcesContent\":[\"/* ThemeSynthesisCard Styles */\\n\\n.theme-synthesis-card {\\n  background: var(--card-bg, #ffffff);\\n  border-radius: 8px;\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  overflow: hidden;\\n  display: flex;\\n  flex-direction: column;\\n  height: 100%;  /* Fill available space */\\n}\\n\\n.card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  padding: 16px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.header-content {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.centrality-badge {\\n  font-size: 10px;\\n  font-weight: 600;\\n  color: white;\\n  padding: 3px 8px;\\n  border-radius: 4px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n  width: fit-content;\\n}\\n\\n.card-header h3 {\\n  margin: 0;\\n  font-size: 16px;\\n  font-weight: 600;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.4;\\n}\\n\\n.close-btn {\\n  background: none;\\n  border: none;\\n  font-size: 24px;\\n  color: var(--text-secondary, #757575);\\n  cursor: pointer;\\n  padding: 0;\\n  line-height: 1;\\n  transition: color 0.2s ease;\\n}\\n\\n.close-btn:hover {\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.card-tabs {\\n  display: flex;\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.tab-btn {\\n  flex: 1;\\n  padding: 12px 16px;\\n  background: none;\\n  border: none;\\n  font-size: 13px;\\n  font-weight: 500;\\n  color: var(--text-secondary, #757575);\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 6px;\\n  border-bottom: 2px solid transparent;\\n  margin-bottom: -1px;\\n}\\n\\n.tab-btn:hover {\\n  background: var(--bg-elevated, #f5f3f0);\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.tab-btn.active {\\n  color: var(--accent-color, #b5343a);\\n  border-bottom-color: var(--accent-color, #b5343a);\\n  background: var(--bg-elevated, #f5f3f0);\\n}\\n\\n.tab-indicator {\\n  width: 8px;\\n  height: 8px;\\n  border-radius: 50%;\\n}\\n\\n.tab-count {\\n  font-size: 11px;\\n  background: var(--bg-tertiary, #e0ddd8);\\n  padding: 2px 6px;\\n  border-radius: 8px;\\n}\\n\\n.tab-btn.active .tab-count {\\n  background: var(--accent-color, #b5343a);\\n  color: white;\\n}\\n\\n/* Tab Content */\\n.tab-content {\\n  padding: 16px;\\n  flex: 1;  /* Fill remaining vertical space */\\n  overflow-y: auto;\\n  min-height: 0;  /* Allow flex shrinking for overflow to work */\\n}\\n\\n.tab-content.empty {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  min-height: 150px;\\n  color: var(--text-secondary, #757575);\\n}\\n\\n/* Overview Tab */\\n.section {\\n  margin-bottom: 20px;\\n}\\n\\n.section:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.section h4 {\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: var(--text-tertiary, #9a9a9a);\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  margin: 0 0 8px 0;\\n}\\n\\n.section p {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.6;\\n  margin: 0;\\n}\\n\\n.claims-list,\\n.commitments-list,\\n.moves-list {\\n  margin: 0;\\n  padding-left: 20px;\\n  list-style-type: disc;\\n}\\n\\n.claims-list li,\\n.commitments-list li,\\n.moves-list li {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.5;\\n  margin-bottom: 6px;\\n}\\n\\n.tensions-text {\\n  font-style: italic;\\n  color: var(--text-secondary, #757575);\\n}\\n\\n.source-tags {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 6px;\\n}\\n\\n.source-tag {\\n  font-size: 11px;\\n  background: var(--bg-tertiary, #e0ddd8);\\n  color: var(--text-secondary, #757575);\\n  padding: 4px 10px;\\n  border-radius: 4px;\\n}\\n\\n/* Engagement Tab */\\n.engagement-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  margin-bottom: 20px;\\n  padding-bottom: 16px;\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.engagement-level-badge {\\n  font-size: 11px;\\n  font-weight: 700;\\n  color: white;\\n  padding: 4px 12px;\\n  border-radius: 4px;\\n}\\n\\n.engagement-description {\\n  font-size: 13px;\\n  color: var(--text-secondary, #757575);\\n}\\n\\n.divergence-text {\\n  background: var(--bg-elevated, #f5f3f0);\\n  padding: 12px;\\n  border-radius: 6px;\\n  border-left: 3px solid var(--accent-color, #b5343a);\\n  font-size: 13px;\\n}\\n\\n.quotes-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.quote-item blockquote {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.6;\\n  margin: 0;\\n  padding: 12px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-left: 3px solid var(--accent-color, #b5343a);\\n  border-radius: 0 6px 6px 0;\\n}\\n\\n.quote-item cite {\\n  font-size: 11px;\\n  color: var(--text-tertiary, #9a9a9a);\\n  display: block;\\n  margin-top: 6px;\\n  font-style: normal;\\n}\\n\\n.severity-section {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n}\\n\\n.severity-badge {\\n  font-size: 10px;\\n  font-weight: 700;\\n  color: white;\\n  padding: 4px 10px;\\n  border-radius: 4px;\\n  text-transform: uppercase;\\n}\\n\\n.severity-note {\\n  font-size: 12px;\\n  color: var(--text-tertiary, #9a9a9a);\\n  font-style: italic;\\n}\\n\\n/* Findings Tab */\\n.findings-summary {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  margin-bottom: 16px;\\n  padding-bottom: 12px;\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.summary-count {\\n  font-size: 13px;\\n  font-weight: 600;\\n  color: var(--text-primary, #1a1a1a);\\n}\\n\\n.summary-types {\\n  display: flex;\\n  gap: 6px;\\n  flex-wrap: wrap;\\n}\\n\\n.type-chip {\\n  font-size: 10px;\\n  font-weight: 500;\\n  color: white;\\n  padding: 3px 8px;\\n  border-radius: 4px;\\n}\\n\\n.findings-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.finding-card {\\n  background: var(--bg-surface, #ffffff);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  border-radius: 0;\\n  overflow: hidden;\\n}\\n\\n.finding-card.expanded {\\n  border-color: var(--border-color, #e0ddd8);\\n}\\n\\n.finding-header {\\n  display: flex;\\n  width: 100%;\\n  padding: 12px;\\n  background: none;\\n  border: none;\\n  cursor: pointer;\\n  text-align: left;\\n}\\n\\n.finding-header:hover {\\n  background: var(--bg-elevated, #f5f3f0);\\n}\\n\\n.finding-header-content {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n  width: 100%;\\n}\\n\\n.finding-title-row {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n}\\n\\n.finding-preview {\\n  font-size: 12px;\\n  color: var(--text-secondary, #757575);\\n  line-height: 1.5;\\n  margin: 0;\\n  display: -webkit-box;\\n  -webkit-line-clamp: 2;\\n  -webkit-box-orient: vertical;\\n  overflow: hidden;\\n  padding-left: 1px;\\n}\\n\\n.sin-type-chip {\\n  font-size: 9px;\\n  font-weight: 600;\\n  color: white;\\n  padding: 3px 6px;\\n  border-radius: 3px;\\n  flex-shrink: 0;\\n}\\n\\n.finding-title {\\n  font-size: 13px;\\n  font-weight: 500;\\n  color: var(--text-primary, #1a1a1a);\\n  flex: 1;\\n}\\n\\n.severity-chip {\\n  font-size: 9px;\\n  font-weight: 600;\\n  color: white;\\n  padding: 2px 6px;\\n  border-radius: 3px;\\n  text-transform: uppercase;\\n}\\n\\n.expand-icon {\\n  font-size: 10px;\\n  color: var(--text-tertiary, #9a9a9a);\\n  margin-left: 8px;\\n}\\n\\n.finding-details {\\n  padding: 16px;\\n  padding-top: 0;\\n  border-top: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.finding-description {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.6;\\n  margin: 0 0 16px 0;\\n}\\n\\n.evidence-section {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n  margin-bottom: 16px;\\n}\\n\\n.evidence-section-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 4px;\\n}\\n\\n.evidence-section-header h5 {\\n  margin: 0;\\n  font-size: 11px;\\n  font-weight: 600;\\n  color: var(--text-tertiary, #9a9a9a);\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n}\\n\\n.deeper-dive-btn {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  color: var(--accent-color, #b5343a);\\n  padding: 5px 10px;\\n  border-radius: 4px;\\n  font-size: 12px;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.deeper-dive-btn:hover {\\n  background: var(--bg-tertiary, #e0ddd8);\\n  border-color: var(--accent-color, #b5343a);\\n}\\n\\n.deeper-dive-btn .btn-icon {\\n  font-size: 11px;\\n}\\n\\n.evidence-block {\\n  padding: 12px;\\n  border-radius: 6px;\\n}\\n\\n.evidence-block.subject {\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-left: 3px solid var(--accent-color, #b5343a);\\n}\\n\\n.evidence-block.source {\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-left: 3px solid #5a7a8a;\\n}\\n\\n.evidence-block label {\\n  font-size: 11px;\\n  font-weight: 600;\\n  color: var(--text-tertiary, #9a9a9a);\\n  display: block;\\n  margin-bottom: 6px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n}\\n\\n.evidence-block blockquote {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.5;\\n  margin: 0;\\n  font-style: italic;\\n}\\n\\n.evidence-block cite {\\n  font-size: 11px;\\n  color: var(--text-tertiary, #9a9a9a);\\n  display: block;\\n  margin-top: 8px;\\n  font-style: normal;\\n}\\n\\n.missing-section,\\n.implication-section {\\n  margin-top: 12px;\\n}\\n\\n.missing-section label,\\n.implication-section label {\\n  font-size: 11px;\\n  font-weight: 600;\\n  color: var(--text-tertiary, #9a9a9a);\\n  display: block;\\n  margin-bottom: 6px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n}\\n\\n.missing-section p,\\n.implication-section p {\\n  font-size: 13px;\\n  color: var(--text-primary, #1a1a1a);\\n  line-height: 1.5;\\n  margin: 0;\\n  padding: 12px;\\n  background: var(--bg-tertiary, #e0ddd8);\\n  border-radius: 6px;\\n}\\n\\n.missing-section p {\\n  border-left: 3px solid var(--accent-color, #b5343a);\\n}\\n\\n.implication-section p {\\n  border-left: 3px solid #5a6b7a;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/provenance/provenance.css\"\n/*!*********************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/provenance/provenance.css ***!\n  \\*********************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../../../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/* ============= PROVENANCE OVERLAY ============= */\n/* Developer tool tracing data through the analysis pipeline.            */\n/* Design: minimal, monochrome with muted accent. Not a dashboard —     */\n/* a quiet overlay that stays out of the way until you need it.         */\n\n/* ── Toggle Button ── */\n\n.prov-toggle {\n  font-size: 0.78rem !important;\n  opacity: 0.55;\n  transition: opacity 0.15s;\n}\n\n.prov-toggle:hover {\n  opacity: 1;\n}\n\n.prov-toggle--active {\n  opacity: 1;\n  color: #b5343a !important;\n  font-weight: 600;\n}\n\n/* ═══════════════════════════════════════════════════\n   LAYER 1 — Summary Panel\n   ═══════════════════════════════════════════════════ */\n\n.prov-summary {\n  background: #faf9f7;\n  border: 1px solid #e8e5e1;\n  border-radius: 6px;\n  margin-bottom: 10px;\n  overflow: hidden;\n}\n\n.prov-summary--loading {\n  opacity: 0.6;\n}\n\n/* Header bar */\n\n.prov-summary__header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 14px;\n  cursor: pointer;\n  -webkit-user-select: none;\n          user-select: none;\n  background: #f3f1ed;\n  border-bottom: 1px solid transparent;\n  transition: background 0.15s;\n}\n\n.prov-summary__header:hover {\n  background: #ebe8e4;\n}\n\n.prov-summary--expanded .prov-summary__header {\n  border-bottom-color: #e8e5e1;\n}\n\n.prov-summary__toggle {\n  font-size: 9px;\n  color: #94a3b8;\n  width: 14px;\n  text-align: center;\n  transition: transform 0.2s;\n}\n\n.prov-summary--expanded .prov-summary__toggle {\n  transform: rotate(90deg);\n}\n\n.prov-summary__title {\n  font-size: 11px;\n  font-weight: 600;\n  color: #64748b;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.prov-summary__loading-text {\n  font-size: 11px;\n  color: #94a3b8;\n  font-style: italic;\n}\n\n.prov-summary__stats {\n  font-size: 11px;\n  color: #94a3b8;\n  margin-left: auto;\n  display: flex;\n  gap: 14px;\n}\n\n.prov-stat {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n}\n\n.prov-stat__value {\n  font-weight: 600;\n  color: #64748b;\n  font-variant-numeric: tabular-nums;\n}\n\n/* Body */\n\n.prov-summary__body {\n  padding: 10px 14px 12px;\n}\n\n.prov-summary__empty {\n  font-size: 11px;\n  color: #94a3b8;\n  font-style: italic;\n}\n\n/* ── Phase Table ── */\n\n.prov-phase-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 11px;\n}\n\n.prov-phase-table th {\n  font-size: 9px;\n  font-weight: 600;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  text-align: left;\n  padding: 0 8px 5px;\n  border-bottom: 1px solid #e8e5e1;\n}\n\n.prov-phase-table td {\n  padding: 6px 8px;\n  color: #475569;\n  border-bottom: 1px solid #f0ede9;\n  vertical-align: middle;\n}\n\n.prov-phase-table tr:last-child td {\n  border-bottom: none;\n}\n\n.prov-phase--skipped td {\n  opacity: 0.35;\n}\n\n.prov-phase-num {\n  font-weight: 700;\n  color: #94a3b8;\n  font-size: 10px;\n  margin-right: 6px;\n  font-variant-numeric: tabular-nums;\n}\n\n.prov-phase-name {\n  color: #334155;\n  font-weight: 500;\n}\n\n.prov-phase-tag {\n  font-size: 9px;\n  color: #b45309;\n  background: rgba(245, 158, 11, 0.1);\n  padding: 1px 4px;\n  border-radius: 3px;\n  margin-left: 6px;\n  font-weight: 500;\n  vertical-align: middle;\n}\n\n/* Duration + token columns */\n\n.prov-phase-duration,\n.prov-phase-tokens {\n  font-variant-numeric: tabular-nums;\n  font-size: 10px;\n  color: #64748b;\n  white-space: nowrap;\n}\n\n.prov-phase-no-engines {\n  color: #cbd5e1;\n  font-style: italic;\n  font-size: 10px;\n}\n\n/* Depth badges */\n\n.prov-depth {\n  font-size: 9px;\n  padding: 1px 5px;\n  border-radius: 3px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n}\n\n.prov-depth--surface {\n  background: rgba(148, 163, 184, 0.12);\n  color: #94a3b8;\n}\n\n.prov-depth--standard {\n  background: rgba(59, 130, 246, 0.08);\n  color: #6b93d6;\n}\n\n.prov-depth--deep {\n  background: rgba(139, 92, 246, 0.08);\n  color: #9b7ed8;\n}\n\n/* Model badges */\n\n.prov-model {\n  font-size: 9px;\n  padding: 1px 5px;\n  border-radius: 3px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n}\n\n.prov-model--opus {\n  background: rgba(181, 52, 58, 0.08);\n  color: #c06065;\n}\n\n.prov-model--sonnet {\n  background: rgba(59, 130, 246, 0.08);\n  color: #6b93d6;\n}\n\n.prov-model--gemini {\n  background: rgba(66, 133, 244, 0.12);\n  color: #4285f4;\n}\n\n.prov-model--openrouter {\n  background: rgba(16, 185, 129, 0.1);\n  color: #34d399;\n}\n\n.prov-model--haiku {\n  background: rgba(139, 92, 246, 0.08);\n  color: #a78bfa;\n}\n\n/* Model pill in ProvenanceBadge */\n.prov-pill--model {\n  font-weight: 600;\n  font-size: 9px;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.prov-pill--model-gemini {\n  background: rgba(66, 133, 244, 0.15);\n  color: #4285f4;\n  border-color: rgba(66, 133, 244, 0.25);\n}\n\n.prov-pill--model-opus {\n  background: rgba(181, 52, 58, 0.12);\n  color: #c06065;\n  border-color: rgba(181, 52, 58, 0.25);\n}\n\n/* OpenRouter model names (e.g. deepseek-r1, qwen-3-235b) */\n[class*=\"prov-pill--model-deepseek\"],\n[class*=\"prov-pill--model-qwen\"],\n[class*=\"prov-pill--model-llama\"] {\n  background: rgba(16, 185, 129, 0.12);\n  color: #34d399;\n  border-color: rgba(16, 185, 129, 0.25);\n}\n\n/* Engine column */\n\n.prov-phase-engines {\n  max-width: 480px;\n}\n\n.prov-phase-chain-label {\n  font-size: 10px;\n  font-weight: 600;\n  color: #64748b;\n  display: block;\n  margin-bottom: 3px;\n}\n\n.prov-phase-blend {\n  font-weight: 400;\n  color: #94a3b8;\n  font-size: 9px;\n  margin-left: 3px;\n}\n\n.prov-engine-flow {\n  display: flex;\n  align-items: center;\n  gap: 0;\n  flex-wrap: wrap;\n}\n\n.prov-engine-chip {\n  font-size: 10px;\n  color: #64748b;\n  text-decoration: none;\n  padding: 1px 6px;\n  border-radius: 3px;\n  background: rgba(0, 0, 0, 0.03);\n  border: 1px solid rgba(0, 0, 0, 0.06);\n  transition: background 0.12s, color 0.12s;\n  white-space: nowrap;\n}\n\n.prov-engine-chip:hover {\n  background: rgba(181, 52, 58, 0.06);\n  color: #b5343a;\n  border-color: rgba(181, 52, 58, 0.15);\n}\n\n.prov-flow-dot {\n  width: 3px;\n  height: 3px;\n  border-radius: 50%;\n  background: #cbd5e1;\n  margin: 0 4px;\n  flex-shrink: 0;\n}\n\n/* ═══════════════════════════════════════════════════\n   LAYER 2 — Per-View Badge\n   ═══════════════════════════════════════════════════ */\n\n.prov-badge2 {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 8px;\n  margin-bottom: 8px;\n  background: #f8f7f5;\n  border: 1px solid #ece9e4;\n  border-radius: 5px;\n  flex-wrap: wrap;\n  min-height: 24px;\n}\n\n/* Subtle separator dot between pill groups */\n.prov-badge2__sep {\n  width: 3px;\n  height: 3px;\n  border-radius: 50%;\n  background: #d4d0cb;\n  flex-shrink: 0;\n}\n\n/* Pills — uniform shape, different tints */\n\n.prov-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 10px;\n  font-weight: 500;\n  padding: 2px 7px;\n  border-radius: 3px;\n  text-decoration: none;\n  white-space: nowrap;\n  transition: opacity 0.12s;\n  line-height: 1.3;\n}\n\n.prov-pill:hover {\n  opacity: 0.75;\n}\n\n/* Source (chain or engine) — warm accent */\n.prov-pill--source {\n  background: rgba(181, 52, 58, 0.07);\n  color: #9b4049;\n  border: 1px solid rgba(181, 52, 58, 0.12);\n  font-weight: 600;\n}\n\n/* Chain toggle — clickable to expand/collapse engine list */\n.prov-pill--chain-toggle {\n  cursor: pointer;\n  -webkit-user-select: none;\n          user-select: none;\n}\n\n.prov-pill--chain-toggle:hover {\n  background: rgba(181, 52, 58, 0.12);\n  opacity: 1;\n}\n\n.prov-pill__chevron {\n  font-size: 9px;\n  opacity: 0.5;\n  transition: transform 0.15s;\n  display: inline-block;\n}\n\n.prov-pill__chevron--open {\n  transform: rotate(90deg);\n}\n\n.prov-pill__icon {\n  font-size: 9px;\n  opacity: 0.6;\n}\n\n.prov-pill__count {\n  font-size: 9px;\n  background: rgba(181, 52, 58, 0.1);\n  color: #b5343a;\n  padding: 0 4px;\n  border-radius: 2px;\n  font-weight: 700;\n  margin-left: 1px;\n}\n\n/* Inline chain engines (unfurled state) */\n.prov-chain-engines {\n  display: inline-flex;\n  align-items: center;\n  gap: 0;\n  flex-wrap: wrap;\n  margin-left: 2px;\n}\n\n.prov-chain-arrow {\n  color: #cbd5e1;\n  font-size: 10px;\n  margin: 0 3px;\n  flex-shrink: 0;\n}\n\n/* Phase — neutral */\n.prov-pill--phase {\n  background: rgba(100, 116, 139, 0.08);\n  color: #64748b;\n  font-weight: 700;\n  font-size: 9px;\n  font-variant-numeric: tabular-nums;\n}\n\n.prov-pill__phase-name {\n  font-weight: 500;\n  margin-left: 3px;\n  opacity: 0.75;\n}\n\n/* Renderer — cool */\n.prov-pill--renderer {\n  background: rgba(139, 92, 246, 0.06);\n  color: #7c6bad;\n  border: 1px solid rgba(139, 92, 246, 0.1);\n}\n\n/* Extraction — warm-neutral */\n.prov-pill--extraction {\n  background: rgba(245, 158, 11, 0.06);\n  color: #a37729;\n}\n\n/* View key — blue-gray */\n.prov-pill--view {\n  background: rgba(59, 130, 246, 0.05);\n  color: #6b8cba;\n  border: 1px solid rgba(59, 130, 246, 0.08);\n  font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;\n  font-size: 9.5px;\n}\n\n/* Stance — uses existing stance-pill colors */\n.prov-pill--stance {\n  font-size: 9px;\n  padding: 2px 6px;\n  border-radius: 8px;\n  font-weight: 600;\n  text-transform: capitalize;\n}\n\n/* Data quality — teal tint */\n.prov-pill--quality {\n  background: rgba(20, 184, 166, 0.06);\n  color: #0d9488;\n  font-size: 9px;\n}\n\n/* Quality degraded */\n.prov-pill--quality-thin {\n  background: rgba(234, 179, 8, 0.08);\n  color: #a37729;\n  font-weight: 600;\n}\n\n.prov-pill--quality-empty {\n  background: rgba(239, 68, 68, 0.06);\n  color: #b95050;\n  font-weight: 600;\n}\n\n/* ═══════════════════════════════════════════════════\n   LAYER 3 — Section Icon + Popover\n   ═══════════════════════════════════════════════════ */\n\n.prov-section-icon {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  cursor: pointer;\n  margin-left: 6px;\n}\n\n.prov-section-icon__glyph {\n  font-size: 14px;\n  color: #94a3b8;\n  transition: color 0.15s;\n  line-height: 1;\n}\n\n.prov-section-icon:hover .prov-section-icon__glyph {\n  color: #b5343a;\n}\n\n/* Popover — right-aligned since icons are on the right side */\n\n.prov-section-popover {\n  position: absolute;\n  top: calc(100% + 4px);\n  right: 0;\n  z-index: 100;\n  background: #ffffff;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);\n  padding: 10px 14px;\n  min-width: 220px;\n  max-width: 340px;\n}\n\n.prov-section-popover__row {\n  display: flex;\n  align-items: baseline;\n  gap: 6px;\n  margin-bottom: 5px;\n  font-size: 11px;\n}\n\n.prov-section-popover__row:last-child {\n  margin-bottom: 0;\n}\n\n.prov-section-popover__label {\n  font-weight: 600;\n  color: #94a3b8;\n  font-size: 9px;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  white-space: nowrap;\n  min-width: 72px;\n}\n\n.prov-section-popover__code {\n  font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;\n  font-size: 10.5px;\n  color: #334155;\n  background: #f5f3f0;\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n\n.prov-section-popover__link {\n  color: #9b4049;\n  text-decoration: none;\n  border-bottom: 1px dotted rgba(181, 52, 58, 0.25);\n  font-size: 10.5px;\n}\n\n.prov-section-popover__link:hover {\n  border-bottom-style: solid;\n  border-bottom-color: #b5343a;\n}\n\n.prov-section-popover__chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 3px;\n}\n\n.prov-section-popover__chip {\n  font-size: 9.5px;\n  padding: 1px 5px;\n  border-radius: 3px;\n  background: #f5f3f0;\n  color: #64748b;\n  font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;\n}\n\n/* ═══════════════════════════════════════════════════\n   DECISION RATIONALE — Collapsible section in Summary\n   ═══════════════════════════════════════════════════ */\n\n.prov-decision-rationale {\n  margin-top: 10px;\n  border-top: 1px solid #e8e5e1;\n}\n\n.prov-decision-rationale__header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 7px 0;\n  cursor: pointer;\n  -webkit-user-select: none;\n          user-select: none;\n  transition: opacity 0.15s;\n}\n\n.prov-decision-rationale__header:hover {\n  opacity: 0.8;\n}\n\n.prov-decision-rationale__title {\n  font-size: 10px;\n  font-weight: 600;\n  color: #7c6bad;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.prov-decision-rationale__body {\n  padding: 0 0 4px;\n}\n\n.prov-decision-rationale__strategy {\n  font-size: 11px;\n  color: #475569;\n  line-height: 1.5;\n  margin: 0 0 10px;\n  padding: 6px 10px;\n  background: rgba(139, 92, 246, 0.04);\n  border-left: 2px solid rgba(139, 92, 246, 0.2);\n  border-radius: 0 4px 4px 0;\n}\n\n.prov-decision-rationale__phases {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n/* Individual phase decision (uses <details>) */\n\n.prov-decision-phase {\n  border-radius: 4px;\n}\n\n.prov-decision-phase[open] {\n  background: rgba(0, 0, 0, 0.015);\n}\n\n.prov-decision-phase__summary {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 6px;\n  cursor: pointer;\n  font-size: 11px;\n  border-radius: 4px;\n  transition: background 0.12s;\n  list-style: none;\n}\n\n.prov-decision-phase__summary::-webkit-details-marker {\n  display: none;\n}\n\n.prov-decision-phase__summary::marker {\n  content: '';\n}\n\n.prov-decision-phase__summary:hover {\n  background: rgba(0, 0, 0, 0.03);\n}\n\n.prov-decision-phase__engine {\n  font-size: 9px;\n  color: #7c6bad;\n  background: rgba(139, 92, 246, 0.06);\n  padding: 1px 5px;\n  border-radius: 3px;\n  font-weight: 600;\n  margin-left: auto;\n  white-space: nowrap;\n}\n\n.prov-decision-phase__details {\n  padding: 4px 10px 8px 28px;\n  font-size: 11px;\n  color: #475569;\n  line-height: 1.5;\n}\n\n.prov-decision-phase__details p {\n  margin: 0 0 4px;\n}\n\n.prov-decision-phase__details strong {\n  color: #64748b;\n  font-weight: 600;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n}\n\n.prov-decision-phase__alts {\n  margin-top: 4px;\n}\n\n.prov-decision-phase__alts strong {\n  display: block;\n  margin-bottom: 2px;\n}\n\n.prov-decision-phase__alts ul {\n  margin: 0;\n  padding-left: 16px;\n}\n\n.prov-decision-phase__alts li {\n  font-size: 10px;\n  color: #64748b;\n  margin-bottom: 1px;\n}\n\n/* ── Why? pill (per-view badge) ── */\n\n.prov-pill--why {\n  background: rgba(139, 92, 246, 0.08);\n  color: #7c6bad;\n  border: 1px solid rgba(139, 92, 246, 0.15);\n  font-weight: 600;\n  font-size: 9px;\n  cursor: help;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/provenance/provenance.css\"],\"names\":[],\"mappings\":\"AAAA,mDAAmD;AACnD,0EAA0E;AAC1E,yEAAyE;AACzE,yEAAyE;;AAEzE,wBAAwB;;AAExB;EACE,6BAA6B;EAC7B,aAAa;EACb,yBAAyB;AAC3B;;AAEA;EACE,UAAU;AACZ;;AAEA;EACE,UAAU;EACV,yBAAyB;EACzB,gBAAgB;AAClB;;AAEA;;wDAEwD;;AAExD;EACE,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,mBAAmB;EACnB,gBAAgB;AAClB;;AAEA;EACE,YAAY;AACd;;AAEA,eAAe;;AAEf;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,eAAe;EACf,yBAAiB;UAAjB,iBAAiB;EACjB,mBAAmB;EACnB,oCAAoC;EACpC,4BAA4B;AAC9B;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,4BAA4B;AAC9B;;AAEA;EACE,cAAc;EACd,cAAc;EACd,WAAW;EACX,kBAAkB;EAClB,0BAA0B;AAC5B;;AAEA;EACE,wBAAwB;AAC1B;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc