ba(244, 162, 97, 0.1)',\n    theorists: ['Markus', 'Joas', 'Dewey'],\n    description: 'Analyzes through creative action and technical normativity'\n  }\n};\n/**\n * Get a paradigm definition by key, with fallback for unknown paradigms.\n */\nfunction getParadigmDefinition(paradigmKey) {\n  if (paradigmKey in PARADIGM_DEFINITIONS) {\n    return PARADIGM_DEFINITIONS[paradigmKey];\n  }\n  // Fallback for unknown paradigms\n  return {\n    id: paradigmKey,\n    name: paradigmKey.replace(/_/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase()),\n    shortName: paradigmKey.split('_')[0],\n    color: '#6b7280',\n    bgColor: 'rgba(107, 114, 128, 0.1)',\n    theorists: [],\n    description: 'Paradigm'\n  };\n}\n\n/**\n * Get all paradigm definitions as an array.\n */\nfunction getAllParadigmDefinitions() {\n  return Object.values(PARADIGM_DEFINITIONS);\n}\n\n/**\n * Analysis layer display names for the 6-pass structure.\n */\nconst ANALYSIS_LAYER_NAMES = {\n  foundational: 'Foundational',\n  structural: 'Structural',\n  dynamic: 'Dynamic',\n  explanatory: 'Explanatory',\n  critique: 'Critique',\n  synthesis: 'Synthesis'\n};\n/**\n * Layer descriptions for tooltips.\n */\nconst ANALYSIS_LAYER_DESCRIPTIONS = {\n  foundational: 'Core assumptions, tensions, and scope conditions',\n  structural: 'Primary entities, relations, and levels of analysis',\n  dynamic: 'Change mechanisms, temporal patterns, and transformation processes',\n  explanatory: 'Key concepts, analytical methods, and problem diagnosis',\n  critique: 'Critique pattern matches and suggested corrections',\n  synthesis: 'Paradigm-specific revelations, concealments, and key insights'\n};\n\nconst $ReactRefreshModuleId$ = __webpack_require__.$Refresh$.moduleId;\nconst $ReactRefreshCurrentExports$ = __react_refresh_utils__.getModuleExports(\n\t$ReactRefreshModuleId$\n);\n\nfunction $ReactRefreshModuleRuntime$(exports) {\n\tif (true) {\n\t\tlet errorOverlay;\n\t\tif (true) {\n\t\t\terrorOverlay = false;\n\t\t}\n\t\tlet test