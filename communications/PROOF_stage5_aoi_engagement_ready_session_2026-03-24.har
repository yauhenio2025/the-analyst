4px;\\n}\\n\\n.revise-modal .section:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.revise-modal .section h3 {\\n  margin: 0 0 12px 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: #4a4a4a;\\n}\\n\\n.revise-modal .section-header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  margin-bottom: 12px;\\n}\\n\\n.revise-modal .section-header h3 {\\n  margin: 0;\\n}\\n\\n.revise-modal .select-all-button {\\n  background: none;\\n  border: 1px solid #e0ddd8;\\n  color: #757575;\\n  font-size: 12px;\\n  padding: 4px 10px;\\n  border-radius: 4px;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.revise-modal .select-all-button:hover {\\n  border-color: #b5343a;\\n  color: #b5343a;\\n}\\n\\n/* Dives List */\\n.revise-modal .no-dives {\\n  padding: 20px;\\n  text-align: center;\\n  color: #666;\\n  background: #f5f3f0;\\n  border-radius: 8px;\\n}\\n\\n.revise-modal .dives-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  max-height: 200px;\\n  overflow-y: auto;\\n}\\n\\n.revise-modal .dive-item {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  padding: 12px;\\n  background: #f5f3f0;\\n  border-radius: 8px;\\n  border: 1px solid transparent;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.revise-modal .dive-item:hover {\\n  background: #f5f3f0;\\n}\\n\\n.revise-modal .dive-item.selected {\\n  border-color: #b5343a;\\n  background: rgba(99, 102, 241, 0.1);\\n}\\n\\n.revise-modal .dive-item input[type=\\\"checkbox\\\"] {\\n  margin-top: 2px;\\n  accent-color: #b5343a;\\n}\\n\\n.revise-modal .dive-info {\\n  flex: 1;\\n}\\n\\n.revise-modal .dive-header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  margin-bottom: 4px;\\n}\\n\\n.revise-modal .sin-type-name {\\n  font-size: 13px;\\n  font-weight: 600;\\n  color: #4a4a4a;\\n  text-transform: capitalize;\\n}\\n\\n.revise-modal .findings-count {\\n  font-size: 11px;\\n  color: #757575;\\n  background: #faf8f5;\\n  padding: 2px 6px;\\n  border-radius: 4px;\\n}\\n\\n.revise-modal .dive-meta {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-size: 11px;\\n  color: #666;\\n}\\n\\n.revise-modal .days-pending {\\n  color: #eab308;\\n}\\n\\n/* Mode Options */\\n.revise-modal .mode-options {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.revise-modal .mode-option {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  padding: 12px;\\n  background: #f5f3f0;\\n  border-radius: 8px;\\n  border: 1px solid transparent;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.revise-modal .mode-option:hover {\\n  background: #f5f3f0;\\n}\\n\\n.revise-modal .mode-option.selected {\\n  border-color: #b5343a;\\n  background: rgba(99, 102, 241, 0.1);\\n}\\n\\n.revise-modal .mode-option input[type=\\\"radio\\\"] {\\n  margin-top: 2px;\\n  accent-color: #b5343a;\\n}\\n\\n.revise-modal .mode-info {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.revise-modal .mode-name {\\n  font-size: 13px;\\n  font-weight: 600;\\n  color: #4a4a4a;\\n}\\n\\n.revise-modal .mode-description {\\n  font-size: 12px;\\n  color: #757575;\\n  line-height: 1.4;\\n}\\n\\n/* Guidance Input */\\n.revise-modal .guidance-input {\\n  width: 100%;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  padding: 12px;\\n  color: #4a4a4a;\\n  font-size: 13px;\\n  font-family: inherit;\\n  resize: vertical;\\n  transition: border-color 0.2s ease;\\n}\\n\\n.revise-modal .guidance-input::placeholder {\\n  color: #666;\\n}\\n\\n.revise-modal .guidance-input:focus {\\n  outline: none;\\n  border-color: #b5343a;\\n}\\n\\n/* Error Message */\\n.revise-modal .error-message {\\n  padding: 12px;\\n  background: rgba(239, 68, 68, 0.15);\\n  border: 1px solid rgba(239, 68, 68, 0.3);\\n  border-radius: 8px;\\n  color: #ef4444;\\n  font-size: 13px;\\n  margin-top: 16px;\\n}\\n\\n/* Footer */\\n.revise-modal .