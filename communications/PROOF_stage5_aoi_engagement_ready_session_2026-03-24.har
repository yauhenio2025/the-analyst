ss-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/* OutlineEditorPage - Full page styles */\n\n.outline-editor-page {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Override OutlineEditorPanel styles when in full page mode */\n.outline-editor-page .outline-editor-panel {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  max-width: none;\n  border-radius: 0;\n  box-shadow: none;\n  animation: none;\n}\n\n.outline-editor-page .outline-editor-panel-close {\n  display: none;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/OutlineEditorPage.css\"],\"names\":[],\"mappings\":\"AAAA,yCAAyC;;AAEzC;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,8DAA8D;AAC9D;EACE,kBAAkB;EAClB,WAAW;EACX,YAAY;EACZ,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,eAAe;AACjB;;AAEA;EACE,aAAa;AACf\",\"sourcesContent\":[\"/* OutlineEditorPage - Full page styles */\\n\\n.outline-editor-page {\\n  flex: 1;\\n  display: flex;\\n  flex-direction: column;\\n  overflow: hidden;\\n}\\n\\n/* Override OutlineEditorPanel styles when in full page mode */\\n.outline-editor-page .outline-editor-panel {\\n  position: relative;\\n  width: 100%;\\n  height: 100%;\\n  max-width: none;\\n  border-radius: 0;\\n  box-shadow: none;\\n  animation: none;\\n}\\n\\n.outline-editor-page .outline-editor-panel-close {\\n  display: none;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/ParadigmsPages.css\"\n/*!*********************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/ParadigmsPages.css ***!\n  \\*********************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/**\n * Paradigms Pages Styles\n *\n * Styling for multi-paradigm analysis pages including\n * selection, parallel column readings, and meta-analysis views.\n */\n\n/* ============= LAYOUT ============= */\n\n.paradigms-layout {\n  min-height: 100vh;\n  background: #faf8f5;\n  color: #4a4a4a;\n}\n\n.paradigms-selection,\n.paradigms-analysis {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 2rem;\n}\n\n.paradigms-selection.loading,\n.paradigms-analysis.loading,\n.paradigms-analysis.error {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 60vh;\n  gap: 1rem;\n}\n\n.loading-spinner {\n  width: 40px;\n  height: 40px;\n  border: 3px solid rgba(148, 163, 184, 0.3);\n  border-top-color: #b5343a;\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* ============= PAGE HEADER ============= */\n\n.page-header {\n  margin-bottom: 2rem;\n  text-align: center;\n}\n\n.page-header h1 {\n  font-size: 2rem;\n  font-weight: 700;\n  color: #1a1a1a;\n  margin: 0 0 0.5rem 0;\n}\n\n.page-subtitle {\n  color: #94a3b8;\n  font-size: 1.1rem;\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n/* ============= ERROR BANNER ============= */\n\n.error-banner {\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  color: #fca5a5;\n  padding: 1rem;\n  border-radius: 8px;\n  margin-bottom: 1.5rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.error-banner button {\n  background: none;\n  border: none;\n  color: #fca5a5;\n  cursor: pointer;\n  text-decoration: underline;\n}\n\n/* ============= PARADIGM GRID ============= */\n\n.paradigm-grid {\n  margin-bottom: 2rem;\n}\n\n.paradigm-grid h2 {\n  font-size: 1.25rem;\n  font-weight: 600;\n  margin-bottom: 1rem;\n  color: #1a1a1a;\n}\n\n.paradigm-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 1rem;\n}\n\n.paradigm-card {\n  background: #faf8f5;\n  border: 2px solid transparent;\n  border-radius: 12px;\n  padding: 1.25rem;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.paradigm-card:hover {\n  background: #757575;\n  border-color: var(--paradigm-color, #64748b);\n}\n\n.paradigm-card.selected {\n  background: var(--paradigm-bg, rgba(100, 116, 139, 0.1));\n  border-color: var(--paradigm-color, #64748b);\n}\n\n.card-header {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n.card-header input[type=\"checkbox\"] {\n  width: 20px;\n  height: 20px;\n  margin-top: 2px;\n  accent-color: var(--paradigm-color, #b5343a);\n}\n\n.card-header h3 {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.card-description {\n  font-size: 0.9rem;\n  color: #94a3b8;\n  margin: 0 0 0.75rem 0;\n  line-height: 1.5;\n}\n\n.card-theorists {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n}\n\n.theorist-tag {\n  background: rgba(148, 163, 184, 0.2);\n  color: #757575;\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  font-size: 0.8rem;\n}\n\n/* ============= MODE SELECTOR ============= */\n\n.analysis-options {\n  margin-bottom: 2rem;\n}\n\n.analysis-options h2 {\n  font-size: 1.25rem;\n  font-weight: 600;\n  margin-bottom: 1rem;\n  color: #1a1a1a;\n}\n\n.mode-selector {\n  display: flex;\n  gap: 1rem;\n}\n\n.mode-option {\n  flex: 1 1;\n  background: #faf8f5;\n  border: 2px solid transparent;\n  border-radius: 8px;\n  padding: 1rem;\n  cursor: pointer;\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  transition: all 0.2s ease;\n}\n\n.mode-option:hover {\n  background: #757575;\n}\n\n.mode-option.selected {\n  border-color: #b5343a;\n  background: rgba(59, 130, 246, 0.1);\n}\n\n.mode-option input[type=\"radio\"] {\n  margin-top: 3px;\n  accent-color: #b5343a;\n}\n\n.mode-content {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n}\n\n.mode-content strong {\n  color: #1a1a1a;\n}\n\n.mode-content span {\n  color: #94a3b8;\n  font-size: 0.9rem;\n}\n\n/* ============= RUN SECTION ============= */\n\n.run-section {\n  text-align: center;\n  margin-bottom: 2rem;\n}\n\n.run-analysis-btn {\n  background: #b5343a;\n  color: white;\n  border: none;\n  padding: 1rem 2rem;\n  font-size: 1.1rem;\n  font-weight: 600;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: background 0.2s ease;\n}\n\n.run-analysis-btn:hover:not(:disabled) {\n  background: #b5343a;\n}\n\n.run-analysis-btn:disabled {\n  background: #475569;\n  cursor: not-allowed;\n}\n\n.selection-hint {\n  color: #94a3b8;\n  font-size: 0.9rem;\n  margin-top: 0.5rem;\n}\n\n/* ============= RECENT JOBS ============= */\n\n.recent-jobs {\n  margin-top: 2rem;\n  padding-top: 2rem;\n  border-top: 1px solid #757575;\n}\n\n.recent-jobs h2 {\n  font-size: 1.25rem;\n  font-weight: 600;\n  margin-bottom: 1rem;\n  color: #1a1a1a;\n}\n\n.job-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.job-list li {\n  margin-bottom: 0.5rem;\n}\n\n.job-list a {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  background: #faf8f5;\n  padding: 0.75rem 1rem;\n  border-radius: 8px;\n  text-decoration: none;\n  color: inherit;\n  transition: background 0.2s ease;\n}\n\n.job-list a:hover {\n  background: #757575;\n}\n\n.job-paradigms {\n  flex: 1 1;\n  color: #1a1a1a;\n  font-weight: 500;\n}\n\n.job-status {\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  font-size: 0.8rem;\n  text-transform: capitalize;\n}\n\n.job-status.status-completed { background: rgba(34, 197, 94, 0.2); color: #86efac; }\n.job-status.status-running { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }\n.job-status.status-pending { background: rgba(234, 179, 8, 0.2); color: #fde047; }\n.job-status.status-failed { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }\n.job-status.status-cancelled { background: rgba(148, 163, 184, 0.2); color: #757575; }\n\n.job-date {\n  color: #64748b;\n  font-size: 0.9rem;\n}\n\n/* ============= ANALYSIS HEADER ============= */\n\n.analysis-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 1.5rem;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.back-link {\n  color: #94a3b8;\n  text-decoration: none;\n  font-size: 0.9rem;\n}\n\n.back-link:hover {\n  color: #1a1a1a;\n}\n\n.analysis-header h1 {\n  font-size: 1.5rem;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.cancel-btn {\n  background: rgba(239, 68, 68, 0.2);\n  color: #fca5a5;\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  padding: 0.5rem 1rem;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.cancel-btn:hover {\n  background: rgba(239, 68, 68, 0.3);\n}\n\n.meta-btn {\n  background: #faf8f5;\n  color: #4a4a4a;\n  border: 1px solid #757575;\n  padding: 0.5rem 1rem;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.meta-btn:hover,\n.meta-btn.active {\n  background: #757575;\n  border-color: #475569;\n}\n\n/* ============= PROGRESS BAR ============= */\n\n.progress-bar {\n  background: #faf8f5;\n  border-radius: 8px;\n  height: 32px;\n  position: relative;\n  overflow: hidden;\n  margin-bottom: 1.5rem;\n}\n\n.progress-fill {\n  background: linear-gradient(90deg, #b5343a, #8b5cf6);\n  height: 100%;\n  transition: width 0.3s ease;\n}\n\n.progress-text {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: #1a1a1a;\n  font-size: 0.9rem;\n  font-weight: 500;\n}\n\n/* ============= READINGS GRID ============= */\n\n.readings-grid {\n  display: grid;\n  grid-template-columns: repeat(var(--paradigm-count, 2), 1fr);\n  gap: 1rem;\n}\n\n@media (max-width: 1200px) {\n  .readings-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .readings-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.no-readings {\n  grid-column: 1 / -1;\n  text-align: center;\n  padding: 3rem;\n  color: #64748b;\n}\n\n/* ============= READING COLUMN ============= */\n\n.reading-column {\n  background: #faf8f5;\n  border-radius: 12px;\n  overflow: hidden;\n  border: 1px solid #757575;\n  min-width: 0; /* Prevent grid blowout from long content */\n}\n\n.column-header {\n  background: var(--paradigm-bg, rgba(100, 116, 139, 0.1));\n  padding: 1rem;\n  border-bottom: 1px solid var(--paradigm-color, #64748b);\n}\n\n.column-header h2 {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: var(--paradigm-color, #f1f5f9);\n  margin: 0 0 0.5rem 0;\n}\n\n.column-header .theorist-tags {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.column-header .theorist-tag {\n  background: rgba(0, 0, 0, 0.2);\n  font-size: 0.75rem;\n}\n\n.layers-container {\n  padding: 0.5rem;\n}\n\n/* ============= LAYER SECTION ============= */\n\n.layer-section {\n  border-radius: 8px;\n  margin-bottom: 0.5rem;\n  overflow: hidden;\n}\n\n.layer-header {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  background: rgba(51, 65, 85, 0.5);\n  border: none;\n  padding: 0.75rem 1rem;\n  color: #4a4a4a;\n  cursor: pointer;\n  text-align: left;\n  font-size: 0.9rem;\n  font-weight: 500;\n  transition: background 0.2s ease;\n}\n\n.layer-header:hover {\n  background: rgba(51, 65, 85, 0.8);\n}\n\n.layer-section.expanded .layer-header {\n  background: #757575;\n}\n\n.layer-name {\n  flex: 1 1;\n}\n\n.item-count {\n  background: rgba(148, 163, 184, 0.2);\n  color: #94a3b8;\n  padding: 0.125rem 0.5rem;\n  border-radius: 10px;\n  font-size: 0.8rem;\n}\n\n.expand-icon {\n  color: #64748b;\n  font-size: 0.75rem;\n}\n\n.layer-content {\n  padding: 1rem;\n  background: rgba(15, 23, 42, 0.5);\n  font-size: 0.9rem;\n  overflow-wrap: break-word;\n  word-break: break-word;\n}\n\n.layer-content .empty {\n  color: #64748b;\n  font-style: italic;\n}\n\n.layer-content .subsection {\n  margin-bottom: 1rem;\n}\n\n.layer-content .subsection:last-child {\n  margin-bottom: 0;\n}\n\n.layer-content h4 {\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #757575;\n  margin: 0 0 0.5rem 0;\n}\n\n.layer-content ul {\n  margin: 0;\n  padding-left: 1.25rem;\n}\n\n.layer-content li {\n  margin-bottom: 0.25rem;\n  color: #94a3b8;\n}\n\n.layer-content blockquote {\n  background: rgba(0, 0, 0, 0.2);\n  border-left: 3px solid var(--paradigm-color, #64748b);\n  margin: 0.5rem 0;\n  padding: 0.5rem 0.75rem;\n  color: #94a3b8;\n  font-size: 0.85rem;\n  font-style: italic;\n}\n\n/* ============= CRITIQUE CONTENT ============= */\n\n.pattern-match {\n  background: rgba(0, 0, 0, 0.2);\n  border-radius: 6px;\n  padding: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n.match-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 0.5rem;\n}\n\n.match-header strong {\n  color: #1a1a1a;\n}\n\n.severity-badge {\n  padding: 0.125rem 0.5rem;\n  border-radius: 4px;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n}\n\n.severity-badge.high { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }\n.severity-badge.medium { background: rgba(234, 179, 8, 0.2); color: #fde047; }\n.severity-badge.low { background: rgba(34, 197, 94, 0.2); color: #86efac; }\n\n.diagnostic {\n  color: #94a3b8;\n  margin: 0 0 0.5rem 0;\n}\n\n.corrections {\n  margin-top: 1rem;\n  padding-top: 1rem;\n  border-top: 1px solid #757575;\n}\n\n.correction {\n  margin-bottom: 0.5rem;\n  color: #94a3b8;\n}\n\n.correction strong {\n  color: #757575;\n}\n\n/* ============= JOB ERRORS ============= */\n\n.job-errors {\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  border-radius: 8px;\n  padding: 1rem;\n  margin-top: 1.5rem;\n}\n\n.job-errors h3 {\n  color: #fca5a5;\n  margin: 0 0 0.5rem 0;\n  font-size: 1rem;\n}\n\n.error-item {\n  color: #fca5a5;\n  margin-bottom: 0.25rem;\n}\n\n/* ============= META-ANALYSIS VIEW ============= */\n\n.meta-analysis-view {\n  background: #faf8f5;\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n.meta-header {\n  background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(59, 130, 246, 0.2));\n  padding: 1.5rem;\n  text-align: center;\n  border-bottom: 1px solid #757575;\n}\n\n.meta-header h2 {\n  font-size: 1.5rem;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0 0 0.5rem 0;\n}\n\n.meta-subtitle {\n  color: #94a3b8;\n  margin: 0;\n}\n\n.meta-tabs {\n  display: flex;\n  background: #faf8f5;\n  border-bottom: 1px solid #757575;\n  overflow-x: auto;\n}\n\n.meta-tabs button {\n  flex: 1 1;\n  min-width: max-content;\n  background: none;\n  border: none;\n  padding: 1rem;\n  color: #94a3b8;\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  transition: all 0.2s ease;\n}\n\n.meta-tabs button:hover {\n  color: #4a4a4a;\n  background: rgba(51, 65, 85, 0.3);\n}\n\n.meta-tabs button.active {\n  color: #1a1a1a;\n  border-bottom-color: #8b5cf6;\n}\n\n.meta-content {\n  padding: 1.5rem;\n}\n\n.tab-description {\n  color: #94a3b8;\n  margin: 0 0 1.5rem 0;\n  font-style: italic;\n}\n\n/* Tensions Tab */\n.tension-card {\n  background: rgba(15, 23, 42, 0.5);\n  border-radius: 8px;\n  padding: 1rem;\n  margin-bottom: 1rem;\n}\n\n.tension-card h4 {\n  color: #1a1a1a;\n  margin: 0 0 0.75rem 0;\n}\n\n.interpretations-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 0.75rem;\n}\n\n.interpretation {\n  background: rgba(0, 0, 0, 0.2);\n  border-left: 3px solid var(--paradigm-color, #64748b);\n  padding: 0.75rem;\n  border-radius: 0 6px 6px 0;\n}\n\n.interpretation strong {\n  display: block;\n  color: var(--paradigm-color, #f1f5f9);\n  margin-bottom: 0.25rem;\n}\n\n.interpretation p {\n  margin: 0;\n  color: #94a3b8;\n  font-size: 0.9rem;\n}\n\n/* Translations Tab */\n.translation-card {\n  background: rgba(15, 23, 42, 0.5);\n  border-radius: 8px;\n  padding: 1rem;\n  margin-bottom: 0.75rem;\n}\n\n.translation-arrow {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin-bottom: 0.5rem;\n}\n\n.translation-arrow .concept {\n  background: rgba(148, 163, 184, 0.2);\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  color: #1a1a1a;\n}\n\n.translation-arrow .arrow {\n  color: #64748b;\n}\n\n.success-badge {\n  display: inline-block;\n  padding: 0.125rem 0.5rem;\n  border-radius: 4px;\n  font-size: 0.8rem;\n}\n\n.success-badge.full { background: rgba(34, 197, 94, 0.2); color: #86efac; }\n.success-badge.partial { background: rgba(234, 179, 8, 0.2); color: #fde047; }\n.success-badge.failed { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }\n\n.translation-notes {\n  color: #94a3b8;\n  font-size: 0.9rem;\n  margin: 0.5rem 0 0 0;\n}\n\n/* Revelations Tab */\n.revelations-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 1rem;\n  margin-bottom: 1.5rem;\n}\n\n.revelation-column {\n  background: var(--paradigm-bg, rgba(100, 116, 139, 0.1));\n  border: 1px solid var(--paradigm-color, #64748b);\n  border-radius: 8px;\n  padding: 1rem;\n}\n\n.revelation-column h4 {\n  color: var(--paradigm-color, #f1f5f9);\n  margin: 0 0 0.75rem 0;\n}\n\n.revelation-column ul {\n  margin: 0;\n  padding-left: 1.25rem;\n}\n\n.revelation-column li {\n  color: #94a3b8;\n  margin-bottom: 0.5rem;\n}\n\n.cumulative-section,\n.revolutionary-section {\n  background: rgba(15, 23, 42, 0.5);\n  border-radius: 8px;\n  padding: 1rem;\n  margin-top: 1.5rem;\n}\n\n.cumulative-section h4,\n.revolutionary-section h4 {\n  color: #1a1a1a;\n  margin: 0 0 0.25rem 0;\n}\n\n.section-description {\n  color: #64748b;\n  font-size: 0.9rem;\n  margin: 0 0 0.75rem 0;\n}\n\n.revolutionary-item {\n  background: rgba(0, 0, 0, 0.2);\n  border-left: 3px solid var(--paradigm-color, #64748b);\n  padding: 0.5rem 0.75rem;\n  margin-bottom: 0.5rem;\n  border-radius: 0 6px 6px 0;\n}\n\n.revolutionary-item strong {\n  color: var(--paradigm-color, #f1f5f9);\n}\n\n.revolutionary-item span {\n  color: #94a3b8;\n  margin-left: 0.5rem;\n}\n\n/* Incommensurable Tab */\n.incommensurable-list {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.incommensurable-list li {\n  background: rgba(15, 23, 42, 0.5);\n  border-radius: 6px;\n  padding: 0.75rem 1rem;\n  margin-bottom: 0.5rem;\n  color: #94a3b8;\n  border-left: 3px solid #8b5cf6;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/ParadigmsPages.css\"],\"names\":[],\"mappings\":\"AAAA;;;;;EAKE;;AAEF,uCAAuC;;AAEvC;EACE,iBAAiB;EACjB,mBAAmB;EACnB,cAAc;AAChB;;AAEA;;EAEE,iBAAiB;EACjB,cAAc;EACd,aAAa;AACf;;AAEA;;;EAGE,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,uBAAuB;EACvB,gBAAgB;EAChB,SAAS;AACX;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,0CAA0C;EAC1C,yBAAyB;EACzB,kBAAkB;EAClB,kCAAkC;AACpC;;AAEA;EACE,KAAK,yBAAyB,EAAE;AAClC;;AAEA,4CAA4C;;AAE5C;EACE,mBAAmB;EACnB,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,oBAAoB;AACtB;;AAEA;EACE,cAAc;EACd,iBAAiB;EACjB,gBAAgB;EAChB,cAAc;AAChB;;AAEA,6CAA6C;;AAE7C;EACE,kCAAkC;EAClC,wCAAwC;EACxC,cAAc;EACd,aAAa;EACb,kBAAkB;EAClB,qBAAqB;EACrB,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,eAAe;EACf,0BAA0B;AAC5B;;AAEA,8CAA8C;;AAE9C;EACE,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,mBAAmB;EACnB,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,4DAA4D;EAC5D,SAAS;AACX;;AAEA;EACE,mBAAmB;EACnB,6BAA6B;EAC7B,mBAAmB;EACnB,gBAAgB;EAChB,eAAe;EACf,yBAAyB;AAC3B;;AAEA;EACE,mBAAmB;EACnB,4CAA4C;AAC9C;;AAEA;EACE,wDAAwD;EACxD,4CAA4C;AAC9C;;AAEA;EACE,aAAa;EAC