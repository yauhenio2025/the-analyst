n}\\n\\n.helicopter-dashboard .pending-alert {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 6px 12px;\\n  background: rgba(239, 68, 68, 0.15);\\n  border: 1px solid rgba(239, 68, 68, 0.3);\\n  border-radius: 6px;\\n  color: #ef4444;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.helicopter-dashboard .pending-alert:hover {\\n  background: rgba(239, 68, 68, 0.25);\\n  border-color: rgba(239, 68, 68, 0.5);\\n}\\n\\n.helicopter-dashboard .alert-badge {\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  width: 20px;\\n  height: 20px;\\n  background: #ef4444;\\n  color: #fff;\\n  border-radius: 50%;\\n  font-size: 11px;\\n  font-weight: 700;\\n}\\n\\n.helicopter-dashboard .alert-text {\\n  font-size: 13px;\\n  font-weight: 500;\\n}\\n\\n/* Metrics Grid */\\n.helicopter-dashboard .metrics-grid {\\n  display: grid;\\n  grid-template-columns: repeat(4, 1fr);\\n  gap: 12px;\\n  margin-bottom: 24px;\\n}\\n\\n.helicopter-dashboard .metric-card {\\n  background: #f5f3f0;\\n  border-radius: 8px;\\n  padding: 16px;\\n  text-align: center;\\n}\\n\\n.helicopter-dashboard .metric-value {\\n  font-size: 28px;\\n  font-weight: 700;\\n  color: #fff;\\n  margin-bottom: 4px;\\n}\\n\\n.helicopter-dashboard .metric-value.empty {\\n  color: #555;\\n}\\n\\n.helicopter-dashboard .metric-value.trend {\\n  font-size: 24px;\\n}\\n\\n.helicopter-dashboard .metric-value.trend.trend-up {\\n  color: #22c55e;\\n}\\n\\n.helicopter-dashboard .metric-value.trend.trend-down {\\n  color: #ef4444;\\n}\\n\\n.helicopter-dashboard .metric-value.trend.trend-stable {\\n  color: #eab308;\\n}\\n\\n.helicopter-dashboard .metric-value.trend.trend-unknown {\\n  color: #757575;\\n}\\n\\n.helicopter-dashboard .metric-label {\\n  font-size: 12px;\\n  color: #757575;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n/* Charts Section */\\n.helicopter-dashboard .charts-section {\\n  display: grid;\\n  grid-template-columns: repeat(2, 1fr);\\n  gap: 16px;\\n  margin-bottom: 24px;\\n}\\n\\n.helicopter-dashboard .mini-chart {\\n  background: #f5f3f0;\\n  border-radius: 8px;\\n  padding: 12px;\\n}\\n\\n.helicopter-dashboard .chart-label {\\n  font-size: 12px;\\n  color: #757575;\\n  margin-bottom: 12px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.helicopter-dashboard .chart-bars {\\n  display: flex;\\n  align-items: flex-end;\\n  justify-content: space-around;\\n  height: 60px;\\n  gap: 8px;\\n}\\n\\n.helicopter-dashboard .bar-container {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  flex: 1;\\n  height: 100%;\\n}\\n\\n.helicopter-dashboard .bar {\\n  width: 100%;\\n  max-width: 30px;\\n  background: linear-gradient(180deg, #b5343a 0%, #9a2c31 100%);\\n  border-radius: 4px 4px 0 0;\\n  transition: height 0.3s ease;\\n}\\n\\n.helicopter-dashboard .bar-label {\\n  font-size: 10px;\\n  color: #757575;\\n  margin-top: 4px;\\n}\\n\\n.helicopter-dashboard .faithfulness-chart .chart-line {\\n  display: flex;\\n  justify-content: space-around;\\n  height: 60px;\\n  position: relative;\\n}\\n\\n.helicopter-dashboard .point-container {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  position: relative;\\n  height: 100%;\\n}\\n\\n.helicopter-dashboard .point {\\n  position: absolute;\\n  width: 10px;\\n  height: 10px;\\n  background: #b5343a;\\n  border-radius: 50%;\\n  border: 2px solid #fff;\\n}\\n\\n.helicopter-dashboard .point-label {\\n  position: absolute;\\n  top: -18px;\\n  font-size: 10px;\\n  color: #b5343a;\\n  white-space: nowrap;\\n}\\n\\n.helicopter-dashboard .point-container .version-label {\\n  position: absolute;\\n  bottom: 0;\\n  font-size: 10px;\\n  color: #757575;\\n}\\n\\n/* Dives Section */\\n.helicopter-dashboard .dives-section {\\n  margin-bottom: 24px;\\n}\\n\\n.helicopter-dashboard .dives-section h4 {\\n  margin: 0 0 12px 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: #757575;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.helicopter-dashboard .dives-stats {\\n  display: flex;\\n  gap: 24px;\\n  margin-bottom: 12px;\\n}\\n\\n.helicopter-dashboard .dive-stat {\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n.helicopter-dashboard .dive-stat .stat-value {\\n  font-size: 20px;\\n  font-weight: 700;\\n  color: #fff;\\n}\\n\\n.helicopter-dashboard .dive-stat.pending .stat-value {\\n  color: #eab308;\\n}\\n\\n.helicopter-dashboard .dive-stat .stat-label {\\n  font-size: 11px;\\n  color: #757575;\\n}\\n\\n.helicopter-dashboard .investigated-types {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 6px;\\n}\\n\\n.helicopter-dashboard .sin-type-tag {\\n  font-size: 11px;\\n  padding: 4px 8px;\\n  background: #e0ddd8;\\n  border-radius: 4px;\\n  color: #aaa;\\n  text-transform: capitalize;\\n}\\n\\n/* Revisions Section */\\n.helicopter-dashboard .revisions-section {\\n  margin-bottom: 24px;\\n}\\n\\n.helicopter-dashboard .revisions-section h4 {\\n  margin: 0 0 12px 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: #757575;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.helicopter-dashboard .revisions-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.helicopter-dashboard .revision-item {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  padding: 10px 12px;\\n  background: #f5f3f0;\\n  border-radius: 6px;\\n  cursor: pointer;\\n  transition: background 0.2s ease;\\n}\\n\\n.helicopter-dashboard .revision-item:hover {\\n  background: #f5f3f0;\\n}\\n\\n.helicopter-dashboard .revision-versions {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n}\\n\\n.helicopter-dashboard .from-version,\\n.helicopter-dashboard .to-version {\\n  font-weight: 600;\\n  font-size: 13px;\\n}\\n\\n.helicopter-dashboard .arrow {\\n  color: #757575;\\n}\\n\\n.helicopter-dashboard .revision-meta {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  font-size: 11px;\\n  color: #757575;\\n}\\n\\n.helicopter-dashboard .trigger-type {\\n  text-transform: capitalize;\\n}\\n\\n.helicopter-dashboard .findings-change.positive {\\n  color: #22c55e;\\n}\\n\\n.helicopter-dashboard .findings-change.negative {\\n  color: #ef4444;\\n}\\n\\n.helicopter-dashboard .score-change {\\n  font-size: 12px;\\n  font-weight: 600;\\n  padding: 2px 6px;\\n  border-radius: 4px;\\n}\\n\\n.helicopter-dashboard .score-change.improved {\\n  background: rgba(34, 197, 94, 0.2);\\n  color: #22c55e;\\n}\\n\\n.helicopter-dashboard .score-change.worsened {\\n  background: rgba(239, 68, 68, 0.2);\\n  color: #ef4444;\\n}\\n\\n/* Contributors Section */\\n.helicopter-dashboard .contributors-section h4 {\\n  margin: 0 0 12px 0;\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: #757575;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.helicopter-dashboard .contributors-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n}\\n\\n.helicopter-dashboard .contributor-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 8px 12px;\\n  background: #f5f3f0;\\n  border-radius: 6px;\\n}\\n\\n.helicopter-dashboard .contributor-rank {\\n  font-size: 11px;\\n  color: #b5343a;\\n  font-weight: 600;\\n}\\n\\n.helicopter-dashboard .contributor-type {\\n  flex: 1;\\n  font-size: 13px;\\n  text-transform: capitalize;\\n}\\n\\n.helicopter-dashboard .contributor-count {\\n  font-size: 11px;\\n  color: #757575;\\n}\\n\\n/* Footer */\\n.helicopter-dashboard .dashboard-footer {\\n  margin-top: 16px;\\n  padding-top: 12px;\\n  border-top: 1px solid #e0ddd8;\\n  font-size: 11px;\\n  color: #666;\\n  text-align: right;\\n}\\n\\n/* Responsive */\\n@media (max-width: 768px) {\\n  .helicopter-dashboard .metrics-grid {\\n    grid-template-columns: repeat(2, 1fr);\\n  }\\n\\n  .helicopter-dashboard .charts-section {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .helicopter-dashboard .dives-stats {\\n    flex-wrap: wrap;\\n  }