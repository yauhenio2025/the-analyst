elected {\n  background: var(--bg-tertiary, #e0ddd8);\n  border-color: var(--sin-color, #b5343a);\n  box-shadow: 0 0 0 1px var(--sin-color, #b5343a);\n}\n\n.sin-type-item.empty {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.sin-type-item:disabled {\n  cursor: not-allowed;\n}\n\n.sin-type-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.sin-type-indicator {\n  width: 12px;\n  height: 12px;\n  border-radius: 3px;\n  flex-shrink: 0;\n}\n\n.sin-type-label {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-primary, #1a1a1a);\n  flex: 1 1;\n}\n\n.sin-type-count {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text-secondary, #757575);\n  background: var(--bg-primary, #ffffff);\n  padding: 2px 8px;\n  border-radius: 10px;\n  min-width: 28px;\n  text-align: center;\n}\n\n.sin-type-item.selected .sin-type-count {\n  background: var(--sin-color, #b5343a);\n  color: white;\n}\n\n.sin-type-details {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n}\n\n.sin-type-description {\n  font-size: 11px;\n  color: var(--text-secondary, #757575);\n  flex: 1 1;\n  line-height: 1.4;\n}\n\n.severity-indicator {\n  display: flex;\n  gap: 4px;\n  flex-shrink: 0;\n}\n\n.severity-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n\n.severity-dot.critical {\n  background: #8a4a4a;\n}\n\n.severity-dot.high {\n  background: #8a6a4a;\n}\n\n.severity-dot.medium {\n  background: #7a7a50;\n}\n\n.severity-dot.low {\n  background: #5a7a60;\n}\n\n.bloom-term {\n  font-size: 10px;\n  color: var(--text-tertiary, #9a9a9a);\n  font-style: italic;\n  text-transform: capitalize;\n  padding-left: 20px;\n}\n\n.investigate-all-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  width: 100%;\n  margin-top: 10px;\n  padding: 8px 12px;\n  background: var(--bg-elevated, #f5f3f0);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 6px;\n  color: var(--accent-color, #b5343a);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.investigate-all-btn:hover {\n  background: var(--bg-tertiary, #e0ddd8);\n  border-color: var(--accent-color, #b5343a);\n}\n\n.investigate-all-btn .btn-icon {\n  font-size: 13px;\n}\n\n.sin-type-item.selected .investigate-all-btn {\n  background: rgba(255, 255, 255, 0.12);\n  border-color: rgba(255, 255, 255, 0.25);\n  color: white;\n}\n\n.sin-type-item.selected .investigate-all-btn:hover {\n  background: rgba(255, 255, 255, 0.2);\n  border-color: rgba(255, 255, 255, 0.4);\n}\n\n.navigator-legend {\n  margin-top: 16px;\n  padding-top: 12px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.legend-title {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n  margin-bottom: 8px;\n}\n\n.legend-items {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: var(--text-secondary, #757575);\n}\n\n.legend-item .severity-dot {\n  width: 6px;\n  height: 6px;\n}\n\n/* V2 Deeper Dive Badge */\n.v2-badge {\n  font-size: 10px;\n  font-weight: 600;\n  color: #5a7a60;\n  background: rgba(90, 122, 96, 0.1);\n  padding: 2px 6px;\n  border-radius: 4px;\n  margin-left: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n  border: 1px solid rgba(90, 122, 96, 0.25);\n}\n\n.sin-type-item.has-v2 {\n  border-left: 3px solid #5a7a60;\n}\n\n.sin-type-item.selected .v2-badge {\n  background: rgba(90, 122, 96, 0.2);\n  border-color: rgba(90, 122, 96, 0.4);\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/SinTypeNavigator.css\"],\"names\":[],\"mappings\":\"AAAA,4BAA4B;;AAE5B;EACE,mCAAmC;EACnC,kBAAkB;EAClB,aAAa;EACb,8CAA8C;AAChD;;AAEA;EACE,YAAY;AACd;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAmB;EACnB,oBAAoB;EACpB,qDAAqD;AACvD;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,mCAAmC;AACrC;;AAEA;EACE,eAAe;EACf,qCAAqC;EACrC,uCAAu