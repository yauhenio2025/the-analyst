: #111010;\n  border-right: 1px solid rgba(80, 70, 58, 0.25);\n  padding: 16px 0;\n  display: flex;\n  flex-direction: column;\n  position: sticky;\n  top: 0;\n  height: calc(100vh - 60px);\n  align-self: flex-start;\n  overflow-y: auto;\n  outline: none;\n}\n\n.research-sidebar-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 10px 16px 10px 0;\n  background: transparent;\n  border: none;\n  color: #b0a89c;\n  font-size: 0.82rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.18s ease;\n  text-align: left;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.research-sidebar-item:hover {\n  background: rgba(255, 255, 255, 0.04);\n  color: #d4ccc0;\n}\n\n.research-sidebar-item.active {\n  background: rgba(255, 255, 255, 0.06);\n  color: #f4ede4;\n  font-weight: 600;\n}\n\n.sidebar-item-accent {\n  width: 4px;\n  height: 24px;\n  border-radius: 0 3px 3px 0;\n  opacity: 0.45;\n  flex-shrink: 0;\n  transition: opacity 0.18s ease;\n}\n\n.research-sidebar-item.active .sidebar-item-accent {\n  opacity: 1;\n  box-shadow: 0 0 6px currentColor;\n}\n\n.research-sidebar-item:hover .sidebar-item-accent {\n  opacity: 0.7;\n}\n\n.sidebar-item-label {\n  flex: 1 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.sidebar-item-count {\n  font-size: 0.72rem;\n  font-weight: 600;\n  color: #968e82;\n  background: rgba(90, 78, 65, 0.3);\n  padding: 2px 7px;\n  border-radius: 10px;\n  font-variant-numeric: tabular-nums;\n  flex-shrink: 0;\n}\n\n.research-sidebar-item.active .sidebar-item-count {\n  color: #d4cabb;\n  background: rgba(100, 88, 72, 0.45);\n}\n\n.sidebar-divider {\n  height: 1px;\n  background: rgba(90, 78, 65, 0.25);\n  margin: 8px 16px;\n}\n\n/* Progress bar at bottom */\n.sidebar-progress {\n  margin-top: auto;\n  padding: 16px 16px 8px;\n}\n\n.sidebar-progress-bar {\n  height: 4px;\n  background: rgba(90, 78, 65, 0.35);\n  border-radius: 2px;\n  overflow: hidden;\n  margin-bottom: 6px;\n}\n\n.sidebar-progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, #5a7a50, #6b9b66, #7aab76);\n  border-radius: 2px;\n  transition: width 0.4s ease;\n  min-width: 0;\n  box-shadow: 0 0 4px rgba(107, 155, 102, 0.3);\n}\n\n.sidebar-progress-text {\n  font-size: 0.68rem;\n  color: #968e82;\n  font-family: 'Inter', -apple-system, sans-serif;\n  font-variant-numeric: tabular-nums;\n}\n\n/* ── Content Area ── */\n\n.research-content {\n  flex: 1 1;\n  min-width: 0;\n  padding: 24px 28px;\n}\n\n/* ── Header ── */\n\n.research-page-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 20px;\n}\n\n.research-page .research-page-title h1 {\n  margin: 0;\n  font-size: 1.5rem;\n  font-family: 'Inter', -apple-system, sans-serif !important;\n  font-weight: 700;\n  color: #f8f4ed;\n  letter-spacing: -0.025em;\n  font-style: normal !important;\n}\n\n.research-page-subtitle {\n  margin: 4px 0 0;\n  font-size: 0.8rem;\n  color: #9e978c;\n  font-weight: 400;\n  letter-spacing: 0.01em;\n}\n\n/* ── View Toggle Bar ── */\n\n.research-view-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n}\n\n.research-view-toggles {\n  display: flex;\n  background: rgba(22, 20, 17, 0.7);\n  border: 1px solid rgba(100, 88, 72, 0.3);\n  border-radius: 10px;\n  padding: 3px;\n  gap: 2px;\n}\n\n.view-toggle-btn {\n  background: transparent;\n  border: none;\n  color: #b8b0a4;\n  font-size: 0.78rem;\n  font-weight: 500;\n  padding: 6px 14px;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.18s ease;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-family: 'Inter', -apple-system, sans-serif;\n  white-space: nowrap;\n}\n\n.view-toggle-btn:hover {\n  color: #ece4d8;\n  background: rgba(255, 255, 255, 0.06);\n}\n\n.view-toggle-btn.active {\n  background: rgba(210, 120, 100, 0.18);\n  color: #f5efe6;\n  font-weight: 600;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);\n}\n\n.view-toggle-count {\n  font-size: 0.68rem;\n  font-weight: 600;\n  color: #8a8278;\n  font-variant-numeric: tabular-nums;\n}\n\n.view-toggle-btn.active .view-toggle-count {\n  color: #d4c8bc;\n}\n\n.research-priority-pills {\n  display: flex;\n  gap: 6px;\n}\n\n.priority-pill {\n  background: rgba(255, 255, 255, 0.03);\n  border: 1px solid rgba(120, 108, 90, 0.35);\n  border-radius: 20px;\n  color: #b8b0a4;\n  padding: 4px 12px;\n  font-size: 0.72rem;\n  cursor: pointer;\n  text-transform: capitalize;\n  transition: all 0.18s ease;\n  font-weight: 500;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.priority-pill:hover {\n  background: rgba(255, 255, 255, 0.06);\n  color: #e0d8cc;\n  border-color: rgba(160, 145, 125, 0.5);\n}\n\n.priority-pill.active {\n  background: rgba(255, 255, 255, 0.08);\n  border-color: currentColor;\n  font-weight: 600;\n  box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);\n}\n\n/* ── Done toggle on card header ── */\n\n.research-done-toggle {\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  border: 2px solid rgba(100, 88, 72, 0.4);\n  background: transparent;\n  color: transparent;\n  font-size: 0.72rem;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  transition: all 0.2s ease;\n  line-height: 1;\n  padding: 0;\n}\n\n.research-done-toggle:hover {\n  border-color: #7a9b76;\n  color: rgba(107, 155, 94, 0.6);\n  background: rgba(107, 138, 94, 0.1);\n}\n\n.research-done-toggle.checked {\n  border-color: #6b8a5e;\n  background: rgba(107, 138, 94, 0.18);\n  color: #6b8a5e;\n  box-shadow: 0 0 6px rgba(107, 138, 94, 0.2);\n}\n\n/* Done card styling */\n.research-card.done {\n  opacity: 0.6;\n}\n\n.research-card.done:hover {\n  opacity: 0.8;\n}\n\n.research-q-text.done-text {\n  text-decoration: line-through;\n  text-decoration-color: rgba(168, 160, 148, 0.5);\n  text-decoration-thickness: 1.5px;\n  color: #a8a094;\n}\n\n/* ── Card header adjustment for done toggle ── */\n\n.research-card-header {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 14px 18px;\n  cursor: pointer;\n  flex-wrap: wrap;\n}\n\n/* ── Mobile: Sidebar chips ── */\n\n.research-sidebar-chips {\n  display: none;\n}\n\n@media (max-width: 768px) {\n  .research-command-center {\n    flex-direction: column;\n  }\n\n  .research-sidebar {\n    display: none;\n  }\n\n  .research-sidebar-chips {\n    display: flex;\n    overflow-x: auto;\n    gap: 6px;\n    padding: 12px 16px;\n    padding-right: 32px;\n    background: #111010;\n    border-bottom: 1px solid rgba(80, 70, 58, 0.25);\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    position: relative;\n    mask-image: linear-gradient(to right, black 85%, transparent 100%);\n    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);\n  }\n\n  .research-sidebar-chips::-webkit-scrollbar {\n    display: none;\n  }\n\n  .sidebar-chip {\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(120, 108, 90, 0.3);\n    border-radius: 20px;\n    color: #b0a89c;\n    padding: 5px 12px;\n    font-size: 0.75rem;\n    cursor: pointer;\n    white-space: nowrap;\n    flex-shrink: 0;\n    transition: all 0.18s ease;\n    font-family: 'Inter', -apple-system, sans-serif;\n    font-weight: 500;\n  }\n\n  .sidebar-chip:hover {\n    background: rgba(255, 255, 255, 0.06);\n    color: #d4ccc0;\n  }\n\n  .sidebar-chip.active {\n    background: rgba(194, 99, 90, 0.15);\n    color: #f4ede4;\n    border-color: rgba(194, 99, 90, 0.4);\n    font-weight: 600;\n  }\n\n  .research-content {\n    padding: 16px;\n  }\n\n  .research-view-bar {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .research-priority-pills {\n    justify-content: center;\n  }\n}\n\n/* ── Smooth transitions ── */\n\n.research-list {\n  animation: research-list-in 0.15s ease-out;\n}\n\n@keyframes research-list-in {\n  from { opacity: 0.6; }\n  to { opacity: 1; }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/research/ResearchPageLayout.css\"],\"names\":[],\"mappings\":\"AAAA,yCAAyC;;AAEzC;EACE,aAAa;EACb,8BAA8B;EAC9B,cAAc,YAAY,sEAAsE;EAChG,mBAAmB;EACnB,2CAA2C;AAC7C;;AAEA,kBAAkB;;AAElB;EACE,YAAY;EACZ,gBAAgB;EAChB,mBAAmB;EACnB,8CAA8C;EAC9C,eAAe;EACf,aAAa;EACb,sBAAsB;EACtB,gBAAgB;EAChB,MAAM;EACN,0BAA0B;EAC1B,sBAAsB;EACtB,gBAAgB;EAChB,aAAa;AACf;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,WAAW;EACX,yBAAyB;EACzB,uBAAuB;EACvB,YAAY;EACZ,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,0BAA0B;EAC1B,gBAAgB;EAChB,+CAA+C;AACjD;;AAEA;EACE,qCAAqC;EACrC,cAAc;AAChB;;AAEA;EACE,qCAAqC;EACrC,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,UAAU;EACV,YAAY;EACZ,0BAA0B;EAC1B,aAAa;EACb,cAAc;EACd,8BAA8B;AAChC;;AAEA;EACE,UAAU;EACV,gCAAgC;AAClC;;AAEA;EACE,YAAY;AACd;;AAEA;EACE,SAAO;EACP,YAAY;EACZ,gBAAgB;EAChB,uBAAuB;EACvB,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,iCAAiC;EACjC,gBAAgB;EAChB,mBAAmB;EACnB,kCAAkC;EAClC,cAAc;AAChB;;AAEA;EACE,cAAc;EACd,mCAAmC;AACrC;;AAEA;EACE,WAAW;EACX,kCAAkC;EAClC,gBAAgB;AAClB;;AAEA,2BAA2B;AAC3B;EACE,gBAAgB;EAChB,sBAAsB;AACxB;;AAEA;EACE,WAAW;EACX,kCAAkC;EAClC,kBAAkB;EAClB,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,YAAY;EACZ,6DAA6D;EAC7D,kBAAkB;EAClB,2BAA2B;EAC3B,YAAY;EACZ,4CAA4C;AAC9C;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,+CAA+C;EAC/C,kCAAkC;AACpC;;AAEA,uBAAuB;;AAEvB;EACE,SAAO;EACP,YAAY;EACZ,kBAAkB;AACpB;;AAEA,iBAAiB;;AAEjB;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,mBAAmB;AACrB;;AAEA;EACE,SAAS;EACT,iBAAiB;EACjB,0DAA0D;EAC1D,gBAAgB;EAChB,cAAc;EACd,wBAAwB;EACxB,6BAA6B;AAC/B;;AAEA;EACE,eAAe;EACf,iBAAiB;EACjB,cAAc;EACd,gBAAgB;EAChB,sBAAsB;AACxB;;AAEA,0BAA0B;;AAE1B;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,SAAS;EACT,mBAAmB;EACnB,eAAe;AACjB;;AAEA;EACE,aAAa;EACb,iCAAiC;EACjC,wCAAwC;EACxC,mBAAmB;EACnB,YAAY;EACZ,QAAQ;AACV;;AAEA;EACE,uBAAuB;EACvB,YAAY;EACZ,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,0BAA0B;EAC1B,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,+CAA+C;EAC/C,mBAAmB;AACrB;;AAEA;EACE,cAAc;EACd,qCAAqC;AACvC;;AAEA;EACE,qCAAqC;EACrC,cAAc;EACd,gBAAgB;EAChB,yCAAyC;AAC3C;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,kCAAkC;AACpC;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,QAAQ;AACV;;AAEA;EACE,qCAAqC;EACrC,0CAA0C;EAC1C,mBAAmB;EACnB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,0BAA0B;EAC1B,0BAA0B;EAC1B,gBAAgB;EAChB,+CAA+C;AACjD;;AAEA;EACE,qCAAqC;EACrC,cAAc;EACd,sCAAsC;AACxC;;AAEA;EACE,qCAAqC;EACrC,0BAA0B;EAC1B,gBAAgB;EAChB,sCAAsC;AACxC;;AAEA,qCAAqC;;AAErC;EACE,WAAW;EACX,YAAY;EACZ,kBAAkB;EAClB,wCAAwC;EACxC,uBAAuB;EACvB,kBAAkB;EAClB,kBAAkB;EAClB,eAAe;EACf,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,cAAc;EACd,yBAAyB;EACzB,cAAc;EACd,UAAU;AACZ;;AAEA;EACE,qBAAqB;EACrB,8BAA8B;EAC9B,mCAAmC;AACrC;;AAEA;EACE,qBAAqB;EACrB,oCAAoC;EACpC,cAAc;EACd,2CAA2C;AAC7C;;AAEA,sBAAsB;AACtB;EACE,YAAY;AACd;;AAEA;EACE,YAAY;AACd;;AAEA;EACE,6BAA6B;EAC7B,+CAA+C;EAC/C,gCAAgC;EAChC,cAAc;AAChB;;AAEA,iDAAiD;;AAEjD;EACE,aAAa;EACb,uBAAuB;EACvB,SAAS;EACT,kBAAkB;EAClB,eAAe;EACf,eAAe;AACjB;;AAEA,gCAAgC;;AAEhC;EACE,aAAa;AACf;;AAEA;EACE;IACE,sBAAsB;EACxB;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,aAAa;IACb,gBAAgB;IAChB,QAAQ;IACR,kBAAkB;IAClB,mBAAmB;IACnB,mBAAmB;IACnB,+CAA+C;IAC/C,iCAAiC;IACjC,qBAAqB;IACrB,kBAAkB;IAClB,kEAAkE;IAClE,0EAA0E;EAC5E;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,qCAAqC;IACrC,yCAAyC;IACzC,mBAAmB;IACnB,cAAc;IACd,iBAAiB;IACjB,kBAAkB;IAClB,eAAe;IACf,mBAAmB;IACnB,cAAc;IACd,0BAA0B;IAC1B,+CAA+C;IAC/C,gBAAgB;EAClB;;EAEA;IACE,qCAAqC;IACrC,cAAc;EAChB;;EAEA;IACE,mCAAmC;IACnC,cAAc;IACd,oCAAoC;IACpC,gBAAgB;EAClB;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,sBAAsB;IACtB,oBAAoB;EACtB;;EAEA;IACE,uBAAuB;EACzB;AACF;;AAEA,6BAA6B;;AAE7B;EACE,0CAA0C;AAC5C;;AAEA;EACE,OAAO,YAAY,EAAE;EACrB,KAAK,UAAU,EAAE;AACnB\",\"sourcesContent\":[\"/* ── Research Command Center Layout ── */\\n\\n.research-command-center {\\n  display: flex;\\n  min-height: calc(100vh - 60px);\\n  flex-shrink: 0;           /* Don't shrink — expand to full content height so sidebar can stick */\\n  background: #141210;\\n  border-top: 1px solid rgba(60, 52, 44, 0.4);\\n}\\n\\n/* ── Sidebar ── */\\n\\n.research-sidebar {\\n  width: 220px;\\n  min-width: 220px;\\n  background: #111010;\\n  border-right: 1px solid rgba(80, 70, 58, 0.25);\\n  padding: 16px 0;\\n  display: flex;\\n  flex-direction: column;\\n  position: sticky;\\n  top: 0;\\n  height: calc(100vh - 60px);\\n  align-self: flex-start;\\n  overflow-y: auto;\\n  outline: none;\\n}\\n\\n.research-sidebar-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  width: 100%;\\n  padding: 10px 16px 10px 0;\\n  background: transparent;\\n  border: none;\\n  color: #b0a89c;\\n  font-size: 0.82rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.18s ease;\\n  text-align: left;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n}\\n\\n.research-sidebar-item:hover {\\n  background: rgba(255, 255, 255, 0.04);\\n  color: #d4ccc0;\\n}\\n\\n.research-sidebar-item.active {\\n  background: rgba(255, 255, 255, 0.06);\\n  color: #f4ede4;\\n  font-weight: 600;\\n}\\n\\n.sidebar-item-accent {\\n  width: 4px;\\n  height: 24px;\\n  border-radius: 0 3px 3px 0;\\n  opacity: 0.45;\\n  flex-shrink: 0;\\n  transition: opacity 0.18s ease;\\n}\\n\\n.research-sidebar-item.active .sidebar-item-accent {\\n  opacity: 1;\\n  box-shadow: 0 0 6px currentColor;\\n}\\n\\n.research-sidebar-item:hover .sidebar-item-accent {\\n  opacity: 0.7;\\n}\\n\\n.sidebar-item-label {\\n  flex: 1;\\n  min-width: 0;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.sidebar-item-count {\\n  font-size: 0.72rem;\\n  font-weight: 600;\\n  color: #968e82;\\n  background: rgba(90, 78, 65, 0.3);\\n  padding: 2px 7px;\\n  border-radius: 10px;\\n  font-variant-numeric: tabular-nums;\\n  flex-shrink: 0;\\n}\\n\\n.research-sidebar-item.active .sidebar-item-count {\\n  color: #d4cabb;\\n  background: rgba(100, 88, 72, 0.45);\\n}\\n\\n.sidebar-divider {\\n  height: 1px;\\n  background: rgba(90, 78, 65, 0.25);\\n  margin: 8px 16px;\\n}\\n\\n/* Progress bar at bottom */\\n.sidebar-progress {\\n  margin-top: auto;\\n  padding: 16px 16px 8px;\\n}\\n\\n.sidebar-progress-bar {\\n  height: 4px;\\n  background: rgba(90, 78, 65, 0.35);\\n  border-radius: 2px;\\n  overflow: hidden;\\n  margin-bottom: 6px;\\n}\\n\\n.sidebar-progress-fill {\\n  height: 100%;\\n  background: linear-gradient(90deg, #5a7a50, #6b9b66, #7aab76);\\n  border-radius: 2px;\\n  transition: width 0.4s ease;\\n  min-width: 0;\\n  box-shadow: 0 0 4px rgba(107, 155, 102, 0.3);\\n}\\n\\n.sidebar-progress-text {\\n  font-size: 0.68rem;\\n  color: #968e82;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n/* ── Content Area ── */\\n\\n.research-content {\\n  flex: 1;\\n  min-width: 0;\\n  padding: 24px 28px;\\n}\\n\\n/* ── Header ── */\\n\\n.research-page-header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  margin-bottom: 20px;\\n}\\n\\n.research-page .research-page-title h1 {\\n  margin: 0;\\n  font-size: 1.5rem;\\n  font-family: 'Inter', -apple-system, sans-serif !important;\\n  font-weight: 700;\\n  color: #f8f4ed;\\n  letter-spacing: -0.025em;\\n  font-style: normal !important;\\n}\\n\\n.research-page-subtitle {\\n  margin: 4px 0 0;\\n  font-size: 0.8rem;\\n  color: #9e978c;\\n  font-weight: 400;\\n  letter-spacing: 0.01em;\\n}\\n\\n/* ── View Toggle Bar ── */\\n\\n.research-view-bar {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 12px;\\n  margin-bottom: 20px;\\n  flex-wrap: wrap;\\n}\\n\\n.research-view-toggles {\\n  display: flex;\\n  background: rgba(22, 20, 17, 0.7);\\n  border: 1px solid rgba(100, 88, 72, 0.3);\\n  border-radius: 10px;\\n  padding: 3px;\\n  gap: 2px;\\n}\\n\\n.view-toggle-btn {\\n  background: transparent;\\n  border: none;\\n  color: #b8b0a4;\\n  font-size: 0.78rem;\\n  font-weight: 500;\\n  padding: 6px 14px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.18s ease;\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n  white-space: nowrap;\\n}\\n\\n.view-toggle-btn:hover {\\n  color: #ece4d8;\\n  background: rgba(255, 255, 255, 0.06);\\n}\\n\\n.view-toggle-btn.active {\\n  background: rgba(210, 120, 100, 0.18);\\n  color: #f5efe6;\\n  font-weight: 600;\\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);\\n}\\n\\n.view-toggle-count {\\n  font-size: 0.68rem;\\n  font-weight: 600;\\n  color: #8a8278;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.view-toggle-btn.active .view-toggle-count {\\n  color: #d4c8bc;\\n}\\n\\n.research-priority-pills {\\n  display: flex;\\n  gap: 6px;\\n}\\n\\n.priority-pill {\\n  background: rgba(255, 255, 255, 0.03);\\n  border: 1px solid rgba(120, 108, 90, 0.35);\\n  border-radius: 20px;\\n  color: #b8b0a4;\\n  padding: 4px 12px;\\n  font-size: 0.72rem;\\n  cursor: pointer;\\n  text-transform: capitalize;\\n  transition: all 0.18s ease;\\n  font-weight: 500;\\n  font-family: 'Inter', -apple-system, sans-serif;\\n}\\n\\n.priority-pill:hover {\\n  background: rgba(255, 255, 255, 0.06);\\n  color: #e0d8cc;\\n  border-color: rgba(160, 145, 125, 0.5);\\n}\\n\\n.priority-pill.active {\\n  background: rgba(255, 255, 255, 0.08);\\n  border-color: currentColor;\\n  font-weight: 600;\\n  box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);\\n}\\n\\n/* ── Done toggle on card header ── */\\n\\n.research-done-toggle {\\n  width: 22px;\\n  height: 22px;\\n  border-radius: 50%;\\n  border: 2px solid rgba(100, 88, 72, 0.4);\\n  background: transparent;\\n  color: transparent;\\n  font-size: 0.72rem;\\n  cursor: pointer;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  flex-shrink: 0;\\n  transition: all 0.2s ease;\\n  line-height: 1;\\n  padding: 0;\\n}\\n\\n.research-done-toggle:hover {\\n  border-color: #7a9b76;\\n  color: rgba(107, 155, 94, 0.6);\\n  background: rgba(107, 138, 94, 0.1);\\n}\\n\\n.research-done-toggle.checked {\\n  border-color: #6b8a5e;\\n  background: rgba(107, 138, 94, 0.18);\\n  color: #6b8a5e;\\n  box-shadow: 0 0 6px rgba(107, 138, 94, 0.2);\\n}\\n\\n/* Done card styling */\\n.research-card.done {\\n  opacity: 0.6;\\n}\\n\\n.research-card.done:hover {\\n  opacity: 0.8;\\n}\\n\\n.research-q-text.done-text {\\n  text-decoration: line-through;\\n  text-decoration-color: rgba(168, 160, 148, 0.5);\\n  text-decoration-thickness: 1.5px;\\n  color: #a8a094;\\n}\\n\\n/* ── Card header adjustment for done toggle ── */\\n\\n.research-card-header {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 10px;\\n  padding: 14px 18px;\\n  cursor: pointer;\\n  flex-wrap: wrap;\\n}\\n\\n/* ── Mobile: Sidebar chips ── */\\n\\n.research-sidebar-chips {\\n  display: none;\\n}\\n\\n@media (max-width: 768px) {\\n  .research-command-center {\\n    flex-direction: column;\\n  }\\n\\n  .research-sidebar {\\n    display: none;\\n  }\\n\\n  .research-sidebar-chips {\\n    display: flex;\\n    overflow-x: auto;\\n    gap: 6px;\\n    padding: 12px 16px;\\n    padding-right: 32px;\\n    background: #111010;\\n    border-bottom: 1px solid rgba(80, 70, 58, 0.25);\\n    -webkit-overflow-scrolling: touch;\\n    scrollbar-width: none;\\n    position: relative;\\n    mask-image: linear-gradient(to right, black 85%, transparent 100%);\\n    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);\\n  }\\n\\n  .research-sidebar-chips::-webkit-scrollbar {\\n    display: none;\\n  }\\n\\n  .sidebar-chip {\\n    background: rgba(255, 255, 255, 0.03);\\n    border: 1px solid rgba(120, 108, 90, 0.3);\\n    border-radius: 20px;\\n    color: #b0a89c;\\n    padding: 5px 12px;\\n    font-size: 0.75rem;\\n    cursor: pointer;\\n    white-space: nowrap;\\n    flex-shrink: 0;\\n    transition: all 0.18s ease;\\n    font-family: 'Inter', -apple-system, sans-serif;\\n    font-weight: 500;\\n  }\\n\\n  .sidebar-chip:hover {\\n    background: rgba(255, 255, 255, 0.06);\\n    color: #d4ccc0;\\n  }\\n\\n  .sidebar-chip.active {\\n    background: rgba(194, 99, 90, 0.15);\\n    color: #f4ede4;\\n    border-color: rgba(194, 99, 90, 0.4);\\n    font-weight: 600;\\n  }\\n\\n  .research-content {\\n    padding: 16px;\\n  }\\n\\n  .research-view-bar {\\n    flex-direction: column;\\n    align-items: stretch;\\n  }\\n\\n  .research-priority-pills {\\n    justify-content: center;\\n  }\\n}\\n\\n/* ── Smooth transitions ── */\\n\\n.research-list {\\n  animation: research-list-in 0.15s ease-out;\\n}\\n\\n@keyframes research-list-in {\\n  from { opacity: 0.6; }\\n  to { opacity: 1; }\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/runtime/api.js\"\n/*!*****************************************************!*\\\n  !*** ./node_modules/css-loader/dist/runtime/api.js ***!\n  \\*****************************************************/\n(module) {\n\n\"use strict\";\n\n\n/*\n  MIT License http://www.opensource.org/licenses/mit-license.php\n  Author Tobias Koppers @sokra\n*/\nmodule.exports = function (cssWithMappingToString) {\n  var list = [];\n\n  // return the list of modules as css string\n  list.toString = function toString() {\n    return this.map(function (item) {\n      var content = \"\";\n      var needLayer = typeof item[5] !== \"undefined\";\n      if (item[4]) {\n        content += \"@supports (\".concat(item[4], \") {\");\n      }\n      if (item[2]) {\n        content += \"@media \".concat(item[2], \" {\");\n      }\n      if (needLayer) {\n        content += \"@layer\".concat(item[5].length > 0 ? \" \".concat(item[5]) : \"\", \" {\");\n      }\n      content += cssWithMappingToString(item);\n      if (needLayer) {\n        content += \"}\";\n      }\n      if (item[2]) {\n        content += \"}\";\n      }\n      if (item[4]) {\n        content += \"}\";\n      }\n      return content;\n    }).join(\"\");\n  