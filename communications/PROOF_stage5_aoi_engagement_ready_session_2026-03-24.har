ween;\n  padding: 14px 18px;\n  border-bottom: 1px solid #334155;\n}\n\n.research-dialog-header h3 {\n  margin: 0;\n  font-size: 1rem;\n  font-weight: 600;\n  color: #e2e8f0;\n}\n\n.research-dialog-close {\n  background: none;\n  border: none;\n  color: #64748b;\n  font-size: 1.4rem;\n  cursor: pointer;\n  padding: 2px 6px;\n  line-height: 1;\n}\n\n.research-dialog-close:hover {\n  color: #cbd5e1;\n}\n\n.research-source-context {\n  padding: 12px 18px;\n  background: #0f172a;\n  border-bottom: 1px solid #1e293b;\n}\n\n.research-source-label {\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: #64748b;\n  margin-right: 6px;\n}\n\n.research-source-title {\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #94a3b8;\n}\n\n.research-source-text {\n  font-size: 0.78rem;\n  color: #64748b;\n  margin-top: 4px;\n  line-height: 1.4;\n}\n\n.research-loading {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 14px 18px;\n  color: #94a3b8;\n  font-size: 0.85rem;\n}\n\n.research-spinner {\n  display: inline-block;\n  width: 16px;\n  height: 16px;\n  border: 2px solid #334155;\n  border-top-color: #6366f1;\n  border-radius: 50%;\n  animation: research-spin 0.6s linear infinite;\n}\n\n@keyframes research-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* === Generate AI Suggestion button row === */\n.research-generate-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 18px;\n}\n\n.research-btn-generate {\n  background: transparent;\n  border: 1px solid #6366f1;\n  color: #6366f1;\n  padding: 6px 14px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 13px;\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  transition: all 0.15s;\n}\n\n.research-btn-generate:hover:not(:disabled) {\n  background: #6366f1;\n  color: #fff;\n}\n\n.research-btn-generate:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.research-generated-badge {\n  font-size: 11px;\n  color: #6366f1;\n  background: rgba(99, 102, 241, 0.1);\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.research-error {\n  padding: 10px 18px;\n  color: #fca5a5;\n  font-size: 0.82rem;\n  background: rgba(239, 68, 68, 0.1);\n}\n\n.research-form {\n  padding: 14px 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.research-label {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.research-label-half {\n  flex: 1 1;\n}\n\n.research-row {\n  display: flex;\n  gap: 12px;\n}\n\n.research-textarea,\n.research-input,\n.research-select {\n  background: #0f172a;\n  border: 1px solid #334155;\n  border-radius: 6px;\n  color: #e2e8f0;\n  padding: 8px 10px;\n  font-size: 0.85rem;\n  font-family: inherit;\n  outline: none;\n  resize: vertical;\n}\n\n.research-textarea:focus,\n.research-input:focus,\n.research-select:focus {\n  border-color: #6366f1;\n}\n\n.research-textarea-sm {\n  font-size: 0.82rem;\n}\n\n.research-select {\n  cursor: pointer;\n}\n\n.research-scope-details {\n  border: 1px solid #334155;\n  border-radius: 6px;\n  padding: 8px 12px;\n}\n\n.research-scope-details summary {\n  cursor: pointer;\n  font-size: 0.78rem;\n  font-weight: 600;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.research-scope-details[open] summary {\n  margin-bottom: 10px;\n}\n\n.research-dialog-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 12px 18px;\n  border-top: 1px solid #334155;\n}\n\n.research-btn {\n  padding: 7px 16px;\n  border-radius: 6px;\n  border: none;\n  font-size: 0.82rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background 0.15s;\n}\n\n.research-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.research-btn-secondary {\n  background: #334155;\n  color: #94a3b8;\n}\n\n.research-btn-secondary:hover:not(:disabled) {\n  background: #475569;\n}\n\n.research-btn-draft {\n  background: #475569;\n  color: #e2e8f0;\n}\n\n.research-btn-draft:hover:not(:disabled) {\n  background: #64748b;\n}\n\n.research-btn-queue {\n  background: #6366f1;\n  color: #fff;\n}\n\n.research-btn-queue:hover:not(:disabled) {\n  background: #4f46e5;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/ResearchFlagDialog.css\"],\"names\":[],\"mappings\":\"AAAA,iEAAiE;;AAEjE;EACE,eAAe;EACf,QAAQ;EACR,8BAA8B;EAC9B,aAAa;EACb,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,0CAA0C;AAC5C;;AAEA;EACE,OAAO,UAAU,EAAE;EACnB,KAAK,UAAU,EAAE;AACnB;;AAEA;EACE,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,YAAY;EACZ,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,0CAA0C;AAC5C;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,kBAAkB;EAClB,gCAAgC;AAClC;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,iBAAiB;EACjB,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,kBAAkB;EAClB,mBAAmB;EACnB,gCAAgC;AAClC;;AAEA;EACE,iBAAiB;EACjB,yBAAyB;EACzB,sBAAsB;EACtB,cAAc;EACd,iBAAiB;AACnB;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,kBAAkB;EAClB,cAAc;EACd,kBAAkB;AACpB;;AAEA;EACE,qBAAqB;EACrB,WAAW;EACX,YAAY;EACZ,yBAAyB;EACzB,yBAAyB;EACzB,kBAAkB;EAClB,6CAA6C;AAC/C;;AAEA;EACE,KAAK,yBAAyB,EAAE;AAClC;;AAEA,8CAA8C;AAC9C;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;AACnB;;AAEA;EACE,uBAAuB;EACvB,yBAAyB;EACzB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,eAAe;EACf,eAAe;EACf,gBAAgB;EAChB,oBAAoB;EACpB,mBAAmB;EACnB,QAAQ;EACR,qBAAqB;AACvB;;AAEA;EACE,mBAAmB;EACnB,WAAW;AACb;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,mCAAmC;EACnC,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,kCAAkC;AACpC;;AAEA;EACE,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;EACR,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EA