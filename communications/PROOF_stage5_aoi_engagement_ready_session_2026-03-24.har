AAqC;AACvC;;AAEA;EACE,UAAU;EACV,WAAW;EACX,kBAAkB;EAClB,mBAAmB;EACnB,aAAa;EACb,cAAc;AAChB;;AAEA;;wDAEwD;;AAExD;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,gBAAgB;EAChB,kBAAkB;EAClB,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,eAAe;EACf,gBAAgB;AAClB;;AAEA,6CAA6C;AAC7C;EACE,UAAU;EACV,WAAW;EACX,kBAAkB;EAClB,mBAAmB;EACnB,cAAc;AAChB;;AAEA,2CAA2C;;AAE3C;EACE,oBAAoB;EACpB,mBAAmB;EACnB,QAAQ;EACR,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,kBAAkB;EAClB,qBAAqB;EACrB,mBAAmB;EACnB,yBAAyB;EACzB,gBAAgB;AAClB;;AAEA;EACE,aAAa;AACf;;AAEA,2CAA2C;AAC3C;EACE,mCAAmC;EACnC,cAAc;EACd,yCAAyC;EACzC,gBAAgB;AAClB;;AAEA,4DAA4D;AAC5D;EACE,eAAe;EACf,yBAAiB;UAAjB,iBAAiB;AACnB;;AAEA;EACE,mCAAmC;EACnC,UAAU;AACZ;;AAEA;EACE,cAAc;EACd,YAAY;EACZ,2BAA2B;EAC3B,qBAAqB;AACvB;;AAEA;EACE,wBAAwB;AAC1B;;AAEA;EACE,cAAc;EACd,YAAY;AACd;;AAEA;EACE,cAAc;EACd,kCAAkC;EAClC,cAAc;EACd,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,gBAAgB;AAClB;;AAEA,0CAA0C;AAC1C;EACE,oBAAoB;EACpB,mBAAmB;EACnB,MAAM;EACN,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,cAAc;EACd,eAAe;EACf,aAAa;EACb,cAAc;AAChB;;AAEA,oBAAoB;AACpB;EACE,qCAAqC;EACrC,cAAc;EACd,gBAAgB;EAChB,cAAc;EACd,kCAAkC;AACpC;;AAEA;EACE,gBAAgB;EAChB,gBAAgB;EAChB,aAAa;AACf;;AAEA,oBAAoB;AACpB;EACE,oCAAoC;EACpC,cAAc;EACd,yCAAyC;AAC3C;;AAEA,8BAA8B;AAC9B;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA,yBAAyB;AACzB;EACE,oCAAoC;EACpC,cAAc;EACd,0CAA0C;EAC1C,4DAA4D;EAC5D,gBAAgB;AAClB;;AAEA,8CAA8C;AAC9C;EACE,cAAc;EACd,gBAAgB;EAChB,kBAAkB;EAClB,gBAAgB;EAChB,0BAA0B;AAC5B;;AAEA,6BAA6B;AAC7B;EACE,oCAAoC;EACpC,cAAc;EACd,cAAc;AAChB;;AAEA,qBAAqB;AACrB;EACE,mCAAmC;EACnC,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,mCAAmC;EACnC,cAAc;EACd,gBAAgB;AAClB;;AAEA;;wDAEwD;;AAExD;EACE,kBAAkB;EAClB,oBAAoB;EACpB,mBAAmB;EACnB,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,uBAAuB;EACvB,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA,8DAA8D;;AAE9D;EACE,kBAAkB;EAClB,qBAAqB;EACrB,QAAQ;EACR,YAAY;EACZ,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,yEAAyE;EACzE,kBAAkB;EAClB,gBAAgB;EAChB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,qBAAqB;EACrB,QAAQ;EACR,kBAAkB;EAClB,eAAe;AACjB;;AAEA;EACE,gBAAgB;AAClB;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,cAAc;EACd,yBAAyB;EACzB,sBAAsB;EACtB,mBAAmB;EACnB,eAAe;AACjB;;AAEA;EACE,4DAA4D;EAC5D,iBAAiB;EACjB,cAAc;EACd,mBAAmB;EACnB,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,cAAc;EACd,qBAAqB;EACrB,iDAAiD;EACjD,iBAAiB;AACnB;;AAEA;EACE,0BAA0B;EAC1B,4BAA4B;AAC9B;;AAEA;EACE,aAAa;EACb,eAAe;EACf,QAAQ;AACV;;AAEA;EACE,gBAAgB;EAChB,gBAAgB;EAChB,kBAAkB;EAClB,mBAAmB;EACnB,cAAc;EACd,4DAA4D;AAC9D;;AAEA;;wDAEwD;;AAExD;EACE,gBAAgB;EAChB,6BAA6B;AAC/B;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,cAAc;EACd,eAAe;EACf,yBAAiB;UAAjB,iBAAiB;EACjB,yBAAyB;AAC3B;;AAEA;EACE,YAAY;AACd;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,gBAAgB;AAClB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,gBAAgB;EAChB,iBAAiB;EACjB,oCAAoC;EACpC,8CAA8C;EAC9C,0BAA0B;AAC5B;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA,+CAA+C;;AAE/C;EACE,kBAAkB;AACpB;;AAEA;EACE,gCAAgC;AAClC;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,gBAAgB;EAChB,eAAe;EACf,eAAe;EACf,kBAAkB;EAClB,4BAA4B;EAC5B,gBAAgB;AAClB;;AAEA;EACE,aAAa;AACf;;AAEA;EACE,WAAW;AACb;;AAEA;EACE,+BAA+B;AACjC;;AAEA;EACE,cAAc;EACd,cAAc;EACd,oCAAoC;EACpC,gBAAgB;EAChB,kBAAkB;EAClB,gBAAgB;EAChB,iBAAiB;EACjB,mBAAmB;AACrB;;AAEA;EACE,0BAA0B;EAC1B,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,eAAe;EACf,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,cAAc;EACd,kBAAkB;AACpB;;AAEA;EACE,SAAS;EACT,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,kBAAkB;AACpB;;AAEA,qCAAqC;;AAErC;EACE,oCAAoC;EACpC,cAAc;EACd,0CAA0C;EAC1C,gBAAgB;EAChB,cAAc;EACd,YAAY;AACd\",\"sourcesContent\":[\"/* ============= PROVENANCE OVERLAY ============= */\\n/* Developer tool tracing data through the analysis pipeline.            */\\n/* Design: minimal, monochrome with muted accent. Not a dashboard —     */\\n/* a quiet overlay that stays out of the way until you need it.         */\\n\\n/* ── Toggle Button ── */\\n\\n.prov-toggle {\\n  font-size: 0.78rem !important;\\n  opacity: 0.55;\\n  transition: opacity 0.15s;\\n}\\n\\n.prov-toggle:hover {\\n  opacity: 1;\\n}\\n\\n.prov-toggle--active {\\n  opacity: 1;\\n  color: #b5343a !important;\\n  font-weight: 600;\\n}\\n\\n/* ═══════════════════════════════════════════════════\\n   LAYER 1 — Summary Panel\\n   ═══════════════════════════════════════════════════ */\\n\\n.prov-summary {\\n  background: #faf9f7;\\n  border: 1px solid #e8e5e1;\\n  border-radius: 6px;\\n  margin-bottom: 10px;\\n  overflow: hidden;\\n}\\n\\n.prov-summary--loading {\\n  opacity: 0.6;\\n}\\n\\n/* Header bar */\\n\\n.prov-summary__header {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 7px 14px;\\n  cursor: pointer;\\n  user-select: none;\\n  background: #f3f1ed;\\n  border-bottom: 1px solid transparent;\\n  transition: background 0.15s;\\n}\\n\\n.prov-summary__header:hover {\\n  background: #ebe8e4;\\n}\\n\\n.prov-summary--expanded .prov-summary__header {\\n  border-bottom-color: #e8e5e1;\\n}\\n\\n.prov-summary__toggle {\\n  font-size: 9px;\\n  color: #94a3b8;\\n  width: 14px;\\n  text-align: center;\\n  transition: transform 0.2s;\\n}\\n\\n.prov-summary--expanded .prov-summary__toggle {\\n  transform: rotate(90deg);\\n}\\n\\n.prov-summary__title {\\n  font-size: 11px;\\n  font-weight: 600;\\n  color: #64748b;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.prov-summary__loading-text {\\n  font-size: 11px;\\n  color: #94a3b8;\\n  font-style: italic;\\n}\\n\\n.prov-summary__stats {\\n  font-size: 11px;\\n  color: #94a3b8;\\n  margin-left: auto;\\n  display: flex;\\n  gap: 14px;\\n}\\n\\n.prov-stat {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 3px;\\n}\\n\\n.prov-stat__value {\\n  font-weight: 600;\\n  color: #64748b;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n/* Body */\\n\\n.prov-summary__body {\\n  padding: 10px 14px 12px;\\n}\\n\\n.prov-summary__empty {\\n  font-size: 11px;\\n  color: #94a3b8;\\n  font-style: italic;\\n}\\n\\n/* ── Phase Table ── */\\n\\n.prov-phase-table {\\n  width: 100%;\\n  border-collapse: collapse;\\n  font-size: 11px;\\n}\\n\\n.prov-phase-table th {\\n  font-size: 9px;\\n  font-weight: 600;\\n  color: #94a3b8;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n  text-align: left;\\n  padding: 0 8px 5px;\\n  border-bottom: 1px solid #e8e5e1;\\n}\\n\\n.prov-phase-table td {\\n  padding: 6px 8px;\\n  color: #475569;\\n  border-bottom: 1px solid #f0ede9;\\n  vertical-align: middle;\\n}\\n\\n.prov-phase-table tr:last-child td {\\n  border-bottom: none;\\n}\\n\\n.prov-phase--skipped td {\\n  opacity: 0.35;\\n}\\n\\n.prov-phase-num {\\n  font-weight: 700;\\n  color: #94a3b8;\\n  font-size: 10px;\\n  margin-right: 6px;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.prov-phase-name {\\n  color: #334155;\\n  font-weight: 500;\\n}\\n\\n.prov-phase-tag {\\n  font-size: 9px;\\n  color: #b45309;\\n  background: rgba(245, 158, 11, 0.1);\\n  padding: 1px 4px;\\n  border-radius: 3px;\\n  margin-left: 6px;\\n  font-weight: 500;\\n  vertical-align: middle;\\n}\\n\\n/* Duration + token columns */\\n\\n.prov-phase-duration,\\n.prov-phase-tokens {\\n  font-variant-numeric: tabular-nums;\\n  font-size: 10px;\\n  color: #64748b;\\n  white-space: nowrap;\\n}\\n\\n.prov-phase-no-engines {\\n  color: #cbd5e1;\\n  font-style: italic;\\n  font-size: 10px;\\n}\\n\\n/* Depth badges */\\n\\n.prov-depth {\\n  font-size: 9px;\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.02em;\\n}\\n\\n.prov-depth--surface {\\n  background: rgba(148, 163, 184, 0.12);\\n  color: #94a3b8;\\n}\\n\\n.prov-depth--standard {\\n  background: rgba(59, 130, 246, 0.08);\\n  color: #6b93d6;\\n}\\n\\n.prov-depth--deep {\\n  background: rgba(139, 92, 246, 0.08);\\n  color: #9b7ed8;\\n}\\n\\n/* Model badges */\\n\\n.prov-model {\\n  font-size: 9px;\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.02em;\\n}\\n\\n.prov-model--opus {\\n  background: rgba(181, 52, 58, 0.08);\\n  color: #c06065;\\n}\\n\\n.prov-model--sonnet {\\n  background: rgba(59, 130, 246, 0.08);\\n  color: #6b93d6;\\n}\\n\\n.prov-model--gemini {\\n  background: rgba(66, 133, 244, 0.12);\\n  color: #4285f4;\\n}\\n\\n.prov-model--openrouter {\\n  background: rgba(16, 185, 129, 0.1);\\n  color: #34d399;\\n}\\n\\n.prov-model--haiku {\\n  background: rgba(139, 92, 246, 0.08);\\n  color: #a78bfa;\\n}\\n\\n/* Model pill in ProvenanceBadge */\\n.prov-pill--model {\\n  font-weight: 600;\\n  font-size: 9px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n}\\n\\n.prov-pill--model-gemini {\\n  background: rgba(66, 133, 244, 0.15);\\n  color: #4285f4;\\n  border-color: rgba(66, 133, 244, 0.25);\\n}\\n\\n.prov-pill--model-opus {\\n  background: rgba(181, 52, 58, 0.12);\\n  color: #c06065;\\n  border-color: rgba(181, 52, 58, 0.25);\\n}\\n\\n/* OpenRouter model names (e.g. deepseek-r1, qwen-3-235b) */\\n[class*=\\\"prov-pill--model-deepseek\\\"],\\n[class*=\\\"prov-pill--model-qwen\\\"],\\n[class*=\\\"prov-pill--model-llama\\\"] {\\n  background: rgba(16, 185, 129, 0.12);\\n  color: #34d399;\\n  border-color: rgba(16, 185, 129, 0.25);\\n}\\n\\n/* Engine column */\\n\\n.prov-phase-engines {\\n  max-width: 480px;\\n}\\n\\n.prov-phase-chain-label {\\n  font-size: 10px;\\n  font-weight: 600;\\n  color: #64748b;\\n  display: block;\\n  margin-bottom: 3px;\\n}\\n\\n.prov-phase-blend {\\n  font-weight: 400;\\n  color: #94a3b8;\\n  font-size: 9px;\\n  margin-left: 3px;\\n}\\n\\n.prov-engine-flow {\\n  display: flex;\\n  align-items: center;\\n  gap: 0;\\n  flex-wrap: wrap;\\n}\\n\\n.prov-engine-chip {\\n  font-size: 10px;\\n  color: #64748b;\\n  text-decoration: none;\\n  padding: 1px 6px;\\n  border-radius: 3px;\\n  background: rgba(0, 0, 0, 0.03);\\n  border: 1px solid rgba(0, 0, 0, 0.06);\\n  transition: background 0.12s, color 0.12s;\\n  white-space: nowrap;\\n}\\n\\n.prov-engine-chip:hover {\\n  background: rgba(181, 52, 58, 0.06);\\n  color: #b5343a;\\n  border-color: rgba(181, 52, 58, 0.15);\\n}\\n\\n.prov-flow-dot {\\n  width: 3px;\\n  height: 3px;\\n  border-radius: 50%;\\n  background: #cbd5e1;\\n  margin: 0 4px;\\n  flex-shrink: 0;\\n}\\n\\n/* ═══════════════════════════════════════════════════\\n   LAYER 2 — Per-View Badge\\n   ═══════════════════════════════════════════════════ */\\n\\n.prov-badge2 {\\n  display: flex;\\n  align-items: center;\\n  gap: 5px;\\n  padding: 4px 8px;\\n  margin-bottom: 8px;\\n  background: #f8f7f5;\\n  border: 1px solid #ece9e4;\\n  border-radius: 5px;\\n  flex-wrap: wrap;\\n  min-height: 24px;\\n}\\n\\n/* Subtle separator dot between pill groups */\\n.prov-badge2__sep {\\n  width: 3px;\\n  height: 3px;\\n  border-radius: 50%;\\n  background: #d4d0cb;\\n  flex-shrink: 0;\\n}\\n\\n/* Pills — uniform shape, different tints */\\n\\n.prov-pill {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 3px;\\n  font-size: 10px;\\n  font-weight: 500;\\n  padding: 2px 7px;\\n  border-radius: 3px;\\n  text-decoration: none;\\n  white-space: nowrap;\\n  transition: opacity 0.12s;\\n  line-height: 1.3;\\n}\\n\\n.prov-pill:hover {\\n  opacity: 0.75;\\n}\\n\\n/* Source (chain or engine) — warm accent */\\n.prov-pill--source {\\n  background: rgba(181, 52, 58, 0.07);\\n  color: #9b4049;\\n  border: 1px solid rgba(181, 52, 58, 0.12);\\n  font-weight: 600;\\n}\\n\\n/* Chain toggle — clickable to expand/collapse engine list */\\n.prov-pill--chain-toggle {\\n  cursor: pointer;\\n  user-select: none;\\n}\\n\\n.prov-pill--chain-toggle:hover {\\n  background: rgba(181, 52, 58, 0.12);\\n  opacity: 1;\\n}\\n\\n.prov-pill__chevron {\\n  font-size: 9px;\\n  opacity: 0.5;\\n  transition: transform 0.15s;\\n  display: inline-block;\\n}\\n\\n.prov-pill__chevron--open {\\n  transform: rotate(90deg);\\n}\\n\\n.prov-pill__icon {\\n  font-size: 9px;\\n  opacity: 0.6;\\n}\\n\\n.prov-pill__count {\\n  font-size: 9px;\\n  background: rgba(181, 52, 58, 0.1);\\n  color: #b5343a;\\n  padding: 0 4px;\\n  border-radius: 2px;\\n  font-weight: 700;\\n  margin-left: 1px;\\n}\\n\\n/* Inline chain engines (unfurled state) */\\n.prov-chain-engines {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0;\\n  flex-wrap: wrap;\\n  margin-left: 2px;\\n}\\n\\n.prov-chain-arrow {\\n  color: #cbd5e1;\\n  font-size: 10px;\\n  margin: 0 3px;\\n  flex-shrink: 0;\\n}\\n\\n/* Phase — neutral */\\n.prov-pill--phase {\\n  background: rgba(100, 116, 139, 0.08);\\n  color: #64748b;\\n  font-weight: 700;\\n  font-size: 9px;\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n.prov-pill__phase-name {\\n  font-weight: 500;\\n  margin-left: 3px;\\n  opacity: 0.75;\\n}\\n\\n/* Renderer — cool */\\n.prov-pill--renderer {\\n  background: rgba(139, 92, 246, 0.06);\\n  color: #7c6bad;\\n  border: 1px solid rgba(139, 92, 246, 0.1);\\n}\\n\\n/* Extraction — warm-neutral */\\n.prov-pill--extraction {\\n  background: rgba(245, 158, 11, 0.06);\\n  color: #a37729;\\n}\\n\\n/* View key — blue-gray */\\n.prov-pill--view {\\n  background: rgba(59, 130, 246, 0.05);\\n  color: #6b8cba;\\n  border: 1px solid rgba(59, 130, 246, 0.08);\\n  font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;\\n  font-size: 9.5px;\\n}\\n\\n/* Stance — uses existing stance-pill colors */\\n.prov-pill--stance {\\n  font-size: 9px;\\n  padding: 2px 6px;\\n  border-radius: 8px;\\n  font-weight: 600;\\n  text-transform: capitalize;\\n}\\n\\n/* Data quality — teal tint */\\n.prov-pill--quality {\\n  background: rgba(20, 184, 166, 0.06);\\n  color: #0d9488;\\n  font-size: 9px;\\n}\\n\\n/* Quality degraded */\\n.prov-pill--quality-thin {\\n  background: rgba(234, 179, 8, 0.08);\\n  color: #a37729;\\n  font-weight: 600;\\n}\\n\\n.prov-pill--quality-empty {\\n  background: rgba(239, 68, 68, 0.06);\\n  color: #b95050;\\n  font-weight: 600;\\n}\\n\\n/* ═══════════════════════════════════════════════════\\n   LAYER 3 — Section Icon + Popover\\n   ═══════════════════════════════════════════════════ */\\n\\n.prov-section-icon {\\n  position: relative;\\n  display: inline-flex;\\n  align-items: center;\\n  cursor: pointer;\\n  margin-left: 6px;\\n}\\n\\n.prov-section-icon__glyph {\\n  font-size: 14px;\\n  color: #94a3b8;\\n  transition: color 0.15s;\\n  line-height: 1;\\n}\\n\\n.prov-section-icon:hover .prov-section-icon__glyph {\\n  color: #b5343a;\\n}\\n\\n/* Popover — right-aligned since icons are on the right side */\\n\\n.prov-section-popover {\\n  position: absolute;\\n  top: calc(100% + 4px);\\n  right: 0;\\n  z-index: 100;\\n  background: #ffffff;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 6px;\\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);\\n  padding: 10px 14px;\\n  min-width: 220px;\\n  max-width: 340px;\\n}\\n\\n.prov-section-popover__row {\\n  display: flex;\\n  align-items: baseline;\\n  gap: 6px;\\n  margin-bottom: 5px;\\n  font-size: 11px;\\n}\\n\\n.prov-section-popover__row:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.prov-section-popover__label {\\n  font-weight: 600;\\n  color: #94a3b8;\\n  font-size: 9px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n  white-space: nowrap;\\n  min-width: 72px;\\n}\\n\\n.prov-section-popover__code {\\n  font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;\\n  font-size: 10.5px;\\n  color: #334155;\\n  background: #f5f3f0;\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n}\\n\\n.prov-section-popover__link {\\n  color: #9b4049;\\n  text-decoration: none;\\n  border-bottom: 1px dotted rgba(181, 52, 58, 0.25);\\n  font-size: 10.5px;\\n}\\n\\n.prov-section-popover__link:hover {\\n  border-bottom-style: solid;\\n  border-bottom-color: #b5343a;\\n}\\n\\n.prov-section-popover__chips {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 3px;\\n}\\n\\n.prov-section-popover__chip {\\n  font-size: 9.5px;\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n  background: #f5f3f0;\\n  color: #64748b;\\n  font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;\\n}\\n\\n/* ═══════════════════════════════════════════════════\\n   DECISION RATIONALE — Collapsible section in Summary\\n   ═══════════════════════════════════════════════════ */\\n\\n.prov-decision-rationale {\\n  margin-top: 10px;\\n  border-top: 1px solid #e8e5e1;\\n}\\n\\n.prov-decision-rationale__header {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 7px 0;\\n  cursor: pointer;\\n  user-select: none;\\n  transition: opacity 0.15s;\\n}\\n\\n.prov-decision-rationale__header:hover {\\n  opacity: 0.8;\\n}\\n\\n.prov-decision-rationale__title {\\n  font-size: 10px;\\n  font-weight: 600;\\n  color: #7c6bad;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.prov-decision-rationale__body {\\n  padding: 0 0 4px;\\n}\\n\\n.prov-decision-rationale__strategy {\\n  font-size: 11px;\\n  color: #475569;\\n  line-height: 1.5;\\n  margin: 0 0 10px;\\n  padding: 6px 10px;\\n  background: rgba(139, 92, 246, 0.04);\\n  border-left: 2px solid rgba(139, 92, 246, 0.2);\\n  border-radius: 0 4px 4px 0;\\n}\\n\\n.prov-decision-rationale__phases {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 2px;\\n}\\n\\n/* Individual phase decision (uses <details>) */\\n\\n.prov-decision-phase {\\n  border-radius: 4px;\\n}\\n\\n.prov-decision-phase[open] {\\n  background: rgba(0, 0, 0, 0.015);\\n}\\n\\n.prov-decision-phase__summary {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  padding: 4px 6px;\\n  cursor: pointer;\\n  font-size: 11px;\\n  border-radius: 4px;\\n  transition: background 0.12s;\\n  list-style: none;\\n}\\n\\n.prov-decision-phase__summary::-webkit-details-marker {\\n  display: none;\\n}\\n\\n.prov-decision-phase__summary::marker {\\n  content: '';\\n}\\n\\n.prov-decision-phase__summary:hover {\\n  background: rgba(0, 0, 0, 0.03);\\n}\\n\\n.prov-decision-phase__engine {\\n  font-size: 9px;\\n  color: #7c6bad;\\n  background: rgba(139, 92, 246, 0.06);\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n  font-weight: 600;\\n  margin-left: auto;\\n  white-space: nowrap;\\n}\\n\\n.prov-decision-phase__details {\\n  padding: 4px 10px 8px 28px;\\n  font-size: 11px;\\n  color: #475569;\\n  line-height: 1.5;\\n}\\n\\n.prov-decision-phase__details p {\\n  margin: 0 0 4px;\\n}\\n\\n.prov-decision-phase__details strong {\\n  color: #64748b;\\n  font-weight: 600;\\n  font-size: 10px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.02em;\\n}\\n\\n.prov-decision-phase__alts {\\n  margin-top: 4px;\\n}\\n\\n.prov-decision-phase__alts strong {\\n  display: block;\\n  margin-bottom: 2px;\\n}\\n\\n.prov-decision-phase__alts ul {\\n  margin: 0;\\n  padding-left: 16px;\\n}\\n\\n.prov-decision-phase__alts li {\\n  font-size: 10px;\\n  color: #64748b;\\n  margin-bottom: 1px;\\n}\\n\\n/* ── Why? pill (per-view badge) ── */\\n\\n.prov-pill--why {\\n  background: rgba(139, 92, 246, 0.08);\\n  color: #7c6bad;\\n  border: 1px solid rgba(139, 92, 246, 0.15);\\n  font-weight: 600;\\n  font-size: 9px;\\n  cursor: help;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/wizard/FeatureAvailability.css\"\n/*!**************************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/wizard/FeatureAvailability.css ***!\n  \\*********************************************