ACzB,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,mBAAmB;EACnB,iBAAiB;EACjB,gBAAgB;EAChB,yBAAyB;AAC3B;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,kCAAkC;EAClC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,SAAS;EACT,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,gBAAgB;EAChB,iBAAiB;EACjB,6BAA6B;AAC/B;;AAEA,UAAU;AACV;;;;;;;;EAQE,SAAS;EACT,kBAAkB;AACpB;;AAEA;;;;;;;;EAQE,mBAAmB;EACnB,gBAAgB;EAChB,cAAc;AAChB;;AAEA,mBAAmB;AACnB;EACE,mCAAmC;EACnC,yCAAyC;EACzC,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,mBAAmB;EACnB,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,SAAS;EACT,iBAAiB;AACnB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA,kBAAkB;AAClB;EACE,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,kBAAkB;EAClB,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,cAAc;AAChB;;AAEA,kBAAkB;AAClB;EACE,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,iBAAiB;EACjB,mBAAmB;EACnB,WAAW;AACb;;AAEA;;EAEE,gBAAgB;AAClB;;AAEA;;EAEE,eAAe;EACf,kBAAkB;AACpB;;AAEA;EACE,cAAc;AAChB;;AAEA,kBAAkB;AAClB;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,kBAAkB;EAClB,kBAAkB;EAClB,sBAAsB;AACxB;;AAEA;EACE,mCAAmC;EACnC,0BAA0B;EAC1B,yCAAyC;EACzC,8BAA8B;AAChC;;AAEA;EACE,mCAAmC;EACnC,0BAA0B;EAC1B,yCAAyC;EACzC,8BAA8B;AAChC;;AAEA;EACE,kCAAkC;EAClC,0BAA0B;EAC1B,wCAAwC;EACxC,8BAA8B;AAChC;;AAEA;EACE,mCAAmC;EACnC,0BAA0B;EAC1B,yCAAyC;EACzC,8BAA8B;AAChC;;AAEA;EACE,mCAAmC;EACnC,0BAA0B;EAC1B,yCAAyC;EACzC,8BAA8B;AAChC;;AAEA;EACE,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,cAAc;EACd,iBAAiB;EACjB,aAAa;AACf;;AAEA;EACE,cAAc;EACd,gBAAgB;EAChB,kBAAkB;EAClB,cAAc;EACd,mBAAmB;EACnB,kBAAkB;AACpB;;AAEA;EACE,SAAS;EACT,cAAc;EACd,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA,iBAAiB;AACjB;EACE,mCAAmC;EACnC,yCAAyC;EACzC,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,mBAAmB;EACnB,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,SAAS;EACT,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,kBAAkB;AACpB;;AAEA;EACE,mCAAmC;EACnC,yCAAyC;AAC3C;;AAEA;EACE,kCAAkC;EAClC,wCAAwC;AAC1C;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,cAAc;AAChB;;AAEA;;EAEE,kBAAkB;EAClB,gBAAgB;EAChB,iBAAiB;EACjB,6CAA6C;EAC7C,cAAc;AAChB;;AAEA,uBAAuB;AACvB;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,mCAAmC;EACnC,yCAAyC;EACzC,kBAAkB;AACpB;;AAEA,eAAe;AACf;EACE;IACE,0BAA0B;EAC5B;;EAEA;IACE,gBAAgB;IAChB,kBAAkB;IAClB,gCAAgC;EAClC;;EAEA;IACE,gBAAgB;EAClB;AACF;;AAEA;EACE;IACE,aAAa;EACf;;EAEA;IACE,sBAAsB;IACtB,kBAAkB;EACpB;;EAEA;;IAEE,aAAa;EACf;;EAEA;IACE,sBAAsB;EACxB;;EAEA;IACE,sBAAsB;IACtB,SAAS;EACX;;EAEA;IACE,iBAAiB;IACjB,gBAAgB;IAChB,iCAAiC;EACnC;;EAEA;IACE,0BAA0B;EAC5B;;EAEA;IACE,sBAAsB;IACtB,SAAS;EACX;AACF;;AAEA,8BAA8B;AAC9B;EACE,kBAAkB;EAClB,cAAc;EACd,iBAAiB;AACnB\",\"sourcesContent\":[\"/* Cross-Corpus Concept Analysis Panel - Dark Theme */\\n/* Uses purple/magenta accent to distinguish from Big Picture (blue) */\\n\\n.cc-panel {\\n  background: #faf8f5;\\n  min-height: 100vh;\\n  color: #4a4a4a;\\n}\\n\\n/* Header */\\n.cc-header {\\n  padding: 32px 40px;\\n  background: linear-gradient(135deg, #faf8f5 0%, #faf8f5 100%);\\n  border-bottom: 1px solid #e0ddd8;\\n}\\n\\n.cc-header-content {\\n  display: flex;\\n  align-items: center;\\n  gap: 20px;\\n  max-width: 1400px;\\n  margin: 0 auto;\\n}\\n\\n.cc-header-icon {\\n  font-size: 2.5rem;\\n  background: linear-gradient(135deg, #9b59b6, #e91e63);\\n  -webkit-background-clip: text;\\n  background-clip: text;\\n  -webkit-text-fill-color: transparent;\\n}\\n\\n.cc-header h2 {\\n  margin: 0;\\n  font-size: 1.75rem;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.cc-subtitle {\\n  margin: 6px 0 0;\\n  color: #757575;\\n  font-size: 0.95rem;\\n}\\n\\n/* Error Display */\\n.cc-error {\\n  max-width: 1400px;\\n  margin: 16px auto;\\n  padding: 16px 24px;\\n  background: rgba(231, 76, 60, 0.15);\\n  border: 1px solid rgba(231, 76, 60, 0.5);\\n  border-radius: 8px;\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  color: #e74c3c;\\n}\\n\\n.cc-error-icon {\\n  font-size: 1.25rem;\\n}\\n\\n.cc-error span {\\n  flex: 1;\\n}\\n\\n.cc-error button {\\n  background: transparent;\\n  border: 1px solid #e74c3c;\\n  color: #e74c3c;\\n  padding: 4px 12px;\\n  border-radius: 4px;\\n  cursor: pointer;\\n  font-size: 1rem;\\n  transition: all 0.2s;\\n}\\n\\n.cc-error button:hover {\\n  background: #e74c3c;\\n  color: #1a1a1a;\\n}\\n\\n/* Main Layout - Two Column */\\n.cc-main-layout {\\n  display: grid;\\n  grid-template-columns: 480px 1fr;\\n  gap: 0;\\n  max-width: 1600px;\\n  margin: 0 auto;\\n  min-height: calc(100vh - 140px);\\n}\\n\\n/* Form Panel (Left) */\\n.cc-form-panel {\\n  background: #faf8f5;\\n  border-right: 1px solid #e0ddd8;\\n  padding: 24px;\\n  overflow-y: auto;\\n  max-height: calc(100vh - 140px);\\n}\\n\\n.cc-form-header {\\n  margin-bottom: 24px;\\n}\\n\\n.cc-form-badge {\\n  display: inline-block;\\n  padding: 6px 14px;\\n  background: linear-gradient(135deg, #9b59b6, #e91e63);\\n  border-radius: 20px;\\n  font-size: 0.85rem;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n/* Form Groups */\\n.cc-form-group {\\n  margin-bottom: 24px;\\n}\\n\\n.cc-label {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  margin-bottom: 10px;\\n  font-size: 0.85rem;\\n  font-weight: 500;\\n  color: #aaa;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.cc-label-icon {\\n  font-size: 1rem;\\n}\\n\\n.cc-selected-count {\\n  margin-left: auto;\\n  padding: 2px 10px;\\n  background: #9b59b6;\\n  border-radius: 12px;\\n  font-size: 0.75rem;\\n  color: #1a1a1a;\\n  text-transform: none;\\n}\\n\\n.cc-optional-badge {\\n  margin-left: 8px;\\n  padding: 2px 8px;\\n  background: #e0ddd8;\\n  border-radius: 4px;\\n  font-size: 0.7rem;\\n  color: #757575;\\n  text-transform: lowercase;\\n}\\n\\n/* Concept Input */\\n.cc-concept-input {\\n  width: 100%;\\n  padding: 14px 16px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  color: #4a4a4a;\\n  font-size: 1rem;\\n  transition: all 0.2s;\\n  box-sizing: border-box;\\n}\\n\\n.cc-concept-input:focus {\\n  outline: none;\\n  border-color: #9b59b6;\\n  box-shadow: 0 0 0 3px rgba(155, 89, 182, 0.2);\\n}\\n\\n.cc-concept-input::placeholder {\\n  color: #666;\\n}\\n\\n.cc-input-hint {\\n  margin: 8px 0 0;\\n  font-size: 0.8rem;\\n  color: #666;\\n}\\n\\n/* Corpus Grid */\\n.cc-corpus-grid {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 10px;\\n  max-height: 280px;\\n  overflow-y: auto;\\n  padding: 4px;\\n}\\n\\n.cc-corpus-grid::-webkit-scrollbar {\\n  width: 6px;\\n}\\n\\n.cc-corpus-grid::-webkit-scrollbar-track {\\n  background: #f5f3f0;\\n  border-radius: 3px;\\n}\\n\\n.cc-corpus-grid::-webkit-scrollbar-thumb {\\n  background: #4d4d6c;\\n  border-radius: 3px;\\n}\\n\\n/* Corpus Card - Modern Design */\\n.cc-corpus-card {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 10px 12px;\\n  background: linear-gradient(135deg, #faf8f5 0%, #f5f3f0 100%);\\n  border: 1px solid #e0ddd8;\\n  border-left: 3px solid var(--corpus-color, #9b59b6);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  position: relative;\\n}\\n\\n.cc-corpus-card:hover {\\n  background: linear-gradient(135deg, #f5f3f0 0%, #f5f3f0 100%);\\n  border-color: #4d4d6c;\\n  border-left-color: var(--corpus-color, #9b59b6);\\n  transform: translateX(2px);\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);\\n}\\n\\n.cc-corpus-card.cc-corpus-selected {\\n  background: linear-gradient(135deg,\\n    color-mix(in srgb, var(--corpus-color, #9b59b6) 12%, #faf8f5) 0%,\\n    color-mix(in srgb, var(--corpus-color, #9b59b6) 8%, #f5f3f0) 100%);\\n  border-color: var(--corpus-color, #9b59b6);\\n  border-left-width: 3px;\\n  box-shadow: 0 0 12px color-mix(in srgb, var(--corpus-color, #9b59b6) 20%, transparent);\\n}\\n\\n/* Custom Checkbox */\\n.cc-corpus-checkbox {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n}\\n\\n.cc-corpus-checkbox input {\\n  width: 16px;\\n  height: 16px;\\n  accent-color: var(--corpus-color, #9b59b6);\\n  cursor: pointer;\\n  border-radius: 3px;\\n}\\n\\n/* Thinker Avatar */\\n.cc-corpus-avatar {\\n  width: 28px;\\n  height: 28px;\\n  border-radius: 6px;\\n  background: var(--corpus-color, #9b59b6);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  font-size: 0.7rem;\\n  font-weight: 700;\\n  color: #1a1a1a;\\n  text-transform: uppercase;\\n  flex-shrink: 0;\\n}\\n\\n.cc-corpus-info {\\n  flex: 1;\\n  min-width: 0;\\n}\\n\\n.cc-corpus-name {\\n  display: block;\\n  font-weight: 600;\\n  font-size: 0.9rem;\\n  color: #1a1a1a;\\n  margin-bottom: 1px;\\n  letter-spacing: 0.01em;\\n}\\n\\n.cc-corpus-path {\\n  display: inline-block;\\n  font-size: 0.65rem;\\n  color: #757575;\\n  margin-bottom: 3px;\\n  font-family: 'JetBrains Mono', monospace;\\n  background: rgba(100, 100, 140, 0.15);\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n}\\n\\n.cc-corpus-stats {\\n  display: flex;\\n  gap: 12px;\\n}\\n\\n.cc-stat {\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n  font-size: 0.75rem;\\n  color: #9999bb;\\n  font-weight: 500;\\n}\\n\\n.cc-stat-icon {\\n  font-size: 0.75rem;\\n  opacity: 0.7;\\n}\\n\\n/* Selected card stats brighter */\\n.cc-corpus-card.cc-corpus-selected .cc-stat {\\n  color: #4a4a4a;\\n}\\n\\n.cc-corpus-card.cc-corpus-selected .cc-corpus-name {\\n  color: #1a1a1a;\\n  text-shadow: 0 0 10px rgba(255, 255, 255, 0.2);\\n}\\n\\n/* Selection Summary */\\n.cc-selection-summary {\\n  margin-top: 12px;\\n  padding: 10px 14px;\\n  background: rgba(155, 89, 182, 0.1);\\n  border: 1px solid rgba(155, 89, 182, 0.3);\\n  border-radius: 6px;\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  font-size: 0.85rem;\\n}\\n\\n.cc-summary-label {\\n  color: #9b59b6;\\n  font-weight: 500;\\n}\\n\\n.cc-summary-stat {\\n  color: #4a4a4a;\\n}\\n\\n.cc-summary-divider {\\n  color: #4d4d6c;\\n}\\n\\n/* Empty State */\\n.cc-empty-state {\\n  text-align: center;\\n  padding: 32px 20px;\\n  color: #666;\\n}\\n\\n.cc-empty-icon {\\n  font-size: 2.5rem;\\n  display: block;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-empty-state p {\\n  margin: 0 0 6px;\\n  font-size: 0.95rem;\\n  color: #757575;\\n}\\n\\n.cc-empty-hint {\\n  font-size: 0.8rem;\\n  color: #666;\\n}\\n\\n/* Works List */\\n.cc-works-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n  max-height: 200px;\\n  overflow-y: auto;\\n  padding: 4px;\\n}\\n\\n.cc-work-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 10px 12px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 6px;\\n  cursor: pointer;\\n  transition: all 0.15s;\\n}\\n\\n.cc-work-item:hover {\\n  border-color: #9b59b6;\\n}\\n\\n.cc-work-item input {\\n  width: 16px;\\n  height: 16px;\\n  accent-color: #9b59b6;\\n}\\n\\n.cc-work-title {\\n  flex: 1;\\n  font-size: 0.9rem;\\n  color: #4a4a4a;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.cc-work-thinker-badge {\\n  padding: 3px 10px;\\n  border-radius: 12px;\\n  font-size: 0.7rem;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n/* Guidance Input */\\n.cc-guidance-input {\\n  width: 100%;\\n  padding: 12px 14px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  color: #4a4a4a;\\n  font-size: 0.9rem;\\n  line-height: 1.5;\\n  resize: vertical;\\n  min-height: 80px;\\n  box-sizing: border-box;\\n  font-family: inherit;\\n}\\n\\n.cc-guidance-input:focus {\\n  outline: none;\\n  border-color: #9b59b6;\\n}\\n\\n.cc-guidance-input::placeholder {\\n  color: #666;\\n}\\n\\n/* Toggle Option */\\n.cc-form-options {\\n  margin-bottom: 20px;\\n}\\n\\n.cc-toggle-option {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  cursor: pointer;\\n  padding: 10px 0;\\n}\\n\\n.cc-toggle-option input {\\n  display: none;\\n}\\n\\n.cc-toggle-slider {\\n  width: 44px;\\n  height: 24px;\\n  background: #e0ddd8;\\n  border-radius: 12px;\\n  position: relative;\\n  transition: all 0.2s;\\n}\\n\\n.cc-toggle-slider::after {\\n  content: '';\\n  position: absolute;\\n  width: 18px;\\n  height: 18px;\\n  background: #888;\\n  border-radius: 50%;\\n  top: 3px;\\n  left: 3px;\\n  transition: all 0.2s;\\n}\\n\\n.cc-toggle-option input:checked + .cc-toggle-slider {\\n  background: #9b59b6;\\n}\\n\\n.cc-toggle-option input:checked + .cc-toggle-slider::after {\\n  left: 23px;\\n  background: #fff;\\n}\\n\\n.cc-toggle-label {\\n  font-size: 0.9rem;\\n  color: #aaa;\\n}\\n\\n/* Start Button */\\n.cc-start-button {\\n  width: 100%;\\n  padding: 16px 24px;\\n  background: linear-gradient(135deg, #9b59b6, #e91e63);\\n  border: none;\\n  border-radius: 8px;\\n  color: #1a1a1a;\\n  font-size: 1.05rem;\\n  font-weight: 600;\\n  cursor: pointer;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 10px;\\n  transition: all 0.2s;\\n}\\n\\n.cc-start-button:hover:not(:disabled) {\\n  transform: translateY(-2px);\\n  box-shadow: 0 8px 20px rgba(155, 89, 182, 0.4);\\n}\\n\\n.cc-start-button:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n  transform: none;\\n  box-shadow: none;\\n}\\n\\n.cc-btn-icon {\\n  font-size: 1.2rem;\\n}\\n\\n.cc-spinner {\\n  width: 20px;\\n  height: 20px;\\n  border: 2px solid rgba(255, 255, 255, 0.3);\\n  border-top-color: #fff;\\n  border-radius: 50%;\\n  animation: spin 0.8s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to { transform: rotate(360deg); }\\n}\\n\\n.cc-validation-hint {\\n  margin: 12px 0 0;\\n  text-align: center;\\n  font-size: 0.85rem;\\n  color: #666;\\n}\\n\\n/* Results Panel (Right) */\\n.cc-results-panel {\\n  background: #faf8f5;\\n  padding: 24px;\\n  overflow-y: auto;\\n  max-height: calc(100vh - 140px);\\n}\\n\\n.cc-section-title {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  margin: 0 0 16px;\\n  font-size: 0.9rem;\\n  font-weight: 500;\\n  color: #757575;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.cc-section-icon {\\n  font-size: 1.1rem;\\n}\\n\\n.cc-count-badge {\\n  padding: 2px 10px;\\n  background: #e0ddd8;\\n  border-radius: 12px;\\n  font-size: 0.75rem;\\n  color: #aaa;\\n}\\n\\n/* Empty Results */\\n.cc-empty-results {\\n  text-align: center;\\n  padding: 60px 20px;\\n  color: #666;\\n}\\n\\n.cc-empty-results .cc-empty-icon {\\n  font-size: 3rem;\\n  display: block;\\n  margin-bottom: 16px;\\n  opacity: 0.5;\\n}\\n\\n.cc-empty-results p {\\n  margin: 0 0 8px;\\n  font-size: 1rem;\\n  color: #757575;\\n}\\n\\n/* Job Cards */\\n.cc-jobs-section {\\n  margin-bottom: 32px;\\n}\\n\\n.cc-job-card {\\n  padding: 16px 20px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-left: 4px solid #f39c12;\\n  border-radius: 8px;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-job-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-job-concept {\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  font-size: 1rem;\\n}\\n\\n.cc-job-status {\\n  padding: 4px 12px;\\n  border-radius: 16px;\\n  font-size: 0.75rem;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n}\\n\\n.cc-status-pending {\\n  background: rgba(241, 196, 15, 0.2);\\n  color: #f1c40f;\\n}\\n\\n.cc-status-extracting {\\n  background: rgba(52, 152, 219, 0.2);\\n  color: #b5343a;\\n}\\n\\n.cc-status-synthesizing {\\n  background: rgba(155, 89, 182, 0.2);\\n  color: #9b59b6;\\n}\\n\\n.cc-status-completed {\\n  background: rgba(46, 204, 113, 0.2);\\n  color: #2ecc71;\\n}\\n\\n.cc-status-failed {\\n  background: rgba(231, 76, 60, 0.2);\\n  color: #e74c3c;\\n}\\n\\n.cc-job-progress {\\n  display: flex;\\n  align-items: center;\\n  gap: 14px;\\n}\\n\\n.cc-progress-bar {\\n  flex: 1;\\n  height: 6px;\\n  background: #e0ddd8;\\n  border-radius: 3px;\\n  overflow: hidden;\\n}\\n\\n.cc-progress-fill {\\n  height: 100%;\\n  background: linear-gradient(90deg, #9b59b6, #e91e63);\\n  border-radius: 3px;\\n  transition: width 0.3s ease;\\n}\\n\\n.cc-progress-text {\\n  font-size: 0.8rem;\\n  color: #757575;\\n  white-space: nowrap;\\n}\\n\\n.cc-job-current {\\n  margin-top: 10px;\\n  font-size: 0.85rem;\\n  color: #666;\\n}\\n\\n.cc-current-label {\\n  color: #9b59b6;\\n  font-weight: 500;\\n}\\n\\n/* Syntheses Section */\\n.cc-syntheses-section {\\n  margin-bottom: 24px;\\n}\\n\\n.cc-syntheses-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 10px;\\n}\\n\\n.cc-synthesis-card {\\n  padding: 16px 20px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.cc-synthesis-card:hover {\\n  border-color: #9b59b6;\\n  transform: translateX(4px);\\n}\\n\\n.cc-synthesis-card.cc-selected {\\n  border-color: #9b59b6;\\n  background: rgba(155, 89, 182, 0.1);\\n  border-left: 4px solid #9b59b6;\\n}\\n\\n.cc-synthesis-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 10px;\\n}\\n\\n.cc-synthesis-concept {\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  font-size: 1rem;\\n}\\n\\n.cc-synthesis-version {\\n  padding: 3px 10px;\\n  background: #e0ddd8;\\n  border-radius: 12px;\\n  font-size: 0.75rem;\\n  color: #aaa;\\n}\\n\\n.cc-synthesis-meta {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 12px;\\n  margin-bottom: 8px;\\n}\\n\\n.cc-meta-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n  font-size: 0.8rem;\\n  color: #757575;\\n}\\n\\n.cc-meta-icon {\\n  font-size: 0.85rem;\\n}\\n\\n.cc-synthesis-date {\\n  font-size: 0.75rem;\\n  color: #666;\\n}\\n\\n/* Detail View (inside results panel) */\\n.cc-detail-view {\\n  height: 100%;\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n.cc-back-btn {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 10px 18px;\\n  margin-bottom: 20px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 6px;\\n  color: #9b59b6;\\n  font-size: 0.9rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.15s;\\n}\\n\\n.cc-back-btn:hover {\\n  background: #f5f3f0;\\n  border-color: #9b59b6;\\n  color: #4a4a4a;\\n}\\n\\n.cc-loading {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 12px;\\n  padding: 60px;\\n  color: #757575;\\n  font-size: 1rem;\\n}\\n\\n.cc-detail-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: flex-start;\\n  margin-bottom: 24px;\\n  flex-wrap: wrap;\\n  gap: 16px;\\n}\\n\\n.cc-detail-title h3 {\\n  margin: 0;\\n  font-size: 1.5rem;\\n  color: #1a1a1a;\\n}\\n\\n.cc-detail-version {\\n  display: block;\\n  margin-top: 4px;\\n  font-size: 0.85rem;\\n  color: #757575;\\n}\\n\\n.cc-detail-actions {\\n  display: flex;\\n  gap: 10px;\\n}\\n\\n.cc-action-btn {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  padding: 8px 16px;\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 6px;\\n  color: #aaa;\\n  font-size: 0.85rem;\\n  cursor: pointer;\\n  transition: all 0.15s;\\n}\\n\\n.cc-action-btn:hover {\\n  border-color: #9b59b6;\\n  color: #1a1a1a;\\n}\\n\\n/* PDF Export Button - Special styling */\\n.cc-pdf-btn {\\n  background: linear-gradient(135deg, #9b59b6, #e91e63);\\n  border-color: transparent;\\n  color: #1a1a1a;\\n  font-weight: 500;\\n}\\n\\n.cc-pdf-btn:hover {\\n  background: linear-gradient(135deg, #a76bc4, #f02e7a);\\n  border-color: transparent;\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(155, 89, 182, 0.4);\\n}\\n\\n/* Overview Stats */\\n.cc-detail-overview {\\n  display: flex;\\n  gap: 32px;\\n  padding: 20px 24px;\\n  background: #f5f3f0;\\n  border-radius: 8px;\\n  margin-bottom: 24px;\\n  flex-wrap: wrap;\\n}\\n\\n.cc-overview-item {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.cc-overview-label {\\n  font-size: 0.75rem;\\n  color: #757575;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.cc-overview-value {\\n  font-size: 1.5rem;\\n  font-weight: 700;\\n  color: #1a1a1a;\\n}\\n\\n.cc-overview-value.cc-score-good {\\n  color: #2ecc71;\\n}\\n\\n/* Tabs Navigation */\\n.cc-tabs {\\n  display: flex;\\n  gap: 4px;\\n  margin: 16px 0;\\n  padding: 6px 8px;\\n  background: #faf8f5;\\n  border: 2px solid #e0ddd8;\\n  border-radius: 8px;\\n  overflow-x: hidden;\\n  flex-wrap: nowrap;\\n  min-height: 44px;\\n  align-items: center;\\n}\\n\\n.cc-tab {\\n  padding: 6px 10px;\\n  border: none;\\n  background: #e0ddd8;\\n  color: #757575;\\n  font-size: 0.72rem;\\n  font-weight: 600;\\n  cursor: pointer;\\n  white-space: nowrap;\\n  transition: all 0.2s;\\n  border-radius: 5px;\\n  flex-shrink: 1;\\n  min-height: 32px;\\n  display: flex;\\n  align-items: center;\\n}\\n\\n.cc-tab:hover {\\n  color: #1a1a1a;\\n  background: #e0ddd8;\\n  border-color: #9b59b6;\\n}\\n\\n.cc-tab.cc-tab-active {\\n  color: #1a1a1a;\\n  background: linear-gradient(135deg, #9b59b6, #e91e63);\\n  border-color: transparent;\\n  font-weight: 700;\\n  box-shadow: 0 4px 12px rgba(155, 89, 182, 0.4);\\n}\\n\\n/* Tab Content */\\n.cc-tab-content {\\n  min-height: 400px;\\n  color: #4a4a4a;\\n  padding-top: 8px;\\n}\\n\\n.cc-tab-section {\\n  margin-bottom: 32px;\\n}\\n\\n.cc-tab-section h4 {\\n  margin: 0 0 16px;\\n  color: #1a1a1a;\\n  font-size: 1.2rem;\\n  font-weight: 700;\\n  padding-bottom: 8px;\\n  border-bottom: 2px solid #e0ddd8;\\n}\\n\\n.cc-section-desc {\\n  color: #757575;\\n  font-size: 0.9rem;\\n  margin: 0 0 14px;\\n  line-height: 1.5;\\n}\\n\\n/* Citation Block */\\n.cc-citation {\\n  background: #f5f3f0;\\n  border-left: 3px solid #9b59b6;\\n  padding: 14px 18px;\\n  margin: 10px 0;\\n  border-radius: 0 6px 6px 0;\\n}\\n\\n.cc-citation blockquote {\\n  margin: 0 0 8px;\\n  font-style: italic;\\n  color: #4a4a4a;\\n  line-height: 1.6;\\n}\\n\\n.cc-citation-meta {\\n  display: flex;\\n  gap: 14px;\\n  font-size: 0.8rem;\\n  color: #757575;\\n}\\n\\n.cc-citation-location {\\n  font-weight: 500;\\n  color: #9b59b6;\\n}\\n\\n/* Semantic Tab */\\n.cc-core-meaning {\\n  font-size: 1.05rem;\\n  line-height: 1.7;\\n  color: #4a4a4a;\\n  padding: 16px 20px;\\n  background: rgba(155, 89, 182, 0.1);\\n  border: 1px solid rgba(155, 89, 182, 0.3);\\n  border-radius: 8px;\\n}\\n\\n.cc-cluster-card {\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  padding: 18px 20px;\\n  margin-bottom: 14px;\\n}\\n\\n.cc-cluster-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 10px;\\n}\\n\\n.cc-cluster-label {\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.cc-cluster-count {\\n  font-size: 0.8rem;\\n  color: #757575;\\n}\\n\\n.cc-cluster-description {\\n  margin: 0 0 14px;\\n  color: #757575;\\n  line-height: 1.6;\\n}\\n\\n.cc-cluster-core,\\n.cc-cluster-texts {\\n  font-size: 0.9rem;\\n  margin-bottom: 10px;\\n  color: #aaa;\\n}\\n\\n/* Inferential Tab */\\n.cc-inferential-link {\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  padding: 16px 20px;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-link-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 14px;\\n  margin-bottom: 10px;\\n}\\n\\n.cc-link-concept {\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.cc-link-relationship {\\n  padding: 4px 12px;\\n  border-radius: 14px;\\n  font-size: 0.7rem;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n}\\n\\n.cc-rel-entails {\\n  background: rgba(46, 204, 113, 0.2);\\n  color: #2ecc71;\\n}\\n\\n.cc-rel-entailed-by {\\n  background: rgba(52, 152, 219, 0.2);\\n  color: #b5343a;\\n}\\n\\n.cc-rel-incompatible-with {\\n  background: rgba(231, 76, 60, 0.2);\\n  color: #e74c3c;\\n}\\n\\n.cc-rel-presupposes {\\n  background: rgba(241, 196, 15, 0.2);\\n  color: #f1c40f;\\n}\\n\\n.cc-rel-enables {\\n  background: rgba(149, 165, 166, 0.2);\\n  color: #95a5a6;\\n}\\n\\n.cc-rel-tensions-with {\\n  background: rgba(230, 126, 34, 0.2);\\n  color: #e67e22;\\n}\\n\\n.cc-link-explanation {\\n  margin: 0;\\n  color: #757575;\\n  line-height: 1.6;\\n}\\n\\n.cc-link-citations {\\n  margin-top: 12px;\\n  padding-top: 12px;\\n  border-top: 1px solid #e0ddd8;\\n}\\n\\n/* Lists */\\n.cc-consensus-list,\\n.cc-ancestor-list,\\n.cc-dispute-list,\\n.cc-framework-list,\\n.cc-questions-list,\\n.cc-insights-list,\\n.cc-directions-list,\\n.cc-blindspots-list {\\n  margin: 0;\\n  padding-left: 24px;\\n}\\n\\n.cc-consensus-list li,\\n.cc-ancestor-list li,\\n.cc-dispute-list li,\\n.cc-framework-list li,\\n.cc-questions-list li,\\n.cc-insights-list li,\\n.cc-directions-list li,\\n.cc-blindspots-list li {\\n  margin-bottom: 10px;\\n  line-height: 1.6;\\n  color: #757575;\\n}\\n\\n/* Contested Link */\\n.cc-contested-link {\\n  background: rgba(241, 196, 15, 0.1);\\n  border: 1px solid rgba(241, 196, 15, 0.3);\\n  border-radius: 8px;\\n  padding: 16px 20px;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-contested-claim {\\n  font-weight: 500;\\n  margin-bottom: 10px;\\n  color: #1a1a1a;\\n}\\n\\n.cc-contested-positions {\\n  display: flex;\\n  gap: 24px;\\n  font-size: 0.9rem;\\n}\\n\\n.cc-for {\\n  color: #2ecc71;\\n}\\n\\n.cc-against {\\n  color: #e74c3c;\\n}\\n\\n/* Genealogy Tab */\\n.cc-lineage-card {\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  padding: 16px 20px;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-lineage-claim {\\n  font-weight: 500;\\n  margin-bottom: 8px;\\n  color: #1a1a1a;\\n}\\n\\n.cc-lineage-texts {\\n  font-size: 0.9rem;\\n  color: #757575;\\n}\\n\\n/* Epistemic Tab */\\n.cc-episteme-card {\\n  background: #f5f3f0;\\n  border: 1px solid #e0ddd8;\\n  border-radius: 8px;\\n  padding: 18px 20px;\\n  margin-bottom: 14px;\\n}\\n\\n.cc-episteme-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 12px;\\n}\\n\\n.cc-episteme-label {\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.cc-episteme-count {\\n  font-size: 0.8rem;\\n  color: #757575;\\n}\\n\\n.cc-episteme-description {\\n  margin: 0 0 14px;\\n  color: #757575;\\n  line-height: 1.6;\\n}\\n\\n.cc-episteme-texts {\\n  font-size: 0.9rem;\\n  margin-bottom: 12px;\\n  color: #aaa;\\n}\\n\\n.cc-episteme-assumptions,\\n.cc-episteme-blindspots {\\n  margin-top: 12px;\\n}\\n\\n.cc-episteme-assumptions ul,\\n.cc-episteme-blindspots ul {\\n  margin: 8px 0 0;\\n  padding-left: 20px;\\n}\\n\\n.cc-episteme-blindspots {\\n  color: #e74c3c;\\n}\\n\\n/* Normative Tab */\\n.cc-readings-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.cc-reading-card {\\n  padding: 16px 20px;\\n  border-radius: 8px;\\n  border-left: 4px solid;\\n}\\n\\n.cc-reading-emancipatory {\\n  background: rgba(46, 204, 113, 0.2);\\n  border-left-color: #2ecc71;\\n  border: 1px solid rgba(46, 204, 113, 0.4);\\n  border-left: 4px solid #2ecc71;\\n}\\n\\n.cc-reading-critical {\\n  background: rgba(230, 126, 34, 0.2);\\n  border-left-color: #e67e22;\\n  border: 1px solid rgba(230, 126, 34, 0.4);\\n  border-left: 4px solid #e67e22;\\n}\\n\\n.cc-reading-conservative {\\n  background: rgba(231, 76, 60, 0.2);\\n  border-left-color: #e74c3c;\\n  border: 1px solid rgba(231, 76, 60, 0.4);\\n  border-left: 4px solid #e74c3c;\\n}\\n\\n.cc-reading-practical {\\n  background: rgba(52, 152, 219, 0.2);\\n  border-left-color: #b5343a;\\n  border: 1px solid rgba(52, 152, 219, 0.4);\\n  border-left: 4px solid #b5343a;\\n}\\n\\n.cc-reading-utopian {\\n  background: rgba(155, 89, 182, 0.2);\\n  border-left-color: #9b59b6;\\n  border: 1px solid rgba(155, 89, 182, 0.4);\\n  border-left: 4px solid #9b59b6;\\n}\\n\\n.cc-reading-source {\\n  font-weight: 700;\\n  display: block;\\n  margin-bottom: 6px;\\n  color: #1a1a1a;\\n  font-size: 0.9rem;\\n  opacity: 0.95;\\n}\\n\\n.cc-reading-feature {\\n  display: block;\\n  font-weight: 600;\\n  font-size: 0.85rem;\\n  color: #757575;\\n  margin-bottom: 10px;\\n  font-style: italic;\\n}\\n\\n.cc-reading-content {\\n  margin: 0;\\n  color: #4a4a4a;\\n  line-height: 1.7;\\n  font-size: 0.95rem;\\n}\\n\\n/* Tensions Tab */\\n.cc-tension-card {\\n  background: rgba(241, 196, 15, 0.1);\\n  border: 1px solid rgba(241, 196, 15, 0.3);\\n  border-radius: 8px;\\n  padding: 18px 20px;\\n  margin-bottom: 14px;\\n}\\n\\n.cc-tension-description {\\n  font-weight: 500;\\n  margin-bottom: 16px;\\n  color: #1a1a1a;\\n  line-height: 1.6;\\n}\\n\\n.cc-tension-positions {\\n  display: grid;\\n  grid-template-columns: 1fr 1fr;\\n  gap: 16px;\\n  margin-bottom: 14px;\\n}\\n\\n.cc-position {\\n  padding: 14px;\\n  border-radius: 6px;\\n}\\n\\n.cc-position-a {\\n  background: rgba(52, 152, 219, 0.1);\\n  border: 1px solid rgba(52, 152, 219, 0.3);\\n}\\n\\n.cc-position-b {\\n  background: rgba(231, 76, 60, 0.1);\\n  border: 1px solid rgba(231, 76, 60, 0.3);\\n}\\n\\n.cc-position p {\\n  margin: 8px 0 10px;\\n  line-height: 1.5;\\n  color: #757575;\\n}\\n\\n.cc-position-texts {\\n  font-size: 0.8rem;\\n  color: #757575;\\n}\\n\\n.cc-tension-resolution,\\n.cc-tension-stakes {\\n  font-size: 0.95rem;\\n  margin-top: 10px;\\n  padding-top: 10px;\\n  border-top: 1px solid rgba(241, 196, 15, 0.2);\\n  color: #757575;\\n}\\n\\n/* Synthesis Meta Tab */\\n.cc-meta-summary {\\n  font-size: 1.05rem;\\n  line-height: 1.8;\\n  color: #4a4a4a;\\n  padding: 20px 24px;\\n  background: rgba(155, 89, 182, 0.1);\\n  border: 1px solid rgba(155, 89, 182, 0.3);\\n  border-radius: 8px;\\n}\\n\\n/* Responsive */\\n@media (max-width: 1200px) {\\n  .cc-main-layout {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .cc-form-panel {\\n    max-height: none;\\n    border-right: none;\\n    border-bottom: 1px solid #e0ddd8;\\n  }\\n\\n  .cc-results-panel {\\n    max-height: none;\\n  }\\n}\\n\\n@media (max-width: 768px) {\\n  .cc-header {\\n    padding: 20px;\\n  }\\n\\n  .cc-header-content {\\n    flex-direction: column;\\n    text-align: center;\\n  }\\n\\n  .cc-form-panel,\\n  .cc-results-panel {\\n    padding: 16px;\\n  }\\n\\n  .cc-detail-header {\\n    flex-direction: column;\\n  }\\n\\n  .cc-detail-overview {\\n    flex-direction: column;\\n    gap: 16px;\\n  }\\n\\n  .cc-tabs {\\n    flex-wrap: nowrap;\\n    overflow-x: auto;\\n    -webkit-overflow-scrolling: touch;\\n  }\\n\\n  .cc-tension-positions {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .cc-contested-positions {\\n    flex-direction: column;\\n    gap: 10px;\\n  }\\n}\\n\\n/* Variation source citation */\\n.cc-variation-source {\\n  font-style: italic;\\n  color: #757575;\\n  font-size: 0.85em;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/NavDropdown.css\"\n/*!***********************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/NavDropdown.css ***!\n  \\***************************************************************************************************************************************************************