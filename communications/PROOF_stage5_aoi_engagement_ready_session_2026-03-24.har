_type\":\"tab\",\"renderer_config\":{\"tab_style\":\"underline\",\"default_tab\":1,\"show_count_badges\":true},\"presentation_stance\":\"interactive\",\"priority\":\"primary\",\"rationale\":\"Workflow page default\",\"data_quality\":\"standard\",\"top_level_group\":null,\"source_parent_view_key\":null,\"promoted_to_top_level\":false,\"selection_priority\":\"primary\",\"navigation_state\":\"normal\",\"structuring_policy\":null,\"semantic_scaffold_type\":\"none\",\"scaffold_hosting_mode\":\"none\",\"derivation_kind\":null,\"phase_number\":null,\"engine_key\":null,\"chain_key\":null,\"scope\":\"aggregated\",\"has_structured_data\":false,\"structured_data\":null,\"reading_scaffold\":null,\"raw_prose\":null,\"prose_ref_view_key\":null,\"items\":null,\"tab_count\":null,\"visibility\":\"if_data_exists\",\"position\":1.0,\"children\":[{\"view_key\":\"aoi_source_documents\",\"view_name\":\"Source Documents\",\"description\":\"Inventory of the selected source thinker's documents used to ground the AOI thematic analysis.\",\"renderer_type\":\"card_grid\",\"renderer_config\":{\"title_field\":\"title\",\"subtitle_field\":\"subtitle\",\"description_field\":\"description\",\"badge_field\":\"badge\",\"columns\":2,\"expandable\":false},\"presentation_stance\":\"evidence\",\"priority\":\"secondary\",\"rationale\":\"child of included parent\",\"data_quality\":\"standard\",\"top_level_group\":null,\"source_parent_view_key\":\"aoi_thematic_analysis\",\"promoted_to_top_level\":false,\"selection_priority\":\"secondary\",\"navigation_state\":\"normal\",\"structuring_policy\":null,\"semantic_scaffold_type\":\"none\",\"scaffold_hosting_mode\":\"none\",\"derivation_kind\":null,\"phase_number\":1.0,\"engine_key\":\"aoi_thematic_synthesis\",\"chain_key\":null,\"scope\":\"aggregated\",\"has_structured_data\":true,\"structured_data\":[{\"source_document_id\":\"through_war_economy_to_economy_in_kind\",\"title\":\"Through War Economy to Economy in Kind\",\"subtitle\":\"Otto Neurath | 1919\",\"description\":\"Neurath on non-market calculation and wartime planning.\",\"badge\":\"Otto Neurath\"},{\"source_document_id\":\"international_planning_for_freedom\",\"title\":\"International Planning for Freedom\",\"subtitle\":\"Otto Neurath | 1942\",\"description\":\"Neurath on planning, democracy, and international coordination.\",\"badge\":\"Otto Neurath\"},{\"source_document_id\":\"economic_plan_and_calculation_in_kind\",\"title\":\"Economic Plan and Calculation in Kind\",\"subtitle\":\"Otto Neurath | 1925\",\"description\":\"Neurath on in-kind accounting and the economic plan.\",\"badge\":\"Otto Neurath\"},{\"source_document_id\":\"socialist_utility_calculation_and_capitalist_profit_calculation\",\"title\":\"Socialist Utility Calculation and Capitalist Profit Calculation\",\"subtitle\":\"Otto Neurath | 1920\",\"description\":\"Neurath on socialist utility calculation versus profit metrics.\",\"badge\":\"Otto Neurath\"}],\"reading_scaffold\":null,\"raw_prose\":\"{\\\"themes\\\": [{\\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"overview\\\": \\\"Benanav leans on Neurath's insistence that planning can coordinate production without market prices.\\\", \\\"key_claims\\\": [\\\"Planning can orient production without market-clearing signals.\\\", \\\"Material coordination can be treated as an information design problem.\\\"], \\\"philosophical_commitments\\\": [\\\"Economic rationality is not exhausted by price signals.\\\"], \\\"argumentative_moves\\\": [\\\"Recasts socialist calculation as a coordination problem rather than a scarcity-pricing puzzle.\\\"], \\\"source_documents\\\": [\\\"Through War Economy to Economy in Kind\\\", \\\"Economic Plan and Calculation in Kind\\\"]}, {\\\"theme_name\\\": \\\"Planning as Public Knowledge\\\", \\\"overview\\\": \\\"Benanav partially echoes Neurath's view that planning depends on public knowledge infrastructures and civic intelligibility.\\\", \\\"key_claims\\\": [\\\"Planning requires transparent social knowledge rather than hidden market revelation.\\\"], \\\"philosophical_commitments\\\": [\\\"Democratic coordination depends on shared intelligibility.\\\"], \\\"argumentative_moves\\\": [\\\"Turns epistemic planning into a public-capacity argument.\\\"], \\\"source_documents\\\": [\\\"International Planning for Freedom\\\"]}], \\\"overall_synthesis\\\": \\\"The dossier fixture concentrates on one dominant Neurathian planning theme with a secondary civic-intelligibility theme.\\\"}\",\"prose_ref_view_key\":null,\"items\":null,\"tab_count\":null,\"visibility\":\"if_data_exists\",\"position\":1.1,\"children\":[]},{\"view_key\":\"aoi_by_theme\",\"view_name\":\"By Theme\",\"description\":\"Theme-first AOI surface. Each theme becomes one accordion section exposing the source-theme overview, Benanav's engagement, and the flat findings tied to that theme.\",\"renderer_type\":\"accordion\",\"renderer_config\":{\"expand_first\":true,\"section_renderers\":{\"_default\":{\"sub_renderers\":{\"overview\":{\"renderer_type\":\"annotated_prose\"},\"engagement\":{\"renderer_type\":\"annotated_prose\"},\"key_claims\":{\"renderer_type\":\"rich_description_list\",\"config\":{\"title_field\":\"title\",\"description_field\":\"description\"}},\"philosophical_commitments\":{\"renderer_type\":\"rich_description_list\",\"config\":{\"title_field\":\"title\",\"description_field\":\"description\"}},\"argumentative_moves\":{\"renderer_type\":\"rich_description_list\",\"config\":{\"title_field\":\"title\",\"description_field\":\"description\"}},\"source_documents\":{\"renderer_type\":\"chip_grid\"},\"findings\":{\"renderer_type\":\"mini_card_list\",\"config\":{\"title_field\":\"title\",\"subtitle_field\":\"subtitle\",\"description_field\":\"description\",\"badge_field\":\"badge\"}}}}},\"sections\":[{\"key\":\"theme_calculation_without_prices\",\"title\":\"Calculation Without Prices\"},{\"key\":\"theme_planning_as_public_knowledge\",\"title\":\"Planning as Public Knowledge\"}]},\"presentation_stance\":\"comparison\",\"priority\":\"secondary\",\"rationale\":\"child of included parent\",\"data_quality\":\"standard\",\"top_level_group\":null,\"source_parent_view_key\":\"aoi_thematic_analysis\",\"promoted_to_top_level\":false,\"selection_priority\":\"secondary\",\"navigation_state\":\"normal\",\"structuring_policy\":null,\"semantic_scaffold_type\":\"none\",\"scaffold_hosting_mode\":\"none\",\"derivation_kind\":null,\"phase_number\":3.0,\"engine_key\":\"aoi_sin_findings\",\"chain_key\":null,\"scope\":\"aggregated\",\"has_structured_data\":true,\"structured_data\":{\"theme_calculation_without_prices\":{\"overview\":\"Benanav leans on Neurath's insistence that planning can coordinate production without market prices.\",\"engagement\":\"Engagement level: engaged. Benanav treats planning as a live alternative to price-mediated coordination. He translates Neurath's planning argument into contemporary post-scarcity institutional language. Severity: medium. The shift is interpretive rather than hostile.\",\"key_claims\":[{\"title\":\"Claim 1\",\"description\":\"Planning can orient production without market-clearing signals.\"},{\"title\":\"Claim 2\",\"description\":\"Material coordination can be treated as an information design problem.\"}],\"philosophical_commitments\":[{\"title\":\"Commitment 1\",\"description\":\"Economic rationality is not exhausted by price signals.\"}],\"argumentative_moves\":[{\"title\":\"Move 1\",\"description\":\"Recasts socialist calculation as a coordination problem rather than a scarcity-pricing puzzle.\"}],\"source_documents\":[\"Through War Economy to Economy in Kind\",\"Economic Plan and Calculation in Kind\"],\"findings\":[{\"title\":\"Planning without prices becomes infrastructural coordination\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"The borrowing is strong, but Benanav updates the vocabulary to contemporary platform coordination.\",\"badge\":\"high\",\"sin_type\":\"appropriation\",\"sin_type_label\":\"Appropriation\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"economic_plan_and_calculation_in_kind\",\"target_quote\":\"Coordination can be designed without handing the task back to prices.\",\"source_quote\":\"The economic plan can proceed in kind without price calculation.\",\"implication_for_argument\":\"This keeps planning legible after the critique of market socialism.\"},{\"title\":\"War-economy coordination is rewritten as systems design\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"Benanav abstracts away from the wartime setting while preserving the planning lesson.\",\"badge\":\"medium\",\"sin_type\":\"appropriation\",\"sin_type_label\":\"Appropriation\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"through_war_economy_to_economy_in_kind\",\"target_quote\":\"Large-scale coordination is a design problem, not a market miracle.\",\"source_quote\":\"War economy demonstrates directed allocation beyond market exchange.\",\"implication_for_argument\":\"It lets him universalize a historically bounded planning example.\"},{\"title\":\"In-kind accounting becomes computational administration\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"Benanav compresses a substantive accounting doctrine into a tractability claim.\",\"badge\":\"medium\",\"sin_type\":\"misreading\",\"sin_type_label\":\"Misreading\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"economic_plan_and_calculation_in_kind\",\"target_quote\":\"New infrastructures make administrative coordination tractable at scale.\",\"source_quote\":\"Calculation in kind depends on a rich material inventory, not merely faster computation.\",\"implication_for_argument\":\"The simplification makes the contemporary case easier to state but thinner historically.\"},{\"title\":\"Statistical coordination eclipses material inventory work\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"Benanav keeps the conclusion while thinning the bureaucratic substrate.\",\"badge\":\"low\",\"sin_type\":\"omission\",\"sin_type_label\":\"Omission\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"socialist_utility_calculation_and_capitalist_profit_calculation\",\"target_quote\":\"Coordination requires information systems that no longer need prices.\",\"source_quote\":\"Statistical and material records are the basis of coordinated production.\",\"implication_for_argument\":\"This makes the argument cleaner but less institutionally grounded.\"}]},\"theme_planning_as_public_knowledge\":{\"overview\":\"Benanav partially echoes Neurath's view that planning depends on public knowledge infrastructures and civic intelligibility.\",\"engagement\":\"Engagement level: partial. Benanav gestures toward democratic coordination but does not foreground Neurath's civic epistemology. The public-knowledge dimension is present but compressed. Severity: low. The theme remains visible but subordinate.\",\"key_claims\":[{\"title\":\"Claim 1\",\"description\":\"Planning requires transparent social knowledge rather than hidden market revelation.\"}],\"philosophical_commitments\":[{\"title\":\"Commitment 1\",\"description\":\"Democratic coordination depends on shared intelligibility.\"}],\"argumentative_moves\":[{\"title\":\"Move 1\",\"description\":\"Turns epistemic planning into a public-capacity argument.\"}],\"source_documents\":[\"International Planning for Freedom\"],\"findings\":[{\"title\":\"Democratic intelligibility is present only as a side note\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"The civic dimension survives, but mostly as an appendix to the planning argument.\",\"badge\":\"low\",\"sin_type\":\"compression\",\"sin_type_label\":\"Compression\",\"theme_name\":\"Planning as Public Knowledge\",\"source_document_id\":\"international_planning_for_freedom\",\"target_quote\":\"Coordination must still be socially intelligible.\",\"source_quote\":\"Planning must remain publicly discussable and democratically legible.\",\"implication_for_argument\":\"The result is a narrower, more technical reading of Neurath.\"}]}},\"reading_scaffold\":null,\"raw_prose\":\"{\\\"findings\\\": [{\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"appropriation\\\", \\\"severity\\\": \\\"high\\\", \\\"title\\\": \\\"Planning without prices becomes infrastructural coordination\\\", \\\"summary\\\": \\\"Benanav imports Neurath's non-price planning premise and turns it into an infrastructural coordination thesis.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Coordination can be designed without handing the task back to prices.\\\", \\\"source_work_title\\\": \\\"Economic Plan and Calculation in Kind\\\", \\\"source_quote\\\": \\\"The economic plan can proceed in kind without price calculation.\\\", \\\"discrepancy_analysis\\\": \\\"The borrowing is strong, but Benanav updates the vocabulary to contemporary platform coordination.\\\", \\\"implication_for_argument\\\": \\\"This keeps planning legible after the critique of market socialism.\\\"}, {\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"appropriation\\\", \\\"severity\\\": \\\"medium\\\", \\\"title\\\": \\\"War-economy coordination is rewritten as systems design\\\", \\\"summary\\\": \\\"A wartime planning argument is reformulated as a general systems-design problem.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Large-scale coordination is a design problem, not a market miracle.\\\", \\\"source_work_title\\\": \\\"Through War Economy to Economy in Kind\\\", \\\"source_quote\\\": \\\"War economy demonstrates directed allocation beyond market exchange.\\\", \\\"discrepancy_analysis\\\": \\\"Benanav abstracts away from the wartime setting while preserving the planning lesson.\\\", \\\"implication_for_argument\\\": \\\"It lets him universalize a historically bounded planning example.\\\"}, {\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"misreading\\\", \\\"severity\\\": \\\"medium\\\", \\\"title\\\": \\\"In-kind accounting becomes computational administration\\\", \\\"summary\\\": \\\"The texture of Neurath's in-kind accounting is simplified into a computational administration claim.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"New infrastructures make administrative coordination tractable at scale.\\\", \\\"source_work_title\\\": \\\"Economic Plan and Calculation in Kind\\\", \\\"source_quote\\\": \\\"Calculation in kind depends on a rich material inventory, not merely faster computation.\\\", \\\"discrepancy_analysis\\\": \\\"Benanav compresses a substantive accounting doctrine into a tractability claim.\\\", \\\"implication_for_argument\\\": \\\"The simplification makes the contemporary case easier to state but thinner historically.\\\"}, {\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"omission\\\", \\\"severity\\\": \\\"low\\\", \\\"title\\\": \\\"Statistical coordination eclipses material inventory work\\\", \\\"summary\\\": \\\"The planning argument underplays the administrative labor of maintaining material inventories.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Coordination requires information systems that no longer need prices.\\\", \\\"source_work_title\\\": \\\"Socialist Utility Calculation and Capitalist Profit Calculation\\\", \\\"source_quote\\\": \\\"Statistical and material records are the basis of coordinated production.\\\", \\\"discrepancy_analysis\\\": \\\"Benanav keeps the conclusion while thinning the bureaucratic substrate.\\\", \\\"implication_for_argument\\\": \\\"This makes the argument cleaner but less institutionally grounded.\\\"}, {\\\"theme_id\\\": \\\"theme_planning_as_public_knowledge\\\", \\\"theme_name\\\": \\\"Planning as Public Knowledge\\\", \\\"sin_type\\\": \\\"compression\\\", \\\"severity\\\": \\\"low\\\", \\\"title\\\": \\\"Democratic intelligibility is present only as a side note\\\", \\\"summary\\\": \\\"Neurath's democratic pedagogy appears, but only as a subordinate implication.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Coordination must still be socially intelligible.\\\", \\\"source_work_title\\\": \\\"International Planning for Freedom\\\", \\\"source_quote\\\": \\\"Planning must remain publicly discussable and democratically legible.\\\", \\\"discrepancy_analysis\\\": \\\"The civic dimension survives, but mostly as an appendix to the planning argument.\\\", \\\"implication_for_argument\\\": \\\"The result is a narrower, more technical reading of Neurath.\\\"}]}\",\"prose_ref_view_key\":null,\"items\":null,\"tab_count\":null,\"visibility\":\"if_data_exists\",\"position\":1.2,\"children\":[]},{\"view_key\":\"aoi_by_sin_type\",\"view_name\":\"By Sin Type\",\"description\":\"AOI findings regrouped by the first-class sin taxonomy so the same bounded finding set can be inspected by misuse pattern rather than by source theme.\",\"renderer_type\":\"card_grid\",\"renderer_config\":{\"title_field\":\"title\",\"subtitle_field\":\"theme_name\",\"description_field\":\"description\",\"badge_field\":\"badge\",\"columns\":1,\"group_by\":\"_category\",\"group_style_map\":\"sin_type\",\"expandable\":false},\"presentation_stance\":\"evidence\",\"priority\":\"secondary\",\"rationale\":\"child of included parent\",\"data_quality\":\"standard\",\"top_level_group\":null,\"source_parent_view_key\":\"aoi_thematic_analysis\",\"promoted_to_top_level\":false,\"selection_priority\":\"secondary\",\"navigation_state\":\"normal\",\"structuring_policy\":null,\"semantic_scaffold_type\":\"none\",\"scaffold_hosting_mode\":\"none\",\"derivation_kind\":null,\"phase_number\":3.0,\"engine_key\":\"aoi_sin_findings\",\"chain_key\":null,\"scope\":\"aggregated\",\"has_structured_data\":true,\"structured_data\":{\"appropriation\":[{\"title\":\"Planning without prices becomes infrastructural coordination\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"The borrowing is strong, but Benanav updates the vocabulary to contemporary platform coordination.\",\"badge\":\"high\",\"sin_type\":\"appropriation\",\"sin_type_label\":\"Appropriation\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"economic_plan_and_calculation_in_kind\",\"target_quote\":\"Coordination can be designed without handing the task back to prices.\",\"source_quote\":\"The economic plan can proceed in kind without price calculation.\",\"implication_for_argument\":\"This keeps planning legible after the critique of market socialism.\"},{\"title\":\"War-economy coordination is rewritten as systems design\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"Benanav abstracts away from the wartime setting while preserving the planning lesson.\",\"badge\":\"medium\",\"sin_type\":\"appropriation\",\"sin_type_label\":\"Appropriation\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"through_war_economy_to_economy_in_kind\",\"target_quote\":\"Large-scale coordination is a design problem, not a market miracle.\",\"source_quote\":\"War economy demonstrates directed allocation beyond market exchange.\",\"implication_for_argument\":\"It lets him universalize a historically bounded planning example.\"}],\"misreading\":[{\"title\":\"In-kind accounting becomes computational administration\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"Benanav compresses a substantive accounting doctrine into a tractability claim.\",\"badge\":\"medium\",\"sin_type\":\"misreading\",\"sin_type_label\":\"Misreading\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"economic_plan_and_calculation_in_kind\",\"target_quote\":\"New infrastructures make administrative coordination tractable at scale.\",\"source_quote\":\"Calculation in kind depends on a rich material inventory, not merely faster computation.\",\"implication_for_argument\":\"The simplification makes the contemporary case easier to state but thinner historically.\"}],\"omission\":[{\"title\":\"Statistical coordination eclipses material inventory work\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"Benanav keeps the conclusion while thinning the bureaucratic substrate.\",\"badge\":\"low\",\"sin_type\":\"omission\",\"sin_type_label\":\"Omission\",\"theme_name\":\"Calculation Without Prices\",\"source_document_id\":\"socialist_utility_calculation_and_capitalist_profit_calculation\",\"target_quote\":\"Coordination requires information systems that no longer need prices.\",\"source_quote\":\"Statistical and material records are the basis of coordinated production.\",\"implication_for_argument\":\"This makes the argument cleaner but less institutionally grounded.\"}],\"compression\":[{\"title\":\"Democratic intelligibility is present only as a side note\",\"subtitle\":\"Beyond Capitalism 2\",\"description\":\"The civic dimension survives, but mostly as an appendix to the planning argument.\",\"badge\":\"low\",\"sin_type\":\"compression\",\"sin_type_label\":\"Compression\",\"theme_name\":\"Planning as Public Knowledge\",\"source_document_id\":\"international_planning_for_freedom\",\"target_quote\":\"Coordination must still be socially intelligible.\",\"source_quote\":\"Planning must remain publicly discussable and democratically legible.\",\"implication_for_argument\":\"The result is a narrower, more technical reading of Neurath.\"}]},\"reading_scaffold\":null,\"raw_prose\":\"{\\\"findings\\\": [{\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"appropriation\\\", \\\"severity\\\": \\\"high\\\", \\\"title\\\": \\\"Planning without prices becomes infrastructural coordination\\\", \\\"summary\\\": \\\"Benanav imports Neurath's non-price planning premise and turns it into an infrastructural coordination thesis.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Coordination can be designed without handing the task back to prices.\\\", \\\"source_work_title\\\": \\\"Economic Plan and Calculation in Kind\\\", \\\"source_quote\\\": \\\"The economic plan can proceed in kind without price calculation.\\\", \\\"discrepancy_analysis\\\": \\\"The borrowing is strong, but Benanav updates the vocabulary to contemporary platform coordination.\\\", \\\"implication_for_argument\\\": \\\"This keeps planning legible after the critique of market socialism.\\\"}, {\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"appropriation\\\", \\\"severity\\\": \\\"medium\\\", \\\"title\\\": \\\"War-economy coordination is rewritten as systems design\\\", \\\"summary\\\": \\\"A wartime planning argument is reformulated as a general systems-design problem.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Large-scale coordination is a design problem, not a market miracle.\\\", \\\"source_work_title\\\": \\\"Through War Economy to Economy in Kind\\\", \\\"source_quote\\\": \\\"War economy demonstrates directed allocation beyond market exchange.\\\", \\\"discrepancy_analysis\\\": \\\"Benanav abstracts away from the wartime setting while preserving the planning lesson.\\\", \\\"implication_for_argument\\\": \\\"It lets him universalize a historically bounded planning example.\\\"}, {\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"misreading\\\", \\\"severity\\\": \\\"medium\\\", \\\"title\\\": \\\"In-kind accounting becomes computational administration\\\", \\\"summary\\\": \\\"The texture of Neurath's in-kind accounting is simplified into a computational administration claim.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"New infrastructures make administrative coordination tractable at scale.\\\", \\\"source_work_title\\\": \\\"Economic Plan and Calculation in Kind\\\", \\\"source_quote\\\": \\\"Calculation in kind depends on a rich material inventory, not merely faster computation.\\\", \\\"discrepancy_analysis\\\": \\\"Benanav compresses a substantive accounting doctrine into a tractability claim.\\\", \\\"implication_for_argument\\\": \\\"The simplification makes the contemporary case easier to state but thinner historically.\\\"}, {\\\"theme_id\\\": \\\"theme_calculation_without_prices\\\", \\\"theme_name\\\": \\\"Calculation Without Prices\\\", \\\"sin_type\\\": \\\"omission\\\", \\\"severity\\\": \\\"low\\\", \\\"title\\\": \\\"Statistical coordination eclipses material inventory work\\\", \\\"summary\\\": \\\"The planning argument underplays the administrative labor of maintaining material inventories.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Coordination requires information systems that no longer need prices.\\\", \\\"source_work_title\\\": \\\"Socialist Utility Calculation and Capitalist Profit Calculation\\\", \\\"source_quote\\\": \\\"Statistical and material records are the basis of coordinated production.\\\", \\\"discrepancy_analysis\\\": \\\"Benanav keeps the conclusion while thinning the bureaucratic substrate.\\\", \\\"implication_for_argument\\\": \\\"This makes the argument cleaner but less institutionally grounded.\\\"}, {\\\"theme_id\\\": \\\"theme_planning_as_public_knowledge\\\", \\\"theme_name\\\": \\\"Planning as Public Knowledge\\\", \\\"sin_type\\\": \\\"compression\\\", \\\"severity\\\": \\\"low\\\", \\\"title\\\": \\\"Democratic intelligibility is present only as a side note\\\", \\\"summary\\\": \\\"Neurath's democratic pedagogy appears, but only as a subordinate implication.\\\", \\\"target_document_label\\\": \\\"Beyond Capitalism 2\\\", \\\"target_quote\\\": \\\"Coordination must still be socially intelligible.\\\", \\\"source_work_title\\\": \\\"International Planning for Freedom\\\", \\\"source_quote\\\": \\\"Planning must remain publicly discussable and democratically legible.\\\", \\\"discrepancy_analysis\\\": \\\"The civic dimension survives, but mostly as an appendix to the planning argument.\\\", \\\"implication_for_argument\\\": \\\"The result is a narrower, more technical reading of Neurath.\\\"}]}\",\"prose_ref_view_key\":null,\"items\":null,\"tab_count\":null,\"visibility\":\"if_data_exists\",\"position\":1.3,\"children\":[]},{\"view_key\":\"aoi_thematic_report\",\"view_name\":\"Report\",\"description\":\"Structured AOI closeout over the selected thinker: summary, engagement pattern, key divergences, sin distribution, and reading implications.\",\"renderer_type\":\"accordion\",\"renderer_config\":{\"sections\":[{\"key\":\"summary\",\"title\":\"Summary\"},{\"key\":\"engagement_pattern\",\"title\":\"Engagement Pattern\"},{\"key\":\"key_divergences\",\"title\":\"Key Divergences\"},{\"key\":\"sin_distribution\",\"title\":\"Sin Distribution\"},{\"key\":\"reading_implications\",\"title\":\"Reading Implications\"}],\"expand_first\":true,\"section_renderers\":{\"summary\":{\"renderer_type\":\"annotated_prose\",\"config\":{\"pull_quote_min_length\":90,\"section_description\":\"Bounded AOI closeout summary.\"}},\"engagement_pattern\":{\"renderer_type\":\"annotated_prose\",\"config\":{\"pull_quote_min_length\":90,\"section_description\":\"Overall pattern of Benanav's engagement with the selected source thinker.\"}},\"key_divergences\":{\"renderer_type\":\"mini_card_list\",\"config\":{\"title_field\":\"title\",\"subtitle_field\":\"subtitle\",\"description_field\":\"description\",\