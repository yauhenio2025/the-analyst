tent: center;\\n}\\n\\n.btn-create:hover:not(:disabled) {\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);\\n}\\n\\n.btn-create:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n  transform: none;\\n  box-shadow: none;\\n}\\n\\n.btn-create svg {\\n  width: 18px;\\n  height: 18px;\\n}\\n\\n.btn-spinner {\\n  width: 18px;\\n  height: 18px;\\n  border: 2px solid rgba(255, 255, 255, 0.3);\\n  border-top-color: white;\\n  border-radius: 50%;\\n  animation: spin 0.8s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to {\\n    transform: rotate(360deg);\\n  }\\n}\\n\\n/* Responsive */\\n@media (max-width: 768px) {\\n  .wizard-header {\\n    padding: 16px 20px;\\n  }\\n\\n  .wizard-header h1 {\\n    font-size: 18px;\\n  }\\n\\n  .header-spacer {\\n    display: none;\\n  }\\n\\n  .project-wizard-page .wizard-progress {\\n    padding: 16px 20px;\\n  }\\n\\n  .wizard-main {\\n    padding: 24px 20px;\\n  }\\n\\n  .wizard-footer {\\n    padding: 16px 20px;\\n  }\\n\\n  .btn-back,\\n  .btn-next,\\n  .btn-create {\\n    padding: 10px 18px;\\n    font-size: 14px;\\n  }\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/ProjectsPage.css\"\n/*!*******************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/p