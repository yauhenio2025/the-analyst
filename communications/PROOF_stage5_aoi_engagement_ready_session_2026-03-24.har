_.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/* FileUploadZone Styles */\n\n.file-upload-zone-container {\n  margin-bottom: 24px;\n}\n\n.file-input-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.upload-label {\n  display: block;\n  font-size: 14px;\n  font-weight: 500;\n  color: #4a4a4a;\n  margin-bottom: 12px;\n}\n\n.upload-label .required {\n  color: #f87171;\n  margin-left: 4px;\n}\n\n.file-upload-zone {\n  display: block;\n  position: relative;\n  border: 2px dashed #757575;\n  border-radius: 12px;\n  padding: 40px 24px;\n  text-align: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  background: #faf8f5;\n}\n\n.file-upload-zone:hover {\n  border-color: #b5343a;\n  background: rgba(59, 130, 246, 0.05);\n}\n\n.file-upload-zone.dragging {\n  border-color: #b5343a;\n  background: rgba(59, 130, 246, 0.1);\n  transform: scale(1.01);\n}\n\n.file-upload-zone.has-files {\n  padding: 24px;\n}\n\n.upload-icon {\n  width: 48px;\n  height: 48px;\n  margin: 0 auto 16px;\n  color: #64748b;\n  transition: color 0.2s ease;\n}\n\n.file-upload-zone:hover .upload-icon,\n.file-upload-zone.dragging .upload-icon {\n  color: #b5343a;\n}\n\n.upload-icon svg {\n  width: 100%;\n  height: 100%;\n}\n\n.upload-text {\n  color: #94a3b8;\n}\n\n.upload-hint {\n  font-size: 15px;\n  margin: 0 0 8px;\n  color: #4a4a4a;\n}\n\n.upload-formats {\n  font-size: 13px;\n  color: #64748b;\n  margin: 0;\n}\n\n/* Uploaded Files List */\n.uploaded-files {\n  margin-top: 16px;\n  background: #faf8f5;\n  border: 1px solid #757575;\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n.files-header {\n  padding: 12px 16px;\n  background: #faf8f5;\n  border-bottom: 1px solid #757575;\n}\n\n.files-count {\n  font-size: 13px;\n  font-weight: 500;\n  color: #94a3b8;\n}\n\n.files-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  max-height: 300px;\n  overflow-y: auto;\n}\n\n.file-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 16px;\n  border-bottom: 1px solid #757575;\n  transition: background 0.15s ease;\n}\n\n.file-item:last-child {\n  border-bottom: none;\n}\n\n.file-item:hover {\n  background: rgba(59, 130, 246, 0.05);\n}\n\n.file-item.error {\n  background: rgba(239, 68, 68, 0.05);\n}\n\n.file-icon {\n  width: 24px;\n  height: 24px;\n  flex-shrink: 0;\n  color: #64748b;\n}\n\n.file-item.success .file-icon {\n  color: #22c55e;\n}\n\n.file-item.error .file-icon {\n  color: #ef4444;\n}\n\n.file-icon svg {\n  width: 100%;\n  height: 100%;\n}\n\n.upload-spinner {\n  width: 20px;\n  height: 20px;\n  border: 2px solid #757575;\n  border-top-color: #b5343a;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.file-info {\n  flex: 1 1;\n  min-width: 0;\n}\n\n.file-name {\n  display: block;\n  font-size: 14px;\n  font-weight: 500;\n  color: #1a1a1a;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.file-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: #64748b;\n  margin-top: 2px;\n}\n\n.file-error {\n  color: #ef4444;\n}\n\n.file-progress {\n  width: 60px;\n  height: 4px;\n  background: #757575;\n  border-radius: 2px;\n  overflow: hidden;\n}\n\n.progress-bar {\n  height: 100%;\n  background: linear-gradient(90deg, #b5343a, #b5343a);\n  transition: width 0.2s ease;\n}\n\n.file-remove {\n  width: 28px;\n  height: 28px;\n  padding: 4px;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  color: #64748b;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  flex-shrink: 0;\n}\n\n.file-remove:hover {\n  background: rgba(239, 68, 68, 0.1);\n  border-color: rgba(239, 68, 68, 0.3);\n  color: #ef4444;\n}\n\n.file-remove svg {\n  width: 100%;\n  height: 100%;\n}\n\n/* Engagement type badges */\n.engagement-badge {\n  display: inline-block;\n  padding: 1px 6px;\n  border-radius: 3px;\n  font-size: 0.7rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  margin-left: 6px;\n  cursor: help;\n}\n\n.engagement-direct {\n  background: rgba(59, 130, 246, 0.15);\n  color: #60a5fa;\n  border: 1px solid rgba(59, 130, 246, 0.3);\n}\n\n.engagement-indirect {\n  background: rgba(168, 162, 158, 0.15);\n  color: #a8a29e;\n  border: 1px solid rgba(168, 162, 158, 0.3);\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/wizard/FileUploadZone.css\"],\"names\":[],\"mappings\":\"AAAA,0BAA0B;;AAE1B;EACE,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,UAAU;EACV,WAAW;EACX,UAAU;EACV,YAAY;EACZ,gBAAgB;EAChB,sBAAsB;EACtB,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,cAAc;EACd,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,mBAAmB;AACrB;;AAEA;EACE,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,cAAc;EACd,kBAAkB;EAClB,0BAA0B;EAC1B,mBAAmB;EACnB,kBAAkB;EAClB,kBAAkB;EAClB,eAAe;EACf,yBAAyB;EACzB,mBAAmB;AACrB;;AAEA;EACE,qBAAqB;EACrB,oCAAoC;AACtC;;AAEA;EACE,qBAAqB;EACrB,mCAAmC;EACnC,sBAAsB;AACxB;;AAEA;EACE,aAAa;AACf;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,mBAAmB;EACnB,cAAc;EACd,2BAA2B;AAC7B;;AAEA;;EAEE,cAAc;AAChB;;AAEA;EACE,WAAW;EACX,YAAY;AACd;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,SAAS;AACX;;AAEA,wBAAwB;AACxB;EACE,gBAAgB;EAChB,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,mBAAmB;EACnB,gCAAgC;AAClC;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,SAAS;EACT,UAAU;EACV,iBAAiB;EACjB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,kBAAkB;EAClB,gCAAgC;EAChC,iCAAiC;AACnC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;E