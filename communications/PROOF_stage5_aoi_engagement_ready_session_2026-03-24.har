CR,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,kBAAkB;EAClB,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,cAAc;EACd,eAAe;AACjB;;AAEA,qCAAqC;;AAErC;EACE,6BAA6B;EAC7B,UAAU;AACZ;;AAEA;EACE,0BAA0B;EAC1B,gCAAgC;AAClC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,oCAAoC;AACtC;;AAEA;EACE,oCAAoC;AACtC;;AAEA;EACE,oCAAoC;AACtC;;AAEA;EACE,mCAAmC;AACrC;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,yBAAyB;EACzB,sBAAsB;EACtB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,uBAAuB;EACvB,QAAQ;EACR,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,aAAa;EACb,eAAe;EACf,QAAQ;AACV;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,kBAAkB;EAClB,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,kBAAkB;EAClB,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,kBAAkB;EAClB,qBAAqB;AACvB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA,yCAAyC;;AAEzC;EACE,oBAAoB;EACpB,mBAAmB;EACnB,QAAQ;EACR,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,mBAAmB;EACnB,0BAA0B;EAC1B,sBAAsB;EACtB,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA,yBAAyB;AACzB;EACE,qCAAqC;EACrC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,kBAAkB;AACpB;;AAEA,wCAAwC;;AAExC;EACE,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,eAAe;EACf,YAAY;EACZ,gBAAgB;EAChB,UAAU;EACV,0BAA0B;EAC1B,6BAA6B;AAC/B;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,eAAe;EACf,QAAQ;EACR,eAAe;EACf,gBAAgB;EAChB,UAAU;AACZ;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,kBAAkB;EAClB,+BAA+B;EAC/B,cAAc;AAChB;;AAEA,sBAAsB;;AAEtB;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,kBAAkB;EAClB,aAAa;EACb,mBAAmB;EACnB,QAAQ;AACV;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA,oCAAoC;;AAEpC;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,aAAa;EACb,mBAAmB;EACnB,QAAQ;AACV;;AAEA;EACE,oCAAoC;EACpC,cAAc;EACd,cAAc;EACd,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,eAAe;AACjB;;AAEA,yCAAyC;;AAEzC;EACE,kBAAkB;EAClB,kBAAkB;EAClB,oCAAoC;EACpC,0CAA0C;EAC1C,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,yBAAyB;EACzB,qBAAqB;EACrB,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,eAAe;AACjB;;AAEA;EACE,mBAAmB;EACnB,YAAY;EACZ,gBAAgB;EAChB,eAAe;EACf,gBAAgB;EAChB,kBAAkB;EAClB,eAAe;EACf,kBAAkB;AACpB;;AAEA;EACE,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,cAAc;EACd,eAAe;EACf,kBAAkB;AACpB;;AAEA,iCAAiC;;AAEjC;EACE,kBAAkB;EAClB,kBAAkB;EAClB,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,eAAe;EACf,mCAAmC;AACrC\",\"sourcesContent\":[\"/* ============= PIPELINE VISUALIZATION ============= */\\n/* Hierarchical tree showing: Plan → Phases → Chains → Engines → Passes → Stances */\\n/* Matches the warm-cream Critic design (bg: #f5f3f0, border: #e0ddd8, accent: #b5343a) */\\n\\n.pipeline-viz {\\n  background: var(--bg-surface, #ffffff);\\n  border: 1px solid var(--border-color, #e0ddd8);\\n  border-radius: 8px;\\n  margin-top: 12px;\\n  margin-bottom: 16px;\\n  overflow: hidden;\\n}\\n\\n/* ── Header / Collapse Toggle ── */\\n\\n.pipeline-viz__header {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 10px 16px;\\n  cursor: pointer;\\n  user-select: none;\\n  background: var(--bg-elevated, #f5f3f0);\\n  border-bottom: 1px solid transparent;\\n  transition: background 0.15s;\\n}\\n\\n.pipeline-viz__header:hover {\\n  background: #ebe8e4;\\n}\\n\\n.pipeline-viz--expanded .pipeline-viz__header {\\n  border-bottom-color: var(--border-color, #e0ddd8);\\n}\\n\\n.pipeline-viz__toggle {\\n  font-size: 11px;\\n  color: #64748b;\\n  width: 16px;\\n  text-align: center;\\n  transition: transform 0.2s;\\n}\\n\\n.pipeline-viz--expanded .pipeline-viz__toggle {\\n  transform: rotate(90deg);\\n}\\n\\n.pipeline-viz__title {\\n  font-size: 13px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.pipeline-viz__stats {\\n  font-size: 12px;\\n  color: #64748b;\\n  margin-left: auto;\\n  display: flex;\\n  gap: 12px;\\n}\\n\\n.pipeline-viz__stat {\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n}\\n\\n.pipeline-viz__stat-value {\\n  font-weight: 600;\\n  color: #475569;\\n}\\n\\n/* ── Phase List ── */\\n\\n.pipeline-viz__body {\\n  padding: 0;\\n}\\n\\n.pipeline-viz__phases {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n/* ── Phase Card ── */\\n\\n.pipeline-phase {\\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\\n}\\n\\n.pipeline-phase:last-child {\\n  border-bottom: none;\\n}\\n\\n.pipeline-phase__header {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 10px 16px;\\n  cursor: pointer;\\n  user-select: none;\\n  transition: background 0.15s;\\n}\\n\\n.pipeline-phase__header:hover {\\n  background: rgba(0, 0, 0, 0.02);\\n}\\n\\n.pipeline-phase__toggle {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  width: 14px;\\n  text-align: center;\\n  transition: transform 0.2s;\\n}\\n\\n.pipeline-phase--expanded .pipeline-phase__toggle {\\n  transform: rotate(90deg);\\n}\\n\\n/* Status Pips */\\n\\n.pipeline-phase__pip {\\n  width: 10px;\\n  height: 10px;\\n  border-radius: 50%;\\n  flex-shrink: 0;\\n  border: 2px solid;\\n}\\n\\n.pipeline-phase__pip--pending {\\n  background: #e2e8f0;\\n  border-color: #cbd5e1;\\n}\\n\\n.pipeline-phase__pip--running {\\n  background: #3b82f6;\\n  border-color: #2563eb;\\n  animation: pip-pulse 1.5s ease-in-out infinite;\\n}\\n\\n.pipeline-phase__pip--completed {\\n  background: #22c55e;\\n  border-color: #16a34a;\\n}\\n\\n.pipeline-phase__pip--failed {\\n  background: #ef4444;\\n  border-color: #dc2626;\\n}\\n\\n.pipeline-phase__pip--skipped {\\n  background: #94a3b8;\\n  border-color: #64748b;\\n}\\n\\n@keyframes pip-pulse {\\n  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }\\n  50% { opacity: 0.8; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0); }\\n}\\n\\n.pipeline-phase__name {\\n  font-size: 13px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  flex: 1;\\n}\\n\\n.pipeline-phase__number {\\n  font-weight: 400;\\n  color: #94a3b8;\\n  margin-right: 4px;\\n}\\n\\n.pipeline-phase__badges {\\n  display: flex;\\n  gap: 6px;\\n  align-items: center;\\n}\\n\\n.pipeline-phase__badge {\\n  font-size: 10px;\\n  padding: 2px 6px;\\n  border-radius: 3px;\\n  font-weight: 500;\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n}\\n\\n.pipeline-phase__badge--depth-surface {\\n  background: rgba(148, 163, 184, 0.15);\\n  color: #64748b;\\n}\\n\\n.pipeline-phase__badge--depth-standard {\\n  background: rgba(59, 130, 246, 0.12);\\n  color: #2563eb;\\n}\\n\\n.pipeline-phase__badge--depth-deep {\\n  background: rgba(139, 92, 246, 0.12);\\n  color: #7c3aed;\\n}\\n\\n.pipeline-phase__badge--model-opus {\\n  background: rgba(181, 52, 58, 0.1);\\n  color: #b5343a;\\n}\\n\\n.pipeline-phase__badge--model-sonnet {\\n  background: rgba(59, 130, 246, 0.1);\\n  color: #1d4ed8;\\n}\\n\\n.pipeline-phase__badge--per-work {\\n  background: rgba(245, 158, 11, 0.12);\\n  color: #b45309;\\n}\\n\\n.pipeline-phase__badge--chain {\\n  background: rgba(20, 184, 166, 0.1);\\n  color: #0d9488;\\n}\\n\\n.pipeline-phase__badge--chapter {\\n  background: rgba(168, 85, 247, 0.12);\\n  color: #7c3aed;\\n}\\n\\n.pipeline-phase__badge--scope-whole {\\n  background: rgba(148, 163, 184, 0.08);\\n  color: #64748b;\\n  font-style: italic;\\n}\\n\\n.pipeline-phase__badge--skip {\\n  background: rgba(148, 163, 184, 0.15);\\n  color: #94a3b8;\\n  text-decoration: line-through;\\n}\\n\\n.pipeline-phase__engine-count {\\n  font-size: 11px;\\n  color: #94a3b8;\\n}\\n\\n/* ── Phase Body (expanded) ── */\\n\\n.pipeline-phase__body {\\n  padding: 0 16px 12px 40px;\\n}\\n\\n.pipeline-phase__rationale {\\n  font-size: 12px;\\n  color: #64748b;\\n  line-height: 1.5;\\n  margin-bottom: 10px;\\n  padding: 6px 10px;\\n  background: rgba(0, 0, 0, 0.02);\\n  border-radius: 4px;\\n  border-left: 2px solid #e0ddd8;\\n}\\n\\n/* ── Chapter Targets ── */\\n\\n.pipeline-phase__chapter-targets {\\n  margin-bottom: 10px;\\n  padding: 8px 10px;\\n  background: rgba(168, 85, 247, 0.04);\\n  border-radius: 4px;\\n  border-left: 2px solid #a855f7;\\n}\\n\\n.pipeline-phase__chapter-targets-label {\\n  font-size: 11px;\\n  font-weight: 600;\\n  color: #7c3aed;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  margin-bottom: 6px;\\n}\\n\\n.pipeline-phase__chapter-target {\\n  display: flex;\\n  align-items: baseline;\\n  gap: 8px;\\n  font-size: 12px;\\n  padding: 2px 0;\\n}\\n\\n.pipeline-phase__chapter-id {\\n  font-family: 'JetBrains Mono', 'Fira Code', monospace;\\n  font-size: 11px;\\n  color: #7c3aed;\\n  background: rgba(168, 85, 247, 0.08);\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n}\\n\\n.pipeline-phase__chapter-title {\\n  color: #334155;\\n  font-weight: 500;\\n}\\n\\n.pipeline-phase__chapter-rationale {\\n  color: #94a3b8;\\n  font-size: 11px;\\n  font-style: italic;\\n}\\n\\n/* ── Engine Card ── */\\n\\n.pipeline-engine {\\n  margin-bottom: 8px;\\n  border: 1px solid #e8e5e1;\\n  border-radius: 6px;\\n  overflow: hidden;\\n}\\n\\n.pipeline-engine:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.pipeline-engine__header {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 8px 12px;\\n  background: #faf9f7;\\n  cursor: pointer;\\n  user-select: none;\\n  transition: background 0.15s;\\n}\\n\\n.pipeline-engine__header:hover {\\n  background: #f0edea;\\n}\\n\\n.pipeline-engine__toggle {\\n  font-size: 9px;\\n  color: #94a3b8;\\n  width: 12px;\\n  transition: transform 0.2s;\\n}\\n\\n.pipeline-engine--expanded .pipeline-engine__toggle {\\n  transform: rotate(90deg);\\n}\\n\\n.pipeline-engine__name {\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: #334155;\\n  flex: 1;\\n}\\n\\n.pipeline-engine__category {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  text-transform: uppercase;\\n  letter-spacing: 0.04em;\\n}\\n\\n.pipeline-engine__pass-count {\\n  font-size: 11px;\\n  color: #94a3b8;\\n}\\n\\n/* ── Engine Body ── */\\n\\n.pipeline-engine__body {\\n  padding: 8px 12px 10px;\\n  border-top: 1px solid #e8e5e1;\\n}\\n\\n.pipeline-engine__focus {\\n  margin-bottom: 8px;\\n}\\n\\n.pipeline-engine__focus-label {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  text-transform: uppercase;\\n  letter-spacing: 0.04em;\\n  margin-bottom: 4px;\\n}\\n\\n.pipeline-engine__focus-dims {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 4px;\\n}\\n\\n.pipeline-engine__dim-chip {\\n  font-size: 11px;\\n  padding: 2px 6px;\\n  border-radius: 3px;\\n  background: rgba(139, 92, 246, 0.08);\\n  color: #6d28d9;\\n}\\n\\n/* ── Pass Sequence (LLM Call Cards) ── */\\n\\n.pipeline-passes {\\n  margin: 0;\\n  padding: 0;\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n/* ── Data Flow Connector ── */\\n\\n.pipeline-flow-connector {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 2px 0 2px 9px;\\n  position: relative;\\n}\\n\\n.pipeline-flow-connector__line {\\n  width: 2px;\\n  height: 12px;\\n  background: linear-gradient(to bottom, #cbd5e1, #94a3b8);\\n  flex-shrink: 0;\\n}\\n\\n.pipeline-flow-connector__arrow {\\n  font-size: 8px;\\n  color: #94a3b8;\\n  margin-left: -9px;\\n  margin-top: -2px;\\n}\\n\\n.pipeline-flow-connector__label {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  font-style: italic;\\n  margin-left: 4px;\\n}\\n\\n/* ── LLM Call Card ── */\\n\\n.llm-call {\\n  border: 1px solid #e2e0dc;\\n  border-radius: 6px;\\n  background: #ffffff;\\n  transition: border-color 0.15s, box-shadow 0.15s;\\n}\\n\\n.llm-call:hover {\\n  border-color: #d0cec9;\\n}\\n\\n.llm-call--active {\\n  border-color: #3b82f6;\\n  box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.2);\\n}\\n\\n.llm-call__header {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 8px;\\n  padding: 8px 10px;\\n  cursor: pointer;\\n  user-select: none;\\n}\\n\\n.llm-call__header:hover {\\n  background: rgba(0, 0, 0, 0.015);\\n}\\n\\n.llm-call__number {\\n  width: 22px;\\n  height: 22px;\\n  border-radius: 50%;\\n  background: #f1f5f9;\\n  color: #64748b;\\n  font-size: 10px;\\n  font-weight: 700;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  flex-shrink: 0;\\n  margin-top: 1px;\\n  border: 1.5px solid #e2e8f0;\\n}\\n\\n.llm-call__number--active {\\n  background: #3b82f6;\\n  color: white;\\n  border-color: #2563eb;\\n}\\n\\n.llm-call__header-content {\\n  flex: 1;\\n  min-width: 0;\\n}\\n\\n.llm-call__title-row {\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n  flex-wrap: wrap;\\n}\\n\\n.llm-call__label {\\n  font-size: 12px;\\n  font-weight: 500;\\n  color: #334155;\\n}\\n\\n.llm-call__consumes {\\n  font-size: 10px;\\n  color: #94a3b8;\\n}\\n\\n.llm-call__cognitive-mode {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  font-style: italic;\\n  margin-top: 2px;\\n}\\n\\n.llm-call__expand-hint {\\n  font-size: 10px;\\n  color: #cbd5e1;\\n  flex-shrink: 0;\\n  margin-top: 4px;\\n}\\n\\n/* ── LLM Call Detail (expanded) ── */\\n\\n.llm-call__detail {\\n  border-top: 1px solid #f0eeeb;\\n  padding: 0;\\n}\\n\\n.llm-call__section {\\n  padding: 8px 10px 8px 42px;\\n  border-bottom: 1px solid #f5f3f0;\\n}\\n\\n.llm-call__section:last-child {\\n  border-bottom: none;\\n}\\n\\n.llm-call__section--input {\\n  background: rgba(59, 130, 246, 0.02);\\n}\\n\\n.llm-call__section--stance {\\n  background: rgba(139, 92, 246, 0.02);\\n}\\n\\n.llm-call__section--desc {\\n  background: rgba(245, 158, 11, 0.02);\\n}\\n\\n.llm-call__section--output {\\n  background: rgba(34, 197, 94, 0.02);\\n}\\n\\n.llm-call__section-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 5px;\\n  margin-bottom: 4px;\\n}\\n\\n.llm-call__section-icon {\\n  font-size: 11px;\\n  flex-shrink: 0;\\n}\\n\\n.llm-call__section-title {\\n  font-size: 10px;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.04em;\\n  color: #64748b;\\n}\\n\\n.llm-call__input-summary {\\n  font-size: 11px;\\n  color: #475569;\\n  line-height: 1.5;\\n  margin-bottom: 4px;\\n}\\n\\n.llm-call__focus-row {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 6px;\\n  margin-top: 4px;\\n}\\n\\n.llm-call__focus-label {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  flex-shrink: 0;\\n  margin-top: 2px;\\n}\\n\\n.llm-call__focus-chips {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 3px;\\n}\\n\\n.llm-call__dim-chip {\\n  font-size: 10px;\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n  background: rgba(139, 92, 246, 0.08);\\n  color: #6d28d9;\\n}\\n\\n.llm-call__cap-chip {\\n  font-size: 10px;\\n  padding: 1px 5px;\\n  border-radius: 3px;\\n  background: rgba(20, 184, 166, 0.08);\\n  color: #0f766e;\\n}\\n\\n.llm-call__stance-prose {\\n  font-size: 11px;\\n  color: #475569;\\n  line-height: 1.6;\\n  font-style: italic;\\n  white-space: pre-line;\\n}\\n\\n.llm-call__description {\\n  font-size: 11px;\\n  color: #475569;\\n  line-height: 1.6;\\n}\\n\\n.llm-call__output-summary {\\n  font-size: 11px;\\n  color: #475569;\\n  line-height: 1.5;\\n}\\n\\n/* ── Stance Pills (colored by type) ── */\\n\\n.stance-pill {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 3px;\\n  font-size: 10px;\\n  font-weight: 600;\\n  padding: 2px 7px;\\n  border-radius: 10px;\\n  text-transform: capitalize;\\n  letter-spacing: 0.02em;\\n  flex-shrink: 0;\\n}\\n\\n.stance-pill--discovery {\\n  background: rgba(34, 197, 94, 0.12);\\n  color: #15803d;\\n}\\n\\n.stance-pill--inference {\\n  background: rgba(20, 184, 166, 0.12);\\n  color: #0f766e;\\n}\\n\\n.stance-pill--confrontation {\\n  background: rgba(239, 68, 68, 0.12);\\n  color: #b91c1c;\\n}\\n\\n.stance-pill--architecture {\\n  background: rgba(59, 130, 246, 0.12);\\n  color: #1d4ed8;\\n}\\n\\n.stance-pill--dialectical {\\n  background: rgba(139, 92, 246, 0.12);\\n  color: #6d28d9;\\n}\\n\\n.stance-pill--integration {\\n  background: rgba(245, 158, 11, 0.12);\\n  color: #b45309;\\n}\\n\\n.stance-pill--reflection {\\n  background: rgba(236, 72, 153, 0.12);\\n  color: #be185d;\\n}\\n\\n/* Presentation stances */\\n.stance-pill--summary {\\n  background: rgba(100, 116, 139, 0.12);\\n  color: #475569;\\n}\\n\\n.stance-pill--evidence {\\n  background: rgba(34, 197, 94, 0.12);\\n  color: #15803d;\\n}\\n\\n.stance-pill--comparison {\\n  background: rgba(59, 130, 246, 0.12);\\n  color: #1d4ed8;\\n}\\n\\n.stance-pill--narrative {\\n  background: rgba(245, 158, 11, 0.12);\\n  color: #b45309;\\n}\\n\\n.stance-pill--interactive {\\n  background: rgba(139, 92, 246, 0.12);\\n  color: #6d28d9;\\n}\\n\\n.stance-pill--diagnostic {\\n  background: rgba(239, 68, 68, 0.12);\\n  color: #b91c1c;\\n}\\n\\n.pipeline-pass__cognitive-mode {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  font-style: italic;\\n}\\n\\n/* ── Dimension Chips (collapsible) ── */\\n\\n.pipeline-dims {\\n  margin-top: 8px;\\n}\\n\\n.pipeline-dims__toggle {\\n  font-size: 11px;\\n  color: #94a3b8;\\n  cursor: pointer;\\n  border: none;\\n  background: none;\\n  padding: 0;\\n  text-decoration: underline;\\n  text-decoration-style: dotted;\\n}\\n\\n.pipeline-dims__toggle:hover {\\n  color: #64748b;\\n}\\n\\n.pipeline-dims__list {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 4px;\\n  margin-top: 6px;\\n  list-style: none;\\n  padding: 0;\\n}\\n\\n.pipeline-dims__item {\\n  font-size: 10px;\\n  padding: 2px 6px;\\n  border-radius: 3px;\\n  background: rgba(0, 0, 0, 0.04);\\n  color: #64748b;\\n}\\n\\n/* ── Chain Label ── */\\n\\n.pipeline-chain-label {\\n  font-size: 11px;\\n  color: #0d9488;\\n  font-weight: 500;\\n  margin-bottom: 8px;\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n}\\n\\n.pipeline-chain-label__mode {\\n  font-size: 10px;\\n  color: #94a3b8;\\n  font-weight: 400;\\n}\\n\\n/* ── Dependency Arrow (header) ── */\\n\\n.pipeline-phase__deps {\\n  font-size: 11px;\\n  color: #64748b;\\n  margin-left: 6px;\\n  display: flex;\\n  align-items: center;\\n  gap: 2px;\\n}\\n\\n.pipeline-phase__dep-tag {\\n  background: rgba(99, 102, 241, 0.08);\\n  color: #6366f1;\\n  padding: 0 5px;\\n  border-radius: 3px;\\n  font-weight: 600;\\n  font-size: 10px;\\n  cursor: default;\\n}\\n\\n/* ── Context Inputs (expanded body) ── */\\n\\n.pipeline-phase__context-inputs {\\n  margin: 8px 0 12px;\\n  padding: 10px 12px;\\n  background: rgba(99, 102, 241, 0.04);\\n  border: 1px solid rgba(99, 102, 241, 0.12);\\n  border-radius: 6px;\\n}\\n\\n.pipeline-phase__context-inputs-label {\\n  font-size: 11px;\\n  font-weight: 600;\\n  color: #6366f1;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  margin-bottom: 6px;\\n}\\n\\n.pipeline-phase__context-inputs-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.pipeline-phase__context-input {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-size: 12px;\\n}\\n\\n.pipeline-phase__context-input-num {\\n  background: #6366f1;\\n  color: white;\\n  font-weight: 700;\\n  font-size: 10px;\\n  padding: 1px 6px;\\n  border-radius: 3px;\\n  min-width: 28px;\\n  text-align: center;\\n}\\n\\n.pipeline-phase__context-input-name {\\n  color: #334155;\\n  font-weight: 500;\\n}\\n\\n.pipeline-phase__context-input-meta {\\n  color: #94a3b8;\\n  font-size: 11px;\\n  font-style: italic;\\n}\\n\\n/* ── Loading / Error States ── */\\n\\n.pipeline-viz__loading {\\n  padding: 20px 16px;\\n  text-align: center;\\n  color: #94a3b8;\\n  font-size: 13px;\\n}\\n\\n.pipeline-viz__error {\\n  padding: 12px 16px;\\n  color: #b91c1c;\\n  font-size: 12px;\\n  background: rgba(239, 68, 68, 0.05);\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT