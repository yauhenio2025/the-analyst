[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/AnalysisWorkspacePage.css\"\n/*!****************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/AnalysisWorkspacePage.css ***!\n  \\****************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/**\n * AnalysisWorkspacePage.css — \"Humanist Data Craft\"\n *\n * Mirrors the GenealogyPage design system: warm, readable, editorial.\n * Uses the same design tokens and semantic aliases from DesignTokenContext.\n * All classes use aw-* prefix for namespace separation.\n */\n\n\n/* =================================================================\n   1. DESIGN TOKENS: Custom Properties\n   ================================================================= */\n\n.analysis-workspace-layout {\n\n  /* -- Typography Scale -- */\n  --type-display:    2rem;\n  --type-heading:    1.375rem;\n  --type-subheading: 1.125rem;\n  --type-body:       0.9375rem;\n  --type-caption:    0.8125rem;\n  --type-label:      0.75rem;\n\n  /* -- Font Families -- */\n  --font-display:  'Playfair Display', Georgia, serif;\n  --font-serif:    'Source Serif 4', 'Source Serif Pro', Georgia, serif;\n  --font-sans:     'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  --font-mono:     'JetBrains Mono', 'Fira Code', 'Consolas', monospace;\n\n  /* -- Font Weights -- */\n  --weight-normal:   400;\n  --weight-medium:   500;\n  --weight-semibold: 600;\n  --weight-bold:     700;\n\n  /* -- Line Heights -- */\n  --leading-tight:   1.2;\n  --leading-snug:    1.35;\n  --leading-normal:  1.4;\n  --leading-prose:   1.65;\n\n  /* -- Spacing Scale -- */\n  --space-2xs: 0.125rem;\n  --space-xs:  0.25rem;\n  --space-sm:  0.5rem;\n  --space-md:  1rem;\n  --space-lg:  1.5rem;\n  --space-xl:  2rem;\n  --space-2xl: 3rem;\n\n  /* -- Border Radii -- */\n  --radius-sm:   4px;\n  --radius-md:   8px;\n  --radius-lg:   12px;\n  --radius-pill: 9999px;\n\n  /* -- Shadows -- */\n  --shadow-xs:  0 1px 2px rgba(0, 0, 0, 0.04);\n  --shadow-sm:  0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);\n  --shadow-md:  0 4px 6px rgba(0, 0, 0, 0.05), 0 2px 4px rgba(0, 0, 0, 0.04);\n\n  /* -- Transitions -- */\n  --ease-out:        cubic-bezier(0.16, 1, 0.3, 1);\n  --duration-fast:   150ms;\n  --duration-normal: 250ms;\n\n  /* -- Semantic Color Aliases (dt-token fallbacks) -- */\n  --color-surface:      var(--dt-surface-default, #ffffff);\n  --color-surface-alt:  var(--dt-surface-alt, #f8f9fa);\n  --color-surface-elev: var(--dt-surface-elevated, #f1f5f9);\n  --color-border:       var(--dt-border-default, #e2e5e9);\n  --color-border-light: var(--dt-border-light, #eef0f2);\n  --color-text:         var(--dt-text-default, #1a1d23);\n  --color-text-muted:   var(--dt-text-muted, #6b7280);\n  --color-text-faint:   var(--dt-text-faint, #9ca3af);\n  --color-accent:       var(--dt-page-accent, #b5343a);\n  --color-accent-bg:    var(--dt-page-accent-bg, rgba(181, 52, 58, 0.08));\n  --color-accent-hover: var(--dt-page-accent-hover, #9a2c31);\n\n  /* -- Status/Semantic Color Aliases -- */\n  --color-success-bg:       var(--dt-severity-low-bg, rgba(34, 197, 94, 0.12));\n  --color-success-text:     var(--dt-severity-low-text, #15803d);\n  --color-success-border:   var(--dt-severity-low-border, rgba(34, 197, 94, 0.2));\n  --color-info-bg:          var(--dt-status-running-bg, rgba(59, 130, 246, 0.12));\n  --color-info-text:        var(--dt-status-running-text, #1d4ed8);\n  --color-info-border:      var(--dt-status-running-border, rgba(59, 130, 246, 0.2));\n  --color-warning-bg:       var(--dt-severity-medium-bg, rgba(234, 179, 8, 0.12));\n  --color-warning-text:     var(--dt-severity-medium-text, #a16207);\n  --color-warning-border:   var(--dt-severity-medium-border, rgba(234, 179, 8, 0.2));\n  --color-error-bg:         var(--dt-severity-high-bg, rgba(239, 68, 68, 0.12));\n  --color-error-text:       var(--dt-severity-high-text, #b91c1c);\n  --color-error-border:     var(--dt-severity-high-border, rgba(239, 68, 68, 0.2));\n  --color-muted-bg:         var(--dt-surface-alt, rgba(148, 163, 184, 0.12));\n  --color-muted-text:       var(--dt-text-muted, #475569);\n}\n\n\n/* =================================================================\n   2. BASE TYPOGRAPHY & LAYOUT\n   ================================================================= */\n\n.analysis-workspace-layout {\n  font-family: var(--font-sans);\n  font-size: var(--type-body);\n  line-height: var(--leading-normal);\n  color: var(--color-text);\n  background: var(--color-surface);\n  min-height: 100vh;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  padding: var(--space-lg);\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.analysis-workspace-layout h1,\n.analysis-workspace-layout h2,\n.analysis-workspace-layout h3 {\n  font-family: var(--font-serif);\n  color: var(--color-text);\n}\n\n\n/* =================================================================\n   3. HEADER\n   ================================================================= */\n\n.aw-header {\n  margin-bottom: var(--space-lg);\n}\n\n.aw-header h1 {\n  font-family: var(--font-display);\n  font-size: var(--type-display);\n  font-weight: var(--weight-bold);\n  margin-bottom: var(--space-sm);\n  color: var(--color-text);\n  letter-spacing: -0.01em;\n}\n\n.aw-header p {\n  font-size: var(--type-caption);\n  color: var(--color-text-faint);\n  margin: 0;\n  font-family: var(--font-sans);\n}\n\n\n/* =================================================================\n   4. LOADING CENTER\n   ================================================================= */\n\n.aw-loading-center {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-2xl) 0;\n  gap: var(--space-sm);\n  color: var(--color-text-muted);\n  font-size: var(--type-caption);\n  font-family: var(--font-sans);\n}\n\n\n/* =================================================================\n   5. ERROR BANNER\n   ================================================================= */\n\n.aw-error-banner {\n  background: var(--color-error-bg);\n  border: 1px solid var(--color-error-border);\n  color: var(--color-error-text);\n  padding: var(--space-sm) var(--space-md);\n  border-radius: var(--radius-md);\n  margin-bottom: var(--space-md);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: var(--type-caption);\n  font-family: var(--font-sans);\n}\n\n.aw-error-banner button {\n  background: none;\n  border: none;\n  color: var(--color-accent);\n  cursor: pointer;\n  text-decoration: underline;\n  font-size: var(--type-caption);\n  font-family: var(--font-sans);\n}\n\n.aw-error-actions {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n\n/* =================================================================\n   6. CONTROLS: Run Analysis + Import V2\n   ================================================================= */\n\n.aw-controls {\n  display: flex;\n  gap: var(--space-md);\n  align-items: stretch;\n  margin-bottom: var(--space-lg);\n  flex-wrap: wrap;\n}\n\n.aw-run-card {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  padding: var(--space-md);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n  flex: 1 1;\n  min-width: 280px;\n}\n\n.aw-run-card h3 {\n  font-size: var(--type-body);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n  margin: 0;\n  font-family: var(--font-serif);\n}\n\n.aw-run-btn {\n  background: var(--color-accent);\n  color: white;\n  border: none;\n  padding: 10px 24px;\n  font-size: var(--type-caption);\n  font-weight: var(--weight-semibold);\n  font-family: var(--font-sans);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  transition: background var(--duration-fast);\n  align-self: flex-start;\n}\n\n.aw-run-btn:hover:not(:disabled) {\n  background: var(--color-accent-hover);\n}\n\n.aw-run-btn:disabled {\n  background: var(--color-text-faint);\n  cursor: not-allowed;\n}\n\n.aw-import-card {\n  background: var(--color-accent-bg);\n  border: 1px solid var(--color-accent-bg);\n  border-radius: var(--radius-md);\n  padding: var(--space-md);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n  min-width: 280px;\n}\n\n.aw-import-card h3 {\n  font-size: var(--type-body);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n  margin: 0;\n  font-family: var(--font-serif);\n}\n\n.aw-import-row {\n  display: flex;\n  gap: var(--space-sm);\n  align-items: center;\n}\n\n.aw-import-input {\n  flex: 1 1;\n  max-width: 280px;\n  padding: 6px 12px;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  font-size: var(--type-caption);\n  font-family: var(--font-mono);\n  background: var(--color-surface);\n  color: var(--color-text);\n}\n\n.aw-import-input::placeholder {\n  color: var(--color-text-faint);\n  font-family: inherit;\n}\n\n.aw-import-btn {\n  background: var(--color-accent-bg);\n  color: var(--color-accent);\n  border: 1px solid var(--color-accent);\n  padding: 6px 16px;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  font-size: var(--type-caption);\n  font-weight: var(--weight-medium);\n  font-family: var(--font-sans);\n  transition: background var(--duration-fast);\n  white-space: nowrap;\n}\n\n.aw-import-btn:hover {\n  background: var(--color-accent-bg);\n}\n\n.aw-import-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n\n/* =================================================================\n   7. PROGRESS\n   ================================================================= */\n\n.aw-progress-section {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  padding: var(--space-md);\n  margin-bottom: var(--space-lg);\n}\n\n.aw-progress-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-sm);\n}\n\n.aw-progress-header h2 {\n  font-size: var(--type-subheading);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n  margin: 0;\n}\n\n.aw-progress-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.aw-job-status {\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n  font-size: var(--type-label);\n  text-transform: capitalize;\n  font-weight: var(--weight-medium);\n  font-family: var(--font-sans);\n}\n\n.aw-job-status.status-completed { background: var(--color-success-bg); color: var(--color-success-text); }\n.aw-job-status.status-running { background: var(--color-info-bg); color: var(--color-info-text); }\n.aw-job-status.status-pending { background: var(--color-warning-bg); color: var(--color-warning-text); }\n.aw-job-status.status-failed { background: var(--color-error-bg); color: var(--color-error-text); }\n.aw-job-status.status-cancelled { background: var(--color-muted-bg); color: var(--color-muted-text); }\n\n.aw-cancel-btn {\n  background: var(--color-error-bg);\n  color: var(--color-error-text);\n  border: 1px solid var(--color-error-border);\n  padding: 4px 12px;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  font-size: var(--type-label);\n  font-family: var(--font-sans);\n  transition: background var(--duration-fast);\n}\n\n.aw-cancel-btn:hover {\n  background: var(--color-error-bg);\n}\n\n.aw-resume-btn {\n  background: var(--color-info-bg);\n  color: var(--color-info-text);\n  border: 1px solid var(--color-info-border);\n  padding: 6px 16px;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  font-size: var(--type-caption);\n  font-weight: var(--weight-semibold);\n  font-family: var(--font-sans);\n  transition: background var(--duration-fast);\n  margin-top: var(--space-sm);\n}\n\n.aw-resume-btn:hover {\n  background: var(--color-info-bg);\n}\n\n.aw-recover-btn {\n  background: var(--color-success-bg);\n  color: var(--color-success-text);\n  border: 1px solid var(--color-success-border);\n  padding: 6px 16px;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  font-size: var(--type-caption);\n  font-weight: var(--weight-medium);\n  font-family: var(--font-sans);\n  transition: background var(--duration-fast);\n  margin-top: var(--space-sm);\n}\n\n.aw-recover-btn:hover {\n  background: var(--color-success-bg);\n}\n\n.aw-progress-bar {\n  background: var(--color-surface-elev);\n  border-radius: var(--radius-md);\n  height: 8px;\n  overflow: hidden;\n  margin-bottom: var(--space-sm);\n}\n\n.aw-progress-fill {\n  background: linear-gradient(90deg, var(--color-accent), var(--color-info-text));\n  height: 100%;\n  transition: width 0.5s ease;\n  border-radius: var(--radius-md);\n}\n\n.aw-progress-detail {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: var(--type-caption);\n  font-family: var(--font-sans);\n}\n\n.aw-progress-pass {\n  color: var(--color-text);\n  font-weight: var(--weight-medium);\n}\n\n.aw-progress-sub {\n  color: var(--color-text-muted);\n}\n\n\n/* =================================================================\n   8. RESULTS SECTION\n   ================================================================= */\n\n.aw-results-section {\n  margin-top: var(--space-lg);\n}\n\n.aw-results-header {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-sm);\n  flex-wrap: wrap;\n}\n\n.aw-results-header h2 {\n  font-size: var(--type-heading);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n  margin: 0;\n  font-family: var(--font-serif);\n}\n\n.aw-v2-badge {\n  display: inline-block;\n  font-size: 0.625rem;\n  font-weight: var(--weight-medium);\n  text-transform: capitalize;\n  letter-spacing: 0.02em;\n  background: var(--color-accent-bg);\n  color: var(--color-accent);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--color-accent-bg);\n  font-family: var(--font-sans);\n}\n\n.aw-link-btn,\n.gen-link-btn {\n  background: none;\n  border: none;\n  color: var(--color-accent);\n  cursor: pointer;\n  font-size: var(--type-label);\n  font-family: var(--font-sans);\n  padding: 0;\n  text-decoration: underline;\n  transition: color var(--duration-fast);\n}\n\n.aw-link-btn:hover,\n.gen-link-btn:hover {\n  color: var(--color-accent-hover);\n}\n\n/* =================================================================\n   9. TAB NAVIGATION (Two-Level)\n   ================================================================= */\n\n/* -- Primary Parent Tabs -- */\n.aw-tabs {\n  display: flex;\n  border-bottom: 2px solid var(--color-border-light);\n  overflow-x: auto;\n  margin-bottom: 0;\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  background: var(--color-surface);\n  scrollbar-width: none;\n}\n\n.aw-tabs::-webkit-scrollbar {\n  display: none;\n}\n\n.aw-tabs button {\n  flex-shrink: 0;\n  background: none;\n  border: none;\n  padding: 12px 18px;\n  color: var(--color-text-muted);\n  cursor: pointer;\n  border-bottom: 3px solid transparent;\n  margin-bottom: -2px;\n  transition: color var(--duration-fast), border-color var(--duration-fast);\n  font-size: var(--type-body);\n  font-weight: var(--weight-semibold);\n  font-family: var(--font-sans);\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  white-space: nowrap;\n}\n\n.aw-tabs button:hover {\n  color: var(--color-text);\n  background: transparent;\n}\n\n.aw-tabs button.active {\n  color: var(--color-accent);\n  border-bottom-color: var(--color-accent);\n  font-weight: var(--weight-bold);\n}\n\n/* -- Child Sub-Tabs -- */\n.aw-tabs-children {\n  display: flex;\n  border-bottom: 1px solid var(--color-border-light);\n  overflow-x: auto;\n  margin-bottom: 0;\n  padding-left: var(--space-md);\n  background: var(--color-surface-alt);\n  scrollbar-width: none;\n}\n\n.aw-tabs-children::-webkit-scrollbar {\n  display: none;\n}\n\n.aw-tabs-children button {\n  flex-shrink: 0;\n  background: none;\n  border: none;\n  padding: 8px 14px;\n  color: var(--color-text-faint);\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  margin-bottom: -1px;\n  transition: color var(--duration-fast), border-color var(--duration-fast);\n  font-size: var(--type-caption);\n  font-weight: var(--weight-medium);\n  font-family: var(--font-sans);\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  white-space: nowrap;\n}\n\n.aw-tabs-children button:hover {\n  color: var(--color-text-muted);\n}\n\n.aw-tabs-children button.active {\n  color: var(--color-accent);\n  border-bottom-color: var(--color-accent);\n}\n\n/* -- Tab Count Badge -- */\n.aw-tab-count {\n  background: var(--color-surface-alt);\n  color: var(--color-text-muted);\n  padding: 1px 7px;\n  border-radius: var(--radius-pill);\n  font-size: 0.6875rem;\n  font-weight: var(--weight-semibold);\n  font-family: var(--font-sans);\n}\n\n.aw-tabs button.active .aw-tab-count {\n  background: var(--color-accent-bg);\n  color: var(--color-accent);\n}\n\n/* -- Tab Quality Indicator -- */\n.aw-tab-quality {\n  font-size: 0.625rem;\n  color: var(--color-text-faint);\n}\n\n\n/* =================================================================\n   10. TAB CONTENT\n   ================================================================= */\n\n.aw-tab-content {\n  padding-top: var(--space-md);\n}\n\n\n/* =================================================================\n   11. EMPTY STATE\n   ================================================================= */\n\n.aw-empty-state {\n  text-align: center;\n  padding: var(--space-2xl) var(--space-lg);\n  color: var(--color-text-faint);\n}\n\n.aw-empty-state h3 {\n  font-size: var(--type-heading);\n  font-weight: var(--weight-medium);\n  color: var(--color-text-muted);\n  margin: 0 0 var(--space-sm) 0;\n  font-family: var(--font-serif);\n}\n\n.aw-empty-state p {\n  font-size: var(--type-caption);\n  margin: 0;\n  line-height: var(--leading-prose);\n  font-family: var(--font-sans);\n}\n\n\n/* =================================================================\n   12. SAVED RESULTS LIST\n   ================================================================= */\n\n.aw-saved-results {\n  margin-bottom: var(--space-lg);\n}\n\n.aw-saved-results h3 {\n  font-size: var(--type-body);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n  margin: 0 0 var(--space-sm) 0;\n  font-family: var(--font-serif);\n}\n\n.aw-saved-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.aw-saved-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  transition: border-color var(--duration-fast), box-shadow var(--duration-fast);\n}\n\n.aw-saved-item:hover {\n  border-color: var(--color-accent);\n  box-shadow: var(--shadow-xs);\n}\n\n.aw-saved-item-info {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.aw-saved-item-date {\n  font-size: var(--type-caption);\n  color: var(--color-text);\n  font-weight: var(--weight-medium);\n  font-family: var(--font-sans);\n}\n\n.aw-saved-item-meta {\n  font-size: var(--type-label);\n  color: var(--color-text-faint);\n  font-family: var(--font-mono);\n}\n\n\n/* =================================================================\n   13. PROSE TYPOGRAPHY\n   Styles for .gen-prose-renderer / .gen-prose-content produced by\n   ProseRenderer, and general prose within .aw-tab-content.\n   ================================================================= */\n\n/* -- Prose container -- */\n.analysis-workspace-layout .gen-prose-renderer {\n  max-width: 72ch;\n}\n\n.analysis-workspace-layout .gen-prose-content {\n  font-family: var(--font-serif);\n  font-size: var(--type-body);\n  line-height: var(--leading-prose);\n  color: var(--color-text);\n}\n\n.analysis-workspace-layout .gen-prose-content p {\n  margin: 0 0 1em 0;\n  max-width: 72ch;\n}\n\n.analysis-workspace-layout .gen-prose-content h2 {\n  font-family: var(--font-display);\n  font-size: var(--type-heading);\n  font-weight: var(--weight-bold);\n  color: var(--color-text);\n  margin: 1.75em 0 0.5em 0;\n  letter-spacing: -0.01em;\n}\n\n.analysis-workspace-layout .gen-prose-content h3 {\n  font-family: var(--font-serif);\n  font-size: var(--type-subheading);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n  margin: 1.5em 0 0.4em 0;\n}\n\n.analysis-workspace-layout .gen-prose-content h4 {\n  font-family: var(--font-serif);\n  font-size: var(--type-body);\n  font-weight: var(--weight-semibold);\n  color: var(--color-text-muted);\n  text-transform: capitalize;\n  letter-spacing: 0.02em;\n  margin: 1.25em 0 0.35em 0;\n}\n\n.analysis-workspace-layout .gen-prose-content strong {\n  font-weight: var(--weight-semibold);\n  color: var(--color-text);\n}\n\n.analysis-workspace-layout .gen-prose-content em {\n  font-style: italic;\n}\n\n/* -- General tab content prose -- */\n.aw-tab-content {\n  font-family: var(--font-serif);\n  line-height: var(--leading-prose);\n}\n\n.aw-tab-content p {\n  max-width: 72ch;\n  line-height: var(--leading-prose);\n}\n\n/* -- View descriptions (inline styles from V2TabContent) -- */\n.analysis-workspace-layout [style*=\"color: #64748b\"][style*=\"fontSize: 0.9rem\"] {\n  font-family: var(--font-serif);\n  max-width: 72ch;\n}\n\n/* -- Raw JSON fallback -- */\n.analysis-workspace-layout .gen-raw-json {\n  font-family: var(--font-mono);\n  font-size: var(--type-caption);\n  line-height: var(--leading-normal);\n  background: var(--color-surface-elev);\n  padding: var(--space-md);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--color-border-light);\n  overflow-x: auto;\n  max-width: 100%;\n}\n\n/* -- Empty state -- */\n.analysis-workspace-layout .gen-empty {\n  color: var(--color-text-faint);\n  font-style: italic;\n  font-family: var(--font-sans);\n  font-size: var(--type-caption);\n}\n\n\n/* =================================================================\n   14. STYLE LOADING ANIMATION\n   ================================================================= */\n\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.3; }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/AnalysisWorkspacePage.css\"],\"names\":[],\"mappings\":\"AAAA;;;;;;EAME;;;AAGF;;sEAEsE;;AAEtE;;EAEE,2BAA2B;EAC3B,uBAAuB;EACvB,2BAA2B;EAC3B,2BAA2B;EAC3B,4BAA4B;EAC5B,4BAA4B;EAC5B,0BAA0B;;EAE1B,wBAAwB;EACxB,mDAAmD;EACnD,qEAAqE;EACrE,mFAAmF;EACnF,qEAAqE;;EAErE,uBAAuB;EACvB,sBAAsB;EACtB,sBAAsB;EACtB,sBAAsB;EACtB,sBAAsB;;EAEtB,uBAAuB;EACvB,sBAAsB;EACtB,uBAAuB;EACvB,sBAAsB;EACtB,uBAAuB;;EAEvB,wBAAwB;EACxB,qBAAqB;EACrB,oBAAoB;EACpB,mBAAmB;EACnB,iBAAiB;EACjB,mBAAmB;EACnB,iBAAiB;EACjB,iBAAiB;;EAEjB,uBAAuB;EACvB,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;EACnB,qBAAqB;;EAErB,kBAAkB;EAClB,2CAA2C;EAC3C,0EAA0E;EAC1E,0EAA0E;;EAE1E,sBAAsB;EACtB,gDAAgD;EAChD,wBAAwB;EACxB,wBAAwB;;EAExB,sDAAsD;EACtD,wDAAwD;EACxD,oDAAoD;EACpD,yDAAyD;EACzD,uDAAuD;EACvD,qDAAqD;EACrD,qDAAqD;EACrD,mDAAmD;EACnD,mDAAmD;EACnD,oDAAoD;EACpD,uEAAuE;EACvE,0DAA0D;;EAE1D,wCAAwC;EACxC,4EAA4E;EAC5E,8DAA8D;EAC9D,+EAA+E;EAC/E,+EAA+E;EAC/E,gEAAgE;EAChE,kFAAkF;EAClF,+EAA+E;EAC/E,iEAAiE;EACjE,kFAAkF;EAClF,6EAA6E;EAC7E,+DAA+D;EAC/D,gFAAgF;EAChF,0EAA0E;EAC1E,uDAAuD;AACzD;;;AAGA;;sEAEsE;;AAEtE;EACE,6BAA6B;EAC7B,2BAA2B;EAC3B,kCAAkC;EAClC,wBAAwB;EACxB,gCAAgC;EAChC,iBAAiB;EACjB,mCAAmC;EACnC,kCAAkC;EAClC,wBAAwB;EACxB,iBAAiB;EACjB,cAAc;AAChB;;AAEA;;;EAGE,8BAA8B;EAC9B,wBAAwB;AAC1B;;;AAGA;;sEAEsE;;AAEtE;EACE,8BAA8B;AAChC;;AAEA;EACE,gCAAgC;EAChC,8BAA8B;EAC9B,+BAA+B;EAC/B,8BAA8B;EAC9B,wBAAwB;EACxB,uBAAuB;AACzB;;AAEA;EACE,8BAA8B;EAC9B,8BAA8B;EAC9B,SAAS;EACT,6BAA6B;AAC/B;;;AAGA;;sEAEsE;;AAEtE;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,2BAA2B;EAC3B,oBAAoB;EACpB,8BAA8B;EAC9B,8BAA8B;EAC9B,6BAA6B;AAC/B;;;AAGA;;sEAEsE;;A