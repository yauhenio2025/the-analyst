 display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  animation: fadeIn 0.15s ease-out;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n.deeper-dive-modal {\n  background: #ffffff;\n  border-radius: 12px;\n  width: 90%;\n  max-width: 600px;\n  max-height: 85vh;\n  overflow-y: auto;\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\n  animation: slideIn 0.2s ease-out;\n}\n\n@keyframes slideIn {\n  from {\n    opacity: 0;\n    transform: translateY(-20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Header */\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px 24px;\n  border-bottom: 1px solid #e0ddd8;\n  position: sticky;\n  top: 0;\n  background: #ffffff;\n  z-index: 1;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n\n.modal-header h2 {\n  margin: 0;\n  font-size: 1.4rem;\n  color: #4a4a4a;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.header-icon {\n  font-size: 1.2rem;\n}\n\n.sin-type-badge {\n  padding: 4px 12px;\n  border-radius: 12px;\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: white;\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  color: #757575;\n  font-size: 1.8rem;\n  cursor: pointer;\n  padding: 0 8px;\n  line-height: 1;\n  transition: color 0.2s;\n}\n\n.close-btn:hover {\n  color: #4a4a4a;\n}\n\n/* Context */\n.modal-context {\n  padding: 16px 24px;\n  background: #f5f3f0;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.modal-context p {\n  margin: 0 0 8px 0;\n  color: #aaa;\n  font-size: 0.95rem;\n}\n\n.modal-context p:last-child {\n  margin-bottom: 0;\n}\n\n.context-stats {\n  color: #757575 !important;\n  font-size: 0.9rem !important;\n}\n\n/* Sections */\n.modal-section {\n  padding: 20px 24px;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.modal-section:last-of-type {\n  border-bottom: none;\n}\n\n.modal-section h3 {\n  margin: 0 0 12px 0;\n  font-size: 1rem;\n  color: #4a4a4a;\n  font-weight: 600;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.section-header h3 {\n  margin: 0;\n}\n\n.toggle-all-btn {\n  background: #e8e5e0;\n  border: 1px solid #444;\n  color: #aaa;\n  padding: 4px 12px;\n  border-radius: 4px;\n  font-size: 0.85rem;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.toggle-all-btn:hover:not(:disabled) {\n  background: #444;\n  color: #4a4a4a;\n}\n\n.toggle-all-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Text List */\n.text-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-height: 150px;\n  overflow-y: auto;\n  padding-right: 8px;\n}\n\n.text-list.disabled {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.text-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  background: #f5f3f0;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.text-item:hover {\n  background: #e8e5e0;\n}\n\n.text-item input[type=\"checkbox\"] {\n  width: 16px;\n  height: 16px;\n  cursor: pointer;\n  accent-color: #4a9eff;\n}\n\n.text-name {\n  flex: 1 1;\n  color: #4a4a4a;\n  font-size: 0.9rem;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.text-tokens {\n  color: #666;\n  font-size: 0.8rem;\n}\n\n.no-texts {\n  color: #757575;\n  font-style: italic;\n  text-align: center;\n  padding: 20px;\n}\n\n/* Mode Selection */\n.mode-options {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.mode-option {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 12px 16px;\n  background: #f5f3f0;\n  border: 2px solid transparent;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.mode-option:hover {\n  background: #e8e5e0;\n}\n\n.mode-option.selected {\n  border-color: #4a9eff;\n  background: rgba(74, 158, 255, 0.1);\n}\n\n.mode-option input[type=\"radio\"] {\n  margin-top: 2px;\n  width: 16px;\n  height: 16px;\n  cursor: pointer;\n  accent-color: #4a9eff;\n}\n\n.mode-content {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.mode-label {\n  color: #4a4a4a;\n  font-size: 0.95rem;\n  font-weight: 500;\n}\n\n.mode-description {\n  color: #757575;\n  font-size: 0.85rem;\n  line-height: 1.4;\n}\n\n/* Focus Guidance */\n.focus-input {\n  width: 100%;\n  padding: 12px;\n  background: #f5f3f0;\n  border: 1px solid #444;\n  border-radius: 8px;\n  color: #4a4a4a;\n  font-size: 0.95rem;\n  font-family: inherit;\n  resize: vertical;\n  min-height: 80px;\n}\n\n.focus-input:focus {\n  outline: none;\n  border-color: #4a9eff;\n}\n\n.focus-input::placeholder {\n  color: #666;\n}\n\n.guidance-hint {\n  margin: 8px 0 0 0;\n  color: #666;\n  font-size: 0.85rem;\n}\n\n/* Error Message */\n.error-message {\n  padding: 12px 24px;\n  background: rgba(239, 68, 68, 0.1);\n  border-top: 1px solid #ef4444;\n  color: #ef4444;\n  font-size: 0.9rem;\n}\n\n/* Actions */\n.modal-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  padding: 16px 24px;\n  background: #1a1a1a;\n  border-top: 1px solid #e0ddd8;\n  position: sticky;\n  bottom: 0;\n}\n\n.cancel-btn,\n.submit-btn {\n  padding: 10px 20px;\n  border-radius: 6px;\n  font-size: 0.95rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.cancel-btn {\n  background: #e8e5e0;\n  border: 1px solid #444;\n  color: #aaa;\n}\n\n.cancel-btn:hover:not(:disabled) {\n  background: #444;\n  color: #4a4a4a;\n}\n\n.submit-btn {\n  background: #4a9eff;\n  border: none;\n  color: white;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.submit-btn:hover:not(:disabled) {\n  background: #b5343a;\n}\n\n.submit-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Spinner */\n.spinner {\n  width: 16px;\n  height: 16px;\n  border: 2px solid rgba(255, 255, 255, 0.3);\n  border-top-color: white;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Scrollbar */\n.deeper-dive-modal::-webkit-scrollbar,\n.text-list::-webkit-scrollbar {\n  width: 8px;\n}\n\n.deeper-dive-modal::-webkit-scrollbar-track,\n.text-list::-webkit-scrollbar-track {\n  background: #ffffff;\n}\n\n.deeper-dive-modal::-webkit-scrollbar-thumb,\n.text-list::-webkit-scrollbar-thumb {\n  background: #444;\n  border-radius: 4px;\n}\n\n.deeper-dive-modal::-webkit-scrollbar-thumb:hover,\n.text-list::-webkit-scrollbar-thumb:hover {\n  background: #555;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/DeeperDiveModal.css\"],\"names\":[],\"mappings\":\"AAAA,4DAA4D;;AAE5D;EACE,eAAe;EACf,MAAM;EACN,OAAO;EACP,QAAQ;EACR,SAAS;EACT,8BAA8B;EAC9B,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,aAAa;EACb,gCAAgC;AAClC;;AAEA;EACE,OAAO,UAAU,EAAE;EACnB,KAAK,UAAU,EAAE;AACnB;;AAEA;EACE,mBAAmB;EACnB,mBAAmB;EACnB,UAAU;EACV,gBAAgB;EAChB,gBAAgB;EAChB,gBAAgB;EAChB,0CAA0C;EAC1C,gCAAgC;AAClC;;AAEA;EACE;IACE,UAAU;IACV,4BAA4B;EAC9B;EACA;IACE,UAAU;IACV,wBAAwB;EAC1B;AACF;;AAEA,WAAW;AACX;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,kBAAkB;EAClB,gCAAgC;EAChC,gBAAgB;EAChB,MAAM;EACN,mBAAmB;EACnB,UAAU;AACZ;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,SAAS;EACT,iBAAiB;EACjB,cAAc;EACd,aAAa;EACb,mBAAmB;EACnB,QAAQ;AACV;;AAEA;EACE,iBAAiB;AACnB;;AAEA;EACE,iBAAiB;EACjB,mBAAmB;EACnB,kBAAkB;EAClB,gBAAgB;EAChB,YAAY;AACd;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,iBAAiB;EACjB,eAAe;EACf,cAAc;EACd,cAAc;EACd,sBAAsB;AACxB;;AAEA;EACE,cAAc;AAChB;;AAEA,YAAY;AACZ;EACE,kBAAkB;EAClB,mBAAmB;EACnB,gCAAgC;AAClC;;AAEA;EACE,iBAAiB;EACjB,WAAW;EACX,kBAAkB;AACpB;;AAEA;EACE,gBAAgB;AAClB;;AAEA;EACE,yBAAyB;EACzB,4BAA4B;AAC9B;;AAEA,aAAa;AACb;EACE,kBAAkB;EAClB,gCAAgC;AAClC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAmB;AACrB;;AAEA;EACE,SAAS;AACX;;AAEA;EACE,mBAAmB;EACnB,sBAAsB;EACtB,WAAW;EACX,iB