575;\\n  cursor: pointer;\\n}\\n\\n.checkbox-label input[type=\\\"checkbox\\\"] {\\n  width: auto;\\n  cursor: pointer;\\n}\\n\\n/* =============================================================================\\n   LOADING STATE\\n   ============================================================================= */\\n\\n.panel-loading {\\n  text-align: center;\\n  padding: 60px;\\n  color: #94a3b8;\\n  font-size: 14px;\\n}\\n\\n/* =============================================================================\\n   PENDING REVISIONS ALERT\\n   ============================================================================= */\\n\\n.pending-revisions-alert {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 16px;\\n  padding: 16px 20px;\\n  background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);\\n  border: 1px solid rgba(99, 102, 241, 0.3);\\n  border-radius: 12px;\\n  margin-bottom: 20px;\\n}\\n\\n.pending-revisions-alert .alert-content {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n}\\n\\n.pending-revisions-alert .alert-icon {\\n  font-size: 24px;\\n  line-height: 1;\\n}\\n\\n.pending-revisions-alert .alert-text {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n}\\n\\n.pending-revisions-alert .alert-text strong {\\n  color: #4a4a4a;\\n  font-weight: 600;\\n}\\n\\n.pending-revisions-alert .pending-types {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 6px;\\n  margin-top: 4px;\\n}\\n\\n.pending-revisions-alert .pending-type-tag {\\n  font-size: 11px;\\n  padding: 3px 8px;\\n  background: var(--border-color, #e0ddd8);\\n  border-radius: 4px;\\n  color: var(--text-secondary, #757575);\\n}\\n\\n.pending-revisions-alert .revise-report-btn {\\n  padding: 10px 20px;\\n  background: var(--accent-primary, #b5343a);\\n  border: none;\\n  border-radius: 8px;\\n  color: white;\\n  font-size: 14px;\\n  font-weight: 600;\\n  cursor: pointer;\\n  white-space: nowrap;\\n  