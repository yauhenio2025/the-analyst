(/* binding */ STREAM_META),\n/* harmony export */   TEXT_TYPE_LABELS: () => (/* binding */ TEXT_TYPE_LABELS),\n/* harmony export */   VULNERABILITY_STREAMS: () => (/* binding */ VULNERABILITY_STREAMS),\n/* harmony export */   VULNERABILITY_STREAM_META: () => (/* binding */ VULNERABILITY_STREAM_META),\n/* harmony export */   isCherrypickFinding: () => (/* binding */ isCherrypickFinding),\n/* harmony export */   isConcessionFinding: () => (/* binding */ isConcessionFinding),\n/* harmony export */   isContradictionFinding: () => (/* binding */ isContradictionFinding),\n/* harmony export */   isCritiqueFinding: () => (/* binding */ isCritiqueFinding),\n/* harmony export */   isDeflectionFinding: () => (/* binding */ isDeflectionFinding),\n/* harmony export */   isExposedFlankFinding: () => (/* binding */ isExposedFlankFinding),\n/* harmony export */   isInconsistencyFinding: () => (/* binding */ isInconsistencyFinding),\n/* harmony export */   isLeapFinding: () => (/* binding */ isLeapFinding),\n/* harmony export */   isLogicGapFinding: () => (/* binding */ isLogicGapFinding),\n/* harmony export */   isNamedropFinding: () => (/* binding */ isNamedropFinding),\n/* harmony export */   isOverconcessionFinding: () => (/* binding */ isOverconcessionFinding),\n/* harmony export */   isOverreachFinding: () => (/* binding */ isOverreachFinding),\n/* harmony export */   isResponseStream: () => (/* binding */ isResponseStream),\n/* harmony export */   isRetreatFinding: () => (/* binding */ isRetreatFinding),\n/* harmony export */   isSilenceFinding: () => (/* binding */ isSilenceFinding),\n/* harmony export */   isStrawmanRiskFinding: () => (/* binding */ isStrawmanRiskFinding),\n/* harmony export */   isTuQuoqueFinding: () => (/* binding */ isTuQuoqueFinding),\n/* harmony export */   isUnansweredFinding: () => (/* binding */ isUnansweredFinding),\n/* harmony export */   isUndercitationFinding: () => (/* binding */ isUndercitationFinding),\n/* harmony export */   isVulnerabilityStream: () => (/* binding */ isVulnerabilityStream),\n/* harmony export */   isWeakAuthorityFinding: () => (/* binding */ isWeakAuthorityFinding)\n/* harmony export */ });\n/* provided dependency */ var __react_refresh_utils__ = __webpack_require__(/*! ./node_modules/@pmmmwh/react-refresh-webpack-plugin/lib/runtime/RefreshUtils.js */ \"./node_modules/@pmmmwh/react-refresh-webpack-plugin/lib/runtime/RefreshUtils.js\");\n__webpack_require__.$Refresh$.runtime = __webpack_require__(/*! ./node_modules/react-refresh/runtime.js */ \"./node_modules/react-refresh/runtime.js\");\n\n// Types for the Benanav Critique Analyzer\n\n// Standard critique finding (used by political_economy, hegelian, praxis)\n\n// Deflection finding (different structure - showing both sides)\n\n// Contradiction finding (Moving Goalposts - comparing Response to original essays)\n\n// Leap finding (Phantom Premises - incorrect inferences about Morozov's argument)\n\n// === 6 NEW FINDING TYPES ===\n\n// Silence finding (Unanswered Challenges - what Benanav ignores)\n\n// Concession finding (Silent Agreements - implicit agreements without acknowledgment)\n\n// Retreat finding (Strategic Withdrawals - \"clarifications\" that are retreats)\n\n// Cherrypick finding (Selective Quotation - quoting out of context)\n\n// Namedrop finding (Authority Gaps - empty appeals to theorists)\n\n// TuQuoque finding (You Too Fallacies - deflection by counter-accusation)\n\n// ============== VULNERABILITY ANALYSIS FINDING TYPES ==============\n// These analyze Morozov's counter-response for weaknesses Benanav could exploit\n\n// Base vulnerability finding structure\n\n// Strawman Risk - where Morozov might be accused of misrepresenting Benanav\n\n// Inconsistency - where Morozov contradicts himself\n\n// Logic Gap - where conclusions don't follow from premises\n\n// Unanswered - where Morozov ignores valid points Benanav made\n\n// Over-concession - where Morozov concedes too much\n\n// Overreach - where Morozov extends beyond defensible positions\n\n// Under-citation - where claims lack textual evidence\n\n// Weak Authority - where invoked theorists might not support claims\n\n// Exposed Flank - where critiques could be turned back on Morozov\n\n// Extended finding with stream info (for display)\n\n// Extended deflection finding with stream info\n\n// Extended contradiction finding with stream info\n\n// Extended leap finding with stream info\n\n// === 6 NEW EXTENDED TYPES ===\n\n// === VULNERABILITY ANALYSIS EXTENDED TYPES ===\n\n// Union type for any finding (now includes all 12 stream types + 9 vulnerability types = 21)\n\n// Comment on highlighted text - extended for new field types\n\n// === ASK AI TYPES ===\n\n// Selection and comments state (persisted to PostgreSQL backend)\n\n// === 6 NEW STREAM RESULT TYPES ===\n\n// === VULNERABILITY STREAM RESULT TYPES ===\n\n// Critique streams (original 3)\n\n// Response analysis streams (original 3 + 6 new = 9)\n\n// Vulnerability analysis streams (9 total) - analyze Morozov's counter-response for weaknesses\n\n// Genealogy-sourced stream types (added to Arsenal from genealogy capture)\n\n// All stream types (3 critique + 9 response + 9 vulnerability + 2 genealogy = 23)\n\n// Stream group types for UI navigation\n\n// Critique stream metadata\nconst CRITIQUE_STREAM_META = {\n  political_economy: {\n    id: 'political_economy',\n    title: 'Political Economy Critique',\n    shortTitle: 'Political Economy',\n    description: 'Identifies where Benanav operationalizes rather than critiques classical political economy categories',\n    color: '#8a5a5a',\n    icon: '',\n    theorists: ['Moishe Postone', 'Simon Clarke'],\n    group: 'critique'\n  },\n  hegelian: {\n    id: 'hegelian',\n    title: 'Hegelian Critique',\n    shortTitle: 'Hegelian',\n    description: 'Finds instances of relative vs. absolute ethical life categories, neo-Kantian structure',\n    color: '#5a7a8a',\n    icon: '',\n    theorists: ['Gillian Rose'],\n    group: 'critique'\n  },\n  praxis: {\n    id: 'praxis',\n    title: 'Praxis Critique',\n    shortTitle: 'Praxis',\n    description: 'Locates reification of communicative sphere and neglect of technical normativity',\n    color: '#5a7a6a',\n    icon: '',\n    theorists: ['György Márkus', 'Hans Joas'],\n    group: 'critique'\n  }\n};\n\n// Response analysis stream metadata (9 streams)\nconst RESPONSE_STREAM_META = {\n  deflection: {\n    id: 'deflection',\n    title: 'Deflection Analysis',\n    shortTitle: 'Deflections',\n    description: 'Instances where Benanav claims Morozov misunderstands him, but Morozov\\'s text actually addresses those points',\n    color: '#8a7968',\n    icon: '',\n    theorists: ['Textual Evidence'],\n    group: 'rhetoric'\n  },\n  contradiction: {\n    id: 'contradiction',\n    title: 'Self-Contradictions',\n    shortTitle: 'Moving Goalposts',\n    description: 'Where Benanav\\'s Response claims go beyond, contradict, or retroactively reframe his original NLR essays',\n    color: '#7a6a8a',\n    icon: '',\n    theorists: ['Textual Comparison'],\n    group: 'rhetoric'\n  },\n  leap: {\n    id: 'leap',\n    title: 'Logical Leaps',\n    shortTitle: 'Phantom Premises',\n    description: 'Where Benanav draws wrong conclusions from correct readings OR attributes phantom premises to Morozov',\n    color: '#946a6a',\n    icon: '',\n    theorists: ['Logical Analysis'],\n    group: 'rhetoric'\n  },\n  silence: {\n    id: 'silence',\n    title: 'Unanswered Challenges',\n    shortTitle: 'The Silence',\n    description: 'Morozov\\'s specific questions, challenges, or provocations that Benanav simply ignores',\n    color: '#6a7a7a',\n    icon: '',\n    theorists: ['Textual Evidence'],\n    group: 'rhetoric'\n  },\n  concession: {\n    id: 'concession',\n    title: 'Silent Concessions',\n    shortTitle: 'Quiet Agreements',\n    description: 'Where Benanav implicitly agrees with Morozov through changed framing but won\\'t acknowledge it',\n    color: '#6a7a5a',\n    icon: '',\n    theorists: ['Textual Comparison'],\n    group: 'rhetoric'\n  },\n  retreat: {\n    id: 'retreat',\n    title: 'Rhetorical Retreats',\n    shortTitle: 'Strategic Withdrawals',\n    description: '\"Clarifications\" that are actually substantive position changes - weakening, narrowing, or qualifying claims',\n    color: '#8a7a5a',\n    icon: '',\n    theorists: ['Textual Comparison'],\n    group: 'rhetoric'\n  },\n  cherrypick: {\n    id: 'cherrypick',\n    title: 'Selective Quotation',\n    shortTitle: 'Cherry Picks',\n    description: 'Where Benanav quotes Morozov out of context, truncates quotes, or selectively omits parts',\n    color: '#8a5a5a',\n    icon: '',\n    theorists: ['Textual Evidence'],\n    group: 'rhetoric'\n  },\n  namedrop: {\n    id: 'namedrop',\n    title: 'Authority Gaps',\n    shortTitle: 'Name-Drops',\n    description: 'Where Benanav invokes theorists (Neurath, Dewey, etc.) without showing how their work supports his claims',\n    color: '#6a5a4a',\n    icon: '',\n    theorists: ['Textual Evidence'],\n    group: 'rhetoric'\n  },\n  tuquoque: {\n    id: 'tuquoque',\n    title: 'Tu Quoque Fallacies',\n    shortTitle: 'You Too',\n    description: 'Where Benanav deflects criticism by claiming Morozov has the same problem - even if true, this doesn\\'t answer the critique',\n    color: '#5a7a7a',\n    icon: '',\n    theorists: ['Logical Analysis'],\n    group: 'rhetoric'\n  }\n};\n\n// Vulnerability analysis stream metadata (9 streams) - for analyzing Morozov's counter-response\nconst VULNERABILITY_STREAM_META = {\n  strawman_risk: {\n    id: 'strawman_risk',\n    title: 'Strawman Risk',\n    shortTitle: 'Strawman Risk',\n    description: 'Where Morozov might be accused of misrepresenting Benanav\\'s position',\n    color: '#ef4444',\n    icon: '',\n    theorists: ['Textual Analysis'],\n    group: 'vulnerability'\n  },\n  inconsistency: {\n    id: 'inconsistency',\n    title: 'Internal Inconsistency',\n    shortTitle: 'Inconsistencies',\n    description: 'Where Morozov contradicts himself or earlier positions',\n    color: '#f97316',\n    icon: '',\n    theorists: ['Textual Comparison'],\n    group: 'vulnerability'\n  },\n  logic_gap: {\n    id: 'logic_gap',\n    title: 'Logic Gaps',\n    shortTitle: 'Logic Gaps',\n    description: 'Where conclusions don\\'t follow from premises',\n    color: '#eab308',\n    icon: '',\n    theorists: ['Logical Analysis'],\n    group: 'vulnerability'\n  },\n  unanswered: {\n    id: 'unanswered',\n    title: 'Unanswered Points',\n    shortTitle: 'Unanswered',\n    description: 'Where Morozov ignores valid points Benanav made',\n    color: '#84cc16',\n    icon: '',\n    theorists: ['Textual Evidence'],\n    group: 'vulnerability'\n  },\n  overconcession: {\n    id: 'overconcession',\n    title: 'Over-Concessions',\n    shortTitle: 'Over-Concessions',\n    description: 'Where Morozov concedes too much to Benanav',\n    color: '#22c55e',\n    icon: '',\n    theorists: ['Argumentative Analysis'],\n    group: 'vulnerability'\n  },\n  overreach: {\n    id: 'overreach',\n    title: 'Argumentative Overreach',\n    shortTitle: 'Overreach',\n    description: 'Where Morozov extends beyond defensible positions',\n    color: '#14b8a6',\n    icon: '',\n    theorists: ['Argumentative Analysis'],\n    group: 'vulnerability'\n  },\n  undercitation: {\n    id: 'undercitation',\n    title: 'Under-Citation',\n    shortTitle: 'Under-Citation',\n    description: 'Where claims lack sufficient textual evidence',\n    color: '#06b6d4',\n    icon: '',\n    theorists: ['Textual Evidence'],\n    group: 'vulnerability'\n  },\n  weak_authority: {\n    id: 'weak_authority',\n    title: 'Weak Authority Appeals',\n    shortTitle: 'Weak Authority',\n    description: 'Where invoked theorists might not support the claims',\n    color: '#3b82f6',\n    icon: '',\n    theorists: ['Scholarly Analysis'],\n    group: 'vulnerability'\n  },\n  exposed_flank: {\n    id: 'exposed_flank',\n    title: 'Exposed Flanks',\n    shortTitle: 'Exposed Flanks',\n    description: 'Where critiques of Benanav could be turned back on Morozov',\n    color: '#8b5cf6',\n    icon: '',\n    theorists: ['Logical Analysis'],\n    group: 'vulnerability'\n  }\n};\n\n// Genealogy stream metadata (sourced from genealogy capture → Arsenal)\nconst GENEALOGY_STREAM_META = {\n  genealogy_ammunition: {\n    id: 'genealogy_ammunition',\n    title: 'Genealogy Ammunition',\n    shortTitle: 'Genealogy Ammo',\n    description: 'Offensive findings sourced from intellectual genealogy analysis',\n    color: '#d97706',\n    icon: 'crosshairs',\n    theorists: [],\n    group: 'rhetoric'\n  },\n  genealogy_revision: {\n    id: 'genealogy_revision',\n    title: 'Genealogy Revision',\n    shortTitle: 'Genealogy Rev',\n    description: 'Defensive revision items sourced from intellectual genealogy analysis',\n    color: '#0891b2',\n    icon: 'shield',\n    theorists: [],\n    group: 'vulnerability'\n  }\n};\n\n// Combined metadata for all streams\nconst STREAM_META = {\n  ...CRITIQUE_STREAM_META,\n  ...RESPONSE_STREAM_META,\n  ...VULNERABILITY_STREAM_META,\n  ...GENEALOGY_STREAM_META\n};\n\n// Arrays for easy iteration\nconst CRITIQUE_STREAMS = ['political_economy', 'hegelian', 'praxis'];\nconst RESPONSE_STREAMS = ['deflection', 'contradiction', 'leap', 'silence', 'concession', 'retreat', 'cherrypick', 'namedrop', 'tuquoque'];\nconst VULNERABILITY_STREAMS = ['strawman_risk', 'inconsistency', 'logic_gap', 'unanswered', 'overconcession', 'overreach', 'undercitation', 'weak_authority', 'exposed_flank'];\nconst GENEALOGY_STREAMS = ['genealogy_ammunition', 'genealogy_revision'];\nconst ALL_STREAMS = [...CRITIQUE_STREAMS, ...RESPONSE_STREAMS, ...VULNERABILITY_STREAMS, ...GENEALOGY_STREAMS];\n\n// Alias for new \"Rhetoric\" naming (same as RESPONSE_STREAMS)\nconst RHETORIC_STREAMS = RESPONSE_STREAMS;\n// Type guard to check if a finding is a deflection\nfunction isDeflectionFinding(finding) {\n  return finding.stream === 'deflection';\n}\n\n// Type guard to check if a finding is a contradiction\nfunction isContradictionFinding(finding) {\n  return finding.stream === 'contradiction';\n}\n\n// Type guard to check if a finding is a leap\nfunction isLeapFinding(finding) {\n  return finding.stream === 'leap';\n}\n\n// Type guard to check if a finding is a critique finding\nfunction isCritiqueFinding(finding) {\n  return CRITIQUE_STREAMS.includes(finding.stream);\n}\n\n// === 6 NEW TYPE GUARDS ===\n\nfunction isSilenceFinding(finding) {\n  return finding.stream === 'silence';\n}\nfunction isConcessionFinding(finding) {\n  return finding.stream === 'concession';\n}\nfunction isRetreatFinding(finding) {\n  return finding.stream === 'retreat';\n}\nfunction isCherrypickFinding(finding) {\n  return finding.stream === 'cherrypick';\n}\nfunction isNamedropFinding(finding) {\n  return finding.stream === 'namedrop';\n}\nfunction isTuQuoqueFinding(finding) {\n  return finding.stream === 'tuquoque';\n}\n\n// Check if stream is a response analysis stream\nfunction isResponseStream(stream) {\n  return RESPONSE_STREAMS.includes(stream);\n}\n\n// Check if stream is a vulnerability analysis stream\nfunction isVulnerabilityStream(stream) {\n  return VULNERABILITY_STREAMS.includes(stream);\n}\n\n// === VULNERABILITY TYPE GUARDS ===\n\nfunction isStrawmanRiskFinding(finding) {\n  return finding.stream === 'strawman_risk';\n}\nfunction isInconsistencyFinding(finding) {\n  return finding.stream === 'inconsistency';\n}\nfunction isLogicGapFinding(finding) {\n  return finding.stream === 'logic_gap';\n}\nfunction isUnansweredFinding(finding) {\n  return finding.stream === 'unanswered';\n}\nfunction isOverconcessionFinding(finding) {\n  return finding.stream === 'overconcession';\n}\nfunction isOverreachFinding(finding) {\n  return finding.stream === 'overreach';\n}\nfunction isUndercitationFinding(finding) {\n  return finding.stream === 'undercitation';\n}\nfunction isWeakAuthorityFinding(finding) {\n  return finding.stream === 'weak_authority';\n}\nfunction isExposedFlankFinding(finding) {\n  return finding.stream === 'exposed_flank';\n}\n\n// API Request/Response types for Ask AI feature\n\n// ============== Rhetoric Analysis Types ==============\n\n// ============== Vulnerability Analysis Types ==============\n\n// ============== Arsenal Types ==============\n\n// ============== Concept Analysis Types ==============\n\n// Progress info for multi-phase logical analysis\n\n// Inferential Role Analysis (Quine/Brandom/Sellars) - New Structure\n\n// Logical Structure Analysis\n\n// Chain Taxonomy Types (5 Classification Systems)\n\n// Taxonomy category for UI organization\n\n// ============== Assumption Analysis (Engine) Types ==============\n\n// Actual format from visualizer assumption_excavation engine\n\n// Generic analysis type for v2-backed engines (semantic_field, causal, metaphorical)\n\n// Synthesis type for v2 engines\n\n// Union type for any concept analysis result\n\n// Summary type for listing analyses\n\n// =============================================================================\n// Premise Scrutiny Types (Quick/Deep/Both Modes)\n// =============================================================================\n\n// Attacks that would cause chain reactions\n\n// Deep mode structural analysis types\n\n// =============================================================================\n// Ammunition Search Types (Explore Corpus feature)\n// =============================================================================\n\n// =============================================================================\n// LLM-Powered Ammunition Analysis Types (Phase 2 Explore Corpus)\n// =============================================================================\n\n// Phase 2 Enhancement: Sibling attack summary for context\n\n// Phase 2 Enhancement: What this attack takes for granted\n\n// =============================================================================\n// Outline Management Types\n// =============================================================================\n\n// API Request/Response Types\n\n// Job Types\n\n// Extended UserAnnotations to include outline\n\n// ====== LINES OF ATTACK FEATURE TYPES ======\n\n// ============= CORPUS ANALYSIS TYPES =============\n// Multi-stage pipeline for analyzing large author corpuses\n\n// Summary for listing corpus analyses (from GET /api/corpus/analyses)\n\n// ============= SUMMARY MEMO =============\n\n// ============= VERSIONED SUMMARY MEMOS =============\n\n// ============= WORK SELECTION PRESETS =============\n\n// ============= MULTI-ROUND CORPUS ANALYSIS =============\n\n// ============= RE-SYNTHESIS =============\n\n// ============= SAVED OUTLINE SUMMARIES =============\n\n// =============================================================================\n// BIG PICTURE ANALYSIS TYPES (Pre-conceptual, document-level inferential mapping)\n// =============================================================================\n\n// Core Thesis/Claim in the document\n\n// Major commitment package across the entire document\n\n// Document-level incompatibility\n\n// Cross-document tension (between NLR articles and Response)\n\n// Internal tension within the corpus\n\n// Practical stakes at the document level\n\n// The main Big Picture Inferential Analysis result\n\n// Summary for listing Big Picture analyses\n\n// =============================================================================\n// CROSS-CORPUS CONCEPT ANALYSIS TYPES\n// Analyzes how a concept appears across multiple corpora/thinkers\n// =============================================================================\n\n// Citation in cross-concept analysis\n\n// Inferential link between concepts\n\n// Per-text extraction types\n\n// Complete extraction from a single text (cached)\n\n// Cross-text synthesis types\n\n// Work metadata for attribution lookup\n\n// Full cross-corpus synthesis\n\n// Job tracking\n\n// API request/response types\n\n// Extraction cache entry\n\n// List response for cache\n\n// Summary for listing syntheses\n\n// Corpus/Work selection types for the UI\n\n// =============================================================================\n// ANXIETY OF INFLUENCE TYPES\n// Intellectual debt analysis for how Benanav uses thinkers/traditions\n// =============================================================================\n\n// Expanded sin taxonomy (10 types based on Bloom's Anxiety of Influence)\n\n// Using source's authority for unsupported positions\n\n// Bloom mapping for UI reference\n\n// Sin type metadata for UI display\n\n// Complete sin type metadata\nconst SIN_TYPE_META = {\n  misreading: {\n    id: 'misreading',\n    label: 'Misreading',\n    description: 'Getting the source wrong substantively',\n    bloomTerm: 'clinamen',\n    color: '#8a5a5a',\n    detectionCriteria: 'Source says X, target represents it as Y (where X ≠ Y)'\n  },\n  unacknowledged_debt: {\n    id: 'unacknowledged_debt',\n    label: 'Unacknowledged Debt',\n    description: 'Using concepts/frameworks without crediting their scholarly origin',\n    color: '#8a7968',\n    detectionCriteria: \"Target's framing depends on source's prior scholarly labor\"\n  },\n  misappropriation: {\n    id: 'misappropriation',\n    label: 'Misappropriation',\n    description: \"Taking concepts and deploying them against source's intentions\",\n    color: '#7a6b8a',\n    detectionCriteria: 'Source explicitly argues against the use target makes'\n  },\n  decontextualization: {\n    id: 'decontextualization',\n    label: 'Decontextualization',\n    description: 'Stripping ideas from their constitutive context',\n    bloomTerm: 'daemonization',\n    color: '#5a7a8a',\n    detectionCriteria: \"Source's position requires philosophical/historical context target omits\"\n  },\n  selective_citation: {\n    id: 'selective_citation',\n    label: 'Selective Citation',\n    description: 'Citing only what supports, omitting what complicates',\n    color: '#9a6060',\n    detectionCriteria: \"Source makes arguments target doesn't address that undermine target's use\"\n  },\n  flattening: {\n    id: 'flattening',\n    label: 'Flattening',\n    description: 'Reducing multidimensional position to single dimension',\n    bloomTerm: 'kenosis',\n    color: '#5a7a60',\n    detectionCriteria: 'Source has complexity/tensions target erases'\n  },\n  ventriloquism: {\n    id: 'ventriloquism',\n    label: 'Ventriloquism',\n    description: \"Putting words/positions in source's mouth they didn't hold\",\n    bloomTerm: 'tessera',\n    color: '#7a6b8a',\n    detectionCriteria: 'Target claims source believes X; source never said X'\n  },\n  strategic_silence: {\n    id: 'strategic_silence',\n    label: 'Strategic Silence',\n    description: 'Not citing source when engagement is intellectually required',\n    bloomTerm: 'askesis',\n    color: '#6a7a80',\n    detectionCriteria: 'Source is the obvious interlocutor but goes unmentioned'\n  },\n  premature_synthesis: {\n    id: 'premature_synthesis',\n    label: 'Premature Synthesis',\n    description: \"Treating unresolved debates as settled in target's favor\",\n    color: '#8a7a50',\n    detectionCriteria: \"Source presents multiple views; target picks one as 'the' view\"\n  },\n  legitimation_borrowing: {\n    id: 'legitimation_borrowing',\n    label: 'Legitimation Borrowing',\n    description: \"Using source's authority to validate positions source wouldn't endorse\",\n    bloomTerm: 'apophrades',\n    color: '#6a5a4a',\n    detectionCriteria: 'Citation is for legitimacy, not intellectual engagement'\n  }\n};\n\n// Reference to a thinker in Benanav's texts\n\n// Thinker identified in Pass 1\n\n// Pass 1 result\n\n// Working hypothesis (Pass 2)\n\n// Literature type for reference texts\n\n// Secondary literature link\n\n// Reference text uploaded for analysis\n\n// Finding from Pass 4 analysis\n\n// Final report (Pass 5) - Updated for 10-type sin taxonomy\n\n// =============================================================================\n// THEMATIC-FIRST ARCHITECTURE TYPES\n// Theme-based analysis of intellectual influence (replaces atomized quote comparison)\n// =============================================================================\n\n// Theme extracted from cited author's corpus (Pass 2)\n\n// How Benanav engages with a theme (Pass 3)\n\n// Finding within thematic context (Pass 4)\n\n// Thematic Synthesis Result (Pass 2 output)\n\n// Thematic Mapping Result (Pass 3 output)\n\n// Sin Identification Result (Pass 4 output)\n\n// Thematic Report (Pass 5 output)\n\n// API Response types for thematic analysis\n\n// Navigation modes for dual-axis UI\n\n// Thematic analysis job tracking\n\n// Thinker summary for grid view\n\n// API Response types\n\n// API Request types\n\n// Cache status for Pass 3\n\n// ============= MANUAL THINKER TYPES =============\n\n// Request to create a manual thinker\n\n// Request to update a thinker\n\n// Request to add secondary links to a text\n\n// Response for secondary links addition\n\n// Secondary literature entry for a thinker\n\n// Response for secondary literature list\n\n// ============= DEEPER DIVE TYPES =============\n// Focused re-analysis of a single sin type to find ALL instances\n\n// Evidence quote for multiple quotes per finding\n\n// =============================================================================\n// REPORT VERSIONING SYSTEM\n// Version tracking, diffs, and attribution for influence reports\n// =============================================================================\n\n// LLM-powered diff analysis types\n\n// ==========================================\n// Multi-Project Support Types\n// ==========================================\n\n// ==========================================\n// PARADIGM ANALYSIS TYPES\n// ==========================================\n\n// ============= READING RESULT TYPES =============\n\n// ============= META-ANALYSIS TYPES ========