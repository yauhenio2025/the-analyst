;AAEA;EACE,aAAa;EACb,YAAY;EACZ,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,sBAAsB;AACxB;;AAEA;EACE,aAAa;AACf;;AAEA,sDAAsD;;AAEtD;EACE,iCAAiC;AACnC;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,wBAAwB;EACxB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,8BAA8B;EAC9B,0CAA0C;EAC1C,qBAAqB;EACrB,SAAS;EACT,4BAA4B;EAC5B,kBAAkB;AACpB;;AAEA;EACE,8BAA8B;EAC9B,gBAAgB;EAChB,aAAa;EACb,0CAA0C;AAC5C;;AAEA;EACE,mCAAmC;AACrC;;AAEA,wDAAwD;;AAExD;EACE,iCAAiC;AACnC;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,wBAAwB;EACxB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,iDAAiD;AACnD;;AAEA;EACE,8BAA8B;EAC9B,gBAAgB;EAChB,aAAa;EACb,0CAA0C;AAC5C;;AAEA;EACE,mCAAmC;AACrC;;AAEA,sDAAsD;;AAEtD;EACE,iCAAiC;AACnC;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,wBAAwB;EACxB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,8BAA8B;EAC9B,gBAAgB;EAChB,aAAa;EACb,0CAA0C;EAC1C,mBAAmB;AACrB;;AAEA;EACE,mCAAmC;AACrC;;AAEA,8DAA8D;;AAE9D;EACE,iCAAiC;AACnC;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,wBAAwB;EACxB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,8BAA8B;EAC9B,gBAAgB;EAChB,aAAa;EACb,0CAA0C;EAC1C,mBAAmB;AACrB;;AAEA;EACE,mCAAmC;AACrC;;AAEA,uDAAuD;;AAEvD;EACE,iCAAiC;AACnC;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,wBAAwB;EACxB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,8BAA8B;EAC9B,0CAA0C;EAC1C,qBAAqB;EACrB,SAAS;EACT,4BAA4B;AAC9B;;AAEA;EACE,8BAA8B;EAC9B,gBAAgB;EAChB,aAAa;EACb,0CAA0C;AAC5C;;AAEA;EACE,mCAAmC;AACrC;;AAEA,sDAAsD;;AAEtD;EACE,iCAAiC;AACnC;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,wBAAwB;EACxB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,iDAAiD;AACnD;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,gBAAgB;EAChB,wBAAwB;EACxB,0BAA0B;AAC5B;;AAEA;EACE,8BAA8B;EAC9B,gBAAgB;EAChB,aAAa;EACb,0CAA0C;EAC1C,mBAAmB;AACrB;;AAEA;EACE,mCAAmC;AACrC;;AAEA,2CAA2C;;AAE3C;EACE,aAAa;AACf;;AAEA;EACE,gBAAgB;EAChB,UAAU;EACV,gBAAgB;EAChB,aAAa;EACb,sBAAsB;AACxB;;AAEA;EACE,SAAO;EACP,gBAAgB;EAChB,eAAe;AACjB;;AAEA;EACE,qBAAqB;AACvB;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,wBAAwB;EACxB,qBAAqB;EACrB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,eAAe;EACf,yBAAyB;EACzB,mCAAmC;EACnC,aAAa;EACb,+BAA+B;EAC/B,yCAAyC;AAC3C;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,0BAA0B;EAC1B,8BAA8B;EAC9B,aAAa;EACb,+BAA+B;EAC/B,qBAAqB;AACvB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,8BAA8B;EAC9B,+BAA+B;EAC/B,aAAa;EACb,yCAAyC;AAC3C;;AAEA;EACE,iBAAiB;EACjB,gBAAgB;EAChB,yBAAyB;EACzB,qBAAqB;AACvB;;AAEA;EACE,kBAAkB;EAClB,4BAA4B;EAC5B,SAAS;EACT,qBAAqB;EACrB,0CAA0C;EAC1C,iBAAiB;EACjB,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,wBAAwB;EACxB,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,iBAAiB;EACjB,yCAAyC;EACzC,iBAAiB;EACjB,wBAAwB;AAC1B;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,WAAW;AACb;;AAEA,4CAA4C;AAC5C;EACE,eAAe;EACf,yBAAyB;EACzB,6BAA6B;AAC/B;;AAEA;EACE,oCAAoC;EACpC,gCAAgC;EAChC,+BAA+B;AACjC;;AAEA;EACE,iBAAiB;EACjB,wBAAwB;EACxB,kBAAkB;EAClB,mBAAmB;EACnB,UAAU;EACV,6BAA6B;AAC/B;;AAEA;EACE,UAAU;AACZ\",\"sourcesContent\":[\"/* The Critic - Editorial Design */\\n\\n:root {\\n  /* Typography */\\n  --font-headline: 'Playfair Display', Georgia, serif;\\n  --font-body: 'Source Serif Pro', Georgia, serif;\\n  --font-ui: 'IBM Plex Sans', -apple-system, sans-serif;\\n  --font-mono: 'IBM Plex Mono', 'Fira Code', monospace;\\n\\n  /* Type Scale */\\n  --text-xs: 0.75rem;\\n  --text-sm: 0.875rem;\\n  --text-base: 1rem;\\n  --text-lg: 1.125rem;\\n  --text-xl: 1.25rem;\\n  --text-2xl: 1.5rem;\\n  --text-3xl: 1.875rem;\\n\\n  /* Light Theme - Paper & Ink */\\n  --bg-paper: #faf8f5;\\n  --bg-surface: #ffffff;\\n  --bg-elevated: #f5f3f0;\\n  --bg-dark: var(--bg-paper);\\n  --bg-card: var(--bg-surface);\\n\\n  /* Text Colors */\\n  --text-primary: #1a1a1a;\\n  --text-secondary: #4a4a4a;\\n  --text-muted: #757575;\\n  --text-caption: #9a9a9a;\\n\\n  /* Borders */\\n  --border-color: #e0ddd8;\\n  --border-subtle: #eceae6;\\n\\n  /* Accent Colors */\\n  --accent-primary: #b5343a;\\n  --accent-hover: #9a2c31;\\n  --accent-subtle: rgba(181, 52, 58, 0.08);\\n  --accent-red: #b5343a;\\n  --accent-blue: #4a6fa5;\\n  --accent-green: #3d7a6b;\\n  --accent-gold: #b8860b;\\n\\n  /* Stream Colors - Muted editorial palette */\\n  --stream-political-economy: #c75146;\\n  --stream-hegelian: #5a7b9a;\\n  --stream-praxis: #4a8a7f;\\n  --stream-deflection: #b87333;\\n  --stream-contradiction: #7a5a8f;\\n  --stream-leap: #c45a6a;\\n  --stream-silence: #6a7a8a;\\n  --stream-concession: #6a8a5a;\\n  --stream-retreat: #c08040;\\n  --stream-cherrypick: #a04040;\\n  --stream-namedrop: #6a5a4a;\\n  --stream-tuquoque: #4a8a9a;\\n\\n  /* Shadows - Subtle */\\n  --shadow-soft: 0 1px 3px rgba(0, 0, 0, 0.04);\\n  --shadow-glow: 0 2px 8px rgba(0, 0, 0, 0.06);\\n  --shadow-lg: 0 4px 16px rgba(0, 0, 0, 0.08);\\n\\n  /* Radii - More subtle */\\n  --radius-sm: 4px;\\n  --radius-md: 6px;\\n  --radius-lg: 8px;\\n\\n  /* Transitions */\\n  --transition-fast: 0.15s ease;\\n  --transition-med: 0.25s ease;\\n}\\n\\n* {\\n  box-sizing: border-box;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\nbody {\\n  font-family: var(--font-body);\\n  background: var(--bg-paper);\\n  color: var(--text-primary);\\n  line-height: 1.7;\\n  min-height: 100vh;\\n  -webkit-font-smoothing: antialiased;\\n  -moz-osx-font-smoothing: grayscale;\\n}\\n\\n.app {\\n  min-height: 100vh;\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n/* Loading & Error States */\\n.loading-container,\\n.error-container {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  justify-content: center;\\n  min-height: 100vh;\\n  gap: 1rem;\\n}\\n\\n.loading-spinner {\\n  width: 48px;\\n  height: 48px;\\n  border: 3px solid var(--border-color);\\n  border-top-color: var(--accent-blue);\\n  border-radius: 50%;\\n  animation: spin 1s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to { transform: rotate(360deg); }\\n}\\n\\n/* Header */\\n.header {\\n  background: var(--bg-surface);\\n  border-bottom: 1px solid var(--border-color);\\n  padding: 1.25rem 2rem;\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n}\\n\\n.header-content {\\n  text-align: left;\\n}\\n\\n.header-content h1 {\\n  font-family: var(--font-headline);\\n  font-size: var(--text-2xl);\\n  font-weight: 700;\\n  letter-spacing: -0.01em;\\n  margin-bottom: 0.25rem;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  color: var(--text-primary);\\n}\\n\\n.header-icon {\\n  font-size: 1.75rem;\\n  display: none; /* Hide emoji icons */\\n}\\n\\n.header-subtitle {\\n  font-family: var(--font-ui);\\n  color: var(--text-muted);\\n  font-size: var(--text-sm);\\n  font-weight: 400;\\n}\\n\\n/* Concepts Button */\\n.concepts-button {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 12px 20px;\\n  background: linear-gradient(135deg, #9b59b6, #8e44ad);\\n  border: none;\\n  border-radius: 8px;\\n  color: white;\\n  font-size: 1rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  box-shadow: 0 2px 8px rgba(155, 89, 182, 0.3);\\n}\\n\\n.concepts-button:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(155, 89, 182, 0.4);\\n}\\n\\n.concepts-button-icon {\\n  font-size: 1.2rem;\\n}\\n\\n/* Lines of Attack Button */\\n.lines-button {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 12px 20px;\\n  background: linear-gradient(135deg, #20b2aa, #b5343a);\\n  border: none;\\n  border-radius: 8px;\\n  color: white;\\n  font-size: 1rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  box-shadow: 0 2px 8px rgba(32, 178, 170, 0.3);\\n}\\n\\n.lines-button:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(32, 178, 170, 0.4);\\n}\\n\\n.lines-button-icon {\\n  font-size: 1.2rem;\\n}\\n\\n/* Outline Editor Button */\\n.outline-editor-button {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 12px 20px;\\n  background: linear-gradient(135deg, #b5343a, #9a2c31);\\n  border: none;\\n  border-radius: 8px;\\n  color: white;\\n  font-size: 1rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  box-shadow: 0 2px 8px rgba(181, 52, 58, 0.3);\\n}\\n\\n.outline-editor-button:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(181, 52, 58, 0.4);\\n}\\n\\n.outline-editor-button-icon {\\n  font-size: 1.2rem;\\n}\\n\\n/* Stats Bar */\\n.stats-bar {\\n  display: flex;\\n  justify-content: center;\\n  gap: 1rem;\\n  padding: 1.5rem 2rem;\\n  background: var(--bg-card);\\n  border-bottom: 1px solid var(--border-color);\\n  flex-wrap: wrap;\\n}\\n\\n.stat-item {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  padding: 1rem 1.5rem;\\n  background: var(--bg-elevated);\\n  border-radius: var(--radius-md);\\n  border: 1px solid var(--border-color);\\n  min-width: 120px;\\n  cursor: pointer;\\n  transition: all var(--transition-med);\\n}\\n\\n.stat-item:hover {\\n  transform: translateY(-2px);\\n  border-color: var(--stream-color, var(--accent-blue));\\n  box-shadow: 0 4px 20px rgba(69, 123, 157, 0.2);\\n}\\n\\n.stat-item.active {\\n  border-color: var(--stream-color, var(--accent-blue));\\n  background: rgba(69, 123, 157, 0.1);\\n  box-shadow: 0 0 20px rgba(69, 123, 157, 0.15);\\n}\\n\\n.stat-item.total {\\n  background: linear-gradient(135deg, var(--accent-blue), #b5343a);\\n  border-color: transparent;\\n}\\n\\n.stat-item.total:hover {\\n  transform: translateY(-2px);\\n  box-shadow: var(--shadow-glow);\\n}\\n\\n.stat-icon {\\n  font-size: 1.5rem;\\n  margin-bottom: 0.25rem;\\n}\\n\\n.stat-number {\\n  font-size: 1.75rem;\\n  font-weight: 700;\\n  color: var(--text-primary);\\n}\\n\\n.stat-label {\\n  font-size: 0.75rem;\\n  color: var(--text-secondary);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n/* Main Content */\\n.main-content {\\n  display: flex;\\n  flex: 1;\\n  gap: 0;\\n}\\n\\n/* Sidebar */\\n.sidebar {\\n  width: 260px;\\n  background: var(--bg-surface);\\n  border-right: 1px solid var(--border-color);\\n  padding: 1.25rem;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 1.25rem;\\n}\\n\\n.filter-section h3 {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  text-transform: uppercase;\\n  letter-spacing: 0.08em;\\n  color: var(--text-muted);\\n  margin-bottom: 0.75rem;\\n  font-weight: 600;\\n}\\n\\n.filter-group {\\n  margin-bottom: 0.875rem;\\n}\\n\\n.filter-group label {\\n  display: block;\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  margin-bottom: 0.375rem;\\n}\\n\\n.filter-group select,\\n.filter-group input {\\n  width: 100%;\\n  padding: 0.625rem 0.75rem;\\n  background: var(--bg-surface);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  color: var(--text-primary);\\n  font-family: var(--font-ui);\\n  font-size: var(--text-sm);\\n  transition: border-color var(--transition-fast);\\n}\\n\\n.filter-group select:hover,\\n.filter-group input:hover {\\n  border-color: var(--text-muted);\\n}\\n\\n.filter-group select:focus,\\n.filter-group input:focus {\\n  outline: none;\\n  border-color: var(--accent-primary);\\n  box-shadow: none;\\n}\\n\\n/* Stream Info */\\n.stream-info {\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--stream-color, var(--border-color));\\n  border-radius: var(--radius-md);\\n  padding: 1.25rem;\\n  border-left: 4px solid var(--stream-color);\\n}\\n\\n.stream-info h4 {\\n  font-size: 1rem;\\n  margin-bottom: 0.75rem;\\n  color: var(--stream-color);\\n}\\n\\n.stream-info p {\\n  font-size: 0.9rem;\\n  color: var(--text-secondary);\\n  margin-bottom: 1rem;\\n}\\n\\n.theorists {\\n  font-size: 0.85rem;\\n}\\n\\n.theorists strong {\\n  color: var(--text-secondary);\\n  display: block;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.theorists ul {\\n  list-style: none;\\n  padding-left: 0;\\n}\\n\\n.theorists li {\\n  color: var(--text-primary);\\n  padding: 0.25rem 0;\\n}\\n\\n.theorists li::before {\\n  content: '→ ';\\n  color: var(--stream-color);\\n}\\n\\n/* Findings Container */\\n.findings-container {\\n  flex: 1;\\n  padding: 2rem 2.5rem;\\n  overflow-y: auto;\\n  background: var(--bg-paper);\\n}\\n\\n.no-findings {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  justify-content: center;\\n  height: 400px;\\n  color: var(--text-muted);\\n  text-align: center;\\n}\\n\\n.no-findings code {\\n  margin-top: 1rem;\\n  padding: 0.75rem 1.5rem;\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  font-family: var(--font-mono);\\n  color: var(--text-secondary);\\n}\\n\\n.no-findings-icon {\\n  font-size: 2rem;\\n  margin-bottom: 1rem;\\n  opacity: 0.4;\\n  display: none; /* Hide emoji icons */\\n}\\n\\n.no-findings h3 {\\n  margin: 0 0 0.5rem 0;\\n  color: var(--text-primary);\\n  font-family: var(--font-headline);\\n  font-size: var(--text-xl);\\n  font-weight: 700;\\n}\\n\\n.no-findings p {\\n  max-width: 400px;\\n  line-height: 1.6;\\n  margin-bottom: 1.5rem;\\n  font-family: var(--font-body);\\n}\\n\\n.btn-generate-findings {\\n  padding: 0.875rem 2rem;\\n  background: linear-gradient(135deg, var(--accent-blue) 0%, #5b8def 100%);\\n  color: white;\\n  border: none;\\n  border-radius: var(--radius-md);\\n  font-size: 1rem;\\n  font-weight: 600;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);\\n}\\n\\n.btn-generate-findings:hover:not(:disabled) {\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 16px rgba(59, 130, 246, 0.4);\\n}\\n\\n.btn-generate-findings:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.generate-error {\\n  margin-top: 1rem;\\n  color: var(--accent-red);\\n  font-size: 0.875rem;\\n}\\n\\n/* Findings List */\\n.findings-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5rem;\\n  max-width: 800px;\\n  margin: 0 auto;\\n  padding: 0 1rem;\\n}\\n\\n/* Finding Card - Editorial Style */\\n.finding-card {\\n  background: var(--bg-surface);\\n  border: 1px solid var(--border-subtle);\\n  border-radius: var(--radius-sm);\\n  padding: 2rem 2rem;\\n  cursor: pointer;\\n  transition: background 0.15s ease;\\n  position: relative;\\n}\\n\\n.finding-card:hover {\\n  background: var(--bg-elevated);\\n}\\n\\n.finding-card.selected {\\n  background: var(--bg-elevated);\\n}\\n\\n/* Stream indicator line */\\n.finding-card::before {\\n  content: '';\\n  display: block;\\n  width: 2.5rem;\\n  height: 2px;\\n  background: var(--stream-color, var(--border-color));\\n  margin-bottom: 1.25rem;\\n}\\n\\n.finding-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: baseline;\\n  margin-bottom: 1rem;\\n  padding-bottom: 0.75rem;\\n  border-bottom: 1px solid var(--border-subtle);\\n}\\n\\n.finding-stream {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.25rem;\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--stream-color);\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.08em;\\n}\\n\\n.finding-severity {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  padding: 0.25rem 0.5rem;\\n  border-radius: var(--radius-sm);\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n  background: var(--bg-elevated);\\n  color: var(--text-muted);\\n  border: 1px solid var(--border-color);\\n}\\n\\n.severity-high {\\n  color: var(--accent-primary);\\n  border-color: var(--accent-primary);\\n  background: rgba(181, 52, 58, 0.05);\\n}\\n\\n.severity-medium {\\n  color: var(--accent-gold);\\n  border-color: var(--accent-gold);\\n  background: rgba(184, 134, 11, 0.05);\\n}\\n\\n.severity-low {\\n  color: var(--accent-green);\\n  border-color: var(--accent-green);\\n  background: rgba(61, 122, 107, 0.05);\\n}\\n\\n.finding-category {\\n  font-family: var(--font-headline);\\n  font-size: 1.15rem;\\n  font-weight: 700;\\n  color: var(--text-primary);\\n  margin-bottom: 1.25rem;\\n  padding-bottom: 0;\\n  border-bottom: none;\\n}\\n\\n.finding-quote {\\n  font-family: var(--font-body);\\n  font-style: italic;\\n  color: var(--text-primary);\\n  padding: 1rem 1.5rem;\\n  background: var(--bg-elevated);\\n  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\\n  border-left: 3px solid var(--stream-color);\\n  margin: 0.5rem 0 1.5rem 0;\\n  font-size: var(--text-base);\\n  line-height: 1.8;\\n}\\n\\n.finding-quote cite {\\n  display: block;\\n  margin-top: 0.75rem;\\n  font-style: normal;\\n  font-family: var(--font-ui);\\n  font-size: var(--text-sm);\\n  color: var(--text-caption);\\n}\\n\\n/* Finding Details (expandable) */\\n.finding-details {\\n  max-height: 0;\\n  overflow: hidden;\\n  transition: max-height 0.3s ease, opacity 0.3s ease;\\n  opacity: 0;\\n}\\n\\n.finding-card.expanded .finding-details {\\n  max-height: 2000px;\\n  opacity: 1;\\n  padding-top: 1.25rem;\\n  border-top: 1px solid var(--border-subtle);\\n  margin-top: 1.25rem;\\n}\\n\\n.finding-analysis,\\n.finding-reference {\\n  margin-bottom: 1.5rem;\\n}\\n\\n.finding-analysis h5,\\n.finding-reference h5 {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  text-transform: uppercase;\\n  letter-spacing: 0.08em;\\n  color: var(--text-muted);\\n  margin-bottom: 0.5rem;\\n  font-weight: 600;\\n}\\n\\n.finding-analysis p,\\n.finding-reference p {\\n  font-family: var(--font-body);\\n  color: var(--text-secondary);\\n  font-size: var(--text-base);\\n  line-height: 1.8;\\n}\\n\\n.finding-reference p {\\n  color: var(--stream-color);\\n  font-weight: 500;\\n}\\n\\n/* Recommendation - actionable advice */\\n.finding-recommendation {\\n  margin-top: 1.25rem;\\n  padding: 1.25rem;\\n  background: var(--bg-elevated);\\n  border-left: 2px solid var(--accent-primary);\\n  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\\n}\\n\\n.finding-recommendation h5 {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  text-transform: uppercase;\\n  letter-spacing: 0.08em;\\n  color: var(--accent-primary);\\n  margin-bottom: 0.5rem;\\n  font-weight: 600;\\n}\\n\\n.finding-recommendation p {\\n  font-family: var(--font-body);\\n  color: var(--text-secondary);\\n  font-size: var(--text-base);\\n  line-height: 1.8;\\n  margin: 0;\\n}\\n\\n.finding-expand-hint {\\n  font-size: 0.75rem;\\n  color: var(--text-muted);\\n  text-align: center;\\n  margin-top: 1.25rem;\\n  padding-top: 0.75rem;\\n  border-top: 1px solid var(--border-subtle);\\n  transition: color var(--transition-fast);\\n}\\n\\n.finding-card:hover .finding-expand-hint {\\n  color: var(--text-secondary);\\n}\\n\\n/* Footer */\\n.footer {\\n  background: var(--bg-card);\\n  border-top: 1px solid var(--border-color);\\n  padding: 1rem 2rem;\\n  text-align: center;\\n}\\n\\n.footer p {\\n  color: var(--text-muted);\\n  font-size: 0.85rem;\\n}\\n\\n/* Responsive */\\n@media (max-width: 900px) {\\n  .main-content {\\n    flex-direction: column;\\n  }\\n\\n  .sidebar {\\n    width: 100%;\\n    border-right: none;\\n    border-bottom: 1px solid var(--border-color);\\n  }\\n\\n  .stats-bar {\\n    gap: 0.5rem;\\n  }\\n\\n  .stat-item {\\n    min-width: 100px;\\n    padding: 0.75rem 1rem;\\n  }\\n\\n  .header-content h1 {\\n    font-size: 1.5rem;\\n  }\\n}\\n\\n/* Custom Scrollbar */\\n::-webkit-scrollbar {\\n  width: 8px;\\n}\\n\\n::-webkit-scrollbar-track {\\n  background: var(--bg-paper);\\n}\\n\\n::-webkit-scrollbar-thumb {\\n  background: var(--border-color);\\n  border-radius: 4px;\\n}\\n\\n::-webkit-scrollbar-thumb:hover {\\n  background: var(--text-caption);\\n}\\n\\n/* Animations */\\n@keyframes fadeIn {\\n  from { opacity: 0; transform: translateY(10px); }\\n  to { opacity: 1; transform: translateY(0); }\\n}\\n\\n.finding-card {\\n  animation: fadeIn 0.3s ease forwards;\\n}\\n\\n.findings-list .finding-card:nth-child(1) { animation-delay: 0.05s; }\\n.findings-list .finding-card:nth-child(2) { animation-delay: 0.1s; }\\n.findings-list .finding-card:nth-child(3) { animation-delay: 0.15s; }\\n.findings-list .finding-card:nth-child(4) { animation-delay: 0.2s; }\\n.findings-list .finding-card:nth-child(5) { animation-delay: 0.25s; }\\n\\n/* ========== EXPORT VIEW STYLES ========== */\\n\\n.export-view-section {\\n  background: linear-gradient(135deg, rgba(69, 123, 157, 0.1), rgba(42, 157, 143, 0.1));\\n  border: 1px solid var(--accent-blue);\\n  border-radius: var(--radius-md);\\n  padding: 1rem;\\n  margin-bottom: 1rem;\\n}\\n\\n.export-view-section h3 {\\n  font-size: 0.85rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.1em;\\n  color: var(--accent-blue);\\n  margin-bottom: 0.5rem;\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n}\\n\\n.export-view-info {\\n  font-size: 0.8rem;\\n  color: var(--text-secondary);\\n  margin-bottom: 0.75rem;\\n}\\n\\n.export-view-buttons {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.5rem;\\n}\\n\\n.btn-export-md,\\n.btn-export-json {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 0.5rem;\\n  padding: 0.6rem 1rem;\\n  border-radius: var(--radius-sm);\\n  font-size: 0.85rem;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all var(--transition-fast);\\n  border: 1px solid;\\n}\\n\\n.btn-export-md {\\n  background: linear-gradient(135deg, var(--accent-blue), #b5343a);\\n  border-color: var(--accent-blue);\\n  color: white;\\n}\\n\\n.btn-export-md:hover {\\n  background: linear-gradient(135deg, #5a9ec9, var(--accent-blue));\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(69, 123, 157, 0.3);\\n}\\n\\n.btn-export-json {\\n  background: linear-gradient(135deg, var(--accent-green), #228b76);\\n  border-color: var(--accent-green);\\n  color: white;\\n}\\n\\n.btn-export-json:hover {\\n  background: linear-gradient(135deg, #3abfa6, var(--accent-green));\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(42, 157, 143, 0.3);\\n}\\n\\n.btn-export-md:disabled,\\n.btn-export-json:disabled {\\n  opacity: 0.4;\\n  cursor: not-allowed;\\n  transform: none;\\n  box-shadow: none;\\n}\\n\\n.export-btn-icon {\\n  font-size: 1rem;\\n}\\n\\n/* ========== SELECTION FEATURE STYLES ========== */\\n\\n/* Selection Section in Sidebar */\\n.selection-section,\\n.comments-section {\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-md);\\n  padding: 1rem;\\n}\\n\\n.selection-section h3,\\n.comments-section h3 {\\n  font-size: 0.85rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.1em;\\n  color: var(--text-secondary);\\n  margin-bottom: 0.75rem;\\n}\\n\\n.selection-info {\\n  margin-bottom: 0.75rem;\\n}\\n\\n.selection-count {\\n  font-size: 0.9rem;\\n  color: var(--text-primary);\\n  font-weight: 500;\\n}\\n\\n.selection-buttons,\\n.comments-buttons {\\n  display: flex;\\n  gap: 0.5rem;\\n  margin-bottom: 0.75rem;\\n}\\n\\n/* Buttons */\\n.btn {\\n  padding: 0.6rem 1rem;\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  background: var(--bg-elevated);\\n  color: var(--text-primary);\\n  cursor: pointer;\\n  font-size: 0.85rem;\\n  transition: all var(--transition-fast);\\n  width: 100%;\\n}\\n\\n.btn:hover {\\n  border-color: var(--accent-blue);\\n  background: rgba(69, 123, 157, 0.1);\\n}\\n\\n.btn-small {\\n  padding: 0.4rem 0.75rem;\\n  font-size: 0.8rem;\\n  width: auto;\\n  flex: 1;\\n}\\n\\n.btn-primary {\\n  background: var(--accent-blue);\\n  border-color: var(--accent-blue);\\n  color: white;\\n}\\n\\n.btn-primary:hover {\\n  background: #b5343a;\\n}\\n\\n.btn-primary:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n.btn-secondary {\\n  background: transparent;\\n}\\n\\n/* Checkbox Styling */\\n.finding-header-left,\\n.finding-header-right {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.75rem;\\n}\\n\\n/* Arsenal button on finding cards */\\n.btn-arsenal {\\n  width: 28px;\\n  height: 28px;\\n  padding: 0;\\n  background: transparent;\\n  border: 1px solid #475569;\\n  border-radius: 6px;\\n  color: #64748b;\\n  font-size: 16px;\\n  cursor: pointer;\\n  transition: all 0.15s ease;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n}\\n\\n.btn-arsenal:hover:not(:disabled) {\\n  border-color: #fbbf24;\\n  color: #fbbf24;\\n  background: rgba(251, 191, 36, 0.1);\\n}\\n\\n.btn-arsenal.in-arsenal {\\n  border-color: #fbbf24;\\n  color: #fbbf24;\\n  background: rgba(251, 191, 36, 0.15);\\n}\\n\\n.btn-arsenal:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n.checkbox-wrapper {\\n  position: relative;\\n  display: inline-flex;\\n  align-items: center;\\n  cursor: pointer;\\n}\\n\\n.checkbox-wrapper input[type=\\\"checkbox\\\"] {\\n  position: absolute;\\n  opacity: 0;\\n  width: 0;\\n  height: 0;\\n}\\n\\n.checkmark {\\n  width: 22px;\\n  height: 22px;\\n  background: var(--bg-dark);\\n  border: 2px solid var(--border-color);\\n  border-radius: 4px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  transition: all var(--transition-fast);\\n}\\n\\n.checkbox-wrapper:hover .checkmark {\\n  border-color: var(--accent-blue);\\n}\\n\\n.checkbox-wrapper input[type=\\\"checkbox\\\"]:checked + .checkmark {\\n  background: var(--accent-blue);\\n  border-color: var(--accent-blue);\\n}\\n\\n.checkbox-wrapper input[type=\\\"checkbox\\\"]:checked + .checkmark::after {\\n  content: '✓';\\n  color: white;\\n  font-size: 14px;\\n  font-weight: bold;\\n}\\n\\n/* Finding card when checked */\\n.finding-card.checked {\\n  background: rgba(69, 123, 157, 0.08);\\n  border-color: var(--accent-blue);\\n}\\n\\n/* Comment Badge */\\n.comment-badge {\\n  background: rgba(233, 196, 106, 0.2);\\n  color: var(--accent-gold);\\n  padding: 0.2rem 0.5rem;\\n  border-radius: 100px;\\n  font-size: 0.75rem;\\n  font-weight: 500;\\n}\\n\\n/* ========== COMMENTS FEATURE STYLES ========== */\\n\\n/* Selectable Text */\\n.selectable-text {\\n  cursor: text;\\n  user-select: text;\\n}\\n\\n.selectable-text::selection {\\n  background: rgba(69, 123, 157, 0.4);\\n  color: var(--text-primary);\\n}\\n\\n/* Finding Comments */\\n.finding-comments {\\n  margin-top: 1.5rem;\\n  padding-top: 1rem;\\n  border-top: 1px solid var(--border-color);\\n}\\n\\n.finding-comments h5 {\\n  font-size: 0.8rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.1em;\\n  color: var(--accent-gold);\\n  margin-bottom: 0.75rem;\\n}\\n\\n.comment-item {\\n  background: var(--bg-dark);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  padding: 0.75rem;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.comment-highlight {\\n  font-style: italic;\\n  color: var(--text-muted);\\n  font-size: 0.85rem;\\n  margin-bottom: 0.5rem;\\n  padding-left: 0.5rem;\\n  border-left: 2px solid var(--accent-gold);\\n}\\n\\n.comment-text {\\n  color: var(--text-primary);\\n  font-size: 0.9rem;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.comment-meta {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  font-size: 0.75rem;\\n  color: var(--text-muted);\\n}\\n\\n.btn-delete {\\n  background: transparent;\\n  border: none;\\n  color: var(--accent-red);\\n  cursor: pointer;\\n  font-size: 0.75rem;\\n  padding: 0.2rem 0.4rem;\\n  border-radius: 4px;\\n}\\n\\n.btn-delete:hover {\\n  background: rgba(230, 57, 70, 0.2);\\n}\\n\\n/* ========== MODAL STYLES ========== */\\n\\n.modal-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.75);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  z-index: 1000;\\n  animation: fadeIn 0.2s ease;\\n}\\n\\n.modal {\\n  background: var(--bg-card);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-lg);\\n  width: 90%;\\n  max-width: 500px;\\n  max-height: 80vh;\\n  overflow: hidden;\\n  display: flex;\\n  flex-direction: column;\\n  box-shadow: var(--shadow-soft);\\n}\\n\\n.modal-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 1rem 1.5rem;\\n  border-bottom: 1px solid var(--border-color);\\n}\\n\\n.modal-header h3 {\\n  font-size: 1.1rem;\\n  color: var(--text-primary);\\n  margin: 0;\\n}\\n\\n.modal-close {\\n  background: transparent;\\n  border: none;\\n  color: var(--text-secondary);\\n  font-size: 1.5rem;\\n  cursor: pointer;\\n  padding: 0;\\n  line-height: 1;\\n}\\n\\n.modal-close:hover {\\n  color: var(--text-primary);\\n}\\n\\n.modal-body {\\n  padding: 1.5rem;\\n  overflow-y: auto;\\n}\\n\\n.modal-footer {\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 0.75rem;\\n  padding: 1rem 1.5rem;\\n  border-top: 1px solid var(--border-color);\\n}\\n\\n.modal-footer .btn {\\n  width: auto;\\n}\\n\\n/* Comment Modal Specifics */\\n.selected-text-preview {\\n  margin-bottom: 1.25rem;\\n}\\n\\n.selected-text-preview label,\\n.comment-input label {\\n  display: block;\\n  font-size: 0.85rem;\\n  color: var(--text-secondary);\\n  margin-bottom: 0.5rem;\\n}\\n\\n.selected-text-preview blockquote {\\n  background: var(--bg-dark);\\n  border-left: 3px solid var(--accent-gold);\\n  padding: 0.75rem;\\n  margin: 0;\\n  font-style: italic;\\n  color: var(--text-secondary);\\n  border-radius: var(--radius-sm);\\n  font-size: 0.9rem;\\n  max-height: 100px;\\n  overflow-y: auto;\\n}\\n\\n.comment-input textarea {\\n  width: 100%;\\n  padding: 0.75rem;\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  color: var(--text-primary);\\n  font-family: inherit;\\n  font-size: 0.95rem;\\n  resize: vertical;\\n  min-height: 100px;\\n}\\n\\n.comment-input textarea:focus {\\n  outline: none;\\n  border-color: var(--accent-blue);\\n  box-shadow: 0 0 0 3px rgba(69, 123, 157, 0.2);\\n}\\n\\n/* Add to Outline in Comment Modal */\\n.add-to-outline-section {\\n  margin-top: 1rem;\\n  padding-top: 1rem;\\n  border-top: 1px solid var(--border-color);\\n}\\n\\n.add-to-outline-section label {\\n  display: block;\\n  font-size: 0.85rem;\\n  color: var(--text-secondary);\\n  margin-bottom: 0.5rem;\\n}\\n\\n.add-to-outline-section select {\\n  width: 100%;\\n  padding: 0.5rem 0.75rem;\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  color: var(--text-primary);\\n  font-family: inherit;\\n  font-size: 0.9rem;\\n  cursor: pointer;\\n}\\n\\n.add-to-outline-section select:focus {\\n  outline: none;\\n  border-color: #b5343a;\\n  box-shadow: 0 0 0 3px rgba(181, 52, 58, 0.2);\\n}\\n\\n.add-to-outline-section select:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.add-to-outline-error {\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  color: var(--text-secondary);\\n  padding: 0.5rem 0.75rem;\\n  border-radius: 0;\\n  font-size: 0.85rem;\\n  margin-top: 0.75rem;\\n}\\n\\n.btn-outline {\\n  background: transparent;\\n  border: 1px solid var(--border-color);\\n  color: var(--text-secondary);\\n  padding: 0.5rem 1rem;\\n  border-radius: 0;\\n  cursor: pointer;\\n  font-weight: 500;\\n  transition: all var(--transition-fast);\\n}\\n\\n.btn-outline:hover:not(:disabled) {\\n  background: var(--bg-elevated);\\n  border-color: var(--text-muted);\\n  color: var(--text-primary);\\n}\\n\\n.btn-outline:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n  transform: none;\\n}\\n\\n/* Export Modal Specifics */\\n.export-description {\\n  color: var(--text-secondary);\\n  margin-bottom: 1.25rem;\\n}\\n\\n.export-options {\\n  display: flex;\\n  gap: 1rem;\\n}\\n\\n.export-option {\\n  flex: 1;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  padding: 1.5rem 1rem;\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-md);\\n  cursor: pointer;\\n  transition: all var(--transition-fast);\\n}\\n\\n.export-option:hover {\\n  border-color: var(--accent-blue);\\n  background: rgba(69, 123, 157, 0.1);\\n  transform: translateY(-2px);\\n}\\n\\n.export-icon {\\n  font-size: 2rem;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.export-label {\\n  font-size: 1rem;\\n  font-weight: 600;\\n  color: var(--text-primary);\\n  margin-bottom: 0.25rem;\\n}\\n\\n.export-desc {\\n  font-size: 0.75rem;\\n  color: var(--text-muted);\\n}\\n\\n/* ========== RIGHT SIDEBAR - WORD-STYLE COMMENTS PANEL ========== */\\n\\n.comments-panel {\\n  width: 300px;\\n  min-width: 300px;\\n  background: var(--bg-card);\\n  border-left: 1px solid var(--border-color);\\n  display: flex;\\n  flex-direction: column;\\n  max-height: calc(100vh - 200px);\\n}\\n\\n.comments-panel.has-comments {\\n  background: linear-gradient(to bottom, var(--bg-card), var(--bg-elevated));\\n}\\n\\n.comments-panel-header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  padding: 1rem 1.25rem;\\n  border-bottom: 1px solid var(--border-color);\\n  background: var(--bg-elevated);\\n  position: sticky;\\n  top: 0;\\n  z-index: 10;\\n}\\n\\n.comments-panel-header h3 {\\n  font-size: 1rem;\\n  font-weight: 600;\\n  color: var(--text-primary);\\n  margin: 0;\\n}\\n\\n.comments-count {\\n  background: var(--accent-gold);\\n  color: var(--bg-dark);\\n  font-size: 0.75rem;\\n  font-weight: 700;\\n  padding: 0.2rem 0.5rem;\\n  border-radius: 100px;\\n  min-width: 24px;\\n  text-align: center;\\n}\\n\\n.comments-empty {\\n  padding: 2rem 1.25rem;\\n  text-align: center;\\n  color: var(--text-muted);\\n}\\n\\n.comments-empty p {\\n  margin: 0 0 0.5rem 0;\\n}\\n\\n.comments-hint {\\n  font-size: 0.8rem;\\n  font-style: italic;\\n}\\n\\n.comments-panel-actions {\\n  display: flex;\\n  gap: 0.5rem;\\n  padding: 0.75rem 1.25rem;\\n  border-bottom: 1px solid var(--border-color);\\n}\\n\\n.comments-panel-actions .btn {\\n  flex: 1;\\n  padding: 0.4rem 0.5rem;\\n  font-size: 0.75rem;\\n}\\n\\n.comments-list {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 0.75rem;\\n}\\n\\n/* Individual Comment Card */\\n.comment-card {\\n  background: var(--bg-dark);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  padding: 0.75rem;\\n  margin-bottom: 0.75rem;\\n  cursor: pointer;\\n  transition: all var(--transition-fast);\\n  position: relative;\\n}\\n\\n.comment-card:hover {\\n  border-color: var(--accent-blue);\\n  transform: translateX(-2px);\\n  box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);\\n}\\n\\n.comment-card:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.comment-card-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.comment-number {\\n  font-size: 0.7rem;\\n  font-weight: 700;\\n  color: var(--accent-gold);\\n  background: rgba(233, 196, 106, 0.15);\\n  padding: 0.1rem 0.35rem;\\n  border-radius: 4px;\\n}\\n\\n.comment-stream {\\n  font-size: 0.9rem;\\n}\\n\\n.comment-delete {\\n  margin-left: auto;\\n  background: transparent;\\n  border: none;\\n  color: var(--text-muted);\\n  font-size: 1.1rem;\\n  cursor: pointer;\\n  padding: 0 0.25rem;\\n  line-height: 1;\\n  opacity: 0;\\n  transition: opacity var(--transition-fast), color var(--transition-fast);\\n}\\n\\n.comment-card:hover .comment-delete {\\n  opacity: 1;\\n}\\n\\n.comment-delete:hover {\\n  color: var(--accent-red);\\n}\\n\\n.comment-card-finding {\\n  font-size: 0.8rem;\\n  font-weight: 600;\\n  color: var(--text-secondary);\\n  margin-bottom: 0.5rem;\\n  white-space: nowrap;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n}\\n\\n.comment-card-highlight {\\n  font-size: 0.75rem;\\n  font-style: italic;\\n  color: var(--text-muted);\\n  padding: 0.4rem 0.5rem;\\n  background: rgba(233, 196, 106, 0.1);\\n  border-left: 2px solid var(--accent-gold);\\n  margin-bottom: 0.5rem;\\n  line-height: 1.4;\\n}\\n\\n.comment-card-text {\\n  font-size: 0.85rem;\\n  color: var(--text-primary);\\n  line-height: 1.5;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.comment-card-date {\\n  font-size: 0.7rem;\\n  color: var(--text-muted);\\n  text-align: right;\\n}\\n\\n/* Highlight pulse animation when navigating to a finding */\\n@keyframes highlightPulse {\\n  0%, 100% { box-shadow: 0 0 0 0 rgba(69, 123, 157, 0); }\\n  50% { box-shadow: 0 0 0 8px rgba(69, 123, 157, 0.4); }\\n}\\n\\n.finding-card.highlight-pulse {\\n  animation: highlightPulse 0.75s ease 2;\\n}\\n\\n/* ========== DEFLECTION CARD STYLES ========== */\\n\\n.deflection-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.deflection-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.deflection-section {\\n  margin-bottom: 1rem;\\n}\\n\\n/* Editorial label style - subtle, no colored backgrounds */\\n.deflection-label,\\n.contradiction-label,\\n.leap-label,\\n.silence-label,\\n.concession-label,\\n.retreat-label,\\n.cherrypick-label,\\n.namedrop-label,\\n.tuquoque-label,\\n.vulnerability-label {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  font-weight: 600;\\n  letter-spacing: 0.05em;\\n  text-transform: uppercase;\\n  color: var(--text-muted);\\n  margin-top: 1.25rem;\\n  margin-bottom: 0.5rem;\\n  display: block;\\n}\\n\\n/* Morozov quotes - subtle distinction */\\n.morozov-quote {\\n  border-left-color: var(--text-muted) !important;\\n  background: transparent !important;\\n}\\n\\n.avoided-critique {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.avoided-critique h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n.avoided-critique p {\\n  color: var(--text-secondary) !important;\\n  font-weight: 400;\\n}\\n\\n/* ========== CONTRADICTION CARD STYLES ========== */\\n\\n.contradiction-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.contradiction-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.contradiction-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.original-quote {\\n  border-left-color: var(--text-muted) !important;\\n  background: transparent !important;\\n}\\n\\n/* Type badges - subtle text style */\\n.contradiction-type,\\n.leap-type,\\n.retreat-type,\\n.cherrypick-type,\\n.gap-type {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  color: var(--text-muted);\\n  text-transform: capitalize;\\n}\\n\\n/* ========== LEAP CARD STYLES ========== */\\n\\n.leap-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.leap-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.leap-section {\\n  margin-bottom: 1rem;\\n}\\n\\n/* Actual argument section */\\n.actual-argument {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.actual-argument h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n.actual-argument p {\\n  color: var(--text-primary) !important;\\n  font-weight: 500;\\n}\\n\\n/* ========== 6 NEW FINDING TYPE STYLES ========== */\\n\\n/* Silence findings - Unanswered challenges */\\n.silence-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.silence-label {\\n  font-size: 0.8rem;\\n  font-weight: 600;\\n  letter-spacing: 0.03em;\\n  margin-bottom: 0.5rem;\\n  padding: 0.3rem 0.6rem;\\n  border-radius: var(--radius-sm);\\n  display: inline-block;\\n}\\n\\n/* Finding gap text */\\n.finding-gap {\\n  padding: 0.8rem 1rem;\\n  background: var(--bg-elevated);\\n  border-left: 2px solid var(--border-color);\\n  font-style: italic;\\n  color: var(--text-secondary);\\n}\\n\\n/* Challenge type - subtle text */\\n.challenge-type {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  color: var(--text-muted);\\n  text-transform: capitalize;\\n}\\n\\n/* Why matters section */\\n.why-matters {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.why-matters h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* Concession findings */\\n.concession-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.shift-quote {\\n  border-left-color: var(--text-muted) !important;\\n}\\n\\n.wont-say {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.wont-say h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* Retreat findings */\\n.retreat-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.clarification-quote {\\n  border-left-color: var(--text-muted) !important;\\n}\\n\\n.what-changed, .disguise {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n  margin-bottom: 0.75rem;\\n}\\n\\n.what-changed h5, .disguise h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n.disguise-language {\\n  font-style: italic;\\n}\\n\\n/* Cherrypick findings */\\n.cherrypick-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.omits, .meaning-change {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n  margin-bottom: 0.75rem;\\n}\\n\\n.omits h5, .meaning-change h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* Namedrop findings */\\n.namedrop-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.claim-defended {\\n  padding: 0.8rem 1rem;\\n  background: var(--bg-elevated);\\n  border-left: 2px solid var(--border-color);\\n  color: var(--text-primary);\\n}\\n\\n.theorist-actual {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.theorist-actual h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* TuQuoque findings */\\n.tuquoque-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.accuracy-badge {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  color: var(--text-secondary);\\n}\\n\\n.accuracy-badge.accurate {\\n  color: var(--text-muted);\\n}\\n\\n.accuracy-badge.inaccurate {\\n  color: var(--accent-primary);\\n}\\n\\n.doesnt-answer, .should-address {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n  margin-bottom: 0.75rem;\\n}\\n\\n.doesnt-answer h5, .should-address h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* Responsive: hide comments panel on smaller screens */\\n@media (max-width: 1200px) {\\n  .comments-panel {\\n    display: none;\\n  }\\n}\\n\\n/* Show comments panel as overlay on medium screens */\\n@media (max-width: 1200px) and (min-width: 901px) {\\n  .comments-panel.has-comments {\\n    display: flex;\\n    position: fixed;\\n    right: 0;\\n    top: 200px;\\n    bottom: 60px;\\n    width: 280px;\\n    z-index: 100;\\n    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.5);\\n  }\\n}\\n\\n/* ========== ASK AI FEATURE STYLES (Phase 2) ========== */\\n\\n/* Ask AI Button */\\n.comment-card-actions {\\n  margin: 0.5rem 0;\\n}\\n\\n.ask-ai-button {\\n  background: var(--accent-primary);\\n  border: none;\\n  color: white;\\n  padding: 0.4rem 0.8rem;\\n  border-radius: var(--radius-sm);\\n  font-family: var(--font-ui);\\n  font-size: var(--text-sm);\\n  cursor: pointer;\\n  transition: all var(--transition-fast);\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.3rem;\\n}\\n\\n.ask-ai-button:hover {\\n  background: var(--accent-hover);\\n}\\n\\n.ask-ai-button.loading {\\n  opacity: 0.7;\\n  cursor: not-allowed;\\n}\\n\\n/* Ask AI Loading State */\\n.ask-ai-loading {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  color: var(--accent-blue);\\n  font-size: 0.8rem;\\n  font-style: italic;\\n}\\n\\n.loading-spinner-small {\\n  width: 14px;\\n  height: 14px;\\n  border: 2px solid var(--border-color);\\n  border-top-color: var(--accent-blue);\\n  border-radius: 50%;\\n  animation: spin 1s linear infinite;\\n}\\n\\n/* Add to Outline Button (in comments panel) */\\n.add-to-outline-button {\\n  background: linear-gradient(135deg, #b5343a, #9a2c31);\\n  border: none;\\n  color: white;\\n  padding: 0.4rem 0.8rem;\\n  border-radius: var(--radius-sm);\\n  font-size: 0.8rem;\\n  cursor: pointer;\\n  transition: all var(--transition-fast);\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.3rem;\\n}\\n\\n.add-to-outline-button:hover {\\n  background: linear-gradient(135deg, #9a2c31, #d97b3f);\\n  transform: translateY(-1px);\\n  box-shadow: 0 2px 8px rgba(181, 52, 58, 0.4);\\n}\\n\\n.add-to-outline-loading {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  color: #b5343a;\\n  font-size: 0.8rem;\\n  font-style: italic;\\n}\\n\\n.add-to-outline-loading .loading-spinner-small {\\n  border-top-color: #b5343a;\\n}\\n\\n/* Ask AI Modal */\\n.ask-ai-modal {\\n  max-width: 550px;\\n}\\n\\n.ask-ai-modal-overlay {\\n  z-index: 1001;\\n}\\n\\n.ask-ai-context-preview {\\n  background: var(--bg-dark);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  padding: 1rem;\\n  margin-bottom: 1rem;\\n}\\n\\n.context-item {\\n  margin-bottom: 0.75rem;\\n}\\n\\n.context-item:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.context-item label {\\n  display: block;\\n  font-size: 0.75rem;\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n  margin-bottom: 0.25rem;\\n}\\n\\n.context-stream {\\n  font-weight: 600;\\n  font-size: 0.9rem;\\n}\\n\\n.context-highlight {\\n  background: rgba(69, 123, 157, 0.1);\\n  border-left: 3px solid var(--accent-blue);\\n  padding: 0.5rem;\\n  margin: 0;\\n  font-style: italic;\\n  color: var(--text-secondary);\\n  font-size: 0.85rem;\\n  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\\n}\\n\\n.context-comment {\\n  color: var(--text-primary);\\n  font-size: 0.9rem;\\n  margin: 0;\\n}\\n\\n.ask-ai-question-input {\\n  margin-top: 1rem;\\n}\\n\\n.ask-ai-question-input label {\\n  display: block;\\n  font-size: 0.85rem;\\n  color: var(--text-secondary);\\n  margin-bottom: 0.5rem;\\n}\\n\\n.ask-ai-question-input textarea {\\n  width: 100%;\\n  padding: 0.75rem;\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-sm);\\n  color: var(--text-primary);\\n  font-family: inherit;\\n  font-size: 0.95rem;\\n  resize: vertical;\\n  min-height: 80px;\\n}\\n\\n.ask-ai-question-input textarea:focus {\\n  outline: none;\\n  border-color: var(--accent-blue);\\n  box-shadow: 0 0 0 3px rgba(69, 123, 157, 0.2);\\n}\\n\\n.ask-ai-submit-button {\\n  background: linear-gradient(135deg, #4a90d9, #b5343a) !important;\\n}\\n\\n.ask-ai-submit-button:hover:not(:disabled) {\\n  background: linear-gradient(135deg, #b5343a, #b5343a) !important;\\n}\\n\\n/* AI Response Display (under comment card) */\\n.ai-response {\\n  margin-top: 0.75rem;\\n  padding: 0.75rem;\\n  background: rgba(74, 144, 217, 0.08);\\n  border: 1px solid rgba(74, 144, 217, 0.25);\\n  border-radius: var(--radius-sm);\\n  font-size: 0.8rem;\\n}\\n\\n.ai-response-question {\\n  color: var(--text-secondary);\\n  margin-bottom: 0.5rem;\\n  font-style: italic;\\n}\\n\\n.ai-response-question strong {\\n  color: var(--accent-blue);\\n  font-style: normal;\\n}\\n\\n.ai-response-answer {\\n  color: var(--text-primary);\\n  line-height: 1.5;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.ai-response-answer strong {\\n  color: var(--accent-green);\\n}\\n\\n.ai-response-citations {\\n  margin-top: 0.5rem;\\n  padding-top: 0.5rem;\\n  border-top: 1px solid rgba(74, 144, 217, 0.2);\\n}\\n\\n.citations-label {\\n  font-size: 0.75rem;\\n  color: var(--accent-gold);\\n}\\n\\n/* Comment card with Q&A */\\n.comment-card.has-qa {\\n  border-color: rgba(74, 144, 217, 0.4);\\n  background: rgba(74, 144, 217, 0.03);\\n}\\n\\n/* === SIDEBAR TABS (Phase 3) === */\\n\\n.sidebar-tabs {\\n  display: flex;\\n  gap: 0;\\n  padding: 0;\\n  margin-bottom: 1rem;\\n  border-radius: var(--radius-md);\\n  overflow: hidden;\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n}\\n\\n.sidebar-tab {\\n  flex: 1;\\n  padding: 0.75rem 0.5rem;\\n  background: transparent;\\n  border: none;\\n  color: var(--text-muted);\\n  font-family: var(--font-ui);\\n  font-size: var(--text-sm);\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.15s ease;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 0.35rem;\\n  position: relative;\\n}\\n\\n.sidebar-tab:not(:last-child) {\\n  border-right: 1px solid var(--border-color);\\n}\\n\\n.sidebar-tab:hover:not(.active) {\\n  background: var(--bg-surface);\\n  color: var(--text-primary);\\n}\\n\\n.sidebar-tab.active {\\n  background: var(--bg-surface);\\n  color: var(--accent-primary);\\n}\\n\\n/* Outline tab specific styling */\\n.sidebar-tab.outline-tab.active {\\n  color: var(--accent-gold);\\n}\\n\\n.sidebar-tab-badge {\\n  background: var(--accent-primary);\\n  color: white;\\n  font-size: var(--text-xs);\\n  font-weight: 600;\\n  padding: 0.125rem 0.375rem;\\n  border-radius: 10px;\\n  min-width: 1.2rem;\\n  text-align: center;\\n}\\n\\n/* === Q&A HISTORY TAB (Phase 3) === */\\n\\n.qa-history-section {\\n  animation: fadeIn 0.2s ease;\\n}\\n\\n.qa-history-section h3 {\\n  font-size: 1rem;\\n  font-weight: 600;\\n  color: var(--text-primary);\\n  margin-bottom: 1rem;\\n  padding-bottom: 0.5rem;\\n  border-bottom: 1px solid var(--border-color);\\n}\\n\\n/* Empty State */\\n.qa-history-empty {\\n  text-align: center;\\n  padding: 2rem 1rem;\\n  color: var(--text-muted);\\n}\\n\\n.qa-history-empty-icon {\\n  font-size: 2.5rem;\\n  margin-bottom: 1rem;\\n  opacity: 0.5;\\n}\\n\\n.qa-history-empty p {\\n  margin: 0.5rem 0;\\n  font-size: 0.9rem;\\n}\\n\\n.qa-history-empty-hint {\\n  font-size: 0.8rem !important;\\n  color: var(--text-muted);\\n  line-height: 1.5;\\n}\\n\\n/* Q&A History List */\\n.qa-history-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.75rem;\\n}\\n\\n/* Q&A History Card */\\n.qa-history-card {\\n  background: var(--bg-elevated);\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-md);\\n  padding: 0.75rem;\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n}\\n\\n.qa-history-card:hover {\\n  border-color: var(--accent-primary);\\n  background: var(--accent-subtle);\\n}\\n\\n.qa-history-card-header {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.qa-history-stream {\\n  font-size: 1rem;\\n}\\n\\n.qa-history-date {\\n  font-size: 0.7rem;\\n  color: var(--text-muted);\\n}\\n\\n/* Question and Answer */\\n.qa-history-question,\\n.qa-history-answer {\\n  font-size: 0.8rem;\\n  line-height: 1.4;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.qa-history-label {\\n  font-weight: 600;\\n  margin-right: 0.3rem;\\n}\\n\\n.qa-history-question .qa-history-label {\\n  color: var(--accent-blue);\\n}\\n\\n.qa-history-question-text {\\n  color: var(--text-primary);\\n}\\n\\n.qa-history-answer .qa-history-label {\\n  color: var(--accent-green);\\n}\\n\\n.qa-history-answer-text {\\n  color: var(--text-secondary);\\n}\\n\\n/* Citations */\\n.qa-history-citations {\\n  font-size: 0.75rem;\\n  color: var(--accent-gold);\\n  margin-bottom: 0.5rem;\\n}\\n\\n/* Click hint */\\n.qa-history-click-hint {\\n  font-size: 0.7rem;\\n  color: var(--text-muted);\\n  text-align: center;\\n  padding-top: 0.5rem;\\n  border-top: 1px dashed var(--border-color);\\n  opacity: 0;\\n  transition: opacity 0.2s ease;\\n}\\n\\n.qa-history-card:hover .qa-history-click-hint {\\n  opacity: 1;\\n}\\n\\n/* Animation */\\n@keyframes fadeIn {\\n  from {\\n    opacity: 0;\\n    transform: translateY(-5px);\\n  }\\n  to {\\n    opacity: 1;\\n    transform: translateY(0);\\n  }\\n}\\n\\n/* ========== STREAM NAVIGATION BAR ========== */\\n\\n.stream-nav {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.75rem;\\n  padding: 1rem 2rem;\\n  background: var(--bg-elevated);\\n  border-bottom: 1px solid var(--border-color);\\n  overflow-x: auto;\\n  flex-wrap: wrap;\\n}\\n\\n.stream-nav-tab {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  padding: 0.6rem 1rem;\\n  border: 1px solid var(--border-color);\\n  border-radius: var(--radius-md);\\n  background: var(--bg-card);\\n  color: var(--text-secondary);\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  font-size: 0.85rem;\\n  white-space: nowrap;\\n}\\n\\n.stream-nav-tab:hover {\\n  background: var(--bg-surface);\\n  border-color: var(--text-secondary);\\n  color: var(--text-primary);\\n}\\n\\n.stream-nav-tab.active {\\n  background: var(--bg-surface);\\n  border-color: var(--text-primary);\\n  color: var(--text-primary);\\n  font-weight: 600;\\n}\\n\\n.stream-nav-all {\\n  flex-direction: column;\\n  padding: 0.5rem 1.25rem;\\n  min-width: 80px;\\n}\\n\\n.stream-nav-all .stream-nav-count {\\n  font-size: 1.5rem;\\n  font-weight: 700;\\n  color: var(--text-primary);\\n}\\n\\n.stream-nav-all .stream-nav-label {\\n  font-size: 0.7rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n  color: var(--text-muted);\\n}\\n\\n.stream-nav-all.active .stream-nav-count {\\n  color: var(--accent-primary);\\n}\\n\\n.stream-nav-divider {\\n  width: 1px;\\n  height: 40px;\\n  background: var(--border-color);\\n  margin: 0 0.5rem;\\n}\\n\\n.stream-nav-group {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.35rem;\\n}\\n\\n.stream-nav-group-label {\\n  font-size: 0.6rem;\\n  font-weight: 700;\\n  text-transform: uppercase;\\n  letter-spacing: 0.1em;\\n  color: var(--text-muted);\\n  padding-left: 0.25rem;\\n}\\n\\n.stream-nav-buttons {\\n  display: flex;\\n  gap: 0.35rem;\\n  flex-wrap: wrap;\\n}\\n\\n.stream-nav-icon {\\n  font-size: 1rem;\\n}\\n\\n.stream-nav-name {\\n  font-size: 0.8rem;\\n}\\n\\n.stream-nav-count {\\n  font-size: 0.75rem;\\n  font-weight: 600;\\n  padding: 0.15rem 0.4rem;\\n  background: rgba(255, 255, 255, 0.1);\\n  border-radius: 100px;\\n  min-width: 1.5rem;\\n  text-align: center;\\n}\\n\\n.stream-nav-tab.active .stream-nav-count {\\n  background: var(--stream-color, var(--accent-blue));\\n  color: white;\\n}\\n\\n/* Stream Nav Actions (Run Analysis button) */\\n.stream-nav-actions {\\n  display: flex;\\n  align-items: center;\\n  gap: 1rem;\\n  margin-left: auto;\\n  padding-left: 1.5rem;\\n}\\n\\n.btn-run-analysis {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.5rem;\\n  padding: 0.6rem 1rem;\\n  font-size: 0.85rem;\\n  font-weight: 600;\\n  background: var(--accent-blue);\\n  color: white;\\n  border: none;\\n  border-radius: var(--radius-md);\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  white-space: nowrap;\\n}\\n\\n.btn-run-analysis:hover:not(:disabled) {\\n  background: color-mix(in srgb, var(--accent-blue) 85%, white);\\n  transform: translateY(-1px);\\n}\\n\\n.btn-run-analysis:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n.btn-run-analysis.running {\\n  background: var(--accent-green);\\n}\\n\\n.btn-run-analysis .btn-icon {\\n  font-size: 0.75rem;\\n}\\n\\n.btn-run-analysis .btn-spinner {\\n  width: 14px;\\n  height: 14px;\\n  border: 2px solid rgba(255, 255, 255, 0.3);\\n  border-top-color: white;\\n  border-radius: 50%;\\n  animation: spin 0.8s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to { transform: rotate(360deg); }\\n}\\n\\n.analysis-status {\\n  font-size: 0.75rem;\\n  color: var(--accent-green);\\n  font-weight: 500;\\n}\\n\\n.analysis-error {\\n  font-size: 0.75rem;\\n  color: var(--accent-red);\\n  font-weight: 500;\\n}\\n\\n/* ========== STREAM EXPLAINER BANNER ========== */\\n\\n.stream-explainer {\\n  padding: 1.25rem 2rem;\\n  background: linear-gradient(135deg,\\n    color-mix(in srgb, var(--stream-color) 8%, var(--bg-card)),\\n    color-mix(in srgb, var(--stream-color) 3%, var(--bg-card))\\n  );\\n  border-bottom: 2px solid var(--stream-color);\\n}\\n\\n.stream-explainer-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.75rem;\\n  margin-bottom: 0.75rem;\\n}\\n\\n.stream-explainer-icon {\\n  font-size: 2rem;\\n}\\n\\n.stream-explainer-title {\\n  font-size: 1.25rem;\\n  font-weight: 600;\\n  color: var(--stream-color);\\n  margin: 0;\\n  flex: 1;\\n}\\n\\n.stream-explainer-count {\\n  font-size: 0.8rem;\\n  font-weight: 600;\\n  padding: 0.3rem 0.75rem;\\n  background: var(--stream-color);\\n  color: white;\\n  border-radius: 100px;\\n}\\n\\n.stream-explainer-description {\\n  font-size: 0.9rem;\\n  color: var(--text-secondary);\\n  margin: 0 0 0.75rem 0;\\n  line-height: 1.5;\\n}\\n\\n.stream-explainer-insight {\\n  font-size: 0.85rem;\\n  color: var(--text-primary);\\n  background: rgba(0, 0, 0, 0.2);\\n  padding: 0.75rem 1rem;\\n  border-radius: var(--radius-sm);\\n  border-left: 3px solid var(--stream-color);\\n  line-height: 1.5;\\n}\\n\\n.stream-explainer-insight strong {\\n  color: var(--stream-color);\\n}\\n\\n/* ========== OLD STATS BAR (keeping for compatibility) ========== */\\n\\n.stat-group {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.25rem;\\n  padding: 0.5rem;\\n  background: rgba(255, 255, 255, 0.02);\\n  border-radius: var(--radius-md);\\n  border: 1px solid var(--border-color);\\n}\\n\\n.stat-group-label {\\n  font-size: 0.65rem;\\n  font-weight: 600;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n  color: var(--text-muted);\\n  padding: 0 0.25rem;\\n}\\n\\n.stat-group-items {\\n  display: flex;\\n  gap: 0.25rem;\\n  flex-wrap: wrap;\\n}\\n\\n.stat-group .stat-item {\\n  min-width: auto;\\n  padding: 0.3rem 0.5rem;\\n}\\n\\n.stat-group .stat-item .stat-label {\\n  display: none;\\n}\\n\\n/* ========== SILENCE CARD STYLES (Slate) ========== */\\n\\n.silence-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.silence-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.silence-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.gap-text {\\n  background: var(--bg-elevated);\\n  border-left: 2px solid var(--border-color);\\n  padding: 0.75rem 1rem;\\n  margin: 0;\\n  color: var(--text-secondary);\\n  font-style: italic;\\n}\\n\\n.why-matters {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.why-matters h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* ========== CONCESSION CARD STYLES (Lime) ========== */\\n\\n.concession-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.concession-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.concession-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.shift-quote {\\n  border-left-color: var(--border-color) !important;\\n}\\n\\n.wont-say {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.wont-say h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* ========== RETREAT CARD STYLES (Amber) ========== */\\n\\n.retreat-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.retreat-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.retreat-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.what-changed, .disguise-language {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n  margin-bottom: 1rem;\\n}\\n\\n.what-changed h5, .disguise-language h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* ========== CHERRYPICK CARD STYLES (Cherry Red) ========== */\\n\\n.cherrypick-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.cherrypick-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.cherrypick-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.what-omits, .how-changes {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n  margin-bottom: 1rem;\\n}\\n\\n.what-omits h5, .how-changes h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* ========== NAMEDROP CARD STYLES (Brown) ========== */\\n\\n.namedrop-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.namedrop-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.namedrop-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.claim-text {\\n  background: var(--bg-elevated);\\n  border-left: 2px solid var(--border-color);\\n  padding: 0.75rem 1rem;\\n  margin: 0;\\n  color: var(--text-secondary);\\n}\\n\\n.theorist-actual {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n}\\n\\n.theorist-actual h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* ========== TUQUOQUE CARD STYLES (Cyan) ========== */\\n\\n.tuquoque-card {\\n  --stream-color: var(--text-muted);\\n}\\n\\n.tuquoque-title {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  color: var(--text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.tuquoque-section {\\n  margin-bottom: 1rem;\\n}\\n\\n.tuquoque-quote {\\n  border-left-color: var(--border-color) !important;\\n}\\n\\n.tuquoque-accuracy {\\n  font-family: var(--font-ui);\\n  font-size: var(--text-xs);\\n  font-weight: 500;\\n  color: var(--text-muted);\\n  text-transform: capitalize;\\n}\\n\\n.why-doesnt-answer, .should-address {\\n  background: var(--bg-elevated);\\n  border-radius: 0;\\n  padding: 1rem;\\n  border-left: 2px solid var(--border-color);\\n  margin-bottom: 1rem;\\n}\\n\\n.why-doesnt-answer h5, .should-address h5 {\\n  color: var(--text-muted) !important;\\n}\\n\\n/* ========== Q&A DETAIL MODAL ========== */\\n\\n.qa-detail-modal-overlay {\\n  z-index: 1001;\\n}\\n\\n.qa-detail-modal {\\n  max-width: 700px;\\n  width: 90%;\\n  max-height: 85vh;\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n.qa-detail-body {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 1.5rem;\\n}\\n\\n.qa-detail-section {\\n  margin-bottom: 1.5rem;\\n}\\n\\n.qa-detail-label {\\n  font-size: 0.85rem;\\n  font-weight: 600;\\n  color: var(--text-muted);\\n  margin-bottom: 0.5rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n}\\n\\n.qa-detail-question {\\n  font-size: 1rem;\\n  color: var(--accent-blue);\\n  background: rgba(66, 135, 245, 0.1);\\n  padding: 1rem;\\n  border-radius: var(--radius-sm);\\n  border-left: 3px solid var(--accent-blue);\\n}\\n\\n.qa-detail-answer {\\n  font-size: 0.95rem;\\n  line-height: 1.7;\\n  color: var(--text-primary);\\n  background: var(--bg-elevated);\\n  padding: 1rem;\\n  border-radius: var(--radius-sm);\\n  white-space: pre-wrap;\\n}\\n\\n.qa-detail-citations {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 1rem;\\n}\\n\\n.qa-detail-citation {\\n  background: var(--bg-elevated);\\n  border-radius: var(--radius-sm);\\n  padding: 1rem;\\n  border-left: 3px solid var(--accent-gold);\\n}\\n\\n.citation-source {\\n  font-size: 0.8rem;\\n  font-weight: 600;\\n  color: var(--accent-gold);\\n  margin-bottom: 0.5rem;\\n}\\n\\n.citation-quote {\\n  font-style: italic;\\n  color: var(--text-secondary);\\n  margin: 0;\\n  padding-left: 0.75rem;\\n  border-left: 2px solid var(--border-color);\\n  font-size: 0.9rem;\\n  line-height: 1.5;\\n}\\n\\n.citation-page {\\n  font-size: 0.75rem;\\n  color: var(--text-muted);\\n  margin-top: 0.5rem;\\n}\\n\\n.qa-detail-meta {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding-top: 1rem;\\n  border-top: 1px solid var(--border-color);\\n  font-size: 0.8rem;\\n  color: var(--text-muted);\\n}\\n\\n.qa-detail-stream {\\n  display: flex;\\n  align-items: center;\\n  gap: 0.3rem;\\n}\\n\\n/* Clickable AI Response in Comments Panel */\\n.ai-response-clickable {\\n  cursor: pointer;\\n  transition: all 0.2s ease;\\n  border: 1px solid transparent;\\n}\\n\\n.ai-response-clickable:hover {\\n  background: rgba(66, 135, 245, 0.15);\\n  border-color: var(--accent-blue);\\n  border-radius: var(--radius-sm);\\n}\\n\\n.ai-response-click-hint {\\n  font-size: 0.7rem;\\n  color: var(--text-muted);\\n  text-align: center;\\n  padding-top: 0.5rem;\\n  opacity: 0;\\n  transition: opacity 0.2s ease;\\n}\\n\\n.ai-response-clickable:hover .ai-response-click-hint {\\n  opacity: 1;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/ConceptsPanel.css\"\n/*!**************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/ConceptsPanel.css ***!\n  \\********************************************************************************************************************************************************************************************************************