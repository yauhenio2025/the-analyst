;\n  background: #faf8f5;\n  border-bottom: 1px solid #757575;\n}\n\n.feature-header h4 {\n  margin: 0;\n  font-size: 15px;\n  font-weight: 600;\n  color: #1a1a1a;\n}\n\n.feature-count {\n  font-size: 13px;\n  font-weight: 500;\n  color: #22c55e;\n  background: rgba(34, 197, 94, 0.1);\n  padding: 4px 10px;\n  border-radius: 20px;\n}\n\n.feature-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.feature-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 14px 20px;\n  border-bottom: 1px solid #757575;\n}\n\n.feature-item:last-child {\n  border-bottom: none;\n}\n\n.feature-icon {\n  width: 20px;\n  height: 20px;\n  flex-shrink: 0;\n  margin-top: 2px;\n}\n\n.feature-item.available .feature-icon {\n  color: #22c55e;\n}\n\n.feature-item.unavailable .feature-icon {\n  color: #f59e0b;\n}\n\n.feature-icon svg {\n  width: 100%;\n  height: 100%;\n}\n\n.feature-info {\n  flex: 1 1;\n}\n\n.feature-name {\n  display: block;\n  font-size: 14px;\n  font-weight: 500;\n  color: #1a1a1a;\n}\n\n.feature-item.unavailable .feature-name {\n  color: #94a3b8;\n}\n\n.feature-requirement {\n  display: block;\n  font-size: 12px;\n  color: #f59e0b;\n  margin-top: 2px;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/wizard/FeatureAvailability.css\"],\"names\":[],\"mappings\":\"AAAA,+BAA+B;;AAE/B;EACE,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,kBAAkB;EAClB,mBAAmB;EACnB,gCAAgC;AAClC;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,kCAAkC;EAClC,iBAAiB;EACjB,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,SAAS;EACT,UAAU;AACZ;;AAEA;EACE,aAAa;EACb,uBAAuB;EACvB,SAAS;EACT,kBAAkB;EAClB,gCAAgC;AAClC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,WAAW;EACX,YAAY;AACd;;AAEA;EACE,SAAO;AACT;;AAEA;EACE,cAAc;EACd,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;EACd,eAAe;EACf,cAAc;EACd,eAAe;AACjB\",\"sourcesContent\":[\"/* FeatureAvailability Styles */\\n\\n.feature-availability {\\n  background: #faf8f5;\\n  border: 1px solid #757575;\\n  border-radius: 12px;\\n  overflow: hidden;\\n}\\n\\n.feature-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 16px 20px;\\n  background: #faf8f5;\\n  border-bottom: 1px solid #757575;\\n}\\n\\n.feature-header h4 {\\n  margin: 0;\\n  font-size: 15px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.feature-count {\\n  font-size: 13px;\\n  font-weight: 500;\\n  color: #22c55e;\\n  background: rgba(34, 197, 94, 0.1);\\n  padding: 4px 10px;\\n  border-radius: 20px;\\n}\\n\\n.feature-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n.feature-item {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  padding: 14px 20px;\\n  border-bottom: 1px solid #757575;\\n}\\n\\n.feature-item:last-child {\\n  border-bottom: none;\\n}\\n\\n.feature-icon {\\n  width: 20px;\\n  height: 20px;\\n  flex-shrink: 0;\\n  margin-top: 2px;\\n}\\n\\n.feature-item.available .feature-icon {\\n  color: #22c55e;\\n}\\n\\n.feature-item.unavailable .feature-icon {\\n  color: #f59e0b;\\n}\\n\\n.feature-icon svg {\\n  width: 100%;\\n  height: 100%;\\n}\\n\\n.feature-info {\\n  flex: 1;\\n}\\n\\n.feature-name {\\n  display: block;\\n  font-size: 14px;\\n  font-weight: 500;\\n  color: #1a1a1a;\\n}\\n\\n.feature-item.unavailable .feature-name {\\n  color: #94a3b8;\\n}\\n\\n.feature-requirement {\\n  display: block;\\n  font-size: 12px;\\n  color: #f59e0b;\\n  margin-top: 2px;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_