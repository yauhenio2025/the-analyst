sh-webpack-plugin/lib/runtime/RefreshUtils.js\");\n__webpack_require__.$Refresh$.runtime = __webpack_require__(/*! ./node_modules/react-refresh/runtime.js */ \"./node_modules/react-refresh/runtime.js\");\n\n/**\n * Chain Taxonomy Definitions\n *\n * 5 classification systems for argument chains based on philosophical logic literature:\n * 1. Inferential Mode (Classical Logic - Aristotle/Mill/Peirce)\n * 2. Causal Structure (Philosophy of Causation - Salmon/Woodward/Machamer)\n * 3. Dialectical Function (Hegelian Logic - Hegel/Marx/Rose/Postone)\n * 4. Inferential Role (Normative Pragmatics - Sellars/Brandom)\n * 5. Argumentative Function (Argumentation Theory - Toulmin/Walton)\n */\n\n// Type for taxonomy value strings\n\n// Definition for a single taxonomy type value\n\n// Definition for a taxonomy category\n\n// Inferential Mode (Taxonomy 1)\nconst INFERENTIAL_MODE = {\n  id: 'inferential_mode',\n  name: 'Inferential Mode',\n  shortName: 'Mode',\n  description: 'How the conclusion follows from premises',\n  philosophicalBasis: 'Classical logic distinctions from Aristotle through Mill to Peirce',\n  theorists: ['Aristotle', 'John Stuart Mill', 'Charles Sanders Peirce'],\n  color: '#e63946',\n  types: {\n    deductive: {\n      label: 'Deductive',\n      shortLabel: 'Ded',\n      definition: 'Conclusion necessarily follows; if premises are true, conclusion MUST be true',\n      example: '\"If capitalism requires unemployment as discipline, and full employment removes this, then workers gain power\"',\n      color: '#e63946',\n      icon: '🔒'\n    },\n    inductive: {\n      label: 'Inductive',\n      shortLabel: 'Ind',\n      definition: 'Conclusion probably follows from accumulated evidence or repeated observations',\n      example: 'Historical cases of worker productivity → general claim about worker knowledge',\n      color: '#f4a261',\n      icon: '📊'\n    },\n    abductive: {\n      label: 'Abductive',\n      shortLabel: 'Abd',\n      definition: 'Inference to best explanation; \"what would explain this fact?\"',\n      example: '\"Work motivation is degraded\" → Best explanation: capitalist profit constraints',\n      color: '#2a9d8f',\n      icon: '💡'\n    },\n    analogical: {\n      label: 'Analogical',\n      shortLabel: 'Ana',\n      definition: 'Reasoning from structural similarity; \"A is to B as C is to D\"',\n      example: 'Comparing Technical Associations to professional guilds',\n      color: '#457b9d',\n      icon: '🔗'\n    }\n  }\n};\n\n// Causal Structure (Taxonomy 2)\nconst CAUSAL_STRUCTURE = {\n  id: 'causal_structure',\n  name: 'Causal Structure',\n  shortName: 'Causal',\n  description: 'What kind of causal explanation is offered',\n  philosophicalBasis: 'Philosophy of causation drawing on scientific explanation theory',\n  theorists: ['Wesley Salmon', 'James Woodward', 'Peter Machamer'],\n  color: '#457b9d',\n  types: {\n    mechanistic: {\n      label: 'Mechanistic',\n      shortLabel: 'Mech',\n      definition: 'Specifies HOW something works via constituent parts and activities',\n      example: '\"Profit constraint produces degraded work motivation via competition for jobs\"',\n      color: '#e63946',\n      icon: '⚙️'\n    },\n    counterfactual: {\n      label: 'Counterfactual',\n      shortLabel: 'CF',\n      definition: 'What would change if intervention occurred; \"if not X, then not Y\"',\n      example: '\"If capitalist constraints removed, workers could pursue meaningful goals\"',\n      color: '#f4a261',\n      icon: '🔀'\n    },\n    constitutive: {\n      label: 'Constitutive',\n      shortLabel: 'Const',\n      definition: 'Part-whole relations (not temporal); \"X is constituted by Y and Z\"',\n      example: '\"Post-capitalist economy is constituted by Technical Associations + democratic planning\"',\n      color: '#2a9d8f',\n      icon: '🧩'\n    },\n    teleological: {\n      label: 'Teleological',\n      shortLabel: 'Telo',\n      definition: 'Purpose-oriented; means-end reasoning; \"X in order to achieve Y\"',\n      example: '\"Work time reduction pursued in order to expand freedom realm\"',\n      color: '#457b9d',\n      icon: '🎯'\n    },\n    dispositional: {\n      label: 'Dispositional',\n      shortLabel: 'Disp',\n      definition: 'Capacities and their triggering conditions; \"X has power to Y when Z\"',\n      example: '\"Workers possess innovation knowledge that capitalism cannot mobilize\"',\n      color: '#9b59b6',\n      icon: '⚡'\n    }\n  }\n};\n\n// Dialectical Function (Taxonomy 3)\nconst DIALECTICAL_FUNCTION = {\n  id: 'dialectical_function',\n  name: 'Dialectical Function',\n  shortName: 'Dialectical',\n  description: 'Role in Hegelian dialectical movement',\n  philosophicalBasis: 'Hegel\\'s Science of Logic + Marxist critique tradition',\n  theorists: ['G.W.F. Hegel', 'Karl Marx', 'Gillian Rose', 'Moishe Postone'],\n  color: '#9b59b6',\n  types: {\n    thesis_establishing: {\n      label: 'Thesis-Establishing',\n      shortLabel: 'Thesis',\n      definition: 'Posits an initial position; affirmation',\n      example: '\"Work under capitalism is degraded\" (A1)',\n      color: '#e63946',\n      icon: '✓'\n    },\n    antithetical: {\n      label: 'Antithetical',\n      shortLabel: 'Anti',\n      definition: 'Negates or critiques a position; opposition',\n      example: '\"Work diversification undermines convergence assumption\" (A2)',\n      color: '#f4a261',\n      icon: '✗'\n    },\n    synthetic: {\n      label: 'Synthetic',\n      shortLabel: 'Synth',\n      definition: 'Sublates contradiction into higher unity (Aufhebung)',\n      example: '\"Multi-criterial optimization integrates quality + time reduction\"',\n      color: '#2a9d8f',\n      icon: '∞'\n    },\n    immanent_critique: {\n      label: 'Immanent Critique',\n      shortLabel: 'Imm',\n      definition: 'Shows internal contradictions within a position itself',\n      example: '\"Capitalism needs workers but systematically degrades them\"',\n      color: '#457b9d',\n      icon: '🔄'\n    },\n    determinate_negation: {\n      label: 'Determinate Negation',\n      shortLabel: 'Det',\n      definition: 'Specific negation that preserves positive content (not mere denial)',\n      example: '\"Not just \\'anti-capitalism\\' but specific post-capitalist form\"',\n      color: '#9b59b6',\n      icon: '⊖'\n    }\n  }\n};\n\n// Inferential Role (Taxonomy 4)\nconst INFERENTIAL_ROLE = {\n  id: 'inferential_role',\n  name: 'Inferential Role',\n  shortName: 'Inf. Role',\n  description: 'Type of inferential binding (Brandom/Sellars)',\n  philosophicalBasis: 'Sellars\\' material vs formal inference distinction; Brandom\\'s normative pragmatics',\n  theorists: ['Wilfrid Sellars', 'Robert Brandom'],\n  color: '#2a9d8f',\n  types: {\n    material: {\n      label: 'Material Inference',\n      shortLabel: 'Mat',\n      definition: 'Content-based inference; depends on meaning (e.g., \"rain\" to \"wet streets\")',\n      example: '\"Unemployment as discipline\" → \"worker insecurity\" (meaning-constitutive)',\n      color: '#e63946',\n      icon: '📖'\n    },\n    formal: {\n      label: 'Formal Inference',\n      shortLabel: 'Form',\n      definition: 'Structure-based inference; topic-neutral logical form (e.g., modus ponens)',\n      example: 'Any P→Q; P; ∴Q regardless of content',\n      color: '#f4a261',\n      icon: '📐'\n    },\n    modal: {\n      label: 'Modal Inference',\n      shortLabel: 'Mod',\n      definition: 'Necessity/possibility relations; what must or can be the case',\n      example: '\"Multi-criterial planning must include worker input\"',\n      color: '#2a9d8f',\n      icon: '◇'\n    },\n    normative: {\n      label: 'Normative Inference',\n      shortLabel: 'Norm',\n      definition: 'Ought-based practical reasoning; what should or ought to be done',\n      example: '\"Work should be professionalized across all types\"',\n      color: '#457b9d',\n      icon: '⚖️'\n    },\n    commissive: {\n      label: 'Commissive Inference',\n      shortLabel: 'Comm',\n      definition: 'Commitment-preserving; accepting X commits you to accepting Y',\n      example: 'Benanav\\'s commitment to X entails commitment to Y',\n      color: '#9b59b6',\n      icon: '🤝'\n    }\n  }\n};\n\n// Argumentative Function (Taxonomy 5)\nconst ARGUMENTATIVE_FUNCTION = {\n  id: 'argumentative_function',\n  name: 'Argumentative Function',\n  shortName: 'Function',\n  description: 'Role in building the overall argument (Toulmin/Walton)',\n  philosophicalBasis: 'Toulmin\\'s argumentation model + Walton\\'s argumentation schemes',\n  theorists: ['Stephen Toulmin', 'Douglas Walton'],\n  color: '#f4a261',\n  types: {\n    foundational: {\n      label: 'Foundational',\n      shortLabel: 'Found',\n      definition: 'Establishes ground-level claims; provides basic warrants',\n      example: '\"Labor is heterogeneous\" (basic claim supporting later arguments)',\n      color: '#e63946',\n      icon: '🏛️'\n    },\n    elaborative: {\n      label: 'Elaborative',\n      shortLabel: 'Elab',\n      definition: 'Draws out implications from established claims',\n      example: '\"If heterogeneous, then labor-time accounting fails\"',\n      color: '#f4a261',\n      icon: '📝'\n    },\n    defensive: {\n      label: 'Defensive',\n      shortLabel: 'Def',\n      definition: 'Responds to potential objections or rebuttals',\n      example: '\"Against efficiency objection: multi-criterial optimization...\"',\n      color: '#2a9d8f',\n      icon: '🛡️'\n    },\n    bridge: {\n      label: 'Bridge',\n      shortLabel: 'Brg',\n      definition: 'Connects disparate domains; cross-domain warrants',\n      example: 'Linking economic analysis to political prescription',\n      color: '#457b9d',\n      icon: '🌉'\n    },\n    culminative: {\n      label: 'Culminative',\n      shortLabel: 'Culm',\n      definition: 'Reaches ultimate conclusions; final claims',\n      example: '\"Post-capitalist society should pursue X, Y, Z\"',\n      color: '#9b59b6',\n 