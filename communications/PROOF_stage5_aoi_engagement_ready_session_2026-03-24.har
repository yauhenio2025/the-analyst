 {\n  display: block;\n}\n\n/* Taxonomy Description */\n.taxonomy-description {\n  padding: 0.75rem 1rem;\n  background: var(--bg-card);\n  border-left: 3px solid;\n  border-radius: var(--radius-sm);\n}\n\n.taxonomy-name {\n  font-weight: 600;\n  font-size: 1rem;\n  color: var(--text-primary);\n  margin-bottom: 0.25rem;\n}\n\n.taxonomy-basis {\n  font-size: 0.85rem;\n  color: var(--text-secondary);\n  margin-bottom: 0.25rem;\n}\n\n.taxonomy-theorists {\n  font-size: 0.75rem;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* Type Filter Bar */\n.type-filter-bar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  padding: 0.5rem;\n  background: var(--bg-elevated);\n  border-radius: var(--radius-sm);\n}\n\n.type-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.4rem 0.75rem;\n  background: var(--bg-dark);\n  border: 1px solid var(--border-color);\n  border-radius: 20px;\n  color: var(--text-secondary);\n  font-size: 0.75rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.type-chip:hover:not(:disabled) {\n  background: var(--chip-color-dim, var(--bg-card));\n  border-color: var(--chip-color, var(--border-color));\n  color: var(--chip-color, var(--text-primary));\n}\n\n.type-chip.active {\n  background: var(--chip-color-dim, var(--bg-card));\n  border-color: var(--chip-color, var(--accent-blue));\n  color: var(--chip-color, var(--accent-blue));\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n}\n\n.type-chip.all {\n  --chip-color: var(--accent-blue);\n  --chip-color-dim: rgba(69, 123, 157, 0.2);\n}\n\n.type-chip.unclassified {\n  --chip-color: var(--text-muted);\n  --chip-color-dim: rgba(90, 90, 112, 0.2);\n}\n\n.type-chip.empty {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.chip-icon {\n  font-size: 0.9rem;\n}\n\n.chip-label {\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n}\n\n.chip-count {\n  opacity: 0.7;\n  font-size: 0.7rem;\n}\n\n/* Chains Grid */\n.chains-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n/* Taxonomy Group */\n.taxonomy-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.group-header {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 0.75rem;\n  background: var(--bg-card);\n  border-left: 3px solid;\n  border-radius: var(--radius-sm);\n}\n\n.taxonomy-group.unclassified .group-header {\n  border-color: var(--text-muted);\n}\n\n.group-icon {\n  font-size: 1.1rem;\n}\n\n.group-name {\n  font-weight: 600;\n  font-size: 0.9rem;\n  color: var(--text-primary);\n}\n\n.group-count {\n  margin-left: auto;\n  font-size: 0.75rem;\n  color: var(--text-muted);\n  background: var(--bg-dark);\n  padding: 0.15rem 0.5rem;\n  border-radius: 10px;\n}\n\n.group-chains {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  padding-left: 1rem;\n}\n\n/* Chain Card */\n.taxonomy-chain-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-md);\n  padding: 1rem;\n  transition: all var(--transition-fast);\n}\n\n.taxonomy-chain-card:hover {\n  border-color: var(--accent-blue);\n  box-shadow: var(--shadow-soft);\n}\n\n.chain-card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n.chain-card-id {\n  font-weight: 700;\n  font-size: 0.95rem;\n  color: var(--accent-blue);\n}\n\n.chain-card-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n}\n\n.chain-card-sequence {\n  font-family: 'Fira Code', 'SF Mono', monospace;\n  font-size: 0.85rem;\n  color: var(--accent-gold);\n  background: var(--bg-dark);\n  padding: 0.5rem 0.75rem;\n  border-radius: var(--radius-sm);\n  margin-bottom: 0.75rem;\n}\n\n.chain-card-viz {\n  margin-bottom: 0.75rem;\n  padding: 0.5rem;\n  background: var(--bg-dark);\n  border-radius: var(--radius-sm);\n  overflow-x: auto;\n}\n\n.chain-card-conclusion {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n}\n\n.conclusion-label {\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--text-muted);\n}\n\n.conclusion-text {\n  font-size: 0.85rem;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n/* No chains message */\n.no-chains-message {\n  text-align: center;\n  padding: 2rem;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* Responsive adjustments */\n@media (max-width: 768px) {\n  .taxonomy-tab-bar {\n    gap: 0.15rem;\n  }\n\n  .taxonomy-tab {\n    padding: 0.5rem;\n    font-size: 0.65rem;\n    min-width: 60px;\n  }\n\n  .type-filter-bar {\n    gap: 0.35rem;\n  }\n\n  .type-chip {\n    padding: 0.3rem 0.5rem;\n    font-size: 0.7rem;\n  }\n\n  .group-chains {\n    padding-left: 0.5rem;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/ChainTaxonomyTabs.css\"],\"names\":[],\"mappings\":\"AAAA,4DAA4D;;AAE5D;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA,qBAAqB;AACrB;EACE,aAAa;EACb,YAAY;EACZ,gBAAgB;EAChB,0BAA0B;EAC1B,+BAA+B;EAC/B,gBAAgB;AAClB;;AAEA;EACE,SAAO;EACP,eAAe;EACf,uBAAuB;EACvB,uBAAuB;EACvB,YAAY;EACZ,+BAA+B;EAC/B,4BAA4B;EAC5B,kBAAkB;EAClB,gBAAgB;EAChB,yBAAyB;EACzB,sBAAsB;EACtB,eAAe;EACf,sCAAsC;EACtC,mBAAmB;AACrB;;AAEA;EACE,8BAA8B;EAC9B,0BAA0B;AAC5B;;AAEA;EACE,gCAAgC;EAChC,uBAAuB;EACvB,4CAA4C;AAC9C;;AAEA;EACE,cAAc;AAChB;;AAEA,yBAAyB;AACzB;EACE,qBAAqB;EACrB,0BAA0B;EAC1B,sBAAsB;EACtB,+BAA+B;AACjC;;AAEA;EACE,gBAAgB;EAChB,eAAe;EACf,0BAA0B;EAC1B,sBAAsB;AACxB;;AAEA;EACE,kBAAkB;EAClB,4BAA4B;EAC5B,sBAAsB;AACxB;;AAEA;EACE,kBAAkB;EAClB,wBAAwB;EACxB,kBAAkB;AACpB;;AAEA,oBAAoB;AACpB;EACE,aAAa;EACb,eAAe;EACf,WAAW;EACX,eAAe;EACf,8BAA8B;EAC9B,+BAA+B;AACjC;;AAEA;EACE,oBAAoB;EACpB,mBAAmB;EACnB,YAAY;EACZ,uBAAuB;EACvB,0BAA0B;EAC1B,qCAAqC;EACrC,mBAAmB;EACnB,4BAA4B;EAC5B,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,sCAAsC;AACxC;;AAEA;EACE,iDAAiD;EACjD,oDAAoD;EACpD,6CAA6C;AAC/C;;AAEA;EACE,iDAAiD;EACjD,mDAAmD;EACnD,4CAA4C;EAC5C,wCAAwC;AAC1C;;AAEA;EACE,gCAAgC;EACh