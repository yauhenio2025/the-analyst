EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;AAChB;;AAEA;EACE,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,SAAS;EACT,UAAU;AACZ;;AAEA;EACE,eAAe;EACf,cAAc;EACd,cAAc;EACd,mBAAmB;EACnB,gBAAgB;EAChB,uBAAuB;AACzB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,kBAAkB;EAClB,SAAS;AACX;;AAEA,eAAe;AACf;EACE,iBAAiB;EACjB,mCAAmC;EACnC,mBAAmB;EACnB,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA,mBAAmB;AACnB;EACE,gBAAgB;EAChB,SAAS;EACT,UAAU;AACZ;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,eAAe;EACf,gCAAgC;AAClC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA,qBAAqB;AACrB;EACE,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,SAAS;EACT,aAAa;EACb,gBAAgB;EAChB,iCAAiC;EACjC,mBAAmB;EACnB,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,yBAAyB;EACzB,yBAAyB;EACzB,kBAAkB;EAClB,oCAAoC;AACtC;;AAEA;EACE;IACE,yBAAyB;EAC3B;AACF;;AAEA,0DAA0D;AAC1D;EACE,gBAAgB;EAChB,kBAAkB;EAClB,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,SAAS;EACT,UAAU;AACZ;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,gBAAgB;EAChB,iDAAiD;EACjD,kBAAkB;EAClB,iCAAiC;AACnC;;AAEA;EACE,mCAAmC;AACrC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,eAAe;EACf,YAAY;EACZ,WAAW;EACX,YAAY;EACZ,cAAc;EACd,cAAc;EACd,kDAAkD;AACpD;;AAEA;EACE,sBAAsB;EACtB,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,WAAW;EACX,YAAY;AACd;;AAEA;EACE,SAAO;EACP,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,uBAAuB;EACvB,mBAAmB;AACrB;;AAEA;EACE,iBAAiB;EACjB,mBAAmB;EACnB,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,6BAA6B;EAC7B,eAAe;EACf,0BAA0B;AAC5B;;AAEA;EACE,mBAAmB;EACnB,YAAY;AACd;;AAEA;EACE,mCAAmC;EACnC,cAAc;EACd,oCAAoC;AACtC;;AAEA;EACE,qCAAqC;EACrC,cAAc;EACd,sCAAsC;AACxC;;AAEA;EACE,qCAAqC;EACrC,cAAc;EACd,sCAAsC;AACxC;;AAEA;EACE,mCAAmC;EACnC,cAAc;EACd,oCAAoC;AACtC;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,gBAAgB;EAChB,kBAAkB;EAClB,mCAAmC;EACnC,yCAAyC;EACzC,kBAAkB;AACpB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA,2CAA2C;AAC3C;EACE,iBAAiB;EACjB,mBAAmB;EACnB,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA,mCAAmC;;AAEnC;EACE,iDAAiD;AACnD;;AAEA;EACE,mBAAmB;AACrB;;AAEA,+DAA+D;AAC/D;EACE,mBAAmB;AACrB;;AAEA,uCAAuC;AACvC;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,gBAAgB;EAChB,6BAA6B;EAC7B,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,cAAc;EACd,cAAc;EACd,0BAA0B;AAC5B;;AAEA;EACE,oCAAoC;EACpC,qCAAqC;EACrC,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,sCAAsC;AACxC;;AAEA;EACE,WAAW;EACX,YAAY;AACd;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,mBAAmB;EACnB,YAAY;EACZ,mBAAmB;EACnB,eAAe;EACf,YAAY;EACZ,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,cAAc;AAChB;;AAEA,qDAAqD;AACrD;EACE,eAAe;EACf,4BAA4B;EAC5B,oCAAoC;EACpC,6CAA6C;AAC/C;;AAEA;EACE,aAAa;EACb,qBAAqB;EACrB,SAAS;EACT,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,yBAAyB;EACzB,qBAAqB;EACrB,aAAa;EACb,mBAAmB;EACnB,QAAQ;AACV;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,mBAAmB;EACnB,YAAY;EACZ,mBAAmB;EACnB,eAAe;EACf,YAAY;EACZ,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA,sBAAsB;AACtB;EACE,gBAAgB;EAChB,gBAAgB;EAChB,UAAU;AACZ;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,gBAAgB;EAChB,kBAAkB;EAClB,gCAAgC;AAClC;;AAEA;EACE,oCAAoC;AACtC;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,cAAc;EACd,cAAc;AAChB;;AAEA;EACE,SAAO;EACP,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,uBAAuB;EACvB,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,cAAc;AAChB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,eAAe;EACf,YAAY;EACZ,WAAW;EACX,YAAY;EACZ,cAAc;EACd,cAAc;EACd,kBAAkB;EAClB,yBAAyB;EACzB,UAAU;AACZ;;AAEA;EACE,UAAU;AACZ;;AAEA;EACE,cAAc;EACd,kCAAkC;AACpC;;AAEA;EACE,WAAW;EACX,YAAY;AACd;;AAEA,gCAAgC;AAChC;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,2CAA2C;EAC3C,kBAAkB;EAClB,eAAe;EACf,cAAc;EACd,eAAe;EACf,0BAA0B;AAC5B;;AAEA;EACE,qBAAqB;EACrB,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,qBAAqB;EACrB,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,cAAc;AAChB;;AAEA,iCAAiC;AACjC;EACE,gBAAgB;AAClB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,gBAAgB;EAChB,gBAAgB;AAClB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,kBAAkB;EAClB,gBAAgB;EAChB,2CAA2C;EAC3C,kBAAkB;EAClB,eAAe;EACf,cAAc;EACd,eAAe;EACf,0BAA0B;EAC1B,WAAW;AACb;;AAEA;EACE,qBAAqB;EACrB,oCAAoC;EACpC,cAAc;AAChB;;AAEA;EACE,WAAW;EACX,YAAY;AACd\",\"sourcesContent\":[\"/* Shared styles for wizard step components */\\n\\n.wizard-step-content {\\n  max-width: 800px;\\n  margin: 0 auto;\\n}\\n\\n.step-intro {\\n  margin-bottom: 32px;\\n}\\n\\n.step-intro h2 {\\n  font-size: 28px;\\n  font-weight: 700;\\n  color: #1a1a1a;\\n  margin: 0 0 12px;\\n}\\n\\n.step-intro p {\\n  font-size: 16px;\\n  color: #94a3b8;\\n  margin: 0;\\n  line-height: 1.6;\\n}\\n\\n/* Form Elements */\\n.form-row {\\n  display: grid;\\n  grid-template-columns: 1fr 1fr;\\n  gap: 20px;\\n}\\n\\n@media (max-width: 600px) {\\n  .form-row {\\n    grid-template-columns: 1fr;\\n  }\\n}\\n\\n.form-group {\\n  margin-bottom: 20px;\\n}\\n\\n.form-group label {\\n  display: block;\\n  font-size: 14px;\\n  font-weight: 500;\\n  color: #4a4a4a;\\n  margin-bottom: 8px;\\n}\\n\\n.form-group label .required {\\n  color: #f87171;\\n  margin-left: 2px;\\n}\\n\\n.form-group input,\\n.form-group textarea {\\n  width: 100%;\\n  padding: 12px 16px;\\n  background: #faf8f5;\\n  border: 1px solid #757575;\\n  border-radius: 8px;\\n  color: #1a1a1a;\\n  font-size: 15px;\\n  transition: border-color 0.15s ease, box-shadow 0.15s ease;\\n}\\n\\n.form-group input:focus,\\n.form-group textarea:focus {\\n  outline: none;\\n  border-color: #b5343a;\\n  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);\\n}\\n\\n.form-group input.error,\\n.form-group textarea.error {\\n  border-color: #ef4444;\\n}\\n\\n.form-group input::placeholder,\\n.form-group textarea::placeholder {\\n  color: #64748b;\\n}\\n\\n.field-hint {\\n  display: block;\\n  margin-top: 6px;\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n.error-message {\\n  display: block;\\n  margin-top: 6px;\\n  font-size: 12px;\\n  color: #ef4444;\\n}\\n\\n/* Info Callout */\\n.info-callout {\\n  display: flex;\\n  gap: 14px;\\n  padding: 16px 20px;\\n  background: rgba(59, 130, 246, 0.08);\\n  border: 1px solid rgba(59, 130, 246, 0.2);\\n  border-radius: 10px;\\n  margin-bottom: 24px;\\n}\\n\\n.callout-icon {\\n  width: 22px;\\n  height: 22px;\\n  flex-shrink: 0;\\n  color: #b5343a;\\n}\\n\\n.callout-icon svg {\\n  width: 100%;\\n  height: 100%;\\n}\\n\\n.callout-content {\\n  font-size: 14px;\\n  color: #94a3b8;\\n  line-height: 1.5;\\n}\\n\\n.callout-content strong {\\n  color: #b5343a;\\n}\\n\\n/* Step Error */\\n.step-error {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 14px 18px;\\n  background: rgba(239, 68, 68, 0.1);\\n  border: 1px solid rgba(239, 68, 68, 0.3);\\n  border-radius: 8px;\\n  color: #ef4444;\\n  font-size: 14px;\\n  margin-top: 16px;\\n}\\n\\n.step-error svg {\\n  width: 20px;\\n  height: 20px;\\n  flex-shrink: 0;\\n}\\n\\n/* Document Sections (Additional Docs Step) */\\n.docs-section {\\n  margin-bottom: 32px;\\n  padding-bottom: 32px;\\n  border-bottom: 1px solid #757575;\\n}\\n\\n.docs-section:last-of-type {\\n  border-bottom: none;\\n}\\n\\n.section-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  margin-bottom: 8px;\\n}\\n\\n.section-header h3 {\\n  font-size: 18px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  margin: 0;\\n}\\n\\n.optional-badge {\\n  padding: 3px 10px;\\n  background: rgba(148, 163, 184, 0.15);\\n  border-radius: 20px;\\n  font-size: 12px;\\n  font-weight: 500;\\n  color: #94a3b8;\\n}\\n\\n.section-description {\\n  font-size: 14px;\\n  color: #64748b;\\n  margin: 0 0 16px;\\n  line-height: 1.5;\\n}\\n\\n.engagement-info-banner {\\n  padding: 12px 16px;\\n  background: rgba(59, 130, 246, 0.06);\\n  border: 1px solid rgba(59, 130, 246, 0.15);\\n  border-radius: 8px;\\n  font-size: 13px;\\n  color: #94a3b8;\\n  line-height: 1.6;\\n  margin-bottom: 24px;\\n}\\n\\n.engagement-info-banner strong {\\n  color: #cbd5e1;\\n}\\n\\n.skip-hint {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 14px 18px;\\n  background: #faf8f5;\\n  border-radius: 8px;\\n  font-size: 13px;\\n  color: #64748b;\\n  margin-top: 8px;\\n}\\n\\n.skip-hint svg {\\n  width: 16px;\\n  height: 16px;\\n  flex-shrink: 0;\\n}\\n\\n/* Review Step Grid */\\n.review-grid {\\n  display: grid;\\n  grid-template-columns: repeat(2, 1fr);\\n  gap: 20px;\\n}\\n\\n@media (max-width: 700px) {\\n  .review-grid {\\n    grid-template-columns: 1fr;\\n  }\\n}\\n\\n.review-card {\\n  background: #faf8f5;\\n  border: 1px solid #757575;\\n  border-radius: 12px;\\n  overflow: hidden;\\n}\\n\\n.review-card.full-width {\\n  grid-column: 1 / -1;\\n}\\n\\n.review-card .card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 14px 18px;\\n  background: #faf8f5;\\n  border-bottom: 1px solid #757575;\\n}\\n\\n.review-card .card-header h3 {\\n  font-size: 15px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n  margin: 0;\\n}\\n\\n.review-card .card-content {\\n  padding: 16px 18px;\\n}\\n\\n.detail-row {\\n  display: flex;\\n  gap: 12px;\\n  margin-bottom: 10px;\\n}\\n\\n.detail-row:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.detail-label {\\n  font-size: 13px;\\n  color: #64748b;\\n  flex-shrink: 0;\\n  min-width: 100px;\\n}\\n\\n.detail-value {\\n  font-size: 14px;\\n  color: #4a4a4a;\\n}\\n\\n.detail-value.mono {\\n  font-family: 'Monaco', 'Menlo', monospace;\\n  font-size: 13px;\\n  color: #94a3b8;\\n}\\n\\n/* Document Summary */\\n.doc-summary {\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n.doc-group {\\n  margin-bottom: 16px;\\n}\\n\\n.doc-group:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.doc-group-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 8px;\\n}\\n\\n.doc-type {\\n  padding: 3px 10px;\\n  border-radius: 4px;\\n  font-size: 12px;\\n  font-weight: 500;\\n}\\n\\n.doc-type.subject {\\n  background: rgba(59, 130, 246, 0.15);\\n  color: #b5343a;\\n}\\n\\n.doc-type.critique {\\n  background: rgba(249, 115, 22, 0.15);\\n  color: #fb923c;\\n}\\n\\n.doc-type.response {\\n  background: rgba(34, 197, 94, 0.15);\\n  color: #4ade80;\\n}\\n\\n.doc-type.counter-response {\\n  background: rgba(139, 92, 246, 0.15);\\n  color: #a78bfa;\\n}\\n\\n.doc-count {\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n.doc-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n.doc-list li {\\n  font-size: 13px;\\n  color: #94a3b8;\\n  padding: 4px 0;\\n  white-space: nowrap;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n}\\n\\n.no-docs {\\n  font-size: 13px;\\n  color: #475569;\\n  font-style: italic;\\n  margin: 0;\\n}\\n\\n/* Auto Badge */\\n.auto-badge {\\n  padding: 3px 10px;\\n  background: rgba(34, 197, 94, 0.15);\\n  border-radius: 20px;\\n  font-size: 11px;\\n  font-weight: 500;\\n  color: #4ade80;\\n}\\n\\n/* Framework List */\\n.framework-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n.framework-list li {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 10px 0;\\n  border-bottom: 1px solid #757575;\\n}\\n\\n.framework-list li:last-child {\\n  border-bottom: none;\\n}\\n\\n.framework-name {\\n  font-size: 14px;\\n  font-weight: 500;\\n  color: #4a4a4a;\\n}\\n\\n.framework-desc {\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n/* Creating Overlay */\\n.creating-overlay {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  gap: 16px;\\n  padding: 40px;\\n  margin-top: 24px;\\n  background: rgba(15, 23, 42, 0.8);\\n  border-radius: 12px;\\n  color: #94a3b8;\\n  font-size: 15px;\\n}\\n\\n.creating-spinner {\\n  width: 40px;\\n  height: 40px;\\n  border: 3px solid #757575;\\n  border-top-color: #b5343a;\\n  border-radius: 50%;\\n  animation: spin 0.8s linear infinite;\\n}\\n\\n@keyframes spin {\\n  to {\\n    transform: rotate(360deg);\\n  }\\n}\\n\\n/* Primary/Background Toggle Section (Subject Docs Step) */\\n.primary-toggle-section {\\n  margin-top: 20px;\\n  padding: 16px 20px;\\n  background: #faf8f5;\\n  border: 1px solid #757575;\\n  border-radius: 10px;\\n}\\n\\n.primary-toggle-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 12px;\\n}\\n\\n.primary-toggle-label {\\n  font-size: 14px;\\n  font-weight: 600;\\n  color: #1a1a1a;\\n}\\n\\n.primary-count {\\n  font-size: 12px;\\n  color: #64748b;\\n}\\n\\n.primary-toggle-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n.primary-toggle-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  padding: 8px 6px;\\n  border-bottom: 1px solid rgba(117, 117, 117, 0.3);\\n  border-radius: 6px;\\n  transition: background 0.15s ease;\\n}\\n\\n.primary-toggle-item:hover {\\n  background: rgba(234, 179, 8, 0.04);\\n}\\n\\n.primary-toggle-item:last-child {\\n  border-bottom: none;\\n}\\n\\n.primary-star-btn {\\n  background: none;\\n  border: none;\\n  cursor: pointer;\\n  padding: 4px;\\n  width: 28px;\\n  height: 28px;\\n  flex-shrink: 0;\\n  color: #94a3b8;\\n  transition: color 0.15s ease, transform 0.15s ease;\\n}\\n\\n.primary-star-btn:hover:not(:disabled) {\\n  transform: scale(1.15);\\n  color: #ca8a04;\\n}\\n\\n.primary-star-btn.active {\\n  color: #eab308;\\n}\\n\\n.primary-star-btn.active:hover:not(:disabled) {\\n  color: #94a3b8;\\n}\\n\\n.primary-star-btn:disabled {\\n  opacity: 0.4;\\n  cursor: not-allowed;\\n}\\n\\n.primary-star-btn svg {\\n  width: 100%;\\n  height: 100%;\\n}\\n\\n.primary-file-name {\\n  flex: 1;\\n  font-size: 14px;\\n  color: #4a4a4a;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.primary-badge-btn {\\n  padding: 4px 12px;\\n  border-radius: 20px;\\n  font-size: 11px;\\n  font-weight: 500;\\n  flex-shrink: 0;\\n  border: 1px solid transparent;\\n  cursor: pointer;\\n  transition: all 0.15s ease;\\n}\\n\\n.primary-badge-btn:disabled {\\n  cursor: not-allowed;\\n  opacity: 0.6;\\n}\\n\\n.primary-badge-btn.badge-primary {\\n  background: rgba(234, 179, 8, 0.15);\\n  color: #eab308;\\n  border-color: rgba(234, 179, 8, 0.3);\\n}\\n\\n.primary-badge-btn.badge-primary:hover:not(:disabled) {\\n  background: rgba(148, 163, 184, 0.15);\\n  color: #94a3b8;\\n  border-color: rgba(148, 163, 184, 0.3);\\n}\\n\\n.primary-badge-btn.badge-background {\\n  background: rgba(148, 163, 184, 0.15);\\n  color: #94a3b8;\\n  border-color: rgba(148, 163, 184, 0.3);\\n}\\n\\n.primary-badge-btn.badge-background:hover:not(:disabled) {\\n  background: rgba(234, 179, 8, 0.15);\\n  color: #eab308;\\n  border-color: rgba(234, 179, 8, 0.3);\\n}\\n\\n.primary-toggle-instruction {\\n  font-size: 13px;\\n  color: #64748b;\\n  line-height: 1.5;\\n  margin: 0 0 12px;\\n  padding: 10px 14px;\\n  background: rgba(234, 179, 8, 0.06);\\n  border: 1px solid rgba(234, 179, 8, 0.15);\\n  border-radius: 8px;\\n}\\n\\n.primary-toggle-instruction strong {\\n  color: #ca8a04;\\n}\\n\\n.primary-toggle-instruction .primary-warning {\\n  color: #ef4444;\\n}\\n\\n.primary-hint {\\n  color: #eab308;\\n}\\n\\n/* Keep old .primary-badge for ReviewStep */\\n.primary-badge {\\n  padding: 3px 10px;\\n  border-radius: 20px;\\n  font-size: 11px;\\n  font-weight: 500;\\n  flex-shrink: 0;\\n}\\n\\n/* === Chapter Upload Section === */\\n\\n.primary-toggle-item-wrapper {\\n  border-bottom: 1px solid rgba(117, 117, 117, 0.3);\\n}\\n\\n.primary-toggle-item-wrapper:last-child {\\n  border-bottom: none;\\n}\\n\\n/* Remove border from the inner item since wrapper handles it */\\n.primary-toggle-item-wrapper .primary-toggle-item {\\n  border-bottom: none;\\n}\\n\\n/* Chapters toggle button (book icon) */\\n.chapters-toggle-btn {\\n  display: flex;\\n  align-items: center;\\n  gap: 4px;\\n  background: none;\\n  border: 1px solid transparent;\\n  border-radius: 6px;\\n  padding: 4px 8px;\\n  cursor: pointer;\\n  color: #94a3b8;\\n  flex-shrink: 0;\\n  transition: all 0.15s ease;\\n}\\n\\n.chapters-toggle-btn:hover {\\n  background: rgba(59, 130, 246, 0.08);\\n  border-color: rgba(59, 130, 246, 0.2);\\n  color: #64748b;\\n}\\n\\n.chapters-toggle-btn.has-chapters {\\n  color: #3b82f6;\\n}\\n\\n.chapters-toggle-btn.expanded {\\n  background: rgba(59, 130, 246, 0.1);\\n  border-color: rgba(59, 130, 246, 0.25);\\n}\\n\\n.chapters-icon {\\n  width: 16px;\\n  height: 16px;\\n}\\n\\n.chapters-count-badge {\\n  font-size: 10px;\\n  font-weight: 600;\\n  background: #3b82f6;\\n  color: white;\\n  border-radius: 10px;\\n  min-width: 16px;\\n  height: 16px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  padding: 0 4px;\\n}\\n\\n/* Chapters section (expanded under a document row) */\\n.chapters-section {\\n  margin: 0 0 8px;\\n  padding: 12px 16px 12px 44px;\\n  background: rgba(59, 130, 246, 0.03);\\n  border-top: 1px solid rgba(59, 130, 246, 0.1);\\n}\\n\\n.chapters-section-header {\\n  display: flex;\\n  align-items: baseline;\\n  gap: 12px;\\n  margin-bottom: 10px;\\n}\\n\\n.chapters-section-title {\\n  font-size: 12px;\\n  font-weight: 600;\\n  color: #4a4a4a;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  display: flex;\\n  align-items: center;\\n  gap: 6px;\\n}\\n\\n.chapters-section-count {\\n  font-size: 10px;\\n  font-weight: 600;\\n  background: #3b82f6;\\n  color: white;\\n  border-radius: 10px;\\n  min-width: 16px;\\n  height: 16px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  padding: 0 4px;\\n}\\n\\n.chapters-section-hint {\\n  font-size: 12px;\\n  color: #94a3b8;\\n}\\n\\n/* Chapter file list */\\n.chapters-file-list {\\n  list-style: none;\\n  margin: 0 0 10px;\\n  padding: 0;\\n}\\n\\n.chapter-file-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 6px 8px;\\n  border-radius: 6px;\\n  transition: background 0.1s ease;\\n}\\n\\n.chapter-file-item:hover {\\n  background: rgba(59, 130, 246, 0.06);\\n}\\n\\n.chapter-file-icon {\\n  width: 14px;\\n  height: 14px;\\n  color: #94a3b8;\\n  flex-shrink: 0;\\n}\\n\\n.chapter-file-name {\\n  flex: 1;\\n  font-size: 13px;\\n  color: #4a4a4a;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n}\\n\\n.chapter-file-size {\\n  font-size: 11px;\\n  color: #94a3b8;\\n  flex-shrink: 0;\\n}\\n\\n.chapter-remove-btn {\\n  background: none;\\n  border: none;\\n  cursor: pointer;\\n  padding: 2px;\\n  width: 20px;\\n  height: 20px;\\n  color: #94a3b8;\\n  flex-shrink: 0;\\n  border-radius: 4px;\\n  transition: all 0.1s ease;\\n  opacity: 0;\\n}\\n\\n.chapter-file-item:hover .chapter-remove-btn {\\n  opacity: 1;\\n}\\n\\n.chapter-remove-btn:hover {\\n  color: #ef4444;\\n  background: rgba(239, 68, 68, 0.1);\\n}\\n\\n.chapter-remove-btn svg {\\n  width: 100%;\\n  height: 100%;\\n}\\n\\n/* Mini drop zone for chapters */\\n.chapters-dropzone {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 8px 14px;\\n  border: 1px dashed rgba(117, 117, 117, 0.4);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  color: #94a3b8;\\n  font-size: 12px;\\n  transition: all 0.15s ease;\\n}\\n\\n.chapters-dropzone:hover {\\n  border-color: #3b82f6;\\n  background: rgba(59, 130, 246, 0.04);\\n  color: #64748b;\\n}\\n\\n.chapters-dropzone.dragging {\\n  border-color: #3b82f6;\\n  background: rgba(59, 130, 246, 0.08);\\n  color: #3b82f6;\\n}\\n\\n.chapters-dropzone-icon {\\n  width: 14px;\\n  height: 14px;\\n  flex-shrink: 0;\\n}\\n\\n/* Single-file chapters section */\\n.single-file-chapters {\\n  margin-top: 16px;\\n}\\n\\n.chapters-single-hint {\\n  font-size: 13px;\\n  color: #64748b;\\n  line-height: 1.5;\\n  margin: 0 0 12px;\\n}\\n\\n.chapters-single-hint strong {\\n  color: #4a4a4a;\\n}\\n\\n.chapters-add-btn {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 10px 16px;\\n  background: none;\\n  border: 1px dashed rgba(117, 117, 117, 0.4);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  color: #94a3b8;\\n  font-size: 13px;\\n  transition: all 0.15s ease;\\n  width: 100%;\\n}\\n\\n.chapters-add-btn:hover {\\n  border-color: #3b82f6;\\n  background: rgba(59, 130, 246, 0.04);\\n  color: #64748b;\\n}\\n\\n.chapters-add-btn svg {\\n  width: 16px;\\n  height: 16px;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/index.css\"\n/*!******************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/index.css ***!\n  \\******************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony imp