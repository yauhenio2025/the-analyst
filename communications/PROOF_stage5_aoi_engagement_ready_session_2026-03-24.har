r-mix(in srgb, var(--color-success-bg, #ecfdf3) 78%, white 22%);\n  color: var(--color-success-text, #166534);\n}\n\n.presentation-summary-card__meta {\n  background: color-mix(in srgb, var(--color-surface-alt) 84%, white 16%);\n  color: var(--color-text-muted);\n}\n\n.presentation-summary-card__meta--style-state {\n  background: color-mix(in srgb, var(--color-info-bg, #dbeafe) 78%, white 22%);\n  color: var(--color-info-text, #1d4ed8);\n}\n\n.presentation-summary-card__meta--manual {\n  background: color-mix(in srgb, var(--color-warning-bg, #fef3c7) 74%, white 26%);\n  color: var(--color-warning-text, #a16207);\n}\n\n.presentation-summary-card__lede {\n  margin: 0;\n  max-width: 78ch;\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: 0.94rem;\n  line-height: 1.72;\n}\n\n.presentation-summary-card__body {\n  margin-top: 12px;\n  max-width: 76ch;\n}\n\n.presentation-summary-card__body p,\n.presentation-summary-card__note p {\n  margin: 0 0 10px 0;\n  color: var(--color-text-muted);\n  font-family: var(--font-body);\n  font-size: 0.84rem;\n  line-height: 1.68;\n}\n\n.presentation-summary-card__note {\n  margin-top: 14px;\n  padding-top: 12px;\n  border-top: 1px solid color-mix(in srgb, var(--color-border-light) 84%, white 16%);\n}\n\n.presentation-summary-card__note-label {\n  display: inline-block;\n  margin-bottom: 6px;\n  color: var(--color-text-faint);\n  font-size: 0.68rem;\n  font-family: var(--font-sans);\n  font-weight: var(--weight-semibold);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.presentation-summary-card__toggle {\n  margin-top: 12px;\n  padding: 0;\n  border: none;\n  background: none;\n  color: var(--color-accent);\n  font-size: 0.78rem;\n  font-family: var(--font-sans);\n  font-weight: var(--weight-semibold);\n  cursor: pointer;\n}\n\n.presentation-summary-card__toggle:hover {\n  color: var(--color-accent-hover);\n  text-decoration: underline;\n}\n\n.presentation-summary-card__stats {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  align-content: start;\n}\n\n.presentation-summary-card__stat {\n  padding: 12px 10px;\n  border-radius: var(--radius-sm);\n  background: color-mix(in srgb, var(--color-surface-alt) 78%, white 22%);\n  border: 1px solid color-mix(in srgb, var(--color-border-light) 86%, white 14%);\n}\n\n.presentation-summary-card__stat--warning {\n  background: color-mix(in srgb, var(--color-warning-bg, #fef3c7) 72%, white 28%);\n  border-color: color-mix(in srgb, var(--color-warning-text, #b45309) 28%, white 72%);\n}\n\n.presentation-summary-card__stat-value {\n  display: block;\n  margin-bottom: 2px;\n  color: var(--color-text);\n  font-size: 1rem;\n  font-family: var(--font-sans);\n  font-weight: var(--weight-bold);\n}\n\n.presentation-summary-card__stat-label {\n  display: block;\n  color: var(--color-text-faint);\n  font-size: 0.7rem;\n  font-family: var(--font-sans);\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n}\n\n@media (max-width: 980px) {\n  .presentation-summary-card {\n    grid-template-columns: 1fr;\n  }\n\n  .presentation-summary-card__stats {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 640px) {\n  .presentation-summary-card {\n    padding: 15px 16px;\n  }\n\n  .presentation-summary-card__stats {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .presentation-summary-card__lede {\n    font-size: 0.9rem;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/PresentationSummaryCard.css\"],\"names\":[],\"mappings\":\"AAAA;EACE,aAAa;EACb,6DAA6D;EAC7D,SAAS;EACT,kBAAkB;EAClB,8BAA8B;EAC9B;;uHAEqH;EACrH,wEAAwE;EACxE,0CAA0C;EAC1C,+BAA+B;EAC/B,4BAA4B;AAC9B;;AAEA;EACE,YAAY;AACd;;AAEA;EACE,aAAa;EACb,eAAe;EACf,mBAAmB;EACnB,QAAQ;EACR,mBAAmB;AACrB;;AAEA;;;EAGE,oBAAoB;EACpB,mBAAmB;EACnB,uBAAuB;EACvB,gBAAgB;EAChB,gBAAgB;EAChB,oBAAoB;EACpB,kBAAkB;EAClB,6BAA6B;EAC7B,mCAAmC;EACnC,sBAAsB;EACtB,yBAAyB;AAC3B;;AAEA;EACE,qEAAqE;EACrE,0BA