  concession: '#22c55e',\n  retreat: '#3b82f6',\n  cherrypick: '#ec4899',\n  tuquoque: '#14b8a6',\n  namedrop: '#f97316',\n  // Vulnerability streams\n  strawman_risk: '#ef4444',\n  inconsistency: '#f97316',\n  logic_gap: '#eab308',\n  unanswered: '#84cc16',\n  overconcession: '#22c55e',\n  overreach: '#14b8a6',\n  undercitation: '#06b6d4',\n  weak_authority: '#3b82f6',\n  exposed_flank: '#8b5cf6',\n  // Genealogy-sourced streams\n  genealogy_ammunition: '#d97706',\n  genealogy_revision: '#0891b2'\n};\n\n// Check if stream is a vulnerability type\nconst VULNERABILITY_STREAMS = ['strawman_risk', 'inconsistency', 'logic_gap', 'unanswered', 'overconcession', 'overreach', 'undercitation', 'weak_authority', 'exposed_flank'];\n\n// Rhetoric streams (Benanav's weaknesses)\nconst RHETORIC_STREAMS = ['deflection', 'contradiction', 'silence', 'leap', 'concession', 'retreat', 'cherrypick', 'tuquoque', 'namedrop'];\nconst GENEALOGY_ARSENAL_STREAMS = ['genealogy_ammunition', 'genealogy_revision'];\nconst isVulnerabilityStream = stream => VULNERABILITY_STREAMS.includes(stream);\nconst isRhetoricStream = stream => RHETORIC_STREAMS.includes(stream);\nconst isGenealogyStream = stream => GENEALOGY_ARSENAL_STREAMS.includes(stream);\n\n// Helper to extract last name from full name\nconst getLastName = fullName => fullName.split(' ').pop() || fullName;\n\n// Arsenal group types\n\n// Resolve a field from finding data, trying multiple naming conventions.\n// Analysis prompts may use generic prefixes (subject_*, critique_*) or actual author names (benanav_*, morozov_*).\nconst resolveField = (f, ...fieldNames) => {\n  for (const name of fieldNames) {\n    if (f[name]) return f[name];\n  }\n  return '';\n};\n\n// Get flaw/counter text for ammunition (rhetoric) findings\nconst getAmmunitionTexts = (stream, f, subjectName, subjectAuthor, critiqueAuthor) => {\n  var _subjectAuthor$split$, _critiqueAuthor$split;\n  // Build possible field prefixes from author names (e.g., \"benanav\", \"morozov\")\n  const subjectPrefix = (subjectAuthor === null || subjectAuthor === void 0 ? void 0 : (_subjectAuthor$split$ = subjectAuthor.split(' ').pop()) === null || _subjectAuthor$split$ === void 0 ? void 0 : _subjectAuthor$split$.toLowerCase()) || '';\n  const critiquePrefix = (critiqueAuthor === null || critiqueAuthor === void 0 ? void 0 : (_critiqueAuthor$split = critiqueAuthor.split(' ').pop()) === null || _critiqueAuthor$split === void 0 ? void 0 : _critiqueAuthor$split.toLowerCase()) || '';\n  switch (stream) {\n    case 'deflection':\n      return {\n        flaw: resolveField(f, 'subject_complaint', `${subjectPrefix}_complaint`),\n        counter: resolveField(f, 'critique_addresses', `${critiquePrefix}_addresses`, 'morozov_addresses'),\n        flawLabel: `${subjectName} Claims You Misunderstand`,\n        counterLabel: 'But You Actually Wrote'\n      };\n    case 'contradiction':\n      return {\n        flaw: f.original_essay_text,\n        counter: resolveField(f, 'subject_response_claim', `${subjectPrefix}_response_claim`),\n        flawLabel: 'In His Original Essay',\n        counterLabel: 'But Now He Claims'\n      };\n    case 'silence':\n      return {\n        flaw: resolveField(f, 'morozov_challenge', `${critiquePrefix}_challenge`, 'critique_challenge'),\n        counter: resolveField(f, 'subject_response_gap', `${subjectPrefix}_response_gap`) || 'No direct response provided',\n        flawLabel: 'Your Challenge',\n        counterLabel: 'His Non-Answer'\n      };\n    case 'leap':\n      return {\n        flaw: resolveField(f, 'subject_claim', `${subjectPrefix}_claim`),\n        counter: resolveField(f, 'what_morozov_actually_argues', `what_${critiquePrefix}_actually_argues`, 'what_critique_actually_argues'),\n        flawLabel: `${subjectName} Claims You Said`,\n        counterLabel: 'What You Actually Argued'\n      };\n    case 'concession':\n      return {\n        flaw: resolveField(f, 'morozov_critique', `${critiquePrefix}_critique`, 'critique_