 for v1 findings\nconst generateV1Markdown = (thinkerName, sinType, findings, subjectName = 'the author') => {\n  const sinMeta = _types__WEBPACK_IMPORTED_MODULE_7__.SIN_TYPE_META[sinType];\n  const lines = [];\n  lines.push(`# ${sinMeta.label} Analysis: ${thinkerName}`);\n  lines.push('');\n  lines.push(`**Sin Type:** ${sinMeta.label}`);\n  lines.push(`**Description:** ${sinMeta.description}`);\n  lines.push(`**Total Findings:** ${findings.length}`);\n  lines.push(`**Generated:** ${new Date().toLocaleString()}`);\n  lines.push('');\n  lines.push('---');\n  lines.push('');\n  findings.forEach((finding, idx) => {\n    lines.push(`## Finding ${idx + 1}: ${finding.title || 'Untitled'}`);\n    lines.push('');\n    lines.push(`**Severity:** ${finding.severity.toUpperCase()}`);\n    lines.push('');\n    if (finding.description) {\n      lines.push('### Analysis');\n      lines.push(finding.description);\n      lines.push('');\n    }\n    if (finding.subject_quote) {\n      lines.push(`### ${subjectName} Quote`);\n      lines.push(`> ${finding.subject_quote}`);\n      if (finding.subject_source) {\n        lines.push(`> — *${finding.subject_source}${finding.subject_page ? `, p. ${finding.subject_page}` : ''}*`);\n      }\n      lines.push('');\n    }\n    if (finding.source_quote) {\n      lines.push('### Source Quote');\n      lines.push(`> ${finding.source_quote}`);\n      if (finding.source_work) {\n        lines.push(`> — *${finding.source_work}${finding.source_page ? `, p. ${finding.source_page}` : ''}*`);\n      }\n      lines.push('');\n    }\n    if (finding.what_subject_misses) {\n      lines.push(`### What ${subjectName} Misses`);\n      lines.push(finding.what_subject_misses);\n      lines.push('');\n    }\n    if (finding.implication) {\n      lines.push('### Implication');\n      lines.push(finding.implication);\n      lines.push('');\n    }\n    lines.push('---');\n    lines.push('');\n  });\n  return lines.join('\\n');\n};\n\n// Generate Markdown for v2 deep