nt-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  white-space: nowrap;\n}\n\n.analysis-mode-toggle .mode-btn:hover {\n  color: var(--text-primary);\n  background: var(--bg-surface);\n}\n\n.analysis-mode-toggle .mode-btn.active {\n  background: var(--bg-surface);\n  color: var(--accent-primary);\n  box-shadow: var(--shadow-soft);\n}\n\n.analysis-mode-toggle .mode-btn .mode-icon {\n  display: none; /* Hide emoji icons */\n}\n\n/* Vulnerability Finding Styles */\n.vulnerability-section {\n  margin-bottom: 1rem;\n}\n\n.vulnerability-label {\n  font-family: var(--font-ui);\n  font-size: var(--text-xs);\n  font-weight: 600;\n  color: var(--text-muted);\n  margin-bottom: 0.5rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.vulnerable-quote {\n  border-left-color: var(--accent-gold) !important;\n  background: rgba(184, 134, 11, 0.05) !important;\n}\n\n.vulnerability-attack {\n  background: rgba(181, 52, 58, 0.04);\n  border-left: 2px solid var(--accent-primary);\n  padding: 1rem;\n  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\n  margin: 1rem 0;\n}\n\n.vulnerability-attack h5 {\n  font-family: var(--font-ui);\n  color: var(--accent-primary);\n  margin: 0 0 0.5rem 0;\n  font-size: var(--text-sm);\n  font-weight: 600;\n}\n\n.vulnerability-attack p {\n  margin: 0;\n  color: var(--text-secondary);\n  line-height: 1.7;\n}\n\n.vulnerability-revision {\n  background: rgba(61, 122, 107, 0.04);\n  border-left: 2px solid var(--accent-green);\n  padding: 1rem;\n  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\n  margin: 1rem 0;\n}\n\n.vulnerability-revision .revision-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 0.5rem;\n}\n\n.vulnerability-revision .revision-header h5 {\n  margin: 0;\n}\n\n.vulnerability-revision h5 {\n  font-family: var(--font-ui);\n  color: var(--accent-green);\n  margin: 0 0 0.5rem 0;\n  font-size: var(--text-sm);\n  font-weight: 600;\n}\n\n.vulnerability-revision p {\n  margin: 0;\n  color: var(--text-secondary);\n  line-height: 1.7;\n}\n\n/* Accept to Arsenal button */\n.btn-accept-revision {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 6px 12px;\n  font-family: var(--font-ui);\n  font-size: var(--text-xs);\n  font-weight: 600;\n  border: 1px solid var(--accent-green);\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n  background: transparent;\n  color: var(--accent-green);\n  white-space: nowrap;\n}\n\n.btn-accept-revision:hover:not(:disabled) {\n  background: var(--accent-green);\n  color: white;\n}\n\n.btn-accept-revision:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.btn-accept-revision.accepted {\n  background: var(--accent-green);\n  color: white;\n}\n\n/* Ensure main content fills available space */\n.findings-page .main-content {\n  flex: 1 1;\n  display: flex;\n  overflow: hidden;\n}\n\n/* Loading state */\n.findings-page .loading-container {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1rem;\n  color: var(--text-muted);\n}\n\n/* Q&A Detail Modal */\n.qa-detail-modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.4);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  padding: 2rem;\n}\n\n.qa-detail-modal {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-lg);\n  max-width: 800px;\n  max-height: 80vh;\n  width: 100%;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  box-shadow: var(--shadow-lg);\n}\n\n.qa-detail-close {\n  position: absolute;\n  top: 1rem;\n  right: 1rem;\n  background: transparent;\n  border: none;\n  font-size: 1.25rem;\n  color: var(--text-muted);\n  cursor: pointer;\n  z-index: 1;\n  width: 2rem;\n  height: 2rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  transition: all 0.2s ease;\n}\n\n.qa-detail-close:hover {\n  background: var(--bg-elevated);\n  color: var(--text-primary);\n}\n\n.qa-detail-content {\n  padding: 2rem;\n  overflow-y: auto;\n}\n\n.qa-detail-question,\n.qa-detail-answer,\n.qa-detail-citations {\n  margin-bottom: 1.5rem;\n}\n\n.qa-detail-question h3,\n.qa-detail-answer h3,\n.qa-detail-citations h3 {\n  font-family: var(--font-ui);\n  font-size: var(--text-xs);\n  font-weight: 600;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: 0.75rem;\n}\n\n.qa-detail-question p {\n  font-family: var(--font-body);\n  font-size: var(--text-lg);\n  color: var(--text-primary);\n  line-height: 1.6;\n}\n\n.qa-detail-answer p {\n  font-family: var(--font-body);\n  color: var(--text-secondary);\n  line-height: 1.8;\n  white-space: pre-wrap;\n}\n\n.qa-detail-citations ul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.qa-detail-citations li {\n  padding: 0.75rem 1rem;\n  background: var(--bg-elevated);\n  border-radius: var(--radius-sm);\n  margin-bottom: 0.5rem;\n  font-family: var(--font-body);\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n}\n\n/* Finding JSON preview for unsupported types */\n.finding-json {\n  font-family: var(--font-mono);\n  font-size: var(--text-xs);\n  background: var(--bg-elevated);\n  padding: 1rem;\n  border-radius: var(--radius-sm);\n  overflow-x: auto;\n  white-space: pre-wrap;\n  word-wrap: break-word;\n  color: var(--text-secondary);\n  max-height: 300px;\n  overflow-y: auto;\n  border: 1px solid var(--border-subtle);\n}\n\n/* Generate findings button and progress */\n.btn-generate-findings {\n  padding: 0.75rem 1.5rem;\n  background: var(--accent-primary);\n  color: white;\n  border: none;\n  border-radius: var(--radius-sm);\n  font-family: var(--font-ui);\n  font-size: var(--text-base);\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  margin-top: 1rem;\n}\n\n.btn-generate-findings:hover:not(:disabled) {\n  background: var(--accent-hover);\n}\n\n.btn-generate-findings:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.generate-progress {\n  margin-top: 1rem;\n  padding: 0.75rem 1rem;\n  background: var(--accent-subtle);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--accent-primary);\n  font-family: var(--font-ui);\n  font-size: var(--text-sm);\n  animation: pulse 2s infinite;\n}\n\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.7; }\n}\n\n.generate-error {\n  margin-top: 1rem;\n  padding: 0.75rem 1rem;\n  background: rgba(181, 52, 58, 0.05);\n  border: 1px solid var(--accent-primary);\n  border-radius: var(--radius-sm);\n  color: var(--accent-primary);\n  font-family: var(--font-ui);\n  font-size: var(--text-sm);\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/FindingsPage.css\"],\"names\":[],\"mappings\":\"AAAA,oCAAoC;;AAEpC;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;EAChB,YAAY;EACZ,2BAA2B;AAC7B;;AAEA,6DAA6D;AAC7D;EACE,aAAa;EACb,QAAQ;EACR,YAAY;EACZ,8BAA8B;EAC9B,qCAAqC;EACrC,+BAA+B;EAC/B,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,uBAAuB;EACvB,YAAY;EACZ,+BAA+B;EAC/B,wBAAwB;EACxB,2BAA2B;EAC3B,yBAAyB;EACzB,gBAAgB;EAChB,eAAe;EACf,0BAA0B;EAC1B,mBAAmB;AACrB;;AAEA;EACE,0BAA0B;EAC1B,6BAA6B;AAC/B;;AAEA;EACE,6BAA6B;EAC7B,4BAA4B;EAC5B,8BAA8B;AAChC;;AAEA;EACE,aAAa,EAAE,qBAAqB;AACtC;;AAEA,iCAAiC;AACjC;EACE,mBAAmB;AACrB;;AAEA;EACE,2BAA2B;EAC3B,yBAAyB;EACzB,gBAAgB;EAChB,wBAAwB;EACxB,qBAAqB;EACrB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,gDAAgD;EAChD,+CAA+C;AACjD;;AAEA;EACE,mCAAmC;EACnC,4CAA4C;EAC5C,aAAa;EACb,oDAAoD;EACpD,cAAc;AAChB;;AAEA;EACE,2BAA2B;EAC3B,4BAA4B;EAC5B,oBAAoB;EACpB,yBAAyB;EACzB,gBAAgB;AAClB;;AAEA;EACE,SAAS;EACT,4BAA4B;EAC5B,gBAAgB;AAClB;;AAEA;EACE,oCAAoC;EACpC,0CAA0C;EAC1C,aAAa;EACb,oDAAoD;EACpD,cAAc;AAChB;;AAEA;EACE,aAAa;EAC