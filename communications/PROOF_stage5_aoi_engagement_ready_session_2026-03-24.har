h: 90%;\n  box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.4);\n  animation: capture-slide-up 0.2s ease-out;\n}\n\n@keyframes capture-slide-up {\n  from { transform: translateX(-50%) translateY(100%); }\n  to { transform: translateX(-50%) translateY(0); }\n}\n\n.capture-preview {\n  flex: 1 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.capture-title {\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: #94a3b8;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.capture-text {\n  font-size: 0.82rem;\n  color: #cbd5e1;\n  line-height: 1.3;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.capture-annotation-row {\n  flex: 0 0 auto;\n  width: 200px;\n}\n\n.capture-annotation-input {\n  width: 100%;\n  background: #0f172a;\n  border: 1px solid #334155;\n  border-radius: 6px;\n  color: #e2e8f0;\n  padding: 6px 10px;\n  font-size: 0.82rem;\n  outline: none;\n}\n\n.capture-annotation-input:focus {\n  border-color: #6366f1;\n}\n\n.capture-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.capture-btn {\n  padding: 6px 14px;\n  border-radius: 6px;\n  border: 1px solid transparent;\n  font-size: 0.8rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s;\n  white-space: nowrap;\n}\n\n.capture-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.capture-btn-arsenal {\n  background: #d97706;\n  color: #fff;\n}\n\n.capture-btn-arsenal:hover:not(:disabled) {\n  background: #b45309;\n}\n\n.capture-btn-research {\n  background: #6366f1;\n  color: #fff;\n}\n\n.capture-btn-research:hover:not(:disabled) {\n  background: #4f46e5;\n}\n\n.capture-dismiss-btn {\n  background: none;\n  border: none;\n  color: #64748b;\n  font-size: 1.2rem;\n  cursor: pointer;\n  padding: 4px 8px;\n  line-height: 1;\n}\n\n.capture-dismiss-btn:hover {\n  color: #cbd5e1;\n}\n\n/* Result toast variant */\n.capture-action-bar.capture-result {\n  justify-content: center;\n  padding: 8px 16px;\n}\n\n.capture-action-bar.capture-result.success {\n  border-color: #22c55e;\n}\n\n.capture-action-bar.capture-result.error {\n  border-color: #ef4444;\n}\n\n.capture-result-content {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 0.85rem;\n  color: #e2e8f0;\n}\n\n/* Depth badge row */\n.capture-depth-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 1px;\n}\n\n.capture-depth-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 1px 6px;\n  border-radius: 3px;\n  line-height: 1.4;\n}\n\n.capture-depth-badge.depth-L1_section {\n  background: #312e81;\n  color: #a5b4fc;\n}\n\n.capture-depth-badge.depth-L2_element {\n  background: #78350f;\n  color: #fbbf24;\n}\n\n.capture-breadcrumb {\n  font-size: 0.7rem;\n  color: #64748b;\n  font-style: italic;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/CaptureActionBar.css\"],\"names\":[],\"mappings\":\"AAAA,2CAA2C;;AAE3C;EACE,eAAe;EACf,SAAS;EACT,SAAS;EACT,2BAA2B;EAC3B,aAAa;EACb,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,mBAAmB;EACnB,yBAAyB;EACzB,mBAAmB;EACnB,4BAA4B;EAC5B,kBAAkB;EAClB,gBAAgB;EAChB,UAAU;EACV,0CAA0C;EAC1C,yCAAyC;AAC3C;;AAEA;EACE,OAAO,4CAA4C,EAAE;EACrD,KAAK,yCAAyC,EAAE;AAClD;;AAEA;EACE,SAAO;EACP,YAAY;EACZ,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,yBAAyB;EACzB,sBAAsB;EACtB,mBAAmB;EACnB,gBAAgB;EAChB,uBAAuB;AACzB;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,gBAAgB;EAChB,oBAAoB;EACpB,qBAAqB;EACrB,4BAA4B;EAC5B,gBAAgB;AAClB;;AAEA;EACE,cAAc;EACd,YAAY;AACd;;AAEA;EACE,WAAW;EACX,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,cAAc;EACd,iBAAiB;EACjB,kBAAkB;EAClB,aAAa;AACf;;AAEA;EACE,qBAAqB;AACvB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,cAAc;AAChB;;AAEA;EACE,iBAAiB;EACjB,kBAAkB;EAClB,6BAA6B;EAC7B,iBAAiB;EACjB,gBAAgB;EAChB,eAAe;EACf,qBAAqB;EACrB,mBAAmB;A