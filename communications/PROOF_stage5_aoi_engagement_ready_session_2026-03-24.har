n.big-picture-panel-header h2 {\n  margin: 0;\n  font-size: 1.5rem;\n  color: #4a4a4a;\n}\n\n.big-picture-subtitle {\n  margin: 8px 0 0;\n  color: #757575;\n  font-size: 0.9rem;\n}\n\n.big-picture-close-btn {\n  position: absolute;\n  right: 24px;\n  top: 24px;\n  background: none;\n  border: none;\n  color: #757575;\n  font-size: 2rem;\n  cursor: pointer;\n  padding: 0;\n  line-height: 1;\n}\n\n.big-picture-close-btn:hover {\n  color: #4a4a4a;\n}\n\n.big-picture-panel-body {\n  display: flex;\n  flex: 1 1;\n  overflow: hidden;\n}\n\n/* Left column - Form and list */\n.big-picture-list-section {\n  width: 380px;\n  border-right: 1px solid #e0ddd8;\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n}\n\n/* Form styling */\n.big-picture-form {\n  padding: 24px;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.big-picture-form .form-group {\n  margin-bottom: 16px;\n}\n\n.big-picture-form .form-group label {\n  display: block;\n  margin-bottom: 8px;\n  color: #757575;\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.big-picture-form .radio-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.big-picture-form .radio-option {\n  display: flex;\n  align-items: flex-start;\n  padding: 12px;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.big-picture-form .radio-option:hover {\n  border-color: #b5343a;\n}\n\n.big-picture-form .radio-option.selected {\n  border-color: #b5343a;\n  background: #e0ddd8;\n}\n\n.big-picture-form .radio-option input {\n  margin-right: 12px;\n  margin-top: 4px;\n}\n\n.big-picture-form .radio-content {\n  display: flex;\n  flex-direction: column;\n}\n\n.big-picture-form .radio-title {\n  color: #4a4a4a;\n  font-weight: 500;\n}\n\n.big-picture-form .radio-desc {\n  color: #757575;\n  font-size: 0.8rem;\n  margin-top: 4px;\n}\n\n.big-picture-form button[type=\"submit\"] {\n  width: 100%;\n  padding: 12px;\n  background: linear-gradient(135deg, #b5343a, #5dade2);\n  border: none;\n  border-radius: 6px;\n  color: white;\n  font-size: 1rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.big-picture-form button[type=\"submit\"]:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 12px rgba(52, 152, 219, 0.4);\n}\n\n.big-picture-form button[type=\"submit\"]:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.big-picture-form .form-error {\n  margin-top: 12px;\n  padding: 12px;\n  background: rgba(231, 76, 60, 0.2);\n  border: 1px solid #e74c3c;\n  border-radius: 6px;\n  color: #e74c3c;\n  font-size: 0.9rem;\n}\n\n/* Jobs section */\n.big-picture-jobs-section {\n  padding: 16px 24px;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.big-picture-jobs-section h3,\n.big-picture-analyses-section h3 {\n  margin: 0 0 12px;\n  font-size: 0.85rem;\n  color: #757575;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.big-picture-job-card {\n  padding: 12px;\n  background: #f5f3f0;\n  border-radius: 6px;\n  margin-bottom: 8px;\n  border-left: 3px solid #f39c12;\n}\n\n.big-picture-job-card.status-running {\n  border-left-color: #b5343a;\n}\n\n.big-picture-job-type {\n  color: #4a4a4a;\n  font-weight: 500;\n  margin-bottom: 6px;\n}\n\n.big-picture-job-meta {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.8rem;\n}\n\n.big-picture-job-status {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.big-picture-job-status.pending {\n  color: #f39c12;\n}\n\n.big-picture-job-status.running {\n  color: #b5343a;\n}\n\n.big-picture-spinner {\n  width: 12px;\n  height: 12px;\n  border: 2px solid transparent;\n  border-top-color: #b5343a;\n  border-radius: 50%;\n  animation: big-picture-spin 0.8s linear infinite;\n}\n\n@keyframes big-picture-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Analyses section */\n.big-picture-analyses-section {\n  flex: 1 1;\n  padding: 16px 24px;\n  overflow-y: auto;\n}\n\n.big-picture-no-analyses {\n  color: #666;\n  text-align: center;\n  padding: 20px;\n}\n\n.big-picture-analyses-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.big-picture-analysis-card {\n  padding: 12px;\n  background: #f5f3f0;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s;\n  border-left: 3px solid #b5343a;\n}\n\n.big-picture-analysis-card:hover {\n  background: #e0ddd8;\n  transform: translateX(4px);\n}\n\n.big-picture-analysis-title {\n  color: #4a4a4a;\n  font-weight: 500;\n  margin-bottom: 6px;\n}\n\n.big-picture-analysis-meta {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.8rem;\n}\n\n.big-picture-analysis-type {\n  color: #b5343a;\n}\n\n.big-picture-analysis-date {\n  color: #666;\n}\n\n.big-picture-analysis-stats {\n  margin-top: 8px;\n  font-size: 0.8rem;\n  color: #757575;\n  display: flex;\n  gap: 12px;\n}\n\n.big-picture-analysis-preview {\n  margin-top: 8px;\n  font-size: 0.8rem;\n  color: #757575;\n}\n\n/* Right column - Detail view */\n.big-picture-detail-section {\n  flex: 1 1;\n  overflow-y: auto;\n  background: #faf8f5;\n}\n\n.big-picture-no-selection {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: #666;\n}\n\n.big-picture-no-selection-icon {\n  font-size: 3rem;\n  margin-bottom: 16px;\n}\n\n/* Analysis Detail */\n.big-picture-detail {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n\n.big-picture-detail-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding: 24px;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.big-picture-detail-title h3 {\n  margin: 0;\n  color: #4a4a4a;\n  font-size: 1.4rem;\n}\n\n.big-picture-detail-type {\n  display: inline-block;\n  margin-top: 8px;\n  font-size: 0.85rem;\n  color: #b5343a;\n}\n\n.big-picture-detail-close {\n  background: none;\n  border: none;\n  color: #757575;\n  font-size: 1.5rem;\n  cursor: pointer;\n}\n\n.big-picture-detail-close:hover {\n  color: #4a4a4a;\n}\n\n/* Export Buttons */\n.big-picture-detail-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.big-picture-export-btn {\n  padding: 8px 14px;\n  border: 1px solid #e0ddd8;\n  border-radius: 6px;\n  font-size: 0.85rem;\n  cursor: pointer;\n  transition: all 0.2s;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.big-picture-export-btn.export-md {\n  background: linear-gradient(135deg, #e0ddd8, #f5f3f0);\n  color: #7fdb8f;\n  border-color: #e0ddd8;\n}\n\n.big-picture-export-btn.export-md:hover {\n  background: linear-gradient(135deg, #e0ddd8, #e0ddd8);\n  border-color: #5da06d;\n  box-shadow: 0 2px 8px rgba(127, 219, 143, 0.2);\n}\n\n.big-picture-export-btn.export-json {\n  background: linear-gradient(135deg, #e0ddd8, #f5f3f0);\n  color: #8fa8db;\n  border-color: #4d5a7d;\n}\n\n.big-picture-export-btn.export-json:hover {\n  background: linear-gradient(135deg, #4d5a7d, #e0ddd8);\n  border-color: #6d7a9d;\n  box-shadow: 0 2px 8px rgba(143, 168, 219, 0.2);\n}\n\n/* Tabs */\n.big-picture-detail-tabs {\n  display: flex;\n  padding: 0 24px;\n  border-bottom: 1px solid #e0ddd8;\n  overflow-x: auto;\n}\n\n.big-picture-detail-tabs button {\n  padding: 12px 16px;\n  background: none;\n  border: none;\n  color: #757575;\n  font-size: 0.9rem;\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  white-space: nowrap;\n}\n\n.big-picture-detail-tabs button:hover {\n  color: #4a4a4a;\n}\n\n.big-picture-detail-tabs button.active {\n  color: #b5343a;\n  border-bottom-color: #b5343a;\n}\n\n/* Detail content */\n.big-picture-detail-content {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 24px;\n}\n\n.big-picture-tab-content h4 {\n  margin: 0 0 16px;\n  color: #4a4a4a;\n  font-size: 1.1rem;\n}\n\n.big-picture-tab-content h5 {\n  margin: 0 0 8px;\n  color: #757575;\n  font-size: 0.85rem;\n  text-transform: uppercase;\n}\n\n/* Synthesis tab */\n.big-picture-summary-stats {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 24px;\n}\n\n.big-picture-stat-box {\n  flex: 1 1;\n  padding: 16px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  text-align: center;\n}\n\n.big-picture-stat-value {\n  font-size: 2rem;\n  font-weight: 700;\n  color: #b5343a;\n}\n\n.big-picture-stat-label {\n  color: #757575;\n  font-size: 0.85rem;\n  margin-top: 4px;\n}\n\n.big-picture-definition-box {\n  padding: 20px;\n  background: linear-gradient(135deg, #f5f3f0, #faf8f5);\n  border-radius: 8px;\n  margin-bottom: 24px;\n  border-left: 4px solid #b5343a;\n}\n\n.big-picture-definition-box p {\n  margin: 0;\n  color: #757575;\n  font-size: 1.1rem;\n  line-height: 1.6;\n}\n\n.big-picture-reveal-box {\n  padding: 16px;\n  background: rgba(52, 152, 219, 0.1);\n  border-radius: 8px;\n  margin-bottom: 16px;\n  border: 1px solid rgba(52, 152, 219, 0.3);\n}\n\n.big-picture-reveal-box h5 {\n  color: #b5343a;\n  margin-bottom: 8px;\n}\n\n.big-picture-reveal-box p {\n  margin: 0;\n  color: #757575;\n}\n\n/* Theses tab */\n.big-picture-thesis-card {\n  padding: 16px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  margin-bottom: 12px;\n  border-left: 4px solid #b5343a;\n}\n\n.big-picture-thesis-card.load_bearing {\n  border-left-color: #e74c3c;\n}\n\n.big-picture-thesis-card.supporting {\n  border-left-color: #f39c12;\n}\n\n.big-picture-thesis-card.peripheral {\n  border-left-color: #757575;\n}\n\n.big-picture-thesis-header {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.big-picture-thesis-id {\n  font-family: monospace;\n  color: #757575;\n  font-size: 0.8rem;\n}\n\n.big-picture-thesis-centrality {\n  font-size: 0.75rem;\n  padding: 2px 8px;\n  border-radius: 4px;\n  text-transform: uppercase;\n}\n\n.big-picture-thesis-centrality.load_bearing {\n  background: rgba(231, 76, 60, 0.2);\n  color: #e74c3c;\n}\n\n.big-picture-thesis-centrality.supporting {\n  background: rgba(243, 156, 18, 0.2);\n  color: #f39c12;\n}\n\n.big-picture-thesis-centrality.peripheral {\n  background: rgba(136, 136, 136, 0.2);\n  color: #757575;\n}\n\n.big-picture-thesis-claim {\n  color: #4a4a4a;\n  font-weight: 500;\n  margin-bottom: 12px;\n}\n\n.big-picture-thesis-quote {\n  padding: 12px;\n  background: #faf8f5;\n  border-radius: 6px;\n  margin-bottom: 12px;\n  font-style: italic;\n  color: #a0a0c0;\n}\n\n.big-picture-thesis-source {\n  font-size: 0.8rem;\n  color: #757575;\n}\n\n.big-picture-thesis-commitments {\n  margin-top: 12px;\n}\n\n.big-picture-commitment-group {\n  margin-bottom: 12px;\n}\n\n.big-picture-commitment-group h6 {\n  color: #757575;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  margin: 0 0 6px;\n}\n\n.big-picture-commitment-list {\n  list-style: disc;\n  margin: 0;\n  padding-left: 20px;\n}\n\n.big-picture-commitment-list li {\n  color: #757575;\n  font-size: 0.85rem;\n  margin-bottom: 4px;\n}\n\n/* Packages tab */\n.big-picture-package-card {\n  padding: 20px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  margin-bottom: 16px;\n  border-left: 4px solid #9b59b6;\n}\n\n.big-picture-package-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 12px;\n}\n\n.big-picture-package-name {\n  color: #4a4a4a;\n  font-size: 1.1rem;\n  font-weight: 600;\n}\n\n.big-picture-package-id {\n  font-family: monospace;\n  color: #757575;\n  font-size: 0.75rem;\n}\n\n.big-picture-package-description {\n  color: #a0a0c0;\n  margin-bottom: 16px;\n}\n\n.big-picture-package-section {\n  margin-bottom: 12px;\n}\n\n.big-picture-package-section h6 {\n  color: #757575;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  margin: 0 0 8px;\n}\n\n.big-picture-package-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.big-picture-package-list .tag {\n  padding: 4px 8px;\n  background: #faf8f5;\n  border-radius: 4px;\n  font-size: 0.8rem;\n  color: #757575;\n}\n\n.big-picture-package-evidence {\n  margin-top: 12px;\n  padding: 12px;\n  background: #faf8f5;\n  border-radius: 6px;\n}\n\n.big-picture-package-evidence .quote {\n  font-style: italic;\n  color: #a0a0c0;\n  margin-bottom: 6px;\n}\n\n.big-picture-package-evidence .source {\n  font-size: 0.8rem;\n  color: #757575;\n}\n\n/* Incompatibilities tab */\n.big-picture-incompatibility-card {\n  padding: 16px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  margin-bottom: 12px;\n  border-left: 4px solid #e74c3c;\n}\n\n.big-picture-incompatibility-card.severity-strict {\n  border-left-color: #e74c3c;\n}\n\n.big-picture-incompatibility-card.severity-strong {\n  border-left-color: #f39c12;\n}\n\n.big-picture-incompatibility-card.severity-weak {\n  border-left-color: #757575;\n}\n\n.big-picture-incompatibility-header {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 12px;\n}\n\n.big-picture-incompatibility-severity {\n  font-size: 0.75rem;\n  padding: 2px 8px;\n  border-radius: 4px;\n  text-transform: uppercase;\n}\n\n.big-picture-incompatibility-severity.strict {\n  background: rgba(231, 76, 60, 0.2);\n  color: #e74c3c;\n}\n\n.big-picture-incompatibility-severity.strong {\n  background: rgba(243, 156, 18, 0.2);\n  color: #f39c12;\n}\n\n.big-picture-incompatibility-severity.weak {\n  background: rgba(136, 136, 136, 0.2);\n  color: #757575;\n}\n\n.big-picture-incompatibility-positions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n\n.big-picture-position-box {\n  flex: 1 1;\n  padding: 12px;\n  background: #faf8f5;\n  border-radius: 6px;\n}\n\n.big-picture-position-box.position-a {\n  border: 1px solid #b5343a;\n}\n\n.big-picture-position-box.position-b {\n  border: 1px solid #e74c3c;\n}\n\n.big-picture-position-label {\n  font-size: 0.75rem;\n  color: #757575;\n  margin-bottom: 4px;\n}\n\n.big-picture-position-text {\n  color: #4a4a4a;\n}\n\n.big-picture-incompatibility-vs {\n  font-size: 1.5rem;\n  color: #666;\n}\n\n.big-picture-incompatibility-why {\n  margin-top: 12px;\n}\n\n.big-picture-incompatibility-why h6 {\n  color: #757575;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  margin: 0 0 6px;\n}\n\n.big-picture-incompatibility-why p {\n  color: #757575;\n  margin: 0;\n}\n\n/* Tensions tab */\n.big-picture-tension-card {\n  padding: 16px;\n  background: #f5f3f0;\n  border-radius: 8px;\n  margin-bottom: 12px;\n  border-left: 4px solid #f39c12;\n}\n\n.big-picture-tension-card.stability-unstable {\n  border-left-color: #e74c3c;\n}\n\n.big-picture-tension-card.stability-precarious {\n  border-left-color: #f39c12;\n}\n\n.big-picture-tension-card.stability-unresolved {\n  border-left-color: #757575;\n}\n\n.big-picture-tension-header {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 12px;\n}\n\n.big-picture-tension-stability {\n  font-size: 0.75rem;\n  padding: 2px 8px;\n  border-radius: 4px;\n  text-transform: uppercase;\n}\n\n.big-picture-tension-stability.unstable {\n  background: rgba(231, 76, 60, 0.2);\n  color: #e74c3c;\n}\n\n.big-picture-tension-stability.precarious {\n  background: rgba(243, 156, 18, 0.2);\n  color: #f39c12;\n}\n\n.big-picture-tension-stability.unresolved {\n  background: rgba(136, 136, 136, 0.2);\n  color: #757575;\n}\n\n.big-picture-tension-commitments {\n  margin-bottom: 12px;\n}\n\n.big-picture-tension-commitments h6 {\n  color: #757575;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  margin: 0 0 6px;\n}\n\n.big-picture-tension-commitments ul {\n  list-style: disc;\n  margin: 0;\n  padding-left: 20px;\n}\n\n.big-picture-tension-commitments li {\n  color: #4a4a4a;\n  margin-bottom: 4px;\n}\n\n.big-picture-tension-source {\n  margin-bottom: 12px;\n}\n\n.big-picture-tension-source h6 {\n  color: #757575;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  margin: 0 0 6px;\n}\n\n.big-picture-tension-source p {\n  color: #757575;\n  margin: 0;\n}\n\n/* Practical Stakes tab */\n.big-picture-stakes-section {\n  margin-bottom: 24px;\n}\n\n.big-picture-stakes-section h5 {\n  color: #757575;\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  margin: 0 0 12px;\n}\n\n.big-picture-stakes-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.big-picture-stakes-list li {\n  padding: 8px 12px;\n  background: #f5f3f0;\n  border-radius: 6px;\n  margin-bottom: 8px;\n  color: #757575;\n}\n\n.big-picture-obligations .big-picture-stakes-list li {\n  border-left: 3px solid #27ae60;\n}\n\n.big-picture-prohibitions .big-picture-stakes-list li {\n  border-left: 3px solid #e74c3c;\n}\n\n.big-picture-political .big-picture-stakes-list li {\n  border-left: 3px solid #b5343a;\n}\n\n.big-picture-theoretical .big-picture-stakes-list li {\n  border-left: 3px solid #9b59b6;\n}\n\n.big-picture-strategic .big-picture-stakes-list li {\n  border-left: 3px solid #f39c12;\n}\n\n/* Scrollbar */\n.big-picture-panel ::-webkit-scrollbar {\n  width: 8px;\n}\n\n.big-picture-panel ::-webkit-scrollbar-track {\n  background: #faf8f5;\n}\n\n.big-picture-panel ::-webkit-scrollbar-thumb {\n  background: #e0ddd8;\n  border-radius: 4px;\n}\n\n.big-picture-panel ::-webkit-scrollbar-thumb:hover {\n  background: #5d5d7c;\n}\n\n/* ==== Tab Content Styling ==== */\n\n/* Common Tab Styling */\n.tab-content h4 {\n  margin-bottom: 20px;\n  color: #1a1a1a;\n  font-size: 1.2rem;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.tab-content h4::before {\n  content: '';\n  width: 4px;\n  height: 20px;\n  background: linear-gradient(180deg, #b5343a, #5dade2);\n  border-radius: 2px;\n}\n\n/* Theses Tab */\n.theses-tab h4::before {\n  background: linear-gradient(180deg, #e74c3c, #f39c12);\n}\n\n.thesis-item {\n  padding: 20px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 12px;\n  margin-bottom: 16px;\n  border-left: 4px solid #b5343a;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);\n  transition: all 0.25s ease;\n}\n\n.thesis-item:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n\n.thesis-item.centrality-load_bearing {\n  border-left-color: #e74c3c;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.thesis-item.centrality-supporting {\n  border-left-color: #f39c12;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.thesis-item.centrality-peripheral {\n  border-left-color: #666;\n}\n\n.thesis-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 14px;\n}\n\n.thesis-number {\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, #b5343a, #b5343a);\n  border-radius: 50%;\n  font-weight: 700;\n  color: #1a1a1a;\n  font-size: 0.9rem;\n  flex-shrink: 0;\n  box-shadow: 0 2px 8px rgba(52, 152, 219, 0.3);\n}\n\n.thesis-item.centrality-load_bearing .thesis-number {\n  background: linear-gradient(135deg, #e74c3c, #c0392b);\n  box-shadow: 0 2px 8px rgba(231, 76, 60, 0.3);\n}\n\n.thesis-item.centrality-supporting .thesis-number {\n  background: linear-gradient(135deg, #f39c12, #e67e22);\n  box-shadow: 0 2px 8px rgba(243, 156, 18, 0.3);\n}\n\n.thesis-item.centrality-peripheral .thesis-number {\n  background: linear-gradient(135deg, #666, #555);\n  box-shadow: 0 2px 8px rgba(102, 102, 102, 0.3);\n}\n\n.centrality-badge {\n  font-size: 0.7rem;\n  padding: 4px 12px;\n  border-radius: 20px;\n  text-transform: uppercase;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n}\n\n.centrality-badge.load_bearing {\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.25) 0%, rgba(192, 57, 43, 0.25) 100%);\n  color: #ff6b5b;\n  border: 1px solid rgba(231, 76, 60, 0.3);\n}\n\n.centrality-badge.supporting {\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.25) 0%, rgba(230, 126, 34, 0.25) 100%);\n  color: #ffb84d;\n  border: 1px solid rgba(243, 156, 18, 0.3);\n}\n\n.centrality-badge.peripheral {\n  background: rgba(136, 136, 136, 0.15);\n  color: #aaa;\n  border: 1px solid rgba(136, 136, 136, 0.3);\n}\n\n.thesis-source {\n  font-size: 0.8rem;\n  color: #6a6a8a;\n  margin-left: auto;\n  font-style: italic;\n}\n\n.thesis-claim {\n  color: #4a4a4a;\n  font-weight: 500;\n  margin-bottom: 14px;\n  line-height: 1.6;\n  font-size: 1.02rem;\n}\n\n.thesis-quote {\n  padding: 14px 16px;\n  background: rgba(0, 0, 0, 0.25);\n  border-radius: 8px;\n  font-style: italic;\n  color: #9898b8;\n  line-height: 1.7;\n  border-left: 3px solid rgba(52, 152, 219, 0.4);\n  position: relative;\n}\n\n.thesis-quote::before {\n  content: '\"';\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  font-size: 2rem;\n  color: rgba(52, 152, 219, 0.2);\n  font-family: Georgia, serif;\n  line-height: 1;\n}\n\n/* Packages Tab */\n.packages-tab h4::before {\n  background: linear-gradient(180deg, #9b59b6, #8e44ad);\n}\n\n.package-item {\n  padding: 24px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 12px;\n  margin-bottom: 20px;\n  border-left: 4px solid #9b59b6;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);\n  transition: all 0.25s ease;\n}\n\n.package-item:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);\n  border-left-color: #a96cd4;\n}\n\n.package-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 14px;\n}\n\n.package-number {\n  width: 34px;\n  height: 34px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, #9b59b6, #8e44ad);\n  border-radius: 50%;\n  font-weight: 700;\n  color: #1a1a1a;\n  font-size: 0.95rem;\n  flex-shrink: 0;\n  box-shadow: 0 3px 10px rgba(155, 89, 182, 0.35);\n}\n\n.package-name {\n  color: #1a1a1a;\n  font-size: 1.15rem;\n  font-weight: 600;\n  letter-spacing: -0.01em;\n}\n\n.package-description {\n  color: #a8a8c8;\n  margin-bottom: 20px;\n  line-height: 1.65;\n  padding-left: 48px;\n  font-size: 0.95rem;\n}\n\n/* Commitment Cascade - The fancy part */\n.commitment-cascade {\n  margin: 20px 0;\n  padding: 0;\n  border-radius: 10px;\n  overflow: hidden;\n  background: rgba(0, 0, 0, 0.2);\n}\n\n.commitment-level {\n  padding: 16px 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n  position: relative;\n}\n\n.commitment-level:last-child {\n  border-bottom: none;\n}\n\n.commitment-level::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  width: 4px;\n}\n\n.commitment-level:nth-child(1)::before {\n  background: linear-gradient(180deg, #27ae60, #2ecc71);\n}\n\n.commitment-level:nth-child(2)::before {\n  background: linear-gradient(180deg, #f39c12, #e67e22);\n}\n\n.commitment-level:nth-child(3)::before {\n  background: linear-gradient(180deg, #e74c3c, #c0392b);\n}\n\n.level-label {\n  display: inline-block;\n  font-size: 0.7rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  padding: 4px 12px;\n  border-radius: 20px;\n  margin-bottom: 10px;\n}\n\n.commitment-level:nth-child(1) .level-label {\n  background: rgba(39, 174, 96, 0.2);\n  color: #4ade80;\n  border: 1px solid rgba(39, 174, 96, 0.3);\n}\n\n.commitment-level:nth-child(2) .level-label {\n  background: rgba(243, 156, 18, 0.2);\n  color: #fbbf24;\n  border: 1px solid rgba(243, 156, 18, 0.3);\n}\n\n.commitment-level:nth-child(3) .level-label {\n  background: rgba(231, 76, 60, 0.2);\n  color: #f87171;\n  border: 1px solid rgba(231, 76, 60, 0.3);\n}\n\n.commitment-level ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.commitment-level li {\n  color: #757575;\n  font-size: 0.9rem;\n  margin-bottom: 8px;\n  padding-left: 20px;\n  position: relative;\n  line-height: 1.55;\n}\n\n.commitment-level li::before {\n  content: '→';\n  position: absolute;\n  left: 0;\n  color: #6a6a8a;\n}\n\n.commitment-level:nth-child(1) li::before { color: #4ade80; }\n.commitment-level:nth-child(2) li::before { color: #fbbf24; }\n.commitment-level:nth-child(3) li::before { color: #f87171; }\n\n/* Incompatible Positions Tags */\n.incompatible-positions {\n  margin-top: 20px;\n  padding: 16px;\n  background: rgba(231, 76, 60, 0.08);\n  border-radius: 10px;\n  border: 1px solid rgba(231, 76, 60, 0.15);\n}\n\n.incompatible-positions strong {\n  display: block;\n  font-size: 0.7rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #e57373;\n  margin-bottom: 10px;\n}\n\n.incompatible-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.incompatible-tag {\n  padding: 6px 14px;\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.2) 0%, rgba(192, 57, 43, 0.2) 100%);\n  border: 1px solid rgba(231, 76, 60, 0.25);\n  border-radius: 20px;\n  font-size: 0.82rem;\n  color: #fca5a5;\n  transition: all 0.2s ease;\n}\n\n.incompatible-tag:hover {\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.3) 0%, rgba(192, 57, 43, 0.3) 100%);\n  transform: translateY(-1px);\n}\n\n/* Who Holds This */\n.who-holds {\n  margin-top: 16px;\n  padding: 12px 16px;\n  background: rgba(52, 152, 219, 0.08);\n  border-radius: 8px;\n  border: 1px solid rgba(52, 152, 219, 0.15);\n  font-size: 0.88rem;\n  color: #93c5fd;\n}\n\n.who-holds strong {\n  color: #b5343a;\n  font-weight: 600;\n  margin-right: 6px;\n}\n\n.package-section {\n  margin-bottom: 16px;\n}\n\n.package-section h6 {\n  color: #7a7a9a;\n  font-size: 0.72rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin: 0 0 10px;\n  font-weight: 600;\n}\n\n.package-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.package-list .tag {\n  padding: 5px 12px;\n  background: rgba(155, 89, 182, 0.15);\n  border: 1px solid rgba(155, 89, 182, 0.2);\n  border-radius: 6px;\n  font-size: 0.82rem;\n  color: #c4b5fd;\n  transition: all 0.2s ease;\n}\n\n.package-list .tag:hover {\n  background: rgba(155, 89, 182, 0.25);\n  transform: translateY(-1px);\n}\n\n.package-theses-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.package-theses-list li {\n  color: #757575;\n  font-size: 0.88rem;\n  margin-bottom: 6px;\n  padding-left: 18px;\n  position: relative;\n}\n\n.package-theses-list li::before {\n  content: '•';\n  position: absolute;\n  left: 0;\n  color: #9b59b6;\n}\n\n.package-evidence {\n  margin-top: 16px;\n  padding: 14px 16px;\n  background: rgba(0, 0, 0, 0.25);\n  border-radius: 8px;\n  border-left: 3px solid rgba(155, 89, 182, 0.4);\n}\n\n.package-evidence .quote {\n  font-style: italic;\n  color: #9898b8;\n  margin-bottom: 8px;\n  line-height: 1.6;\n}\n\n.package-evidence .source {\n  font-size: 0.8rem;\n  color: #6a6a8a;\n}\n\n/* Incompatibilities Tab */\n.incompatibilities-tab h4::before {\n  background: linear-gradient(180deg, #e74c3c, #c0392b);\n}\n\n.incompatibility-item {\n  padding: 20px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 12px;\n  margin-bottom: 16px;\n  border-left: 4px solid #e74c3c;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);\n  transition: all 0.25s ease;\n}\n\n.incompatibility-item:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n\n.incompatibility-item.severity-strict {\n  border-left-color: #e74c3c;\n  background: linear-gradient(135deg, #faf8f5 0%, #faf8f5 100%);\n}\n\n.incompatibility-item.severity-strong {\n  border-left-color: #f39c12;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.incompatibility-item.severity-weak {\n  border-left-color: #666;\n}\n\n.incompatibility-header {\n  margin-bottom: 14px;\n}\n\n.severity-badge {\n  font-size: 0.7rem;\n  padding: 4px 12px;\n  border-radius: 20px;\n  text-transform: uppercase;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n}\n\n.severity-badge.strict {\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.25) 0%, rgba(192, 57, 43, 0.25) 100%);\n  color: #ff6b5b;\n  border: 1px solid rgba(231, 76, 60, 0.3);\n}\n\n.severity-badge.strong {\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.25) 0%, rgba(230, 126, 34, 0.25) 100%);\n  color: #ffb84d;\n  border: 1px solid rgba(243, 156, 18, 0.3);\n}\n\n.severity-badge.weak {\n  background: rgba(136, 136, 136, 0.15);\n  color: #aaa;\n  border: 1px solid rgba(136, 136, 136, 0.3);\n}\n\n.incompatibility-positions {\n  display: flex;\n  align-items: stretch;\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n.position-a,\n.position-b {\n  flex: 1 1;\n  padding: 16px;\n  background: rgba(0, 0, 0, 0.25);\n  border-radius: 10px;\n  border: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.position-a {\n  border-left: 3px solid #b5343a;\n}\n\n.position-b {\n  border-left: 3px solid #e74c3c;\n}\n\n.position-label {\n  font-size: 0.7rem;\n  color: #7a7a9a;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  display: block;\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.position-text {\n  color: #757575;\n  font-size: 0.92rem;\n  line-height: 1.55;\n}\n\n.incompatibility-vs {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 36px;\n  height: 36px;\n  background: rgba(231, 76, 60, 0.15);\n  border-radius: 50%;\n  color: #e74c3c;\n  font-size: 1rem;\n  font-weight: bold;\n  flex-shrink: 0;\n  align-self: center;\n  border: 1px solid rgba(231, 76, 60, 0.25);\n}\n\n.incompatibility-why {\n  margin-top: 14px;\n  padding: 14px 16px;\n  background: rgba(0, 0, 0, 0.2);\n  border-radius: 8px;\n  border-left: 3px solid rgba(231, 76, 60, 0.4);\n}\n\n.incompatibility-why strong {\n  display: block;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #7a7a9a;\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.incompatibility-caught {\n  color: #9898b8;\n  margin-top: 12px;\n  font-size: 0.88rem;\n}\n\n.incompatibility-caught strong {\n  color: #a0a0c0;\n}\n\n/* Tensions Tab */\n.tensions-tab h4::before {\n  background: linear-gradient(180deg, #f39c12, #e67e22);\n}\n\n.tension-item {\n  padding: 20px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 12px;\n  margin-bottom: 16px;\n  border-left: 4px solid #b5343a;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);\n  transition: all 0.25s ease;\n}\n\n.tension-item:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n\n.tension-item.type-expansion {\n  border-left-color: #27ae60;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.tension-item.type-shift {\n  border-left-color: #f39c12;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.tension-item.type-contradiction {\n  border-left-color: #e74c3c;\n  background: linear-gradient(135deg, #faf8f5 0%, #faf8f5 100%);\n}\n\n.tension-item.type-evolution {\n  border-left-color: #9b59b6;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.tension-item.type-reframing {\n  border-left-color: #1abc9c;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.tension-item.type-retreat {\n  border-left-color: #95a5a6;\n}\n\n.tension-item.internal {\n  border-left-color: #e67e22;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.tension-item.stability-unstable {\n  border-left-color: #e74c3c;\n}\n\n.tension-item.stability-precarious {\n  border-left-color: #f39c12;\n}\n\n.tension-item.stability-unresolved {\n  border-left-color: #757575;\n}\n\n.tension-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.tension-type-badge {\n  font-size: 0.7rem;\n  padding: 4px 12px;\n  border-radius: 20px;\n  text-transform: uppercase;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  background: linear-gradient(135deg, rgba(52, 152, 219, 0.25) 0%, rgba(41, 128, 185, 0.25) 100%);\n  color: #5dade2;\n  border: 1px solid rgba(52, 152, 219, 0.3);\n}\n\n.tension-type-badge.expansion {\n  background: linear-gradient(135deg, rgba(39, 174, 96, 0.25) 0%, rgba(46, 204, 113, 0.25) 100%);\n  color: #4ade80;\n  border: 1px solid rgba(39, 174, 96, 0.3);\n}\n\n.tension-type-badge.shift {\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.25) 0%, rgba(230, 126, 34, 0.25) 100%);\n  color: #fbbf24;\n  border: 1px solid rgba(243, 156, 18, 0.3);\n}\n\n.tension-type-badge.contradiction {\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.25) 0%, rgba(192, 57, 43, 0.25) 100%);\n  color: #ff6b5b;\n  border: 1px solid rgba(231, 76, 60, 0.3);\n}\n\n.tension-type-badge.evolution {\n  background: linear-gradient(135deg, rgba(155, 89, 182, 0.25) 0%, rgba(142, 68, 173, 0.25) 100%);\n  color: #c4b5fd;\n  border: 1px solid rgba(155, 89, 182, 0.3);\n}\n\n.tension-type-badge.reframing {\n  background: linear-gradient(135deg, rgba(26, 188, 156, 0.25) 0%, rgba(22, 160, 133, 0.25) 100%);\n  color: #5eead4;\n  border: 1px solid rgba(26, 188, 156, 0.3);\n}\n\n.stability-badge {\n  font-size: 0.7rem;\n  padding: 4px 12px;\n  border-radius: 20px;\n  text-transform: uppercase;\n  font-weight: 600;\n  letter-spacing: 0.05em;\n}\n\n.stability-badge.unstable {\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.25) 0%, rgba(192, 57, 43, 0.25) 100%);\n  color: #ff6b5b;\n  border: 1px solid rgba(231, 76, 60, 0.3);\n}\n\n.stability-badge.precarious {\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.25) 0%, rgba(230, 126, 34, 0.25) 100%);\n  color: #fbbf24;\n  border: 1px solid rgba(243, 156, 18, 0.3);\n}\n\n.stability-badge.unresolved {\n  background: rgba(136, 136, 136, 0.15);\n  color: #aaa;\n  border: 1px solid rgba(136, 136, 136, 0.3);\n}\n\n.tension-description {\n  color: #4a4a4a;\n  margin-bottom: 18px;\n  line-height: 1.6;\n  font-size: 1rem;\n}\n\n.tension-positions {\n  display: flex;\n  align-items: stretch;\n  gap: 16px;\n  margin-bottom: 18px;\n}\n\n.tension-positions .position-a,\n.tension-positions .position-b {\n  flex: 1 1;\n  padding: 16px;\n  background: rgba(0, 0, 0, 0.25);\n  border-radius: 10px;\n  border: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.tension-positions .position-a {\n  border-left: 3px solid #b5343a;\n}\n\n.tension-positions .position-b {\n  border-left: 3px solid #9b59b6;\n}\n\n.tension-positions .position-a strong,\n.tension-positions .position-b strong {\n  display: block;\n  color: #4a4a4a;\n  margin-bottom: 10px;\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n\n.tension-positions .position-a p,\n.tension-positions .position-b p {\n  color: #a0a0c0;\n  margin: 0;\n  line-height: 1.6;\n  font-size: 0.92rem;\n}\n\n.tension-arrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 36px;\n  height: 36px;\n  background: rgba(155, 89, 182, 0.15);\n  border-radius: 50%;\n  color: #c4b5fd;\n  font-size: 1.1rem;\n  flex-shrink: 0;\n  align-self: center;\n  border: 1px solid rgba(155, 89, 182, 0.25);\n}\n\n.tension-explanations {\n  margin-bottom: 16px;\n  padding: 14px 16px;\n  background: rgba(0, 0, 0, 0.2);\n  border-radius: 8px;\n}\n\n.tension-explanations strong {\n  display: block;\n  color: #7a7a9a;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-bottom: 10px;\n  font-weight: 600;\n}\n\n.tension-explanations ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.tension-explanations li {\n  color: #757575;\n  margin-bottom: 6px;\n  font-size: 0.9rem;\n  padding-left: 18px;\n  position: relative;\n  line-height: 1.5;\n}\n\n.tension-explanations li::before {\n  content: '•';\n  position: absolute;\n  left: 0;\n  color: #9b59b6;\n}\n\n.tension-significance,\n.tension-resist,\n.tension-implications {\n  color: #a0a0c0;\n  margin-top: 14px;\n  line-height: 1.6;\n  padding: 12px 16px;\n  background: rgba(0, 0, 0, 0.15);\n  border-radius: 8px;\n  font-size: 0.9rem;\n}\n\n.tension-significance strong,\n.tension-resist strong,\n.tension-implications strong {\n  display: block;\n  color: #7a7a9a;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.tension-commitments {\n  margin-bottom: 14px;\n  padding: 14px 16px;\n  background: rgba(230, 126, 34, 0.08);\n  border-radius: 8px;\n  border: 1px solid rgba(230, 126, 34, 0.15);\n}\n\n.tension-commitments strong {\n  display: block;\n  color: #e67e22;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-bottom: 10px;\n  font-weight: 600;\n}\n\n.tension-commitments ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.tension-commitments li {\n  color: #4a4a4a;\n  margin-bottom: 6px;\n  padding-left: 18px;\n  position: relative;\n  line-height: 1.5;\n}\n\n.tension-commitments li::before {\n  content: '⚡';\n  position: absolute;\n  left: 0;\n  font-size: 0.75rem;\n}\n\n.tension-source {\n  margin-bottom: 14px;\n  padding: 12px 16px;\n  background: rgba(0, 0, 0, 0.15);\n  border-radius: 8px;\n}\n\n.tension-source strong {\n  display: block;\n  color: #7a7a9a;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.tension-evidence {\n  margin-top: 14px;\n}\n\n.tension-evidence strong {\n  display: block;\n  color: #7a7a9a;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-bottom: 10px;\n  font-weight: 600;\n}\n\n.evidence-item {\n  padding: 14px 16px;\n  background: rgba(0, 0, 0, 0.25);\n  border-radius: 8px;\n  margin-bottom: 10px;\n  border-left: 3px solid rgba(52, 152, 219, 0.4);\n}\n\n.evidence-quote {\n  font-style: italic;\n  color: #9898b8;\n  line-height: 1.65;\n  position: relative;\n  padding-left: 20px;\n}\n\n.evidence-quote::before {\n  content: '\"';\n  position: absolute;\n  left: 0;\n  top: -4px;\n  font-size: 1.5rem;\n  color: rgba(52, 152, 219, 0.3);\n  font-family: Georgia, serif;\n}\n\n.evidence-source {\n  font-size: 0.8rem;\n  color: #6a6a8a;\n  margin-top: 8px;\n  padding-left: 20px;\n}\n\n/* Stakes Tab */\n.stakes-tab h4::before {\n  background: linear-gradient(180deg, #27ae60, #2ecc71);\n}\n\n.stakes-intro {\n  margin-bottom: 24px;\n}\n\n.stakes-intro h4 {\n  margin-bottom: 0 !important;\n  font-size: 1.15rem !important;\n  color: #4a4a4a;\n}\n\n.stakes-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 20px;\n  margin-bottom: 24px;\n}\n\n.stakes-section {\n  padding: 20px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 12px;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);\n  transition: all 0.25s ease;\n}\n\n.stakes-section:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n\n.stakes-section h5 {\n  color: #8a8aaa;\n  font-size: 0.78rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin: 0 0 14px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.stakes-section h5::before {\n  content: '';\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.stakes-section.obligations h5::before {\n  background: linear-gradient(135deg, #27ae60, #2ecc71);\n  box-shadow: 0 0 8px rgba(39, 174, 96, 0.5);\n}\n\n.stakes-section.prohibitions h5::before {\n  background: linear-gradient(135deg, #e74c3c, #c0392b);\n  box-shadow: 0 0 8px rgba(231, 76, 60, 0.5);\n}\n\n.stakes-section.political-implications h5::before {\n  background: linear-gradient(135deg, #f39c12, #e67e22);\n  box-shadow: 0 0 8px rgba(243, 156, 18, 0.5);\n}\n\n.stakes-section.strategic-implications h5::before {\n  background: linear-gradient(135deg, #b5343a, #b5343a);\n  box-shadow: 0 0 8px rgba(52, 152, 219, 0.5);\n}\n\n.stakes-section.theoretical-implications h5::before {\n  background: linear-gradient(135deg, #9b59b6, #8e44ad);\n  box-shadow: 0 0 8px rgba(155, 89, 182, 0.5);\n}\n\n.stakes-section ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.stakes-section li {\n  color: #757575;\n  margin-bottom: 10px;\n  font-size: 0.9rem;\n  padding-left: 20px;\n  position: relative;\n  line-height: 1.55;\n}\n\n.stakes-section li::before {\n  position: absolute;\n  left: 0;\n  font-size: 0.85rem;\n}\n\n.stakes-section.obligations li::before {\n  content: '✓';\n  color: #4ade80;\n}\n\n.stakes-section.prohibitions li::before {\n  content: '✕';\n  color: #f87171;\n}\n\n.stakes-section.political-implications li::before {\n  content: '→';\n  color: #fbbf24;\n}\n\n.stakes-section.strategic-implications li::before {\n  content: '→';\n  color: #b5343a;\n}\n\n.stakes-section.theoretical-implications li::before {\n  content: '→';\n  color: #c4b5fd;\n}\n\n.stakes-section.obligations {\n  border-left: 4px solid #27ae60;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.stakes-section.obligations h5 {\n  color: #4ade80;\n}\n\n.stakes-section.prohibitions {\n  border-left: 4px solid #e74c3c;\n  background: linear-gradient(135deg, #faf8f5 0%, #faf8f5 100%);\n}\n\n.stakes-section.prohibitions h5 {\n  color: #f87171;\n}\n\n.stakes-section.political-implications {\n  border-left: 4px solid #f39c12;\n  grid-column: 1 / -1;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.stakes-section.political-implications h5 {\n  color: #fbbf24;\n}\n\n.stakes-section.strategic-implications {\n  border-left: 4px solid #b5343a;\n  grid-column: 1 / -1;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.stakes-section.strategic-implications h5 {\n  color: #b5343a;\n}\n\n.stakes-section.theoretical-implications {\n  border-left: 4px solid #9b59b6;\n  grid-column: 1 / -1;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n}\n\n.stakes-section.theoretical-implications h5 {\n  color: #c4b5fd;\n}\n\n/* Synthesis Tab */\n.synthesis-tab h4::before {\n  background: linear-gradient(180deg, #b5343a, #b5343a);\n}\n\n.synthesis-scores {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n  margin-bottom: 28px;\n}\n\n.score-card {\n  padding: 24px 20px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 14px;\n  text-align: center;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);\n  border: 1px solid rgba(52, 152, 219, 0.15);\n  transition: all 0.25s ease;\n}\n\n.score-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n\n.score-card .score-value {\n  font-size: 2.5rem;\n  font-weight: 700;\n  background: linear-gradient(135deg, #b5343a, #5dade2);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  line-height: 1.1;\n  margin-bottom: 8px;\n}\n\n.score-card .score-label {\n  font-size: 0.78rem;\n  color: #8a8aaa;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  font-weight: 600;\n}\n\n.score-card.alert {\n  border-color: rgba(231, 76, 60, 0.2);\n  background: linear-gradient(135deg, #faf8f5 0%, #faf8f5 100%);\n}\n\n.score-card.alert .score-value {\n  background: linear-gradient(135deg, #e74c3c, #ff6b5b);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.executive-summary {\n  margin-bottom: 24px;\n  padding: 20px 24px;\n  background: linear-gradient(135deg, #f5f3f0 0%, #faf8f5 100%);\n  border-radius: 12px;\n  border-left: 4px solid #b5343a;\n}\n\n.executive-summary h4 {\n  margin-bottom: 14px !important;\n}\n\n.executive-summary p {\n  color: #757575;\n  line-height: 1.7;\n  font-size: 1rem;\n  margin: 0;\n}\n\n.key-revelation {\n  margin-bottom: 24px;\n  padding: 20px 24px;\n  background: linear-gradient(135deg, rgba(52, 152, 219, 0.12) 0%, rgba(41, 128, 185, 0.08) 100%);\n  border-radius: 12px;\n  border: 1px solid rgba(52, 152, 219, 0.2);\n  position: relative;\n  overflow: hidden;\n}\n\n.key-revelation::before {\n  content: '💡';\n  position: absolute;\n  top: 20px;\n  right: 24px;\n  font-size: 2rem;\n  opacity: 0.3;\n}\n\n.key-revelation h4 {\n  margin-bottom: 14px !important;\n  color: #5dade2;\n}\n\n.key-revelation .revelation-text {\n  color: #4a4a4a;\n  font-size: 1.05rem;\n  line-height: 1.7;\n  font-weight: 500;\n  margin: 0;\n}\n\n.most-consequential {\n  margin-bottom: 24px;\n  padding: 20px 24px;\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.08) 0%, rgba(192, 57, 43, 0.06) 100%);\n  border-radius: 12px;\n  border: 1px solid rgba(231, 76, 60, 0.15);\n}\n\n.most-consequential h4 {\n  margin-bottom: 14px !important;\n  color: #e57373;\n}\n\n.most-consequential p {\n  color: #757575;\n  line-height: 1.7;\n  margin: 0;\n}\n\n.hidden-price-tags {\n  margin-bottom: 24px;\n  padding: 20px 24px;\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.08) 0%, rgba(230, 126, 34, 0.06) 100%);\n  border-radius: 12px;\n  border: 1px solid rgba(243, 156, 18, 0.15);\n}\n\n.hidden-price-tags h4 {\n  margin-bottom: 16px !important;\n  color: #fbbf24;\n}\n\n.hidden-price-tags ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.hidden-price-tags li {\n  color: #757575;\n  margin-bottom: 10px;\n  padding-left: 24px;\n  position: relative;\n  line-height: 1.55;\n}\n\n.hidden-price-tags li::before {\n  content: '⚠️';\n  position: absolute;\n  left: 0;\n  font-size: 0.85rem;\n}\n\n.fault-lines {\n  padding: 20px 24px;\n  background: linear-gradient(135deg, rgba(155, 89, 182, 0.08) 0%, rgba(142, 68, 173, 0.06) 100%);\n  border-radius: 12px;\n  border: 1px solid rgba(155, 89, 182, 0.15);\n}\n\n.fault-lines h4 {\n  margin-bottom: 14px !important;\n  color: #c4b5fd;\n}\n\n.fault-lines p {\n  color: #757575;\n  line-height: 1.7;\n  margin: 0;\n}\n\n/* Detail section styling improvements */\n.detail-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding: 24px 28px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  background: linear-gradient(180deg, rgba(52, 152, 219, 0.05) 0%, transparent 100%);\n}\n\n.detail-title h3 {\n  margin: 0 0 8px;\n  color: #1a1a1a;\n  font-size: 1.5rem;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n}\n\n.detail-type {\n  font-size: 0.85rem;\n  color: #5dade2;\n  padding: 4px 12px;\n  background: rgba(52, 152, 219, 0.15);\n  border-radius: 20px;\n  display: inline-block;\n}\n\n.detail-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.export-btn {\n  padding: 10px 16px;\n  border-radius: 8px;\n  font-size: 0.82rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  border: 1px solid transparent;\n}\n\n.export-btn.export-md {\n  background: linear-gradient(135deg, #e0ddd8 0%, #f5f3f0 100%);\n  color: #4ade80;\n  border-color: rgba(39, 174, 96, 0.3);\n}\n\n.export-btn.export-md:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(39, 174, 96, 0.25);\n}\n\n.export-btn.export-json {\n  background: linear-gradient(135deg, #e0ddd8 0%, #f5f3f0 100%);\n  color: #93c5fd;\n  border-color: rgba(52, 152, 219, 0.3);\n}\n\n.export-btn.export-json:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(52, 152, 219, 0.25);\n}\n\n.detail-close {\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 8px;\n  color: #757575;\n  font-size: 1.4rem;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.detail-close:hover {\n  background: rgba(231, 76, 60, 0.15);\n  border-color: rgba(231, 76, 60, 0.3);\n  color: #e74c3c;\n}\n\n.detail-tabs {\n  display: flex;\n  padding: 0 28px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  background: rgba(0, 0, 0, 0.1);\n  overflow-x: auto;\n}\n\n.detail-tabs button {\n  padding: 16px 20px;\n  background: none;\n  border: none;\n  color: #7a7a9a;\n  font-size: 0.88rem;\n  font-weight: 500;\n  cursor: pointer;\n  border-bottom: 2px solid transparent;\n  white-space: nowrap;\n  transition: all 0.2s ease;\n  margin-bottom: -1px;\n}\n\n.detail-tabs button:hover {\n  color: #757575;\n  background: rgba(255, 255, 255, 0.02);\n}\n\n.detail-tabs button.active {\n  color: #5dade2;\n  border-bottom-color: #b5343a;\n  background: rgba(52, 152, 219, 0.08);\n}\n\n.detail-content {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 28px;\n}\n\n/* No Selection State */\n.no-selection {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: #5a5a7a;\n  text-align: center;\n  padding: 40px;\n}\n\n.no-selection-icon {\n  font-size: 4rem;\n  margin-bottom: 20px;\n  opacity: 0.6;\n}\n\n.no-selection p {\n  margin: 0 0 8px;\n  font-size: 1.05rem;\n}\n\n.no-selection-hint {\n  font-size: 0.88rem;\n  color: #4a4a6a;\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n  .big-picture-panel-body {\n    flex-direction: column;\n  }\n\n  .big-picture-list-section {\n    width: 100%;\n    height: 40%;\n    border-right: none;\n    border-bottom: 1px solid #e0ddd8;\n  }\n\n  .big-picture-detail-section {\n    height: 60%;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/BigPicturePanel.css\"],\"names\":[],\"mappings\":\"AAAA,sDAAsD;AACtD,2EAA2E;;AAE3E;EACE,eAAe;EACf,MAAM;EACN,OAAO;EACP,QAAQ;EACR,SAAS;EACT,8BAA8B;EAC9B,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,aAAa;EACb,aAAa;AACf;;AAEA;EACE,mBAAmB;EACnB,mBAAmB;EACnB,WAAW;EACX,iBAAiB;EACjB,YAAY;EACZ,aAAa;EACb,sBAAsB;EACtB,gBAAgB;EAChB,0CAA0C;AAC5C;;AAEA;EACE,kBAAkB;EAClB,gCAAgC;EAChC,kBAAkB;AACpB;;AAEA;EACE,SAAS;EACT,iBAAiB;EACjB,cAAc;AAChB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,iBAAiB;AACnB;;AAEA;EACE,kBAAkB;EAClB,WAAW;EACX,SAAS;EACT,gBAAgB;EAChB,YAAY;EACZ,cAAc;EACd,eAAe;EACf,eAAe;EACf,UAAU;EACV,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,aAAa;EACb,SAAO;EACP,gBAAgB;AAClB;;AAEA,gCAAgC;AAChC;EACE,YAAY;EACZ,+BAA+B;EAC/B,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,iBAAiB;AACjB;EACE,aAAa;EACb,gCAAgC;AAClC;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,cAAc;EACd,kBAAkB;EAClB,cAAc;EACd,kBAAkB;EAClB,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,uBAAuB;EACvB,aAAa;EACb,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,qBAAqB;AACvB;;AAEA;EACE,qBAAqB;EACrB,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,eAAe;AACjB;;AAEA;EACE,aAAa;EA