ound: #fef2f2;\n  border: 1px solid rgba(220, 38, 38, 0.22);\n  color: #991b1b;\n}\n\n.aoi-compose-form__error--system {\n  background: #fff7ed;\n  border: 1px solid rgba(234, 88, 12, 0.22);\n  color: #9a3412;\n}\n\n.aoi-compose-form__issues {\n  margin: 12px 0 0;\n  padding-left: 20px;\n}\n\n.aoi-compose-form__retry {\n  margin-top: 12px;\n}\n\n.aoi-compose-shell__meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  font-size: 0.95rem;\n  color: #475569;\n}\n\n.aoi-compose-shell__views {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.aoi-compose-shell__view {\n  padding-top: 12px;\n  border-top: 1px solid rgba(15, 23, 42, 0.08);\n}\n\n.aoi-compose-shell__view:first-child {\n  padding-top: 0;\n  border-top: none;\n}\n\n.aoi-compose-shell__view-description,\n.aoi-compose-shell__rationale {\n  margin: 8px 0 0;\n  color: #475569;\n}\n\n.aoi-compose-shell__engine {\n  white-space: nowrap;\n  padding: 4px 8px;\n  border-radius: 999px;\n  background: #eff6ff;\n  color: #1d4ed8;\n  font-size: 0.85rem;\n}\n\n.aoi-compose-shell__details pre {\n  overflow-x: auto;\n  white-space: pre-wrap;\n  background: #0f172a;\n  color: #e2e8f0;\n  padding: 16px;\n  border-radius: 12px;\n}\n\n@media (max-width: 960px) {\n  .aoi-compose-page__header,\n  .aoi-compose-form__section-header,\n  .aoi-compose-shell__view-header {\n    flex-direction: column;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/AoiComposeFromIntentPage.css\"],\"names\":[],\"mappings\":\"AAAA;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,SAAS;EACT,uBAAuB;EACvB,kBAAkB;EAClB,wCAAwC;EACxC,mBAAmB;EACnB;;iFAE+E;AACjF;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,oBAAoB;EACpB,mBAAmB;EACnB,cAAc;EACd,gBAAgB;EAChB,qBAAqB;AACvB;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,SAAS;EACT,gBAAgB;EAChB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;EACR,gBAAgB;EAChB,kBAAkB;EAClB,cAAc;AAChB;;AAEA;;EAEE,aAAa;EACb,sBAAsB;EACtB,SAAS;EACT,aAAa;EACb,wCAAwC;EACxC,mBAAmB;EACnB,gBAAgB;AAClB