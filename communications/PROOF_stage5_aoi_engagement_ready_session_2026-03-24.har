nter;\n  transition: color 0.15s ease;\n  position: relative;\n}\n\n.nav-dropdown-trigger::after {\n  content: '';\n  position: absolute;\n  bottom: -0.875rem;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: transparent;\n  transition: background 0.15s ease;\n}\n\n.nav-dropdown-trigger:hover {\n  color: var(--text-primary);\n}\n\n.nav-dropdown.active .nav-dropdown-trigger {\n  color: var(--accent-primary);\n}\n\n.nav-dropdown.active .nav-dropdown-trigger::after {\n  background: var(--accent-primary);\n}\n\n.nav-dropdown-arrow {\n  font-size: 0.625rem;\n  transition: transform 0.15s ease;\n}\n\n.nav-dropdown.open .nav-dropdown-arrow {\n  transform: rotate(180deg);\n}\n\n.nav-dropdown-menu {\n  position: absolute;\n  top: calc(100% + 0.875rem);\n  left: 50%;\n  transform: translateX(-50%);\n  min-width: 180px;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-md);\n  padding: 0.25rem;\n  z-index: 200;\n  animation: dropdownFadeIn 0.15s ease;\n}\n\n@keyframes dropdownFadeIn {\n  from {\n    opacity: 0;\n    transform: translateX(-50%) translateY(-4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(-50%) translateY(0);\n  }\n}\n\n.nav-dropdown-item {\n  display: block;\n  padding: 0.625rem 1rem;\n  color: var(--text-secondary);\n  text-decoration: none;\n  font-family: var(--font-ui);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  border-radius: var(--radius-sm);\n  transition: all 0.15s ease;\n}\n\n.nav-dropdown-item:hover {\n  background: var(--bg-elevated);\n  color: var(--text-primary);\n}\n\n.nav-dropdown-item.active {\n  background: var(--accent-subtle);\n  color: var(--accent-primary);\n}\n\n/* Responsive adjustments */\n@media (max-width: 1024px) {\n  .nav-dropdown-trigger {\n    padding: 0.5rem 0.75rem;\n    font-size: var(--text-xs);\n  }\n\n  .nav-dropdown-trigger::after {\n    bottom: -0.75rem;\n  }\n\n  .nav-dropdown-menu {\n    top: calc(100% + 0.75rem);\n    min-width: 160px;\n  }\n\n  .nav-dropdown-item {\n    padding: 0.5rem 0.875rem;\n    font-size: var(--text-xs);\n  }\n}\n\n@media (max-width: 600px) {\n  .nav-dropdown-trigger {\n    padding: 0.375rem 0.5rem;\n  }\n\n  .nav-dropdown-menu {\n    min-width: 140px;\n    left: 0;\n    transform: none;\n  }\n\n  @keyframes dropdownFadeIn {\n    from {\n      opacity: 0;\n      transform: translateY(-4px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/NavDropdown.css\"],\"names\":[],\"mappings\":\"AAAA,sDAAsD;;AAEtD;EACE,kBAAkB;EAClB,oBAAoB;AACtB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,YAAY;EACZ,wBAAwB;EACxB,YAAY;EACZ,uBAAuB;EACvB,4BAA4B;EAC5B,2BAA2B;EAC3B,yBAAyB;EACzB,gBAAgB;EAChB,eAAe;EACf,4BAA4B;EAC5B,kBAAkB;AACpB;;AAEA;EACE,WAAW;EACX,kBAAkB;EAClB,iBAAiB;EACjB,OAAO;EACP,QAAQ;EACR,WAAW;EACX,uBAAuB;EACvB,iCAAiC;AACnC;;AAEA;EACE,0BAA0B;AAC5B;;AAEA;EACE,4BAA4B;AAC9B;;AAEA;EACE,iCAAiC;AACnC;;AAEA;EACE,mBAAmB;EACnB,gCAAgC;AAClC;;AAEA;EACE,yBAAyB;AAC3B;;AAEA;EACE,kBAAkB;EAClB,0BAA0B;EAC1B,SAAS;EACT,2BAA2B;EAC3B,gBAAgB;EAChB,6BAA6B;EAC7B,qCAAqC;EACrC,+BAA+B;EAC/B,4BAA4B;EAC5B,gBAAgB;EAChB,YAAY;EACZ,oCAAoC;AACtC;;AAEA;EACE;IACE,UAAU;IACV,4CAA4C;EAC9C;EACA;IACE,UAAU;IACV,yCAAyC;EAC3C;AACF;;AAEA;EACE,cAAc;EACd,sBAAsB;EACtB,4BAA4B;EAC5B,qBAAqB;EACrB,2BAA2B;EAC3B,yBAAyB;EACzB,gBAAgB;EAChB,+BAA+B;EAC/B,0BAA0B;AAC5B;;AAEA;EACE,8BAA8B;EAC9B,0BAA0B;AAC5B;;AAEA;EACE,gCAAgC;EAChC,4BAA4B;AAC9B;;AAEA,2BAA2B;AAC3B;EACE;IACE,uBAAuB;IACvB,yBAAyB;EAC3B;;EAEA;IACE,gBAAgB;EAClB;;EAEA;IACE,yBAAyB;IACzB,gBAAgB;EAClB;;EAEA;IACE,wBAAwB;IACxB,yBAAyB;EAC3B;AACF;;AAEA;EACE;IACE,wBAAwB;EAC1B;;EAEA;IACE,gBAAgB;IAChB,OAAO;IACP,eAAe;EACjB;;EAEA;IACE;MACE,UAAU;MACV,2BAA2B;IAC7B;IACA;MACE,UAAU;MACV,wBAAwB;IAC1B;EACF;AACF\",\"sourcesContent\":[\"/* NavDropdown - Editorial style dropdown navigation */\\n\\n.nav-dropdown {\\n  position: relative;\\n  display: inline-flex;\\n}\\n\\n.nav-dropdown-tr