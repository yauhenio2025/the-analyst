\n  font-size: 0.78rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.18s ease;\n}\n\n.research-capture-toggle:hover {\n  background: rgba(194, 99, 90, 0.2);\n  color: #e4b8a8;\n  border-color: rgba(194, 99, 90, 0.4);\n}\n\n.research-capture-toggle.active {\n  background: rgba(245, 158, 11, 0.15);\n  color: #f59e0b;\n  border-color: rgba(245, 158, 11, 0.4);\n}\n\n.research-capture-pin {\n  background: none;\n  border: 1px solid #544a3f;\n  border-radius: 4px;\n  color: #cec4b8;\n  cursor: pointer;\n  padding: 2px 6px;\n  font-size: 0.85rem;\n  flex-shrink: 0;\n  transition: all 0.15s;\n  margin-right: 8px;\n}\n\n.research-capture-pin:hover {\n  background: rgba(245, 158, 11, 0.15);\n  border-color: #f59e0b;\n  color: #f59e0b;\n}\n\n.research-new-btn {\n  background: rgba(194, 99, 90, 0.15);\n  color: #e4b4a4;\n  border: 1px solid rgba(194, 99, 90, 0.3);\n  border-radius: 8px;\n  padding: 7px 16px;\n  font-size: 0.8rem;\n  font-weight: 600;\n  cursor: pointer;\n  flex-shrink: 0;\n  transition: all 0.18s ease;\n}\n\n.research-new-btn:hover {\n  background: rgba(194, 99, 90, 0.25);\n  border-color: rgba(194, 99, 90, 0.5);\n  color: #f0cbb8;\n  box-shadow: 0 2px 8px rgba(194, 99, 90, 0.15);\n}\n\n/* New question form */\n.research-new-form {\n  background: #1a1714;\n  border: 1px solid rgba(90, 78, 65, 0.4);\n  border-radius: 8px;\n  padding: 14px;\n  margin-bottom: 16px;\n}\n\n.research-new-textarea {\n  width: 100%;\n  background: #12100e;\n  border: 1px solid #3d352c;\n  border-radius: 6px;\n  color: #f5efe6;\n  padding: 10px;\n  font-size: 0.9rem;\n  font-family: inherit;\n  resize: vertical;\n  outline: none;\n  box-sizing: border-box;\n}\n\n.research-new-textarea:focus {\n  border-color: #c2635a;\n}\n\n.research-new-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.research-new-select {\n  background: #12100e;\n  border: 1px solid #3d352c;\n  border-radius: 6px;\n  color: #f5efe6;\n  padding: 6px 10px;\n  font-size: 0.82rem;\n  cursor: pointer;\n}\n\n.research-new-save {\n  background: #c2635a;\n  color: #fff;\n  border: none;\n  border-radius: 6px;\n  padding: 6px 16px;\n  font-size: 0.82rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.research-new-save:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.research-new-cancel {\n  background: #3d352c;\n  color: #cec4b8;\n  border: none;\n  border-radius: 6px;\n  padding: 6px 14px;\n  font-size: 0.82rem;\n  cursor: pointer;\n}\n\n/* Filter styles are now in ResearchPageLayout.css (view toggle + priority pills) */\n\n/* Loading / Empty */\n.research-loading {\n  text-align: center;\n  color: #b0a89c;\n  padding: 40px;\n}\n\n.research-empty {\n  text-align: center;\n  color: #b0a89c;\n  padding: 60px 20px;\n}\n\n.research-empty p {\n  margin: 4px 0;\n}\n\n.research-empty-hint {\n  font-size: 0.82rem;\n  color: #968e82;\n}\n\n/* Todo list */\n.research-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n/* Todo card */\n.research-card {\n  background: #1c1916;\n  border: 1px solid rgba(90, 78, 65, 0.4);\n  border-left: 3px solid;\n  border-radius: 0 10px 10px 0;\n  overflow: hidden;\n  transition: all 0.2s ease;\n}\n\n.research-card:hover {\n  border-color: rgba(110, 95, 78, 0.6);\n  border-left-color: inherit;\n  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);\n}\n\n.research-card.expanded {\n  border-color: rgba(110, 95, 78, 0.7);\n  background: #1c1916;\n  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);\n  overflow: visible; /* Required for position: sticky on annotations panel */\n}\n\n/* Card header layout is now in ResearchPageLayout.css (includes done toggle) */\n\n.research-card-header:hover {\n  background: rgba(255, 255, 255, 0.015);\n}\n\n.research-card-question {\n  width: 100%;\n}\n\n.research-q-text {\n  font-size: 0.88rem;\n  color: #f5efe6;\n  line-height: 1.5;\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n.research-edit-textarea {\n  width: 100%;\n  background: #12100e;\n  border: 1px solid #c2635a;\n  border-radius: 4px;\n  color: #f5efe6;\n  padding: 8px;\n  font-size: 0.88rem;\n  font-family: 'Source Serif 4', Georgia, serif;\n  resize: vertical;\n  outline: none;\n  box-sizing: border-box;\n}\n\n.research-card-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n}\n\n.research-priority-badge,\n.research-status-badge {\n  display: inline-block;\n  padding: 3px 9px;\n  border-radius: 4px;\n  font-size: 0.65rem;\n  font-weight: 700;\n  color: #fff;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.research-type-badge {\n  display: inline-block;\n  padding: 3px 10px;\n  border-radius: 4px;\n  font-size: 0.68rem;\n  font-weight: 500;\n  color: #daa89f;\n  background: rgba(194, 99, 90, 0.12);\n  border: 1px solid rgba(194, 99, 90, 0.2);\n}\n\n.research-tag {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-size: 0.66rem;\n  color: #ccc2b6;\n  background: rgba(100, 88, 75, 0.3);\n  border: none;\n  font-weight: 500;\n}\n\n.research-card-source {\n  padding: 2px 18px 10px;\n  font-size: 0.72rem;\n  color: #a09888;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.research-card-source .source-label {\n  color: #928a7e;\n  font-weight: 500;\n}\n\n.research-card-source .source-path {\n  color: #b0a898;\n}\n\n.capture-depth-badge-sm {\n  font-size: 0.6rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 2px 7px;\n  border-radius: 3px;\n}\n.capture-depth-badge-sm.depth-L1_section {\n  background: rgba(194, 99, 90, 0.12);\n  color: #daa89f;\n}\n.capture-depth-badge-sm.depth-L2_element {\n  background: rgba(251, 191, 36, 0.1);\n  color: #fbbf24;\n}\n\n/* Expanded detail */\n.research-card-detail {\n  border-top: 1px solid rgba(90, 78, 65, 0.5);\n  margin-top: 2px;\n}\n\n/* Flex row: card detail content + annotations panel side by side */\n.research-card-detail-with-panel {\n  display: flex;\n  align-items: flex-start;\n  gap: 0;\n}\n\n.research-card-detail-content {\n  flex: 1 1;\n  min-width: 0;\n  padding: 4px 18px 16px;\n}\n\n.research-detail-section {\n  margin-top: 16px;\n}\n\n.research-detail-section h4 {\n  margin: 0 0 8px;\n  font-size: 0.7rem;\n  font-weight: 600;\n  color: #bcb2a4;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.research-detail-section p {\n  margin: 0;\n  font-size: 0.85rem;\n  color: #ebe3d8;\n  line-height: 1.6;\n}\n\n.research-scope-group {\n  font-size: 0.82rem;\n  color: #c4bab0;\n  margin-bottom: 5px;\n  line-height: 1.5;\n}\n\n.research-scope-group strong {\n  color: #ddd4c8;\n  font-weight: 600;\n}\n\n.research-source-quote {\n  margin: 0;\n  padding: 10px 16px;\n  border-left: 3px solid rgba(194, 99, 90, 0.35);\n  background: rgba(18, 16, 14, 0.6);\n  font-size: 0.82rem;\n  color: #cec4b8;\n  font-style: italic;\n  line-height: 1.6;\n  border-radius: 0 6px 6px 0;\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n.research-answer {\n  background: rgba(180, 160, 120, 0.05);\n  border: 1px solid rgba(180, 160, 120, 0.1);\n  border-radius: 8px;\n  padding: 16px 18px;\n}\n\n.research-answer-content {\n  position: relative;\n}\n\n/* Simplified highlight count label in answer header */\n.research-highlight-count {\n  font-size: 0.68rem;\n  font-weight: 500;\n  color: #d4857e;\n  margin-left: auto;\n  font-family: 'Inter', -apple-system, sans-serif;\n  letter-spacing: 0;\n  font-style: normal;\n  text-transform: none;\n}\n\n.research-answer h4 {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n}\n\n.research-answer-agent {\n  font-size: 0.65rem;\n  font-weight: 400;\n  color: #9c9488;\n  text-transform: none;\n  letter-spacing: 0;\n  font-style: italic;\n}\n\n/* (old comment-hint and comment-count badges removed — replaced by .research-highlight-count) */\n\n/* NotebookLM HTML answer with inline citations */\n.research-answer-html {\n  font-size: 0.88rem;\n  color: #ede5da;\n  line-height: 1.65;\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n.research-answer-html p {\n  margin: 0 0 12px;\n}\n\n/* When formatted sections exist, give prose paragraphs matching visual weight */\n.research-answer-html > div > p:not(:only-child) {\n  padding: 8px 16px;\n  background: rgba(18, 16, 14, 0.25);\n  border-radius: 6px;\n  border-left: 3px solid rgba(168, 158, 146, 0.15);\n  margin: 10px 0;\n}\n\n.research-answer-html p:last-child {\n  margin-bottom: 0;\n}\n\n/* Headings extracted from ### markdown */\n.research-answer-heading {\n  font-size: 0.92rem;\n  font-weight: 700;\n  color: #f5efe6;\n  margin: 22px 0 8px;\n  padding-bottom: 5px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n  font-family: 'Source Serif 4', Georgia, serif;\n  letter-spacing: -0.01em;\n}\n\n.research-answer-heading:first-child {\n  margin-top: 4px;\n}\n\n/* Blockquotes extracted from > markdown */\n.research-answer-blockquote {\n  margin: 8px 0 12px;\n  padding: 10px 14px;\n  border-left: 3px solid #c2635a;\n  background: rgba(194, 99, 90, 0.06);\n  color: #cec4b8;\n  font-style: italic;\n  font-size: 0.84rem;\n  line-height: 1.6;\n  border-radius: 0 4px 4px 0;\n}\n\n/* Inline citations — hoverable */\n.research-answer-html sup {\n  color: #c2635a;\n  font-weight: 700;\n  font-size: 0.7em;\n  cursor: help;\n  transition: color 0.1s;\n}\n\n.research-answer-html sup:hover {\n  color: #d4857e;\n}\n\n.research-answer-html strong,\n.research-answer-html b {\n  color: #f5efe6;\n  font-weight: 600;\n}\n\n/* Footnote tooltip — positioned above citation */\n.fn-tooltip {\n  position: absolute;\n  transform: translate(-50%, -100%);\n  max-width: 420px;\n  min-width: 220px;\n  background: linear-gradient(135deg, #1e1b18 0%, #12100e 100%);\n  border: 1px solid rgba(194, 99, 90, 0.25);\n  border-radius: 10px;\n  padding: 14px 16px 12px;\n  box-shadow:\n    0 4px 6px rgba(0, 0, 0, 0.3),\n    0 12px 28px rgba(0, 0, 0, 0.45),\n    0 0 0 1px rgba(255, 255, 255, 0.04) inset;\n  z-index: 1000;\n  pointer-events: none;\n  animation: fn-tooltip-in 0.15s ease-out;\n}\n\n/* Flip transform when showing below */\n.fn-tooltip.fn-tooltip--below {\n  transform: translate(-50%, 0%);\n}\n\n@keyframes fn-tooltip-in {\n  from { opacity: 0; transform: translate(-50%, -100%) translateY(4px); }\n  to   { opacity: 1; transform: translate(-50%, -100%) translateY(0); }\n}\n\n.fn-tooltip.fn-tooltip--below {\n  animation-name: fn-tooltip-in-below;\n}\n\n@keyframes fn-tooltip-in-below {\n  from { opacity: 0; transform: translate(-50%, 0%) translateY(-4px); }\n  to   { opacity: 1; transform: translate(-50%, 0%) translateY(0); }\n}\n\n.fn-tooltip-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: rgba(194, 99, 90, 0.2);\n  color: #d4857e;\n  font-size: 0.65rem;\n  font-weight: 700;\n  font-family: 'Inter', sans-serif;\n  margin-bottom: 6px;\n  border: 1px solid rgba(194, 99, 90, 0.3);\n}\n\n.fn-tooltip-source {\n  font-size: 0.74rem;\n  font-weight: 600;\n  color: #e8c5b0;\n  margin-bottom: 6px;\n  font-family: 'Inter', sans-serif;\n  letter-spacing: 0.01em;\n  line-height: 1.35;\n}\n\n.fn-tooltip-quote {\n  font-size: 0.78rem;\n  color: #cec4b8;\n  line-height: 1.55;\n  font-style: italic;\n  font-family: 'Source Serif 4', Georgia, serif;\n  padding-top: 6px;\n  border-top: 1px solid rgba(100, 88, 75, 0.4);\n}\n\n/* ── Formatted answer structure (Haiku-restructured HTML) ── */\n\n.fmt-loading {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 0 10px;\n  font-size: 0.75rem;\n  color: #a8a094;\n  font-style: italic;\n  font-family: 'Inter', sans-serif;\n}\n\n.fmt-loading-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #c2635a;\n  animation: fmt-pulse 1s ease-in-out infinite;\n}\n\n@keyframes fmt-pulse {\n  0%, 100% { opacity: 0.3; transform: scale(0.85); }\n  50% { opacity: 1; transform: scale(1); }\n}\n\n/* Numbered sections (e.g. \"1. The Problem of Cloudists...\") */\n.fmt-section {\n  margin: 20px 0 16px;\n  padding: 14px 16px;\n  background: rgba(32, 28, 24, 0.4);\n  border: 1px solid rgba(90, 78, 65, 0.3);\n  border-radius: 8px;\n  border-left: 3px solid rgba(194, 99, 90, 0.4);\n}\n\n.fmt-section-title {\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: #f5efe6;\n  margin: 0 0 10px;\n  font-family: 'Source Serif 4', Georgia, serif;\n  letter-spacing: -0.01em;\n  line-height: 1.4;\n}\n\n/* Sub-points (e.g. \"Consistency with Prior Work:\", \"Genuine Response?\") */\n.fmt-subpoint {\n  margin: 8px 0;\n  padding: 6px 0 6px 14px;\n  border-left: 2px solid rgba(100, 88, 75, 0.4);\n  font-size: 0.86rem;\n  line-height: 1.6;\n  color: #ede5da;\n}\n\n.fmt-subpoint.fmt-solution {\n  border-left-color: rgba(180, 160, 120, 0.35);\n  background: rgba(180, 160, 120, 0.04);\n  padding: 8px 12px;\n  border-radius: 0 6px 6px 0;\n  margin: 10px 0;\n}\n\n.fmt-subpoint.fmt-evaluation {\n  border-left-color: rgba(251, 191, 36, 0.35);\n}\n\n.fmt-label {\n  font-weight: 700;\n  color: #cec4b8;\n  font-size: 0.78rem;\n  font-family: 'Inter', sans-serif;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  margin-right: 4px;\n}\n\n.fmt-body {\n  color: #ede5da;\n}\n\n/* Evaluative headings (\"How Natural or Artificial...\") */\n.fmt-eval-heading {\n  font-size: 0.92rem;\n  font-weight: 700;\n  color: #f5efe6;\n  margin: 24px 0 10px;\n  padding-bottom: 6px;\n  border-bottom: 1px solid rgba(194, 99, 90, 0.15);\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n/* Summary blocks */\n.fmt-summary {\n  margin: 16px 0;\n  padding: 12px 16px;\n  background: rgba(194, 99, 90, 0.05);\n  border: 1px solid rgba(194, 99, 90, 0.15);\n  border-radius: 8px;\n  font-size: 0.86rem;\n  color: #ede5da;\n  line-height: 1.6;\n}\n\n.fmt-summary strong {\n  color: #daa89f;\n}\n\n/* Ensure footnotes inside formatted sections inherit properly */\n.fmt-section sup.citation,\n.fmt-subpoint sup.citation,\n.fmt-summary sup.citation {\n  color: #c2635a;\n  font-weight: 700;\n  font-size: 0.7em;\n  cursor: help;\n}\n\n/* Footnotes section — grouped by source */\n.research-footnotes {\n  margin-top: 14px;\n  padding-top: 10px;\n  border-top: 1px solid rgba(180, 160, 120, 0.15);\n}\n\n.research-source-group-block {\n  margin-bottom: 12px;\n}\n\n.research-fn-source-header {\n  font-weight: 600;\n  color: #ede5da;\n  font-size: 0.8rem;\n  margin-bottom: 6px;\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n.research-fn-entry {\n  margin-bottom: 8px;\n  padding-left: 12px;\n}\n\n.research-fn-numbers {\n  font-size: 0.72rem;\n  color: #c2635a;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n\n/* Clickable back-reference links in Sources section */\n.fn-backref {\n  color: #c2635a;\n  text-decoration: none;\n  cursor: pointer;\n}\n.fn-backref:hover {\n  text-decoration: underline;\n  color: #d4857e;\n}\n\n/* Clickable citation sups in answer text */\n.research-answer-html sup.citation {\n  cursor: pointer;\n}\n\n/* Highlight flash when scrolling to a citation or source entry */\n.fn-highlight {\n  animation: fn-flash 1.5s ease-out;\n}\n@keyframes fn-flash {\n  0% { background: rgba(194, 99, 90, 0.35); border-radius: 3px; }\n  100% { background: transparent; }\n}\n\n.research-fn-quote {\n  margin: 3px 0 0;\n  padding: 6px 10px;\n  border-left: 2px solid #544a3f;\n  background: rgba(0, 0, 0, 0.15);\n  font-size: 0.76rem;\n  color: #cec4b8;\n  font-style: italic;\n  line-height: 1.5;\n  border-radius: 0 3px 3px 0;\n}\n\n/* ── Show in Book — Footnote Context ── */\n\n.fn-context-wrapper {\n  margin-top: 4px;\n}\n\n.fn-show-in-book {\n  background: none;\n  border: none;\n  color: #b4946a;\n  font-size: 0.7rem;\n  font-family: 'Inter', sans-serif;\n  cursor: pointer;\n  padding: 2px 0;\n  opacity: 0.7;\n  transition: opacity 0.15s;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.fn-show-in-book:hover {\n  opacity: 1;\n  text-decoration: underline;\n}\n.fn-show-in-book:disabled {\n  cursor: wait;\n  opacity: 0.5;\n}\n\n.fn-book-spinner {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  border: 1.5px solid rgba(180, 148, 106, 0.3);\n  border-top-color: #b4946a;\n  border-radius: 50%;\n  animation: fn-spin 0.6s linear infinite;\n}\n@keyframes fn-spin {\n  to { transform: rotate(360deg); }\n}\n\n.fn-context-error {\n  font-size: 0.7rem;\n  color: #c2635a;\n  margin-top: 4px;\n}\n\n.fn-book-context {\n  margin-top: 6px;\n  padding: 12px 14px;\n  background: rgba(0, 0, 0, 0.25);\n  border-left: 3px solid #b4946a;\n  border-radius: 0 4px 4px 0;\n  font-family: 'Source Serif 4', Georgia, serif;\n  font-size: 0.78rem;\n  line-height: 1.65;\n  color: #d4cdc4;\n  animation: fn-context-expand 0.2s ease-out;\n}\n@keyframes fn-context-expand {\n  from { opacity: 0; max-height: 0; }\n  to { opacity: 1; max-height: 2000px; }\n}\n\n.fn-context-heading {\n  font-weight: 700;\n  color: #ede5da;\n  font-size: 0.82rem;\n  margin-bottom: 8px;\n  padding-bottom: 4px;\n  border-bottom: 1px solid rgba(180, 148, 106, 0.2);\n  font-family: 'Source Serif 4', Georgia, serif;\n}\n\n.fn-context-dim {\n  color: #9e9588;\n  white-space: pre-wrap;\n}\n\n.fn-context-match {\n  margin: 8px 0;\n  white-space: pre-wrap;\n}\n\n.fn-context-match mark {\n  background: rgba(180, 148, 106, 0.25);\n  color: #ede5da;\n  padding: 1px 2px;\n  border-radius: 2px;\n  font-style: normal;\n}\n\n.fn-quoted-phrase {\n  background: rgba(180, 148, 106, 0.45);\n  text-decoration: underline;\n  text-decoration-color: rgba(180, 148, 106, 0.7);\n  text-underline-offset: 2px;\n  text-decoration-thickness: 1.5px;\n}\n\n.fn-context-meta {\n  margin-top: 8px;\n  font-size: 0.65rem;\n  color: #8e867c;\n  font-family: 'Inter', sans-serif;\n  font-style: italic;\n}\n\n/* ---- Contextualization Panel ---- */\n\n.fn-contextualize-wrapper {\n  margin-top: 10px;\n  padding-top: 8px;\n  border-top: 1px solid rgba(122, 155, 118, 0.15);\n}\n\n.fn-contextualize-btn {\n  background: none;\n  border: none;\n  color: #7a9b76;\n  font-size: 0.7rem;\n  font-family: 'Inter', sans-serif;\n  cursor: pointer;\n  padding: 2px 0;\n  opacity: 0.8;\n  transition: opacity 0.15s;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.fn-contextualize-btn:hover {\n  opacity: 1;\n  text-decoration: underline;\n}\n.fn-contextualize-btn:disabled {\n  cursor: wait;\n  opacity: 0.5;\n}\n\n.fn-ctx-spinner {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  border: 1.5px solid rgba(122, 155, 118, 0.3);\n  border-top-color: #7a9b76;\n  border-radius: 50%;\n  animation: fn-spin 0.6s linear infinite;\n}\n\n.fn-contextualize-panel {\n  margin-top: 8px;\n  padding: 12px 14px;\n  background: rgba(0, 0, 0, 0.2);\n  border-left: 3px solid #7a9b76;\n  border-radius: 0 4px 4px 0;\n  font-family: 'Source Serif 4', Georgia, serif;\n  font-size: 0.78rem;\n  line-height: 1.65;\n  color: #d4cdc4;\n  animation: fn-context-expand 0.2s ease-out;\n}\n\n.fn-ctx-section {\n  margin-bottom: 10px;\n}\n\n.fn-ctx-toggle {\n  background: none;\n  border: none;\n  color: #a8a094;\n  font-size: 0.68rem;\n  font-family: 'Inter', sans-serif;\n  cursor: pointer;\n  padding: 2px 0;\n  opacity: 0.8;\n  transition: opacity 0.15s;\n}\n.fn-ctx-toggle:hover {\n  opacity: 1;\n  color: #d4cdc4;\n}\n\n.fn-ctx-book-summary {\n  margin-top: 6px;\n  padding: 8px 10px;\n  background: rgba(0, 0, 0, 0.15);\n  border-radius: 3px;\n  font-size: 0.74rem;\n  color: #9e9588;\n  white-space: pre-wrap;\n}\n\n.fn-ctx-chapter {\n  margin-bottom: 10px;\n  padding: 6px 10px;\n  background: rgba(122, 155, 118, 0.06);\n  border-radius: 3px;\n}\n\n.fn-ctx-chapter-title {\n  font-weight: 700;\n  color: #b8c4b6;\n  font-size: 0.76rem;\n  margin-bottom: 4px;\n}\n\n.fn-ctx-chapter-summary {\n  font-size: 0.74rem;\n  color: #9e9588;\n}\n\n.fn-ctx-book-summary p,\n.fn-ctx-chapter-summary p {\n  margin: 0 0 0.5em 0;\n}\n\n.fn-ctx-analysis {\n  color: #ede5da;\n  padding: 8px 0;\n  line-height: 1.7;\n}\n\n.fn-ctx-analysis p {\n  margin: 0 0 0.8em 0;\n}\n\n.fn-ctx-analysis h2,\n.fn-ctx-analysis h3,\n.fn-ctx-analysis h4 {\n  margin: 1.2em 0 0.4em 0;\n  color: #c9b99a;\n  font-family: var(--font-display, 'Playfair Display', serif);\n}\n\n.fn-ctx-analysis h3 {\n  font-size: 1.05em;\n}\n\n.fn-ctx-analysis h4 {\n  font-size: 0.95em;\n}\n\n.fn-ctx-extended {\n  margin-top: 10px;\n  padding-top: 8px;\n  border-top: 1px solid rgba(122, 155, 118, 0.12);\n}\n\n.fn-ctx-extended-text {\n  margin: 6px 0 10px;\n  padding: 8px 10px;\n  background: rgba(0, 0, 0, 0.15);\n  border-radius: 3px;\n  font-size: 0.72rem;\n  color: #9e9588;\n  white-space: pre-wrap;\n  max-height: 300px;\n  overflow-y: auto;\n}\n\n.fn-ctx-meta {\n  margin-top: 8px;\n  font-size: 0.62rem;\n  color: #7a9b76;\n  font-family: 'Inter', sans-serif;\n  font-style: italic;\n  opacity: 0.7;\n}\n\n.research-notebook-sources {\n  margin-top: 10px;\n  font-size: 0.72rem;\n  color: #a8a094;\n  font-style: italic;\n}\n\n/* Lookup button */\n.research-action-lookup {\n  background: rgba(194, 99, 90, 0.15);\n  color: #daa89f;\n  font-weight: 600;\n  border: 1px solid rgba(194, 99, 90, 0.25);\n}\n\n.research-action-lookup:hover {\n  background: rgba(194, 99, 90, 0.25);\n  color: #e8c5b0;\n  border-color: rgba(194, 99, 90, 0.4);\n}\n\n.research-action-lookup:disabled {\n  opacity: 0.5;\n  cursor: wait;\n}\n\n/* Lookup loading indicator */\n.research-lookup-loading {\n  padding: 8px 16px;\n  font-size: 0.78rem;\n  color: #c2635a;\n  background: rgba(194, 99, 90, 0.05);\n  border-top: 1px solid #3d352c;\n  animation: research-pulse 1.5s ease-in-out infinite;\n}\n\n@keyframes research-pulse {\n  0%, 100% { opacity: 0.6; }\n  50% { opacity: 1; }\n}\n\n/* Lookup error banner */\n.research-lookup-error {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  border-radius: 6px;\n  padding: 8px 14px;\n  margin-bottom: 12px;\n  font-size: 0.8rem;\n  color: #fca5a5;\n}\n\n.research-lookup-error button {\n  background: none;\n  border: none;\n  color: #fca5a5;\n  font-size: 1.1rem;\n  cursor: pointer;\n  padding: 0 4px;\n}\n\n/* Actions */\n.research-card-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n  margin-top: 16px;\n  padding-top: 12px;\n  border-top: 1px solid rgba(90, 78, 65, 0.5);\n}\n\n.research-action-btn {\n  background: rgba(90, 78, 65, 0.45);\n  color: #ddd5c8;\n  border: none;\n  border-radius: 6px;\n  padding: 6px 12px;\n  font-size: 0.75rem;\n  cursor: pointer;\n  font-weight: 500;\n  transition: all 0.18s ease;\n}\n\n.research-action-btn:hover {\n  background: rgba(110, 95, 78, 0.55);\n  color: #f5efe6;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);\n}\n\n.research-action-secondary {\n  color: #c4bab0;\n  background: rgba(90, 78, 65, 0.35);\n}\n\n.research-action-danger {\n  color: #f87171;\n  background: rgba(239, 68, 68, 0.08);\n}\n\n.research-action-danger:hover {\n  background: rgba(239, 68, 68, 0.18);\n}\n\n.research-action-select {\n  background: rgba(18, 16, 14, 0.5);\n  border: 1px solid rgba(90, 78, 65, 0.6);\n  border-radius: 6px;\n  color: #ebe3d8;\n  padding: 5px 8px;\n  font-size: 0.75rem;\n  cursor: pointer;\n}\n\n/* ── Queue Status Banner ── */\n.research-queue-banner {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 16px;\n  margin-bottom: 12px;\n  background: rgba(194, 99, 90, 0.12);\n  border: 1px solid rgba(194, 99, 90, 0.3);\n  border-radius: 8px;\n  color: #daa89f;\n  font-size: 0.85rem;\n}\n\n.research-queue-spinner {\n  width: 14px;\n  height: 14px;\n  border: 2px solid rgba(194, 99, 90, 0.3);\n  border-top-color: #d4857e;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n  flex-shrink: 0;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n.research-queue-count {\n  color: #cec4b8;\n  font-size: 0.8rem;\n}\n\n.research-provisioning-banner {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 16px;\n  margin-bottom: 12px;\n  background: rgba(90, 140, 194, 0.12);\n  border: 1px solid rgba(90, 140, 194, 0.3);\n  border-radius: 8px;\n  color: #9fbfda;\n  font-size: 0.85rem;\n}\n\n.research-provisioning-banner strong {\n  color: #b8d4ec;\n}\n\n.research-provisioning-error {\n  color: #daa89f;\n  font-size: 0.8rem;\n}\n\n/* ── Queue Indicator in Actions ── */\n.research-queue-indicator {\n  font-size: 0.78rem;\n  color: #daa89f;\n  font-style: italic;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.research-queue-indicator::before {\n  content: '';\n  width: 10px;\n  height: 10px;\n  border: 2px solid rgba(194, 99, 90, 0.3);\n  border-top-color: #d4857e;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n  flex-shrink: 0;\n}\n\n/* ── Pulse animation for processing badge ── */\n.research-status-badge.pulse {\n  animation: badge-pulse 1.5s ease-in-out infinite;\n}\n\n@keyframes badge-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.6; }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/ResearchTodosPage.css\"],\"names\":[],\"mappings\":\"AAAA,6BAA6B;;AAE7B;EACE,UAAU;AACZ;;AAEA,qDAAqD;;AAErD;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;AACV;;AAEA;EACE,kCAAkC;EAClC,cAAc;EACd,yCAAyC;EACzC,kBAAkB;EAClB,iBAAiB;EACjB,kBAAkB;EAClB,gBAAgB;EAChB,eAAe;EACf,0BAA0B;AAC5B;;AAEA;EACE,kCAAkC;EAClC,cAAc;EACd,oCAAoC;AACtC;;AAEA;EACE,oCAAoC;EACpC,cAAc;EACd,qCAAqC;AACvC;;AAEA;EACE,gBAAgB;EAChB,yBAAyB;EACzB,kBAAkB;EAClB,cAAc;EACd,eAAe;EACf,gBAAgB;EAChB,kBAAkB;EAClB,cAAc;EACd,qBAAqB;EACrB,iBAAiB;AACnB;;AAEA;EACE,oCAAoC;EACpC,qBAAqB;EACrB,cAAc;AAChB;;AAEA;EACE,mCAAmC;EACnC,cAAc;EACd,wCAAwC;EACxC,kBAAkB;EAClB,iBAAiB;EACjB,iBAAiB;EACjB,gBAAgB;EAChB,eAAe;EACf,cAAc;EACd,0BAA0B;AAC5B;;AAEA;EACE,mCAAmC;EACnC,oCAAoC;EACpC,cAAc;EACd,6CAA6C;AAC/C;;AAEA,sBAAsB;AACtB;EACE,mBAAmB;EACnB,uCAAuC;EACvC,kBAAkB;EAClB,aAAa;EACb,mBAAmB;AACrB;;AAEA;EACE,WAAW;EACX,mBAAmB;EACnB,yBAAyB;EACz