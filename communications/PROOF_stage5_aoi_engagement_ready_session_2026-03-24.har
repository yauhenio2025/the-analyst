rcase;\n  letter-spacing: 0.5px;\n  color: #22c55e;\n  background: rgba(34, 197, 94, 0.2);\n  padding: 2px 6px;\n  border-radius: 4px;\n  white-space: nowrap;\n}\n\n/* Connector */\n.timeline-connector {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-start;\n  min-width: 60px;\n  padding-top: 22px;\n  position: relative;\n}\n\n.connector-line {\n  height: 2px;\n  width: 100%;\n  background: linear-gradient(90deg, #9a2c31 0%, #b5343a 100%);\n  position: relative;\n}\n\n.connector-line::before,\n.connector-line::after {\n  content: '';\n  position: absolute;\n  width: 6px;\n  height: 6px;\n  background: #b5343a;\n  border-radius: 50%;\n  top: 50%;\n  transform: translateY(-50%);\n}\n\n.connector-line::before {\n  left: 0;\n}\n\n.connector-line::after {\n  right: 0;\n}\n\n/* Revision Marker */\n.revision-marker {\n  position: absolute;\n  top: 40px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  cursor: pointer;\n  padding: 4px 8px;\n  background: #f5f3f0;\n  border-radius: 6px;\n  transition: all 0.2s ease;\n}\n\n.revision-marker:hover {\n  background: #f5f3f0;\n  transform: scale(1.05);\n}\n\n.revision-trigger {\n  font-size: 14px;\n}\n\n.score-delta {\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.score-delta.positive {\n  color: #22c55e;\n}\n\n.score-delta.negative {\n  color: #ef4444;\n}\n\n/* Legend */\n.timeline-legend {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-top: 20px;\n  padding-top: 16px;\n  border-top: 1px solid #e0ddd8;\n  flex-wrap: wrap;\n}\n\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  color: #757575;\n}\n\n.legend-icon {\n  font-size: 14px;\n}\n\n.legend-color {\n  width: 12px;\n  height: 12px;\n  border-radius: 3px;\n}\n\n.legend-label {\n  white-space: nowrap;\n}\n\n/* Responsive */\n@media (max-width: 600px) {\n  .revision-timeline {\n    padding: 12px;\n  }\n\n  .node-circle {\n    width: 40px;\n    height: 40px;\n  }\n\n  .version-label {\n    font-size: 12px;\n  }\n\n  .timeline-connector {\n    min-width: 40px;\n  }\n\n  .timeline-legend {\n    gap: 12px;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/RevisionTimeline.css\"],\"names\":[],\"mappings\":\"AAAA,yBAAyB;;AAEzB;EACE,mBAAmB;EACnB,kBAAkB;EAClB,aAAa;EACb,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,iBAAiB;EACjB,WAAW;AACb;;AAEA,mBAAmB;AACnB;EACE,aAAa;EACb,uBAAuB;EACvB,sBAAsB;EACtB,eAAe;AACjB;;AAEA,iBAAiB;AACjB;EACE,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,eAAe;EACf,kBAAkB;EAClB,cAAc;AAChB;;AAEA;EACE,qBAAqB;EACrB,8CAA8C;AAChD;;AAEA;EACE,6CAA6C;AAC/C;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,6DAA6D;EAC7D,kBAAkB;EAClB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,yBAAyB;EACzB,yBAAyB;AAC3B;;AAEA;EACE,6DAA6D;AAC/D;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,WAAW;AACb;;AAEA;EACE,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,cAAc;EACd,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,WAAW;AACb;;AAEA;EACE,kBAAkB;EAClB,SAAS;EACT,SAAS;EACT,2BAA2B;EAC3B,cAAc;EACd,gBAAgB;EAChB,yBAAyB;EACzB,qBAAqB;EACrB,cAAc;EACd,kCAAkC;EAClC,gBAAgB;EAChB,kBAAkB;EAClB,mBAAmB;AACrB;;AAEA,cAAc;AACd;EACE,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,2BAA2B;EAC3B,eAAe;EACf,iBAAiB;EACjB,kBAAkB;AACpB;;AAEA;EACE,WAAW;EACX,WAAW;EACX,4DAA4D;EAC5D,kBAAkB;AACpB;;AAEA;;EAEE,WAAW;EACX,kBAAkB;EAClB,UAAU;EACV,WAAW;EACX,mBAAmB;EACnB,kBAAkB;EAClB,QAAQ;EACR,2BAA2B;AAC7B;;AAEA;EACE,OAAO;AACT;;AAEA;EACE,QAAQ;AACV;;AAEA,oBAAoB;AACpB;EACE,kBAAkB;EAClB,SAAS;EACT,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,QAAQ;EACR,eAAe;EACf,gBAAgB;EAChB,mBAAmB;EACnB,kBAAkB;EAClB,yBAAyB;AAC3B;;AAEA;EACE,mBAAmB;EACnB,sBAAsB;AACxB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,cAAc;AAChB;;AAEA,WAAW;AACX;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,gBAAgB;EAChB,iBAAiB;EACjB,6BAA6B;EAC7B,eAAe;AACjB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,WAAW;E