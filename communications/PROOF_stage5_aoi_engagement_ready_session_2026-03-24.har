",{\"version\":3,\"sources\":[\"webpack://./src/pages/BigPicturePage.css\"],\"names\":[],\"mappings\":\"AAAA,sCAAsC;;AAEtC;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,2DAA2D;AAC3D;EACE,kBAAkB;EAClB,WAAW;EACX,YAAY;EACZ,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,eAAe;AACjB;;AAEA;EACE,aAAa;AACf\",\"sourcesContent\":[\"/* BigPicturePage - Full page styles */\\n\\n.big-picture-page {\\n  flex: 1;\\n  display: flex;\\n  flex-direction: column;\\n  overflow: hidden;\\n}\\n\\n/* Override BigPicturePanel styles when in full page mode */\\n.big-picture-page .big-picture-panel {\\n  position: relative;\\n  width: 100%;\\n  height: 100%;\\n  max-width: none;\\n  border-radius: 0;\\n  box-shadow: none;\\n  animation: none;\\n}\\n\\n.big-picture-page .big-picture-panel-close {\\n  display: none;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/ConceptAnalysisPage.css\"\n/*!**************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/ConceptAnalysisPage.css ***!\n  \\**************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/* ConceptAnalysisPage - Full page styles */\n\n.concept-analysis-page {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Override ConceptsPanel styles when in full page mode */\n.concept-analysis-page .concepts-panel {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  max-width: none;\n  border-radius: 0;\n  box-shadow: none;\n  animation: none;\n}\n\n.concept-analysis-page .concepts-panel-close {\n  display: none;\n}\n\n/* =========================================================\n   DASHBOARD MODE - Full-width layout when no analysis selected\n   ========================================================= */\n\n/* Hide the old header when in dashboard mode */\n.concept-analysis-page .concepts-panel.dashboard-mode .concepts-panel-header {\n  display: none;\n}\n\n/* Dashboard body fills available space */\n.concept-analysis-page .concepts-dashboard {\n  flex: 1 1;\n  overflow-y: auto;\n  overflow-x: hidden;\n}\n\n/* --- Hero Section --- */\n.concept-analysis-page .dashboard-hero {\n  padding: 3rem 4rem 2rem;\n  background: linear-gradient(180deg, #faf8f5 0%, #f0ece6 100%);\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.concept-analysis-page .dashboard-hero-title {\n  font-family: 'Playfair Display', Georgia, serif;\n  font-size: 2.25rem;\n  font-weight: 700;\n  color: #2c2c2c;\n  margin: 0 0 0.5rem;\n  line-height: 1.2;\n}\n\n.concept-analysis-page .dashboard-hero-subtitle {\n  font-family: 'Source Serif Pro', Georgia, serif;\n  font-size: 1.05rem;\n  color: #757575;\n  margin: 0 0 1.75rem;\n}\n\n/* Search bar row */\n.concept-analysis-page .dashboard-search-row {\n  display: flex;\n  gap: 12px;\n  max-width: 640px;\n}\n\n.concept-analysis-page .dashboard-search-input {\n  flex: 1 1;\n  padding: 14px 18px;\n  font-size: 1rem;\n  font-family: 'Source Serif Pro', Georgia, serif;\n  border: 2px solid #d5d0c8;\n  border-radius: 6px;\n  background: #ffffff;\n  color: #2c2c2c;\n  transition: border-color 0.2s;\n}\n\n.concept-analysis-page .dashboard-search-input:focus {\n  outline: none;\n  border-color: var(--accent-primary, #b5343a);\n  box-shadow: 0 0 0 3px rgba(181, 52, 58, 0.1);\n}\n\n.concept-analysis-page .dashboard-search-input::placeholder {\n  color: #999;\n}\n\n.concept-analysis-page .dashboard-search-btn {\n  padding: 14px 28px;\n  background: var(--accent-primary, #b5343a);\n  color: #ffffff;\n  border: none;\n  border-radius: 6px;\n  font-size: 0.95rem;\n  font-weight: 600;\n  font-family: 'IBM Plex Sans', sans-serif;\n  cursor: pointer;\n  transition: background 0.2s, transform 0.15s;\n  white-space: nowrap;\n}\n\n.concept-analysis-page .dashboard-search-btn:hover:not(:disabled) {\n  background: #962d33;\n  transform: translateY(-1px);\n}\n\n.concept-analysis-page .dashboard-search-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* --- Type Selector Cards --- */\n.concept-analysis-page .dashboard-type-selector {\n  padding: 2rem 4rem;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.concept-analysis-page .dashboard-type-selector-label {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #999;\n  margin-bottom: 1rem;\n  font-weight: 600;\n}\n\n.concept-analysis-page .dashboard-type-cards {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n}\n\n.concept-analysis-page .dashboard-type-card {\n  background: #ffffff;\n  border: 1px solid #e0ddd8;\n  border-top: 3px solid transparent;\n  border-radius: 8px;\n  padding: 20px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.concept-analysis-page .dashboard-type-card:hover {\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);\n  transform: translateY(-1px);\n}\n\n.concept-analysis-page .dashboard-type-card.selected {\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);\n}\n\n/* Type-specific colors */\n.concept-analysis-page .dashboard-type-card.type-inferential {\n  border-top-color: transparent;\n}\n.concept-analysis-page .dashboard-type-card.type-inferential.selected {\n  border-top-color: #2c5aa0;\n  border-color: #2c5aa0;\n}\n.concept-analysis-page .dashboard-type-card.type-inferential .type-card-name {\n  color: #2c5aa0;\n}\n\n.concept-analysis-page .dashboard-type-card.type-logical {\n  border-top-color: transparent;\n}\n.concept-analysis-page .dashboard-type-card.type-logical.selected {\n  border-top-color: #b5343a;\n  border-color: #b5343a;\n}\n.concept-analysis-page .dashboard-type-card.type-logical .type-card-name {\n  color: #b5343a;\n}\n\n.concept-analysis-page .dashboard-type-card.type-assumption {\n  border-top-color: transparent;\n}\n.concept-analysis-page .dashboard-type-card.type-assumption.selected {\n  border-top-color: #2a7a6a;\n  border-color: #2a7a6a;\n}\n.concept-analysis-page .dashboard-type-card.type-assumption .type-card-name {\n  color: #2a7a6a;\n}\n\n.concept-analysis-page .type-card-name {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.95rem;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.concept-analysis-page .type-card-desc {\n  font-size: 0.82rem;\n  color: #757575;\n  line-height: 1.45;\n}\n\n.concept-analysis-page .type-card-engine-badge {\n  display: inline-block;\n  font-size: 0.65rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 1px 5px;\n  border-radius: 3px;\n  background: #2a7a6a;\n  color: #fff;\n  margin-left: 6px;\n  vertical-align: middle;\n}\n\n/* --- Detected Concepts Bar --- */\n.concept-analysis-page .dashboard-concepts-bar {\n  padding: 1.5rem 4rem;\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.concept-analysis-page .dashboard-concepts-bar-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 0.75rem;\n}\n\n.concept-analysis-page .dashboard-concepts-bar-label {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #999;\n  font-weight: 600;\n}\n\n.concept-analysis-page .dashboard-detect-btn {\n  padding: 6px 14px;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  border-radius: 5px;\n  font-size: 0.8rem;\n  color: #555;\n  cursor: pointer;\n  transition: all 0.2s;\n  font-family: 'IBM Plex Sans', sans-serif;\n}\n\n.concept-analysis-page .dashboard-detect-btn:hover:not(:disabled) {\n  background: #eae6df;\n  border-color: #ccc;\n}\n\n.concept-analysis-page .dashboard-detect-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.concept-analysis-page .dashboard-concepts-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n\n.concept-analysis-page .dashboard-concept-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 14px;\n  background: #f5f3f0;\n  border: 1px solid #e0ddd8;\n  border-radius: 20px;\n  font-size: 0.85rem;\n  color: #4a4a4a;\n  cursor: pointer;\n  transition: all 0.2s;\n  white-space: nowrap;\n  font-family: 'Source Serif Pro', Georgia, serif;\n}\n\n.concept-analysis-page .dashboard-concept-chip:hover {\n  background: #eae6df;\n  border-color: var(--accent-primary, #b5343a);\n  color: #2c2c2c;\n}\n\n.concept-analysis-page .dashboard-concept-chip .chip-centrality {\n  font-size: 0.65rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  padding: 1px 6px;\n  border-radius: 3px;\n  font-family: 'IBM Plex Sans', sans-serif;\n}\n\n.concept-analysis-page .dashboard-concept-chip .chip-centrality.centrality-core {\n  background: rgba(181, 52, 58, 0.12);\n  color: #b5343a;\n}\n\n.concept-analysis-page .dashboard-concept-chip .chip-centrality.centrality-important {\n  background: rgba(44, 90, 160, 0.1);\n  color: #2c5aa0;\n}\n\n.concept-analysis-page .dashboard-concept-chip .chip-centrality.centrality-peripheral {\n  background: rgba(127, 140, 141, 0.12);\n  color: #7f8c8d;\n}\n\n.concept-analysis-page .dashboard-concepts-empty {\n  color: #999;\n  font-size: 0.85rem;\n  font-style: italic;\n}\n\n.concept-analysis-page .dashboard-concepts-loading {\n  color: #999;\n  font-size: 0.85rem;\n}\n\n/* --- Running Jobs Bar --- */\n.concept-analysis-page .dashboard-running-bar {\n  padding: 1rem 4rem;\n  background: rgba(181, 52, 58, 0.04);\n  border-bottom: 1px solid #e0ddd8;\n}\n\n.concept-analysis-page .dashboard-running-label {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--accent-primary, #b5343a);\n  font-weight: 600;\n  margin-bottom: 0.5rem;\n}\n\n.concept-analysis-page .dashboard-running-pills {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.concept-analysis-page .dashboard-running-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  background: #ffffff;\n  border: 1px solid #e0ddd8;\n  border-left: 3px solid var(--accent-primary, #b5343a);\n  border-radius: 6px;\n  font-size: 0.85rem;\n}\n\n.concept-analysis-page .dashboard-running-pill .pill-concept {\n  font-weight: 500;\n  color: #2c2c2c;\n}\n\n.concept-analysis-page .dashboard-running-pill .pill-type {\n  color: #999;\n  font-size: 0.8rem;\n}\n\n.concept-analysis-page .dashboard-running-pill .pill-cancel {\n  background: none;\n  border: none;\n  color: #999;\n  cursor: pointer;\n  font-size: 0.9rem;\n  padding: 0 2px;\n  line-height: 1;\n  transition: color 0.2s;\n}\n\n.concept-analysis-page .dashboard-running-pill .pill-cancel:hover {\n  color: #e74c3c;\n}\n\n.concept-analysis-page .dashboard-running-pill .spinner {\n  width: 12px;\n  height: 12px;\n  border: 2px solid transparent;\n  border-top-color: var(--accent-primary, #b5343a);\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n/* --- Analyses Grid Section --- */\n.concept-analysis-page .dashboard-analyses-section {\n  padding: 2rem 4rem 3rem;\n}\n\n.concept-analysis-page .dashboard-analyses-header {\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n  margin-bottom: 1.25rem;\n}\n\n.concept-analysis-page .dashboard-analyses-label {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #999;\n  font-weight: 600;\n}\n\n.concept-analysis-page .dashboard-analyses-count {\n  font-size: 0.75rem;\n  color: #bbb;\n}\n\n.concept-analysis-page .dashboard-analyses-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 16px;\n}\n\n.concept-analysis-page .dashboard-analysis-card {\n  background: #ffffff;\n  border: 1px solid #e0ddd8;\n  border-left: 4px solid #ccc;\n  border-radius: 8px;\n  padding: 20px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.concept-analysis-page .dashboard-analysis-card:hover {\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);\n  transform: translateY(-2px);\n}\n\n/* Type-colored left stripes */\n.concept-analysis-page .dashboard-analysis-card.type-inferential {\n  border-left-color: #2c5aa0;\n}\n.concept-analysis-page .dashboard-analysis-card.type-logical {\n  border-left-color: #b5343a;\n}\n.concept-analysis-page .dashboard-analysis-card.type-assumption {\n  border-left-color: #2a7a6a;\n}\n\n.concept-analysis-page .dashboard-card-type-label {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.7rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  margin-bottom: 6px;\n}\n\n.concept-analysis-page .dashboard-analysis-card.type-inferential .dashboard-card-type-label {\n  color: #2c5aa0;\n}\n.concept-analysis-page .dashboard-analysis-card.type-logical .dashboard-card-type-label {\n  color: #b5343a;\n}\n.concept-analysis-page .dashboard-analysis-card.type-assumption .dashboard-card-type-label {\n  color: #2a7a6a;\n}\n\n.concept-analysis-page .dashboard-card-concept {\n  font-family: 'Source Serif Pro', Georgia, serif;\n  font-size: 1.15rem;\n  font-weight: 600;\n  color: #2c2c2c;\n  margin-bottom: 8px;\n  line-height: 1.3;\n}\n\n.concept-analysis-page .dashboard-card-metrics {\n  font-size: 0.82rem;\n  color: #757575;\n  margin-bottom: 10px;\n}\n\n.concept-analysis-page .dashboard-card-date {\n  font-size: 0.75rem;\n  color: #bbb;\n}\n\n.concept-analysis-page .dashboard-analyses-empty {\n  text-align: center;\n  padding: 3rem 2rem;\n  color: #999;\n}\n\n.concept-analysis-page .dashboard-analyses-empty p {\n  margin: 0;\n  font-size: 0.95rem;\n  font-family: 'Source Serif Pro', Georgia, serif;\n}\n\n/* Form error in dashboard mode */\n.concept-analysis-page .dashboard-form-error {\n  margin-top: 12px;\n  padding: 10px 14px;\n  background: rgba(231, 76, 60, 0.08);\n  border: 1px solid rgba(231, 76, 60, 0.3);\n  border-radius: 6px;\n  color: #c0392b;\n  font-size: 0.9rem;\n  max-width: 640px;\n}\n\n/* =========================================================\n   RESPONSIVE - Dashboard mode\n   ========================================================= */\n@media (max-width: 1024px) {\n  .concept-analysis-page .dashboard-hero {\n    padding: 2rem;\n  }\n\n  .concept-analysis-page .dashboard-type-selector {\n    padding: 1.5rem 2rem;\n  }\n\n  .concept-analysis-page .dashboard-type-cards {\n    grid-template-columns: 1fr;\n    gap: 10px;\n  }\n\n  .concept-analysis-page .dashboard-concepts-bar {\n    padding: 1.25rem 2rem;\n  }\n\n  .concept-analysis-page .dashboard-running-bar {\n    padding: 1rem 2rem;\n  }\n\n  .concept-analysis-page .dashboard-analyses-section {\n    padding: 1.5rem 2rem 2rem;\n  }\n\n  .concept-analysis-page .dashboard-analyses-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* =========================================================\n   DETAIL MODE - Full-width layout when analysis is selected\n   ========================================================= */\n\n/* Hide the old header when in detail mode */\n.concept-analysis-page .concepts-panel.detail-mode .concepts-panel-header {\n  display: none;\n}\n\n/* Full-width detail container */\n.concept-analysis-page .concepts-detail-fullwidth {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* --- Back Bar --- */\n.concept-analysis-page .detail-back-bar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 0.75rem 4rem;\n  border-bottom: 1px solid #e0ddd8;\n  background: #faf8f5;\n  flex-shrink: 0;\n}\n\n.concept-analysis-page .detail-back-btn {\n  background: none;\n  border: none;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.85rem;\n  color: var(--accent-primary, #b5343a);\n  cursor: pointer;\n  padding: 4px 0;\n  transition: color 0.2s;\n}\n\n.concept-analysis-page .detail-back-btn:hover {\n  color: #962d33;\n  text-decoration: underline;\n}\n\n.concept-analysis-page .detail-back-separator {\n  color: #ccc;\n  font-size: 0.75rem;\n}\n\n.concept-analysis-page .detail-back-concept {\n  font-family: 'Source Serif Pro', Georgia, serif;\n  font-size: 0.9rem;\n  color: #757575;\n}\n\n/* --- Detail Content Area --- */\n.concept-analysis-page .detail-fullwidth-content {\n  flex: 1 1;\n  overflow-y: auto;\n  padding: 0 4rem;\n}\n\n/* Center the analysis detail within the full-width container */\n.concept-analysis-page .detail-fullwidth-content .analysis-detail {\n  max-width: 960px;\n  margin: 0 auto;\n}\n\n/* Spacious detail header */\n.concept-analysis-page .detail-fullwidth-content .detail-header {\n  padding: 24px 0;\n}\n\n.concept-analysis-page .detail-fullwidth-content .detail-header h3 {\n  font-family: 'Playfair Display', Georgia, serif;\n  font-size: 1.75rem;\n  font-weight: 700;\n  color: #2c2c2c;\n  margin: 0;\n  line-height: 1.2;\n}\n\n/* Type pill styling in detail header */\n.concept-analysis-page .detail-fullwidth-content .detail-type {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 0.75rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 3px 10px;\n  border-radius: 12px;\n}\n\n.concept-analysis-page .detail-fullwidth-content .detail-type.type-inferential {\n  background: rgba(44, 90, 160, 0.1);\n  color: #2c5aa0;\n}\n\n.concept-analysis-page .detail-fullwidth-content .detail-type.type-logical {\n  background: rgba(181, 52, 58, 0.1);\n  color: #b5343a;\n}\n\n.concept-analysis-page .detail-fullwidth-content .detail-type.type-assumption {\n  background: rgba(42, 122, 106, 0.1);\n  color: #2a7a6a;\n}\n\n/* Hide the × close button in detail mode (replaced by back bar) */\n.concept-analysis-page .detail-fullwidth-content .detail-close {\n  display: none;\n}\n\n/* Tabs spacing */\n.concept-analysis-page .detail-fullwidth-content .detail-tabs {\n  padding: 0;\n}\n\n/* Content breathing room */\n.concept-analysis-page .detail-fullwidth-content .detail-content {\n  padding: 32px 0;\n}\n\n/* =========================================================\n   RESPONSIVE - Detail mode\n   ========================================================= */\n@media (max-width: 1024px) {\n  .concept-analysis-page .detail-back-bar {\n    padding: 0.75rem 2rem;\n  }\n\n  .concept-analysis-page .detail-fullwidth-content {\n    padding: 0 2rem;\n  }\n\n  .concept-analysis-page .detail-fullwidth-content .analysis-detail {\n    max-width: 100%;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/ConceptAnalysisPage.css\"],\"names\":[],\"mappings\":\"AAAA,2CAA2C;;AAE3C;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,yDAAyD;AACzD;EACE,kBAAkB;EAClB,WAAW;EACX,YAAY;EACZ,eAAe;EACf,gBAAgB;EAChB,gBAAgB;EAChB,eAAe;AACjB;;AAEA;EACE,aAAa;AACf;;AAEA;;8DAE8D;;AAE9D,+CAA+C;AAC/C;EACE,aAAa;AACf;;AAEA,yCAAyC;AACzC;EACE,SAAO;EACP,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA,yBAAyB;AACzB;EACE,uBAAuB;EACvB,6DAA6D;EAC7D,gCAAgC;AAClC;;AAEA;EACE,+CAA+C;EAC/C,kBAAkB;EAClB,gBAAgB;EAChB,cAAc;EACd,kBAAkB;EAClB,gBAAgB;AAClB;;AAEA;EACE,+CAA+C;EAC/C,kBAAkB;EAClB,cAAc;EACd,mBAAmB;AACrB;;AAEA,mBAAmB;AACnB;EACE,aAAa;EACb,SAAS;EACT,gBAAgB;AAClB;;AAEA;EACE,SAAO;EACP,kBAAkB;EAClB,eAAe;EACf,+CAA+C;EAC/C,yBAAyB;EACzB,kBAAkB;EAClB,mBAAmB;EACnB,cAAc;EACd,6BAA6B;AAC/B;;AAEA;EACE,aAAa;EACb,4CAA4C;EAC5C,4CAA4C;AAC9C;;AAEA;EACE,WAAW;AACb;;AAEA;EACE,kBAAkB;EAClB,0CAA0C;EAC1C,cAAc;EACd,YAAY;EACZ,kBAAkB;EAClB,kBAAkB;EAClB,gBAAgB;EAChB,wCAAwC;EACxC,eAAe;EACf,4CAA4C;EAC5C,mBAAmB;AACrB;;AAEA;EACE,mBAAmB;EACnB,2BAA2B;AAC7B;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA,gCAAgC;AAChC;EACE,kBAAkB;EAClB,gCAAgC;AAClC;;AAEA;EACE,wCAAwC;EACxC,kBAAkB;EAClB,yBAAyB;EACzB,sBAAsB;EACtB,WAAW;EACX,mBAAmB;EACnB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,qCAAqC;EACrC,SAAS;AACX;;AAEA;EACE,mBAAmB;EACnB,yBAAyB;EACzB,iCAAiC;EACjC