font-size: 0.875rem;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.lines-subnav-btn:hover {\n  background: var(--bg-card);\n  border-color: var(--border-color);\n  color: var(--text-primary);\n}\n\n.lines-subnav-btn.active {\n  background: rgba(32, 178, 170, 0.12);\n  border-color: #20b2aa;\n  color: #20b2aa;\n}\n\n.subnav-icon {\n  font-size: 1rem;\n}\n\n.subnav-label {\n  font-size: 0.875rem;\n}\n\n/* Main content area */\n.lines-content {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Page styles */\n.lines-page {\n  flex: 1 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* Override LinesOfAttackPanel styles when in page mode */\n.lines-page .lines-panel {\n  height: 100%;\n  border-radius: 0;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .lines-subnav {\n    padding: 0.5rem 1rem;\n    gap: 0.25rem;\n  }\n\n  .lines-subnav-btn {\n    padding: 0.4rem 0.75rem;\n    font-size: 0.8rem;\n  }\n\n  .subnav-label {\n    display: none;\n  }\n\n  .subnav-icon {\n    font-size: 1.1rem;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/LinesOfAttackPages.css\"],\"names\":[],\"mappings\":\"AAAA,gDAAgD;;AAEhD;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,mBAAmB;AACnB;EACE,aAAa;EACb,mBAAmB;EACnB,WAAW;EACX,uBAAuB;EACvB,8BAA8B;EAC9B,4CAA4C;AAC9C;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,WAAW;EACX,oBAAoB;EACpB,uBAAuB;EACvB,6BAA6B;EAC7B,+BAA+B;EAC/B,4BAA4B;EAC5B,mBAAmB;EACnB,gBAAgB;EAChB,eAAe;EACf,yBAAyB;AAC3B;;AAEA;EACE,0BAA0B;EAC1B,iCAAiC;EACjC,0BAA0B;AAC5B;;AAEA;EACE,oCAAoC;EACpC,qBAAqB;EACrB,cAAc;AAChB;;AAEA;EACE,eAAe;AACjB;;AAEA;EACE,mBAAmB;AACrB;;AAEA,sBAAsB;AACtB;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,gBAAgB;AAChB;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,gBAAgB;AAClB;;AAEA,yDAAyD;AACzD;EACE,YAAY;EACZ,gBAAgB;AAClB;;AAEA,eAAe;AACf;EACE;IACE,oBAAoB;IACpB,YAAY;EACd;;EAEA;IACE,uBAAuB;IACvB,iBAAiB;EACnB;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,