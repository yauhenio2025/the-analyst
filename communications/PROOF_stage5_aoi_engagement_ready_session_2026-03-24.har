font-size: 0.8rem;\\n  margin-bottom: 0.3rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.05em;\\n}\\n\\n.debates-create-form input,\\n.debates-create-form textarea {\\n  width: 100%;\\n  background: #0f172a;\\n  border: 1px solid #334155;\\n  color: #f1f5f9;\\n  padding: 0.5rem 0.75rem;\\n  border-radius: 4px;\\n  font-size: 0.95rem;\\n  box-sizing: border-box;\\n}\\n\\n.debates-create-form input:focus,\\n.debates-create-form textarea:focus {\\n  outline: none;\\n  border-color: #3b82f6;\\n}\\n\\n.debates-create-form button[type=\\\"submit\\\"] {\\n  background: #22c55e;\\n  color: white;\\n  border: none;\\n  padding: 0.6rem 1.5rem;\\n  border-radius: 6px;\\n  cursor: pointer;\\n  font-size: 0.9rem;\\n}\\n\\n.debates-create-form button[type=\\\"submit\\\"]:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n.debates-loading,\\n.debates-empty {\\n  text-align: center;\\n  color: #94a3b8;\\n  padding: 4rem 2rem;\\n  font-size: 1rem;\\n}\\n\\n.debates-error {\\n  background: #451a1a;\\n  border: 1px solid #dc2626;\\n  color: #fca5a5;\\n  padding: 1rem;\\n  border-radius: 6px;\\n  margin-bottom: 1.5rem;\\n}\\n\\n.debates-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\\n  gap: 1rem;\\n}\\n\\n.debate-card {\\n  background: #1e293b;\\n  border: 1px solid #334155;\\n  border-radius: 8px;\\n  position: relative;\\n  transition: border-color 0.2s;\\n}\\n\\n.debate-card:hover {\\n  border-color: #3b82f6;\\n}\\n\\n.debate-card-link {\\n  display: block;\\n  padding: 1.25rem;\\n  text-decoration: none;\\n  color: inherit;\\n}\\n\\n.debate-card h3 {\\n  color: #f1f5f9;\\n  font-size: 1.1rem;\\n  margin: 0 0 0.5rem 0;\\n}\\n\\n.debate-domain {\\n  display: inline-block;\\n  background: #0f172a;\\n  color: #8b5cf6;\\n  font-size: 0.75rem;\\n  padding: 0.15rem 0.5rem;\\n  border-radius: 3px;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.debate-desc {\\n  color: #94a3b8;\\n  font-size: 0.85rem;\\n  margin: 0.5rem 0;\\n  line-height: 1.4;\\n  display: -webkit-box;\\n  -webkit-line-clamp: 2;\\n  -webkit-box-orient: vertical;\\n  overflow: hidden;\\n}\\n\\n.debate-meta {\\n  display: flex;\\n  justify-content: space-between;\\n  margin-top: 0.75rem;\\n  font-size: 0.8rem;\\n  color: #64748b;\\n}\\n\\n.debate-stage-count {\\n  color: #3b82f6;\\n}\\n\\n.debate-delete-btn {\\n  position: absolute;\\n  top: 0.5rem;\\n  right: 0.5rem;\\n  background: none;\\n  border: none;\\n  color: #64748b;\\n  font-size: 1.2rem;\\n  cursor: pointer;\\n  padding: 0.25rem;\\n  line-height: 1;\\n}\\n\\n.debate-delete-btn:hover {\\n  color: #ef4444;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/FindingsPage.css\"\n/*!*******************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/pages/FindingsPage.css ***!\n  \\*******************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__