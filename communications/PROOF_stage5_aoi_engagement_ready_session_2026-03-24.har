ut:focus,\n.form-grid select:focus {\n  outline: none;\n  border-color: #3b82f6;\n}\n\n.inline-form button[type=\"submit\"] {\n  background: #22c55e;\n  color: white;\n  border: none;\n  padding: 0.35rem 1rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 0.85rem;\n}\n\n/* Main layout */\n.debate-detail-body {\n  display: flex;\n  gap: 1rem;\n  flex: 1 1;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.chain-panel {\n  flex: 0 0 55%;\n  overflow-y: auto;\n  padding-right: 0.5rem;\n}\n\n.detail-panel {\n  flex: 1 1;\n  overflow-y: auto;\n  background: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 8px;\n  padding: 1.25rem;\n}\n\n/* Chain timeline */\n.chain-timeline {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n.chain-empty {\n  text-align: center;\n  color: #64748b;\n  padding: 4rem 1rem;\n}\n\n.chain-connector {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 0.25rem 0;\n}\n\n.connector-line {\n  width: 2px;\n  height: 16px;\n  background: #334155;\n}\n\n.connector-label {\n  font-size: 0.7rem;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.edge-delete-x {\n  background: none;\n  border: none;\n  color: #64748b;\n  cursor: pointer;\n  font-size: 0.9rem;\n  padding: 0 0.15rem;\n  line-height: 1;\n}\n\n.edge-delete-x:hover { color: #ef4444; }\n\n/* Stage node */\n.stage-node {\n  background: #0f172a;\n  border: 1px solid #334155;\n  border-radius: 8px;\n  padding: 0.85rem 1rem;\n  cursor: pointer;\n  transition: border-color 0.2s, box-shadow 0.2s;\n}\n\n.stage-node:hover {\n  border-color: #475569;\n}\n\n.stage-node.selected {\n  border-color: #3b82f6;\n  box-shadow: 0 0 0 1px #3b82f6;\n}\n\n.stage-node-header {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin-bottom: 0.35rem;\n}\n\n.stage-type-badge {\n  background: #1e293b;\n  color: #94a3b8;\n  font-size: 0.65rem;\n  padding: 0.1rem 0.4rem;\n  border-radius: 3px;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.stage-year {\n  color: #64748b;\n  font-size: 0.8rem;\n  margin-left: auto;\n}\n\n.stage-badges {\n  display: flex;\n  gap: 0.25rem;\n}\n\n.badge {\n  width: 18px;\n  height: 18px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.6rem;\n  font-weight: 700;\n}\n\n.badge-text { background: #1e3a5f; color: #60a5fa; }\n.badge-profile { background: #1a3a2a; color: #4ade80; }\n.badge-project { background: #3b1a5e; color: #c084fc; }\n\n.stage-node-title {\n  color: #f1f5f9;\n  font-size: 0.95rem;\n  margin: 0;\n  line-height: 1.3;\n}\n\n.stage-node-author {\n  color: #94a3b8;\n  font-size: 0.8rem;\n  margin: 0.15rem 0 0 0;\n}\n\n.stage-node-pub {\n  color: #64748b;\n  font-size: 0.75rem;\n  margin: 0.1rem 0 0 0;\n}\n\n.stage-node-edges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25rem;\n  margin-top: 0.4rem;\n}\n\n.edge-badge {\n  font-size: 0.65rem;\n  border: 1px solid;\n  padding: 0.1rem 0.35rem;\n  border-radius: 3px;\n  color: #94a3b8;\n}\n\n/* Detail panel content */\n.detail-placeholder {\n  text-align: center;\n  color: #64748b;\n  padding: 4rem 1rem;\n}\n\n.detail-header h2 {\n  color: #f1f5f9;\n  font-size: 1.2rem;\n  margin: 0 0 0.25rem 0;\n}\n\n.detail-author { color: #e2e8f0; font-size: 0.9rem; margin: 0; }\n.detail-pub { color: #94a3b8; font-size: 0.8rem; margin: 0.15rem 0 0 0; }\n\n.detail-status {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n  margin-top: 0.75rem;\n}\n\n.status-pill {\n  font-size: 0.75rem;\n  padding: 0.2rem 0.5rem;\n  border-radius: 4px;\n}\n\n.status-pill.active { background: #1a3a2a; color: #4ade80; }\n.status-pill.inactive { background: #1e293b; color: #64748b; }\n.status-pill.project-link {\n  background: #1e1b4b;\n  color: #a78bfa;\n  text-decoration: none;\n}\n.status-pill.project-link:hover { color: #c4b5fd; }\n\n.detail-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin: 1rem 0;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid #334155;\n}\n\n.btn-action {\n  background: #1e293b;\n  color: #e2e8f0;\n  border: 1px solid #334155;\n  padding: 0.4rem 0.75rem;\n  border-radius: 5px;\n  cursor: pointer;\n  font-size: 0.8rem;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n}\n\n.btn-action:hover { border-color: #475569; }\n.btn-action.btn-primary { background: #1e3a5f; border-color: #3b82f6; color: #60a5fa; }\n.btn-action.btn-primary:hover { background: #1e4a7f; }\n.btn-action.btn-danger:hover { border-color: #ef4444; color: #ef4444; }\n.btn-action:disabled { opacity: 0.5; cursor: not-allowed; }\n\n/* Connections */\n.detail-connections {\n  margin-top: 1rem;\n}\n\n.detail-connections h3 {\n  color: #94a3b8;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin: 0 0 0.5rem 0;\n}\n\n.connection-row {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.3rem 0;\n  font-size: 0.85rem;\n}\n\n.connection-arrow { color: #64748b; }\n.connection-type { font-weight: 500; font-size: 0.75rem; text-transform: uppercase; }\n.connection-text { color: #cbd5e1; }\n\n/* Profile */\n.detail-profile {\n  margin-top: 1rem;\n}\n\n.detail-profile h3 {\n  color: #94a3b8;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin: 0 0 0.75rem 0;\n}\n\n.profile-version {\n  color: #64748b;\n  font-weight: normal;\n}\n\n.detail-no-profile {\n  background: #0f172a;\n  border: 1px dashed #334155;\n  border-radius: 6px;\n  padding: 1rem;\n  margin-top: 1rem;\n  color: #64748b;\n  text-align: center;\n  font-size: 0.85rem;\n}\n\n/* Profile card */\n.profile-card {}\n\n.profile-summary-line {\n  color: #e2e8f0;\n  font-size: 0.95rem;\n  font-style: italic;\n  margin: 0 0 0.75rem 0;\n  padding-bottom: 0.75rem;\n  border-bottom: 1px solid #334155;\n}\n\n.profile-exec-summary {\n  color: #cbd5e1;\n  font-size: 0.85rem;\n  line-height: 1.5;\n  margin-bottom: 1rem;\n}\n\n.profile-exec-summary p { margin: 0; }\n\n.profile-section {\n  margin-bottom: 0.25rem;\n}\n\n.profile-section-header {\n  width: 100%;\n  background: #0f172a;\n  border: 1px solid #334155;\n  border-radius: 4px;\n  color: #e2e8f0;\n  padding: 0.4rem 0.6rem;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.85rem;\n}\n\n.profile-section-header:hover { border-color: #475569; }\n.profile-section-header.open { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }\n.chevron { font-size: 0.6rem; color: #64748b; }\n\n.profile-section-body {\n  background: #0f172a;\n  border: 1px solid #334155;\n  border-top: none;\n  border-radius: 0 0 4px 4px;\n  padding: 0.6rem;\n}\n\n.profile-item {\n  padding: 0.4rem 0;\n  border-bottom: 1px solid #1e293b;\n}\n\n.profile-item:last-child { border-bottom: none; }\n\n.profile-item-main {\n  color: #e2e8f0;\n  font-size: 0.85rem;\n  margin: 0;\n  line-height: 1.4;\n}\n\n.profile-item-evidence {\n  margin: 0.25rem 0 0 1rem;\n  padding: 0;\n  list-style: disc;\n}\n\n.profile-item-evidence li {\n  color: #94a3b8;\n  font-size: 0.8rem;\n  margin-bottom: 0.15rem;\n}\n\n.profile-item-detail {\n  color: #94a3b8;\n  font-size: 0.8rem;\n  margin: 0.15rem 0 0 0;\n}\n\n.strength-badge,\n.type-tag,\n.novelty-tag {\n  display: inline-block;\n  font-size: 0.65rem;\n  padding: 0.1rem 0.3rem;\n  border-radius: 3px;\n  margin-top: 0.2rem;\n  margin-right: 0.25rem;\n}\n\n.strength-badge { background: #1e293b; color: #94a3b8; }\n.strength-badge.strength-high { color: #ef4444; }\n.strength-badge.strength-medium { color: #f59e0b; }\n.strength-badge.strength-low { color: #22c55e; }\n.type-tag { background: #1e1b4b; color: #a78bfa; }\n.novelty-tag { background: #1a3a2a; color: #4ade80; }\n\n.loading, .error {\n  text-align: center;\n  color: #94a3b8;\n  padding: 4rem 2rem;\n}\n\n.error { color: #ef4444; }\n`, \"\",{\"version\":3,\"sources\":[\"web