ound: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-secondary, #757575);\n  cursor: pointer;\n  padding: 0;\n  line-height: 1;\n  transition: color 0.2s ease;\n}\n\n.close-btn:hover {\n  color: var(--text-primary, #1a1a1a);\n}\n\n.card-tabs {\n  display: flex;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.tab-btn {\n  flex: 1 1;\n  padding: 12px 16px;\n  background: none;\n  border: none;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary, #757575);\n  cursor: pointer;\n  transition: all 0.2s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border-bottom: 2px solid transparent;\n  margin-bottom: -1px;\n}\n\n.tab-btn:hover {\n  background: var(--bg-elevated, #f5f3f0);\n  color: var(--text-primary, #1a1a1a);\n}\n\n.tab-btn.active {\n  color: var(--accent-color, #b5343a);\n  border-bottom-color: var(--accent-color, #b5343a);\n  background: var(--bg-elevated, #f5f3f0);\n}\n\n.tab-indicator {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n\n.tab-count {\n  font-size: 11px;\n  background: var(--bg-tertiary, #e0ddd8);\n  padding: 2px 6px;\n  border-radius: 8px;\n}\n\n.tab-btn.active .tab-count {\n  background: var(--accent-color, #b5343a);\n  color: white;\n}\n\n/* Tab Content */\n.tab-content {\n  padding: 16px;\n  flex: 1 1;  /* Fill remaining vertical space */\n  overflow-y: auto;\n  min-height: 0;  /* Allow flex shrinking for overflow to work */\n}\n\n.tab-content.empty {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 150px;\n  color: var(--text-secondary, #757575);\n}\n\n/* Overview Tab */\n.section {\n  margin-bottom: 20px;\n}\n\n.section:last-child {\n  margin-bottom: 0;\n}\n\n.section h4 {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text-tertiary, #9a9a9a);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin: 0 0 8px 0;\n}\n\n.section p {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.6;\n  margin: 0;\n}\n\n.claims-list,\n.commitments-list,\n.moves-list {\n  margin: 0;\n  padding-left: 20px;\n  list-style-type: disc;\n}\n\n.claims-list li,\n.commitments-list li,\n.moves-list li {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.5;\n  margin-bottom: 6px;\n}\n\n.tensions-text {\n  font-style: italic;\n  color: var(--text-secondary, #757575);\n}\n\n.source-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.source-tag {\n  font-size: 11px;\n  background: var(--bg-tertiary, #e0ddd8);\n  color: var(--text-secondary, #757575);\n  padding: 4px 10px;\n  border-radius: 4px;\n}\n\n/* Engagement Tab */\n.engagement-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 20px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.engagement-level-badge {\n  font-size: 11px;\n  font-weight: 700;\n  color: white;\n  padding: 4px 12px;\n  border-radius: 4px;\n}\n\n.engagement-description {\n  font-size: 13px;\n  color: var(--text-secondary, #757575);\n}\n\n.divergence-text {\n  background: var(--bg-elevated, #f5f3f0);\n  padding: 12px;\n  border-radius: 6px;\n  border-left: 3px solid var(--accent-color, #b5343a);\n  font-size: 13px;\n}\n\n.quotes-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.quote-item blockquote {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.6;\n  margin: 0;\n  padding: 12px;\n  background: var(--bg-elevated, #f5f3f0);\n  border-left: 3px solid var(--accent-color, #b5343a);\n  border-radius: 0 6px 6px 0;\n}\n\n.quote-item cite {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n  display: block;\n  margin-top: 6px;\n  font-style: normal;\n}\n\n.severity-section {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.severity-badge {\n  font-size: 10px;\n  font-weight: 700;\n  color: white;\n  padding: 4px 10px;\n  border-radius: 4px;\n  text-transform: uppercase;\n}\n\n.severity-note {\n  font-size: 12px;\n  color: var(--text-tertiary, #9a9a9a);\n  font-style: italic;\n}\n\n/* Findings Tab */\n.findings-summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 16px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.summary-count {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n}\n\n.summary-types {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.type-chip {\n  font-size: 10px;\n  font-weight: 500;\n  color: white;\n  padding: 3px 8px;\n  border-radius: 4px;\n}\n\n.findings-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.finding-card {\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 0;\n  overflow: hidden;\n}\n\n.finding-card.expanded {\n  border-color: var(--border-color, #e0ddd8);\n}\n\n.finding-header {\n  display: flex;\n  width: 100%;\n  padding: 12px;\n  background: none;\n  border: none;\n  cursor: pointer;\n  text-align: left;\n}\n\n.finding-header:hover {\n  background: var(--bg-elevated, #f5f3f0);\n}\n\n.finding-header-content {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  width: 100%;\n}\n\n.finding-title-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.finding-preview {\n  font-size: 12px;\n  color: var(--text-secondary, #757575);\n  line-height: 1.5;\n  margin: 0;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  padding-left: 1px;\n}\n\n.sin-type-chip {\n  font-size: 9px;\n  font-weight: 600;\n  color: white;\n  padding: 3px 6px;\n  border-radius: 3px;\n  flex-shrink: 0;\n}\n\n.finding-title {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-primary, #1a1a1a);\n  flex: 1 1;\n}\n\n.severity-chip {\n  font-size: 9px;\n  font-weight: 600;\n  color: white;\n  padding: 2px 6px;\n  border-radius: 3px;\n  text-transform: uppercase;\n}\n\n.expand-icon {\n  font-size: 10px;\n  color: var(--text-tertiary, #9a9a9a);\n  margin-left: 8px;\n}\n\n.finding-details {\n  padding: 16px;\n  padding-top: 0;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.finding-description {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.6;\n  margin: 0 0 16px 0;\n}\n\n.evidence-section {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n.evidence-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 4px;\n}\n\n.evidence-section-header h5 {\n  margin: 0;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-tertiary, #9a9a9a);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.deeper-dive-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--bg-elevated, #f5f3f0);\n  border: 1px solid var(--border-color, #e0ddd8);\n  color: var(--accent-color, #b5343a);\n  padding: 5px 10px;\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.deeper-dive-btn:hover {\n  background: var(--bg-tertiary, #e0ddd8);\n  border-color: var(--accent-color, #b5343a);\n}\n\n.deeper-dive-btn .btn-icon {\n  font-size: 11px;\n}\n\n.evidence-block {\n  padding: 12px;\n  border-radius: 6px;\n}\n\n.evidence-block.subject {\n  background: var(--bg-elevated, #f5f3f0);\n  border-left: 3px solid var(--accent-color, #b5343a);\n}\n\n.evidence-block.source {\n  background: var(--bg-elevated, #f5f3f0);\n  border-left: 3px solid #5a7a8a;\n}\n\n.evidence-block label {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-tertiary, #9a9a9a);\n  display: block;\n  margin-bottom: 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.evidence-block blockquote {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.5;\n  margin: 0;\n  font-style: italic;\n}\n\n.evidence-block cite {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n  display: block;\n  margin-top: 8px;\n  font-style: normal;\n}\n\n.missing-section,\n.implication-section {\n  margin-top: 12px;\n}\n\n.missing-section label,\n.implication-section label {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-tertiary, #9a9a9a);\n  display: block;\n  margin-bottom: 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.missing-section p,\n.implication-section p {\n  font-size: 13px;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.5;\n  margin: 0;\n  padding: 12px;\n  background: var(--bg-tertiary, #e0ddd8);\n  border-radius: 6px;\n}\n\n.missing-section p {\n  border-left: 3px solid var(--accent-color, #b5343a);\n}\n\n.implication-section p {\n  border-left: 3px solid #5a6b7a;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/ThemeSynthesisCard.css\"],\"names\":[],\"mappings\":\"AAAA,8BAA8B;;AAE9B;EACE,mCAAmC;EACnC,kBAAkB;EAClB,8CAA8C;EAC9C,gBAAgB;EAChB,aAAa;EACb,sBAAsB;EACtB,YAAY,GAAG,yBAAyB;AAC1C;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,uBAAuB;EACvB,aAAa;EACb,uCAAuC;EACvC,qDAAqD;AACvD;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,YAAY;EACZ,gBAAgB;EAChB,kBAAkB;EAClB,yBAAyB;EACzB,qBAAqB;EACrB,kBAAkB;AACpB;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,mCAAmC;EACnC,gBAAgB;AAClB;;AAEA;EACE,gBAAgB;EAChB,YAAY;EACZ,eAAe;EACf,qCAAqC;EACrC,eAAe;EACf,UAAU;EACV,cAAc;EACd,2BAA2B;AAC7B;;AAEA;EACE,mCAAmC;AACrC;;AAEA;EACE,aAAa;EACb,qDAAqD;AACvD;;AAEA;EACE,SAAO;EACP,kBAAkB;EAClB,gBAAgB;EAChB,YAAY;EACZ,eAAe;EACf,gBAAgB;EAChB,qCAAqC;EACrC,eAAe;EACf,yBAAyB;EACzB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,QAAQ;EACR,oCAAoC;EACpC,mBAAmB;AACrB;;AAEA;EACE,uCAAuC;EACvC,mCAAmC;AACrC;;AAEA;EACE,mCAAmC;EACnC,iDAAiD;EACjD,uCAAuC;AACzC;;AAEA;EACE,UAAU;EACV,WAAW;EACX,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,uCAAuC;EACvC,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,wCAAwC;EACx