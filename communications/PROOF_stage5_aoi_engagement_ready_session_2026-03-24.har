 border: 1px solid #475569;\n  color: #94a3b8;\n}\n\n.btn-back:hover:not(:disabled) {\n  border-color: #64748b;\n  color: #4a4a4a;\n}\n\n.btn-back:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.btn-back svg {\n  width: 18px;\n  height: 18px;\n}\n\n.btn-next {\n  background: linear-gradient(135deg, #b5343a, #b5343a);\n  border: none;\n  color: white;\n}\n\n.btn-next:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35);\n}\n\n.btn-next svg {\n  width: 18px;\n  height: 18px;\n}\n\n.btn-create {\n  background: linear-gradient(135deg, #22c55e, #9a2c31);\n  border: none;\n  color: white;\n  min-width: 180px;\n  justify-content: center;\n}\n\n.btn-create:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);\n}\n\n.btn-create:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n  transform: none;\n  box-shadow: none;\n}\n\n.btn-create svg {\n  width: 18px;\n  height: 18px;\n}\n\n.btn-spinner {\n  width: 18px;\n  height: 18px;\n  border: 2px solid rgba(255, 255, 255, 0.3);\n  border-top-color: white;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .wizard-header {\n    padding: 16px 20px;\n  }\n\n  .wizard-header h1 {\n    font-size: 18px;\n  }\n\n  .header-spacer {\n    display: none;\n  }\n\n  .project-wizard-page .wizard-progress {\n    padding: 16px 20px;\n  }\n\n  .wizard-main {\n    padding: 24px 20px;\n  }\n\n  .wizard-footer {\n    padding: 16px 20px;\n  }\n\n  .btn-back,\n  .btn-next,\n  .btn-create {\n    padding: 10px 18px;\n    font-size: 14px;\n  }\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/ProjectWizardPage.css\"],\"names\":[],\"mappings\":\"AAAA,6BAA6B;;AAE7B;EACE,iBAAiB;EACjB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;AACrB;;AAEA,WAAW;AACX;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,kBAAkB;EAClB,mBAAmB;EACnB,gCAAgC;A