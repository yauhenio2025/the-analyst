px;\n  border-radius: 1px;\n  opacity: 0.5;\n}\n\n.gen-trail-connector--final {\n  opacity: 0.3;\n}\n\n.gen-trail-ref {\n  margin-bottom: 8px;\n}\n\n.gen-trail-quote {\n  background: var(--color-surface-alt);\n  border-left: 2px solid var(--color-border);\n  margin: 4px 0;\n  padding: 6px 12px;\n  font-size: 0.8rem;\n  font-family: var(--font-body);\n  color: var(--color-text-muted);\n  line-height: 1.55;\n  border-radius: 0 3px 3px 0;\n}\n\n.gen-trail-quote--current {\n  background: rgba(59, 130, 246, 0.03);\n  border-left-color: rgba(59, 130, 246, 0.3);\n}\n\n.gen-trail-cite {\n  display: block;\n  font-style: normal;\n  font-size: 0.6875rem;\n  font-family: var(--font-sans);\n  color: var(--color-text-faint);\n  margin-top: 4px;\n  font-weight: var(--weight-medium);\n}\n\n.gen-prose-badge {\n  background: var(--color-accent) !important;\n  color: var(--dt-text-inverse, #ffffff) !important;\n  font-size: 0.65rem;\n  font-weight: var(--weight-bold);\n  font-family: var(--font-sans);\n  letter-spacing: 0.05em;\n}\n\n.gen-prose-mode-badge {\n  display: inline-block;\n  background: var(--color-accent);\n  color: var(--dt-text-inverse, #ffffff);\n  font-size: 0.7rem;\n  font-weight: var(--weight-semibold);\n  font-family: var(--font-sans);\n  padding: 4px 10px;\n  border-radius: var(--radius-sm);\n  margin-bottom: var(--space-md);\n  letter-spacing: 0.03em;\n}\n\n.gen-extracting-notice {\n  text-align: center;\n  padding: var(--space-3xl) var(--space-lg);\n  color: var(--color-text-faint);\n}\n\n.gen-extracting-spinner {\n  width: 32px;\n  height: 32px;\n  border: 3px solid var(--color-border);\n  border-top-color: var(--color-accent);\n  border-radius: 50%;\n  animation: gen-spin 0.8s linear infinite;\n  margin: 0 auto var(--space-md);\n}\n\n.gen-extracting-notice p {\n  margin: 8px 0;\n  font-family: var(--font-sans);\n}\n\n.gen-extracting-detail {\n  font-size: 0.85rem;\n  color: var(--color-text-muted);\n}\n\n.gen-extraction-error {\n  padding: var(--space-lg);\n  