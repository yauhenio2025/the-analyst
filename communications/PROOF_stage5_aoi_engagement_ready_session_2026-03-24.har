lor: #cbd5e1;\\n}\\n\\n.research-source-context {\\n  padding: 12px 18px;\\n  background: #0f172a;\\n  border-bottom: 1px solid #1e293b;\\n}\\n\\n.research-source-label {\\n  font-size: 0.7rem;\\n  text-transform: uppercase;\\n  letter-spacing: 0.04em;\\n  color: #64748b;\\n  margin-right: 6px;\\n}\\n\\n.research-source-title {\\n  font-size: 0.82rem;\\n  font-weight: 600;\\n  color: #94a3b8;\\n}\\n\\n.research-source-text {\\n  font-size: 0.78rem;\\n  color: #64748b;\\n  margin-top: 4px;\\n  line-height: 1.4;\\n}\\n\\n.research-loading {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 14px 18px;\\n  color: #94a3b8;\\n  font-size: 0.85rem;\\n}\\n\\n.research-spinner {\\n  display: inline-block;\\n  width: 16px;\\n  height: 16px;\\n  border: 2px solid #334155;\\n  border-top-color: #6366f1;\\n  border-radius: 50%;\\n  animation: research-spin 0.6s linear infinite;\\n}\\n\\n@keyframes research-spin {\\n  to { transform: rotate(360deg); }\\n}\\n\\n/* === Generate AI Suggestion button row === */\\n.research-generate-row {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 8px 18px;\\n}\\n\\n.research-btn-generate {\\n  background: transparent;\\n  border: 1px solid #6366f1;\\n  color: #6366f1;\\n  padding: 6px 14px;\\n  border-radius: 6px;\\n  cursor: pointer;\\n  font-size: 13px;\\n  font-weight: 600;\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 6px;\\n  transition: all 0.15s;\\n}\\n\\n.research-btn-generate:hover:not(:disabled) {\\n  background: #6366f1;\\n  color: #fff;\\n}\\n\\n.research-btn-generate:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n.research-generated-badge {\\n  font-size: 11px;\\n  color: #6366f1;\\n  background: rgba(99, 102, 241, 0.1);\\n  padding: 2px 8px;\\n  border-radius: 4px;\\n}\\n\\n.research-error {\\n  padding: 10px 18px;\\n  color: #fca5a5;\\n  font-size: 0.82rem;\\n  background: rgba(239, 68, 68, 0.1);\\n}\\n\\n.research-form {\\n  padding: 14px 18px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.research-label {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n  font-size: 0.75rem;\\n  font-weight: 600;\\n  color: #94a3b8;\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n}\\n\\n.research-label-half {\\n  flex: 1;\\n}\\n\\n.research-row {\\n  display: flex;\\n  gap: 12px;\\n}\\n\\n.research-textarea,\\n.research-input,\\n.research-select {\\n  background: #0f172a;\\n  border: 1px solid #334155;\\n  border-radius: 6px;\\n  color: #e2e8f0;\\n  padding: 8px 10px;\\n  font-size: 0.85rem;\\n  font-family: inherit;\\n  outline: none;\\n  resize: vertical;\\n}\\n\\n.research-textarea:focus,\\n.research-input:focus,\\n.research-select:focus {\\n  border-color: #6366f1;\\n}\\n\\n.research-textarea-sm {\\n  font-size: 0.82rem;\\n}\\n\\n.research-select {\\n  cursor: pointer;\\n}\\n\\n.research-scope-details {\\n  border: 1px solid #334155;\\n  border-radius: 6px;\\n  padding: 8px 12px;\\n}\\n\\n.research-scope-details summary {\\n  cursor: pointer;\\n  font-size: 0.78rem;\\n  font-weight: 600;\\n  color: #94a3b8;\\n  text-transform: uppercase;\\n  letter-spacing: 0.03em;\\n}\\n\\n.research-scope-details[open] summary {\\n  margin-bottom: 10px;\\n}\\n\\n.research-dialog-footer {\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 8px;\\n  padding: 12px 18px;\\n  border-top: 1px solid #334155;\\n}\\n\\n.research-btn {\\n  padding: 7px 16px;\\n  border-radius: 6px;\\n  border: none;\\n  font-size: 0.82rem;\\n  font-weight: 600;\\n  cursor: pointer;\\n  transition: background 0.15s;\\n}\\n\\n.research-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n.research-btn-secondary {\\n  background: #334155;\\n  color: #94a3b8;\\n}\\n\\n.research-btn-secondary:hover:not(:disabled) {\\n  background: #475569;\\n}\\n\\n.research-btn-draft {\\n  background: #475569;\\n  color: #e2e8f0;\\n}\\n\\n.research-btn-draft:hover:not(:disabled) {\\n  background: #64748b;\\n}\\n\\n.research-btn-queue {\\n  background: #6366f1;\\n  color: #fff;\\n}\\n\\n.research-btn-queue:hover:not(:disabled) {\\n  background: #4f46e5;\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/TaxonomyTooltip.css\"\n/*!***************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/TaxonomyTooltip.css ***!\n  \\***************************************************************************************************************************************************************************************************************************************************/\n(module, __webpack_exports__, __webpack_require__) {\n\n\"use strict\";\n__webpack_require__.r(__webpack_exports__);\n/* harmony export */ __webpack_require__.d(__webpack_exports__, {\n/* harmony export */   \"default\": () => (__WEBPACK_DEFAULT_EXPORT__)\n/* harmony export */ });\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/sourceMaps.js */ \"./node_modules/css-loader/dist/runtime/sourceMaps.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0__);\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! ../../node_modules/css-loader/dist/runtime/api.js */ \"./node_modules/css-loader/dist/runtime/api.js\");\n/* harmony import */ var _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default = /*#__PURE__*/__webpack_require__.n(_node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1__);\n// Imports\n\n\nvar ___CSS_LOADER_EXPORT___ = _node_modules_css_loader_dist_runtime_api_js__WEBPACK_IMPORTED_MODULE_1___default()((_node_modules_css_loader_dist_runtime_sourceMaps_js__WEBPACK_IMPORTED_MODULE_0___default()));\n// Module\n___CSS_LOADER_EXPORT___.push([module.id, `/* TaxonomyTooltip - Rich tooltip styling for chain taxonomies */\n\n/* Trigger container */\n.taxonomy-tooltip-trigger {\n  position: relative;\n  display: inline-flex;\n  cursor: help;\n}\n\n/* Chip style for taxonomy values */\n.taxonomy-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n  padding: 0.2rem 0.5rem;\n  border-radius: 4px;\n  border: 1px solid;\n  font-size: 0.75rem;\n  font-weight: 500;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n\n.taxonomy-chip:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n}\n\n.taxonomy-icon {\n  font-size: 0.85rem;\n}\n\n.taxonomy-label {\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n/* Badge style (more compact) */\n.taxonomy-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.2rem;\n  padding: 0.15rem 0.4rem;\n  border-radius: 3px;\n  border: 1px solid;\n  font-size: 0.7rem;\n  font-weight: 500;\n  transition: all 0.15s ease;\n}\n\n.taxonomy-badge:hover {\n  filter: brightness(1.2);\n}\n\n.badge-icon {\n  font-size: 0.75rem;\n}\n\n.badge-label {\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n}\n\n/* Unknown value fallback */\n.taxonomy-value.unknown {\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* Tooltip container */\n.taxonomy-tooltip {\n  position: absolute;\n  z-index: 1000;\n  min-width: 280px;\n  max-width: 360px;\n  background: var(--bg-elevated);\n  border: 2px solid;\n  border-radius: var(--radius-md);\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);\n  overflow: hidden;\n  animation: tooltipFadeIn 0.2s ease;\n}\n\n.taxonomy-tooltip.top {\n  bottom: calc(100% + 8px);\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.taxonomy-tooltip.bottom {\n  top: calc(100% + 8px);\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n@keyframes tooltipFadeIn {\n  from {\n    opacity: 0;\n    transform: translateX(-50%) translateY(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(-50%) translateY(0);\n  }\n}\n\n/* Tooltip header */\n.tooltip-header {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.75rem 1rem;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.tooltip-icon {\n  font-size: 1.5rem;\n}\n\n.tooltip-titles {\n  display: flex;\n  flex-direction: column;\n  gap: 0.1rem;\n}\n\n.tooltip-type-name {\n  font-weight: 600;\n  font-size: 0.95rem;\n  color: var(--text-primary);\n}\n\n.tooltip-category-name {\n  font-size: 0.75rem;\n  color: var(--text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n/* Tooltip body */\n.tooltip-body {\n  padding: 0.75rem 1rem;\n}\n\n.tooltip-definition {\n  font-size: 0.85rem;\n  line-height: 1.5;\n  color: var(--text-primary);\n}\n\n.tooltip-example {\n  margin-top: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  background: var(--bg-card);\n  border-radius: var(--radius-sm);\n  font-size: 0.8rem;\n}\n\n.example-label {\n  display: block;\n  color: var(--text-muted);\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: 0.25rem;\n}\n\n.example-text {\n  display: block;\n  color: var(--text-secondary);\n  font-style: italic;\n  line-height: 1.4;\n}\n\n/* Tooltip footer */\n.tooltip-footer {\n  padding: 0.5rem 1rem;\n  background: var(--bg-dark);\n  border-top: 1px solid var(--border-color);\n}\n\n.tooltip-theorists {\n  font-size: 0.7rem;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* Arrow indicators (pseudo-elements) */\n.taxonomy-tooltip.top::after {\n  content: '';\n  position: absolute;\n  top: 100%;\n  left: 50%;\n  transform: translateX(-50%);\n  border: 8px solid transparent;\n  border-top-color: var(--bg-elevated);\n}\n\n.taxonomy-tooltip.bottom::after {\n  content: '';\n  position: absolute;\n  bottom: 100%;\n  left: 50%;\n  transform: translateX(-50%);\n  border: 8px solid transparent;\n  border-bottom-color: var(--bg-elevated);\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/TaxonomyTooltip.css\"],\"names\":[],\"mappings\":\"AAAA,gEAAgE;;AAEhE,sBAAsB;AACtB;EACE,kBAAkB;EAClB,oBAAoB;EACpB,YAAY;AACd;;AAEA,mCAAmC;AACnC;EACE,oBAAoB;EACpB,mBAAmB;EACnB,WAAW;EACX,sBAAsB;EACtB,kBAAkB;EAClB,iBAAiB;EACjB,kBAAkB;EAClB,gBAAgB;EAChB,uDAAuD;AACzD;;AAEA;EACE,2BAA2B;EAC3B,wCAAwC;AAC1C;;AAEA;EACE,kBAAkB;AACpB;;AAEA;EACE,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA,+BAA+B;AAC/B;EACE,oBAAoB;EACpB,mBAAmB;EACnB,WAAW;EACX,uBAAuB;EACvB,kBAAkB;EAClB,iBAAiB;EACjB,iBAAiB;EACjB,gBAAgB;EAChB,0BAA0B;AAC5B;;AAEA;EACE,uBAAuB;AACzB;;AAEA;EACE,kBAAkB;AACpB;;AAEA;EACE,yBAAyB;EACzB,sBAAsB;AACxB;;AAEA,2BAA2B;AAC3B;EACE,wBAAwB;EACxB,kBAAkB;AACpB;;AAEA,sBAAsB;AACtB;EACE,kBAAkB;EAClB,aAAa;EACb,gBAAgB;EAChB,gBAAgB;EAChB,8BAA8B;EAC9B,iBAAiB;EACjB,+BAA+B;EAC/B,yCAAyC;EACzC,gBAAgB;EAChB,kCAAkC;AACpC;;AAEA;EACE,wBAAwB;EACxB,SAAS;EACT,2BAA2B;AAC7B;;AAEA;EACE,qBAAqB;EACrB,SAAS;EACT,2BAA2B;AAC7B;;AAEA;EACE;IACE,UAAU;IACV,2CAA2C;EAC7C;EACA;IACE,UAAU;IACV,yCAAyC;EAC3C;AACF;;AAEA,mBAAmB;AACnB;EACE,aAAa;EACb,mBAAmB;EACnB,YAAY;EACZ,qBAAqB;EACrB,4CAA4C;AAC9C;;AAEA;EACE,iBAAiB;AACnB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,WAAW;AACb;;AAEA;EACE,gBAAgB;EAChB,kBAAkB;EAClB,0BAA0B;AAC5B;;AAEA;EACE,kBAAkB