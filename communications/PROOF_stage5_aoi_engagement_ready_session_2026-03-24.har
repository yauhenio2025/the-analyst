zB,kBAAkB;EAClB,kCAAkC;EAClC,mBAAmB;AACrB;;AAEA;EACE,KAAK,yBAAyB,EAAE;AAClC;;AAEA;EACE,aAAa;EACb,SAAS;EACT,yBAAyB;EACzB,kBAAkB;EAClB,yCAAyC;AAC3C;;AAEA;EACE,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,6DAA6D;EAC7D,YAAY;EACZ,YAAY;EACZ,kBAAkB;EAClB,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,2BAA2B;EAC3B,8CAA8C;AAChD;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,oCAAoC;EACpC,yBAAyB;EACzB,cAAc;EACd,kBAAkB;EAClB,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,mCAAmC;AACrC;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,kBAAkB;EAClB,eAAe;EACf,oCAAoC;EACpC,qCAAqC;EACrC,8BAA8B;EAC9B,kBAAkB;EAClB,eAAe;EACf,oBAAoB;AACtB;;AAEA;EACE,qCAAqC;EACrC,wBAAwB;AAC1B;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA,kDAAkD;AAClD;EACE,gBAAgB;EAChB,UAAU;AACZ;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,cAAc;EACd,qBAAqB;EACrB,wBAAwB;EACxB,kBAAkB;AACpB;;AAEA;EACE,cAAc;AAChB;;AAEA;EACE,8BAA8B;EAC9B,mBAAmB;EACnB,kBAAkB;AACpB;;AAEA;EACE,WAAW;EACX,gBAAgB;EAChB,qCAAqC;EACrC,kBAAkB;EAClB,gCAAgC;EAChC,wBAAwB;EACxB,eAAe;AACjB;;AAEA;EACE,aAAa;EACb,iCAAiC;EACjC,6CAA6C;AAC/C;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,WAAW;EACX,gBAAgB;EAChB,qCAAqC;EACrC,kBAAkB;EAClB,gCAAgC;EAChC,wBAAwB;EACxB,kBAAkB;EAClB,oBAAoB;EACpB,gBAAgB;EAChB,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,iCAAiC;EACjC,6CAA6C;AAC/C;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,2BAA2B;EAC3B,iBAAiB;EACjB,mBAAmB;AACrB;;AAEA,yBAAyB;AACzB;EACE,kBAAkB;EAClB,iBAAiB;EACjB,yCAAyC;AAC3C;;AAEA;EACE,qBAAqB;EACrB,8BAA8B;EAC9B,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,YAAY;EACZ,iBAAiB;EACjB,gBAAgB;AAClB;;AAEA;EACE,gBAAgB;EAChB,gCAAgC;EAChC,qCAAqC;EACrC,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,qBAAqB;AACvB;;AAEA;EACE,gBAAgB;EAChB,wBAAwB;EACxB,kBAAkB;AACpB;;AAEA;EACE,+BAA+B;EAC/B,YAAY;EACZ,uBAAuB;EACvB,mBAAmB;EACnB,kBAAkB;EAClB,gBAAgB;AAClB;;AAEA;EACE,8BAA8B;EAC9B,kBAAkB;EAClB,oBAAoB;EACpB,gBAAgB;AAClB;;AAEA;EACE,8BAA8B;EAC9B,iBAAiB;AACnB;;AAEA;EACE,8BAA8B;EAC9B,kBAAkB;AACpB\",\"sourcesContent\":[\"/* Lines of Attack Panel Styling */\\n/* Teal/cyan theme (#20b2aa) - Full-page lavish design */\\n\\n:root {\\n  --lines-primary: #20b2aa;\\n  --lines-primary-dark: #b5343a;\\n  --lines-primary-light: #b5343a;\\n  --lines-bg-dark: #faf8f5;\\n  --lines-bg-card: #ffffff;\\n  --lines-bg-elevated: #f5f3f0;\\n  --lines-surface: #f5f3f0;\\n  --lines-border: #f5f3f0;\\n  --lines-text: #4a4a4a;\\n  --lines-text-muted: #8b949e;\\n  --lines-accent: #b5343a;\\n  --lines-glow: rgba(32, 178, 170, 0.15);\\n}\\n\\n/* ============= TOAST NOTIFICATIONS ============= */\\n.toast-notification {\\n  position: fixed;\\n  top: 20px;\\n  right: 20px;\\n  z-index: 10000;\\n  padding: 14px 20px;\\n  border-radius: 10px;\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  font-size: 14px;\\n  font-weight: 500;\\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\\n  animation: slideInRight 0.3s ease-out;\\n  max-width: 420px;\\n}\\n\\n@keyframes slideInRight {\\n  from {\\n    opacity: 0;\\n    transform: translateX(100px);\\n  }\\n  to {\\n    opacity: 1;\\n    transform: translateX(0);\\n  }\\n}\\n\\n.toast-info {\\n  background: linear-gradient(135deg, #f5f3f0, #b5343a);\\n  border: 1px solid #b5343a;\\n  color: #4a4a4a;\\n}\\n\\n.toast-success {\\n  background: linear-gradient(135deg, #f5f3f0, #b5343a);\\n  border: 1px solid #b5343a;\\n  color: #4a4a4a;\\n}\\n\\n.toast-error {\\n  background: linear-gradient(135deg, #5f1e1e, #7d2d2d);\\n  border: 1px solid #b84c4c;\\n  color: #4a4a4a;\\n}\\n\\n.toast-close {\\n  background: none;\\n  border: none;\\n  color: rgba(255, 255, 255, 0.7);\\n  font-size: 18px;\\n  cursor: pointer;\\n  padding: 0 4px;\\n  margin-left: auto;\\n  transition: color 0.2s;\\n}\\n\\n.toast-close:hover {\\n  color: white;\\n}\\n\\n/* Full-page panel - no overlay needed */\\n.lines-panel {\\n  flex: 1;\\n  display: flex;\\n  flex-direction: column;\\n  background: var(--lines-bg-dark);\\n  min-height: calc(100vh - 80px); /* Account for header */\\n  overflow: hidden;\\n}\\n\\n/* Lavish Header */\\n.lines-panel-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 24px 40px;\\n  background: linear-gradient(135deg, var(--lines-bg-card) 0%, rgba(32, 178, 170, 0.08) 100%);\\n  border-bottom: 2px solid var(--lines-primary);\\n  box-shadow: 0 4px 30px var(--lines-glow);\\n}\\n\\n.lines-panel-header h2 {\\n  margin: 0;\\n  color: var(--lines-primary);\\n  font-size: 2rem;\\n  font-weight: 700;\\n  letter-spacing: -0.02em;\\n  text-shadow: 0 0 30px var(--lines-glow);\\n}\\n\\n/* View Toggle - Prominent Tab Navigation */\\n.view-toggle {\\n  display: flex;\\n  gap: 12px;\\n  background: var(--lines-bg-elevated);\\n  padding: 6px;\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.toggle-btn {\\n  background: transparent;\\n  border: none;\\n  color: var(--lines-text-muted);\\n  padding: 12px 24px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-size: 15px;\\n  font-weight: 500;\\n  transition: all 0.2s ease;\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n}\\n\\n.toggle-btn:hover {\\n  background: rgba(32, 178, 170, 0.1);\\n  color: var(--lines-text);\\n}\\n\\n.toggle-btn.active {\\n  background: linear-gradient(135deg, var(--lines-primary), var(--lines-primary-dark));\\n  color: white;\\n  font-weight: 600;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.toggle-btn.corpus-toggle.active {\\n  background: linear-gradient(135deg, #9b59b6, #8e44ad);\\n  box-shadow: 0 4px 15px rgba(155, 89, 182, 0.3);\\n}\\n\\n/* Submit Form - Full-page layout */\\n.lines-submit-form {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 40px 60px;\\n  display: flex;\\n  justify-content: center;\\n}\\n\\n.lines-submit-form form {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 32px;\\n  max-width: 900px;\\n  width: 100%;\\n}\\n\\n.form-group {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.form-group label {\\n  color: var(--lines-primary);\\n  font-weight: 600;\\n  font-size: 13px;\\n  text-transform: uppercase;\\n  letter-spacing: 1px;\\n}\\n\\n.form-group input[type=\\\"text\\\"],\\n.form-group textarea {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text);\\n  padding: 16px 18px;\\n  border-radius: 10px;\\n  font-family: inherit;\\n  font-size: 15px;\\n  transition: all 0.2s ease;\\n}\\n\\n.form-group input[type=\\\"text\\\"]:focus,\\n.form-group textarea:focus {\\n  outline: none;\\n  border-color: var(--lines-primary);\\n  background: var(--lines-bg-elevated);\\n  box-shadow: 0 0 20px var(--lines-glow);\\n}\\n\\n.form-group textarea {\\n  resize: vertical;\\n  min-height: 120px;\\n}\\n\\n.file-selector {\\n  background: var(--lines-bg-card);\\n  border: 2px dashed var(--lines-primary);\\n  border-radius: 12px;\\n  padding: 24px;\\n}\\n\\n.file-selector .hint {\\n  margin: 0 0 16px 0;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n}\\n\\n.browse-btn {\\n  background: linear-gradient(135deg, var(--lines-primary), var(--lines-primary-dark));\\n  border: none;\\n  color: white;\\n  padding: 14px 24px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 14px;\\n  transition: all 0.2s;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.browse-btn:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n.selected-files {\\n  margin-top: 16px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  max-height: 200px;\\n  overflow-y: auto;\\n}\\n\\n.file-item {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  background: var(--lines-bg-elevated);\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  font-size: 13px;\\n  color: var(--lines-text);\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.remove-btn {\\n  background: none;\\n  border: none;\\n  color: var(--lines-text-muted);\\n  cursor: pointer;\\n  font-size: 18px;\\n  padding: 4px 8px;\\n  transition: color 0.2s;\\n  border-radius: 4px;\\n}\\n\\n.remove-btn:hover {\\n  color: #ff6b6b;\\n  background: rgba(255, 107, 107, 0.1);\\n}\\n\\n.context-selector {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 10px;\\n}\\n\\n.checkbox-label {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  cursor: pointer;\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  transition: all 0.2s;\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.checkbox-label:hover {\\n  background: var(--lines-bg-elevated);\\n  border-color: var(--lines-primary);\\n}\\n\\n.checkbox-label input[type=\\\"checkbox\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  min-width: 18px;\\n  flex-shrink: 0;\\n  margin-right: 8px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n}\\n\\n.submit-btn {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  padding: 18px 32px;\\n  border-radius: 12px;\\n  font-weight: 700;\\n  font-size: 16px;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  box-shadow: 0 4px 20px rgba(32, 178, 170, 0.3);\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  margin-top: 10px;\\n}\\n\\n.submit-btn:hover:not(:disabled) {\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 12px rgba(32, 178, 170, 0.3);\\n}\\n\\n.submit-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n/* List View - Full-page lavish layout */\\n.lines-list-view {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 40px 60px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 32px;\\n  max-width: 1400px;\\n  margin: 0 auto;\\n  width: 100%;\\n}\\n\\n.running-jobs,\\n.analyses-list {\\n  flex: 1;\\n}\\n\\n.running-jobs h3,\\n.analyses-list h3 {\\n  margin: 0 0 20px 0;\\n  color: var(--lines-primary);\\n  font-size: 16px;\\n  text-transform: uppercase;\\n  font-weight: 700;\\n  letter-spacing: 1px;\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n}\\n\\n.running-jobs h3::before,\\n.analyses-list h3::before {\\n  content: '';\\n  width: 4px;\\n  height: 24px;\\n  background: linear-gradient(to bottom, var(--lines-primary), var(--lines-primary-dark));\\n  border-radius: 2px;\\n}\\n\\n.job-card {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-primary);\\n  border-radius: 12px;\\n  padding: 20px;\\n  margin-bottom: 12px;\\n  box-shadow: 0 4px 20px var(--lines-glow);\\n}\\n\\n.job-info {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  color: var(--lines-text);\\n  font-size: 14px;\\n}\\n\\n.status {\\n  color: var(--lines-primary-light);\\n  font-weight: 700;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.analysis-card {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 12px;\\n  padding: 24px;\\n  margin-bottom: 16px;\\n  transition: all 0.3s ease;\\n  cursor: pointer;\\n}\\n\\n.analysis-card:hover {\\n  border-color: var(--lines-primary);\\n  background: var(--lines-bg-elevated);\\n  box-shadow: 0 8px 30px var(--lines-glow);\\n  transform: translateY(-2px);\\n}\\n\\n.analysis-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 16px;\\n}\\n\\n.analysis-header h4 {\\n  margin: 0;\\n  color: var(--lines-primary);\\n  font-size: 18px;\\n  font-weight: 700;\\n}\\n\\n.date {\\n  color: var(--lines-text-muted);\\n  font-size: 13px;\\n}\\n\\n.analysis-stats {\\n  display: flex;\\n  gap: 24px;\\n  margin-bottom: 16px;\\n  font-size: 14px;\\n  color: var(--lines-text-muted);\\n}\\n\\n.details-btn {\\n  background: linear-gradient(135deg, var(--lines-primary), var(--lines-primary-dark));\\n  border: none;\\n  color: white;\\n  padding: 12px 20px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 14px;\\n  transition: all 0.2s;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.details-btn:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n.analysis-actions {\\n  display: flex;\\n  gap: 12px;\\n  align-items: center;\\n}\\n\\n.download-btn,\\n.delete-btn {\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  padding: 10px 14px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-size: 16px;\\n  transition: all 0.2s;\\n  min-width: 44px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n}\\n\\n.download-btn:hover {\\n  border-color: #4a9eff;\\n  color: #b5343a;\\n  background: rgba(74, 158, 255, 0.15);\\n  transform: translateY(-2px);\\n}\\n\\n.delete-btn:hover {\\n  border-color: #ff6b6b;\\n  color: #ff6b6b;\\n  background: rgba(255, 107, 107, 0.15);\\n  transform: translateY(-2px);\\n}\\n\\n.empty-state {\\n  color: var(--lines-text-muted);\\n  font-size: 16px;\\n  text-align: center;\\n  padding: 60px 40px;\\n  margin: 0;\\n  background: var(--lines-bg-card);\\n  border-radius: 12px;\\n  border: 2px dashed var(--lines-border);\\n}\\n\\n.back-btn {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  padding: 12px 20px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 14px;\\n  transition: all 0.2s;\\n  align-self: flex-start;\\n}\\n\\n.back-btn:hover {\\n  border-color: var(--lines-primary);\\n  color: var(--lines-primary);\\n  background: var(--lines-bg-elevated);\\n}\\n\\n/* Detail View - Full-page lavish layout */\\n.lines-detail-view {\\n  flex: 1;\\n  display: flex;\\n  flex-direction: column;\\n  overflow: hidden;\\n}\\n\\n.detail-header {\\n  display: flex;\\n  align-items: center;\\n  gap: 16px;\\n  padding: 24px 40px;\\n  border-bottom: 2px solid var(--lines-primary);\\n  background: linear-gradient(135deg, var(--lines-bg-card) 0%, rgba(32, 178, 170, 0.05) 100%);\\n  flex-shrink: 0;\\n}\\n\\n.detail-header h3 {\\n  margin: 0;\\n  color: var(--lines-primary);\\n  font-size: 1.5rem;\\n  font-weight: 700;\\n}\\n\\n.detail-stats {\\n  padding: 20px 40px;\\n  background: linear-gradient(135deg, var(--lines-bg-card) 0%, rgba(32, 178, 170, 0.03) 100%);\\n  border-bottom: 1px solid var(--lines-border);\\n  flex-shrink: 0;\\n}\\n\\n.stats-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\\n  gap: 16px;\\n}\\n\\n.stats-grid > div {\\n  text-align: center;\\n  font-size: 13px;\\n  color: var(--lines-text-muted);\\n  background: var(--lines-bg-elevated);\\n  padding: 16px;\\n  border-radius: 10px;\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.stats-grid strong {\\n  display: block;\\n  color: var(--lines-primary);\\n  font-size: 24px;\\n  margin-bottom: 6px;\\n  font-weight: 700;\\n}\\n\\n/* Corpus Stats Dashboard */\\n.corpus-stats-dashboard {\\n  display: grid;\\n  grid-template-columns: repeat(4, 1fr);\\n  gap: 16px;\\n  padding: 20px 40px;\\n  background: linear-gradient(135deg, var(--lines-bg-card) 0%, rgba(32, 178, 170, 0.05) 100%);\\n  border-bottom: 1px solid var(--lines-border);\\n}\\n\\n.stat-card {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  justify-content: center;\\n  padding: 16px 12px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 10px;\\n  transition: all 0.2s ease;\\n}\\n\\n.stat-card:hover {\\n  border-color: var(--lines-primary);\\n  box-shadow: 0 4px 20px var(--lines-glow);\\n  transform: translateY(-2px);\\n}\\n\\n.stat-card.accent {\\n  border-color: rgba(99, 102, 241, 0.3);\\n  background: linear-gradient(135deg, var(--lines-bg-elevated) 0%, rgba(99, 102, 241, 0.08) 100%);\\n}\\n\\n.stat-card.accent:hover {\\n  border-color: var(--lines-accent);\\n  box-shadow: 0 4px 20px rgba(99, 102, 241, 0.2);\\n}\\n\\n.stat-icon {\\n  font-size: 20px;\\n  margin-bottom: 6px;\\n  opacity: 0.9;\\n}\\n\\n.stat-value {\\n  font-size: 28px;\\n  font-weight: 700;\\n  color: var(--lines-text);\\n  line-height: 1;\\n}\\n\\n.stat-card.accent .stat-value {\\n  color: var(--lines-accent);\\n}\\n\\n.stat-label {\\n  font-size: 11px;\\n  color: var(--lines-text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  margin-top: 6px;\\n  text-align: center;\\n}\\n\\n.filter-controls {\\n  display: flex;\\n  gap: 10px;\\n  padding: 16px 40px;\\n  border-bottom: 1px solid var(--lines-border);\\n  flex-wrap: wrap;\\n  flex-shrink: 0;\\n  background: var(--lines-bg-card);\\n}\\n\\n.filter-btn {\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  padding: 10px 16px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 13px;\\n  transition: all 0.2s;\\n}\\n\\n.filter-btn:hover {\\n  border-color: var(--lines-primary);\\n  color: var(--lines-text);\\n}\\n\\n.filter-btn.active {\\n  background: linear-gradient(135deg, var(--lines-primary), var(--lines-primary-dark));\\n  border-color: var(--lines-primary);\\n  color: white;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.export-btn {\\n  background: linear-gradient(135deg, var(--lines-primary), var(--lines-primary-dark));\\n  border: none;\\n  color: white;\\n  padding: 10px 20px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 13px;\\n  margin-left: auto;\\n  transition: all 0.2s;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.export-btn:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n.lines-detail-content {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 32px 40px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n  max-width: 1200px;\\n  margin: 0 auto;\\n  width: 100%;\\n}\\n\\n.line-card {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 12px;\\n  padding: 24px;\\n  transition: all 0.3s ease;\\n}\\n\\n.line-card:hover {\\n  border-color: var(--lines-primary);\\n  background: var(--lines-bg-elevated);\\n  box-shadow: 0 8px 30px var(--lines-glow);\\n}\\n\\n.line-header {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 16px;\\n  margin-bottom: 16px;\\n}\\n\\n.line-header input[type=\\\"checkbox\\\"] {\\n  width: 22px;\\n  height: 22px;\\n  margin-top: 2px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n  flex-shrink: 0;\\n}\\n\\n.line-title-section {\\n  flex: 1;\\n}\\n\\n.line-title-section h4 {\\n  margin: 0 0 8px 0;\\n  color: var(--lines-primary);\\n  font-size: 18px;\\n  font-weight: 700;\\n}\\n\\n.line-summary {\\n  margin: 0 0 10px 0;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  line-height: 1.6;\\n}\\n\\n.severity {\\n  display: inline-block;\\n  padding: 6px 12px;\\n  border-radius: 20px;\\n  font-size: 12px;\\n  font-weight: 700;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n.severity.high {\\n  background: rgba(255, 67, 67, 0.2);\\n  color: #ff6b6b;\\n  border: 1px solid rgba(255, 67, 67, 0.3);\\n}\\n\\n.severity.medium {\\n  background: rgba(255, 193, 7, 0.2);\\n  color: #ffc107;\\n  border: 1px solid rgba(255, 193, 7, 0.3);\\n}\\n\\n.severity.low {\\n  background: rgba(76, 175, 80, 0.2);\\n  color: #66bb6a;\\n  border: 1px solid rgba(76, 175, 80, 0.3);\\n}\\n\\n.talking-points {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n  margin-top: 16px;\\n  border-top: 1px solid var(--lines-border);\\n  padding-top: 16px;\\n}\\n\\n.talking-point {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  padding: 16px;\\n  background: rgba(32, 178, 170, 0.05);\\n  border-radius: 10px;\\n  border: 1px solid transparent;\\n  transition: all 0.2s;\\n}\\n\\n.talking-point:hover {\\n  background: rgba(32, 178, 170, 0.08);\\n  border-color: rgba(32, 178, 170, 0.2);\\n}\\n\\n.talking-point input[type=\\\"checkbox\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  margin-top: 2px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n  flex-shrink: 0;\\n}\\n\\n.tp-content {\\n  flex: 1;\\n  font-size: 14px;\\n}\\n\\n.tp-text {\\n  margin: 0 0 10px 0;\\n  color: var(--lines-text);\\n  line-height: 1.6;\\n}\\n\\n.tp-evidence {\\n  color: var(--lines-text);\\n  margin: 0;\\n  cursor: pointer;\\n}\\n\\n.tp-evidence summary {\\n  color: var(--lines-primary);\\n  font-weight: 600;\\n  font-size: 13px;\\n  margin-bottom: 8px;\\n  user-select: none;\\n}\\n\\n.tp-evidence p {\\n  margin: 10px 0 0 0;\\n  padding: 12px;\\n  background: rgba(0, 0, 0, 0.05);\\n  border-radius: 8px;\\n  line-height: 1.5;\\n  font-size: 13px;\\n  color: #3a3a3a;\\n}\\n\\n.tp-evidence .page {\\n  font-size: 12px;\\n  color: var(--lines-primary);\\n}\\n\\n.tp-evidence .targets {\\n  font-size: 13px;\\n}\\n\\n/* Citation count badge */\\n.tp-evidence .citation-count {\\n  color: var(--lines-accent);\\n  font-size: 11px;\\n  font-weight: normal;\\n  opacity: 0.8;\\n}\\n\\n/* Primary evidence section */\\n.tp-evidence .primary-evidence {\\n  margin: 8px 0;\\n}\\n\\n.tp-evidence .primary-evidence > strong {\\n  color: var(--lines-primary);\\n  font-size: 11px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n}\\n\\n/* Supporting citations nested details */\\n.supporting-citations {\\n  margin-top: 12px;\\n  border-top: 1px solid rgba(0, 0, 0, 0.1);\\n  padding-top: 8px;\\n}\\n\\n.supporting-citations summary {\\n  color: var(--lines-accent);\\n  font-size: 12px;\\n  font-weight: 500;\\n  cursor: pointer;\\n  margin-bottom: 8px;\\n}\\n\\n.supporting-citations ul {\\n  list-style: none;\\n  padding: 0;\\n  margin: 0;\\n}\\n\\n.supporting-citation {\\n  background: rgba(0, 0, 0, 0.04);\\n  border-left: 3px solid var(--lines-accent);\\n  padding: 10px 12px;\\n  margin-bottom: 8px;\\n  border-radius: 0 6px 6px 0;\\n}\\n\\n.supporting-citation blockquote {\\n  margin: 0;\\n  padding: 0;\\n  font-style: italic;\\n  color: var(--lines-text);\\n  line-height: 1.5;\\n  font-size: 13px;\\n}\\n\\n.supporting-citation cite {\\n  display: block;\\n  margin-top: 6px;\\n  font-size: 11px;\\n  color: #6b7280;\\n  font-style: normal;\\n}\\n\\n/* Export Modal */\\n.export-modal-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.85);\\n  backdrop-filter: blur(4px);\\n  z-index: 2000;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n}\\n\\n.export-modal {\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-primary);\\n  border-radius: 16px;\\n  padding: 32px;\\n  max-width: 480px;\\n  width: 90%;\\n  box-shadow:\\n    0 0 60px rgba(32, 178, 170, 0.3),\\n    0 25px 50px rgba(0, 0, 0, 0.5);\\n}\\n\\n.export-modal h4 {\\n  margin: 0 0 12px 0;\\n  color: var(--lines-primary);\\n  font-size: 20px;\\n  font-weight: 700;\\n}\\n\\n.export-modal > p {\\n  margin: 0 0 20px 0;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  line-height: 1.5;\\n}\\n\\n.export-options {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n  margin-bottom: 24px;\\n}\\n\\n.export-options label {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  cursor: pointer;\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  padding: 12px 16px;\\n  background: var(--lines-bg-elevated);\\n  border-radius: 8px;\\n  border: 1px solid var(--lines-border);\\n  transition: all 0.2s;\\n}\\n\\n.export-options label:hover {\\n  border-color: var(--lines-primary);\\n  background: var(--lines-glow);\\n}\\n\\n.export-options input[type=\\\"checkbox\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n}\\n\\n.export-options input[type=\\\"text\\\"] {\\n  background: var(--lines-bg-dark);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text);\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  font-size: 14px;\\n  transition: border-color 0.2s;\\n}\\n\\n.export-options input[type=\\\"text\\\"]:focus {\\n  border-color: var(--lines-primary);\\n  outline: none;\\n  box-shadow: 0 0 0 3px var(--lines-glow);\\n}\\n\\n.modal-buttons {\\n  display: flex;\\n  gap: 12px;\\n  justify-content: flex-end;\\n}\\n\\n.export-confirm-btn,\\n.export-cancel-btn {\\n  padding: 12px 24px;\\n  border-radius: 8px;\\n  border: none;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 14px;\\n  transition: all 0.2s;\\n}\\n\\n.export-confirm-btn {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  color: white;\\n}\\n\\n.export-confirm-btn:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(32, 178, 170, 0.4);\\n}\\n\\n.export-cancel-btn {\\n  background: var(--lines-bg-elevated);\\n  color: var(--lines-text-muted);\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.export-cancel-btn:hover {\\n  border-color: var(--lines-primary);\\n  color: var(--lines-primary);\\n}\\n\\n.export-confirm-btn:disabled,\\n.export-cancel-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n  transform: none;\\n}\\n\\n.export-error {\\n  background: rgba(255, 67, 67, 0.15);\\n  border: 1px solid #ff4343;\\n  color: #ff6b6b;\\n  padding: 14px 16px;\\n  border-radius: 8px;\\n  font-size: 13px;\\n  margin-bottom: 20px;\\n}\\n\\n.option-group {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.option-group > label {\\n  color: var(--lines-text-muted);\\n  font-size: 13px;\\n  font-weight: 500;\\n  display: block;\\n  margin-bottom: 4px;\\n  padding: 0;\\n  background: transparent;\\n  border: none;\\n}\\n\\n.option-group > label:hover {\\n  background: transparent;\\n  border: none;\\n}\\n\\n.option-group select {\\n  background: var(--lines-bg-dark);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text);\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  font-size: 14px;\\n  width: 100%;\\n  cursor: pointer;\\n  transition: border-color 0.2s;\\n}\\n\\n.option-group select:focus {\\n  border-color: var(--lines-primary);\\n  outline: none;\\n  box-shadow: 0 0 0 3px var(--lines-glow);\\n}\\n\\n/* File Browser Modal */\\n.file-browser-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.85);\\n  backdrop-filter: blur(4px);\\n  z-index: 2000;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n}\\n\\n.file-browser-modal {\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-primary);\\n  border-radius: 16px;\\n  width: 90%;\\n  max-width: 600px;\\n  max-height: 85vh;\\n  display: flex;\\n  flex-direction: column;\\n  overflow: hidden;\\n  box-shadow:\\n    0 0 60px rgba(32, 178, 170, 0.3),\\n    0 25px 50px rgba(0, 0, 0, 0.5);\\n}\\n\\n.browser-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 24px 28px;\\n  border-bottom: 2px solid var(--lines-primary);\\n  background: linear-gradient(135deg, var(--lines-bg-card) 0%, var(--lines-glow) 100%);\\n  flex-shrink: 0;\\n}\\n\\n.browser-header h3 {\\n  margin: 0;\\n  color: var(--lines-primary);\\n  font-size: 20px;\\n  font-weight: 700;\\n}\\n\\n.browser-path {\\n  padding: 14px 24px;\\n  background: var(--lines-bg-elevated);\\n  border-bottom: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  font-size: 13px;\\n  font-family: monospace;\\n  flex-shrink: 0;\\n}\\n\\n.browser-content {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 16px 0;\\n}\\n\\n.browser-content .loading,\\n.browser-content .empty {\\n  padding: 60px 24px;\\n  text-align: center;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n}\\n\\n.browser-items {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.browser-item {\\n  padding: 0;\\n  display: flex;\\n}\\n\\n.dir-btn {\\n  flex: 1;\\n  background: none;\\n  border: none;\\n  color: var(--lines-primary);\\n  padding: 14px 24px;\\n  text-align: left;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 14px;\\n  transition: all 0.2s;\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n}\\n\\n.dir-btn:hover {\\n  background: var(--lines-glow);\\n}\\n\\n.dir-row {\\n  display: flex;\\n  align-items: center;\\n  width: 100%;\\n}\\n\\n.folder-checkbox {\\n  display: flex;\\n  align-items: center;\\n  padding: 14px;\\n  padding-right: 0;\\n  cursor: pointer;\\n}\\n\\n.folder-checkbox input[type=\\\"checkbox\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n}\\n\\n.folder-checkbox input[type=\\\"checkbox\\\"]:disabled {\\n  cursor: wait;\\n  opacity: 0.5;\\n}\\n\\n.folder-loading {\\n  margin-left: 8px;\\n  font-size: 13px;\\n  color: var(--lines-primary);\\n}\\n\\n.file-label {\\n  flex: 1;\\n  display: flex;\\n  align-items: center;\\n  gap: 14px;\\n  padding: 14px 24px;\\n  cursor: pointer;\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  transition: all 0.2s;\\n  border-radius: 6px;\\n  margin: 0 8px;\\n}\\n\\n.file-label:hover {\\n  background: var(--lines-glow);\\n}\\n\\n.file-label.disabled {\\n  cursor: not-allowed;\\n  color: var(--lines-text-muted);\\n  opacity: 0.5;\\n}\\n\\n.file-label.disabled:hover {\\n  background: transparent;\\n}\\n\\n.file-label input[type=\\\"checkbox\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n  flex-shrink: 0;\\n}\\n\\n.file-info {\\n  flex: 1;\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n}\\n\\n.browser-footer {\\n  padding: 20px 24px;\\n  border-top: 1px solid var(--lines-border);\\n  background: var(--lines-bg-elevated);\\n  flex-shrink: 0;\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 12px;\\n}\\n\\n.confirm-btn {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  padding: 14px 28px;\\n  border-radius: 8px;\\n  font-weight: 600;\\n  font-size: 14px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.confirm-btn:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n/* Scrollbar Styling */\\n.lines-panel::-webkit-scrollbar,\\n.lines-submit-form::-webkit-scrollbar,\\n.lines-list-view::-webkit-scrollbar,\\n.lines-detail-content::-webkit-scrollbar,\\n.browser-content::-webkit-scrollbar,\\n.corpus-view::-webkit-scrollbar {\\n  width: 10px;\\n}\\n\\n.lines-panel::-webkit-scrollbar-track,\\n.lines-submit-form::-webkit-scrollbar-track,\\n.lines-list-view::-webkit-scrollbar-track,\\n.lines-detail-content::-webkit-scrollbar-track,\\n.browser-content::-webkit-scrollbar-track,\\n.corpus-view::-webkit-scrollbar-track {\\n  background: var(--lines-bg-dark);\\n  border-radius: 5px;\\n}\\n\\n.lines-panel::-webkit-scrollbar-thumb,\\n.lines-submit-form::-webkit-scrollbar-thumb,\\n.lines-list-view::-webkit-scrollbar-thumb,\\n.lines-detail-content::-webkit-scrollbar-thumb,\\n.browser-content::-webkit-scrollbar-thumb,\\n.corpus-view::-webkit-scrollbar-thumb {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border-radius: 5px;\\n  border: 2px solid var(--lines-bg-dark);\\n}\\n\\n.lines-panel::-webkit-scrollbar-thumb:hover,\\n.lines-submit-form::-webkit-scrollbar-thumb:hover,\\n.lines-list-view::-webkit-scrollbar-thumb:hover,\\n.lines-detail-content::-webkit-scrollbar-thumb:hover,\\n.browser-content::-webkit-scrollbar-thumb:hover,\\n.corpus-view::-webkit-scrollbar-thumb:hover {\\n  background: var(--lines-primary-light);\\n}\\n\\n/* ========================================= */\\n/* Corpus Analysis View Styles (Phase 8) */\\n/* ========================================= */\\n\\n.corpus-view {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 40px 60px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 32px;\\n  max-width: 1400px;\\n  margin: 0 auto;\\n  width: 100%;\\n}\\n\\n/* Discover Section */\\n.corpus-discover {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 28px;\\n}\\n\\n.discover-form {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n  max-width: 600px;\\n}\\n\\n.discover-btn {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  padding: 16px 32px;\\n  border-radius: 10px;\\n  font-weight: 700;\\n  font-size: 15px;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  text-transform: uppercase;\\n  letter-spacing: 1px;\\n  align-self: flex-start;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.2);\\n}\\n\\n.discover-btn:hover:not(:disabled) {\\n  transform: translateY(-3px);\\n  box-shadow: 0 8px 25px rgba(32, 178, 170, 0.4);\\n}\\n\\n.discover-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n  transform: none;\\n}\\n\\n/* Corpus Detail View */\\n.corpus-detail {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 28px;\\n}\\n\\n.corpus-card {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-primary);\\n  border-radius: 12px;\\n  padding: 28px;\\n  box-shadow:\\n    0 0 30px var(--lines-glow),\\n    0 4px 20px rgba(0, 0, 0, 0.3);\\n}\\n\\n.corpus-card h3 {\\n  margin: 0 0 20px 0;\\n  color: var(--lines-primary);\\n  font-size: 20px;\\n  font-weight: 700;\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n}\\n\\n.corpus-stats {\\n  display: flex;\\n  gap: 24px;\\n  flex-wrap: wrap;\\n}\\n\\n.stat-item {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  background: var(--lines-bg-elevated);\\n  padding: 18px 28px;\\n  border-radius: 10px;\\n  min-width: 120px;\\n  border: 1px solid var(--lines-border);\\n  transition: all 0.2s;\\n}\\n\\n.stat-item:hover {\\n  border-color: var(--lines-primary);\\n  transform: translateY(-2px);\\n}\\n\\n.stat-value {\\n  font-size: 28px;\\n  font-weight: 700;\\n  color: var(--lines-primary);\\n}\\n\\n.stat-label {\\n  font-size: 12px;\\n  color: var(--lines-text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  margin-top: 6px;\\n}\\n\\n/* Works List */\\n.works-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 10px;\\n}\\n\\n.works-list h4 {\\n  margin: 0 0 16px 0;\\n  color: var(--lines-primary);\\n  font-size: 15px;\\n  text-transform: uppercase;\\n  font-weight: 700;\\n  letter-spacing: 1px;\\n}\\n\\n.work-item {\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 10px;\\n  overflow: hidden;\\n  transition: all 0.2s;\\n}\\n\\n.work-item:hover {\\n  border-color: var(--lines-primary);\\n  box-shadow: 0 4px 15px var(--lines-glow);\\n}\\n\\n.work-item.selected {\\n  border-color: var(--lines-primary);\\n  background: var(--lines-glow);\\n}\\n\\n.work-main {\\n  display: flex;\\n  align-items: center;\\n  gap: 16px;\\n  padding: 16px 20px;\\n  cursor: pointer;\\n}\\n\\n.work-main input[type=\\\"checkbox\\\"] {\\n  width: 20px;\\n  height: 20px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n  flex-shrink: 0;\\n}\\n\\n.work-info {\\n  flex: 1;\\n  min-width: 0;\\n}\\n\\n.work-title {\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  font-weight: 600;\\n  white-space: nowrap;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n}\\n\\n.work-meta {\\n  display: flex;\\n  gap: 16px;\\n  margin-top: 6px;\\n  font-size: 12px;\\n  color: var(--lines-text-muted);\\n}\\n\\n.work-scores {\\n  display: flex;\\n  gap: 10px;\\n  flex-shrink: 0;\\n}\\n\\n.score-badge {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  padding: 8px 14px;\\n  border-radius: 8px;\\n  min-width: 55px;\\n}\\n\\n.score-badge.relevance {\\n  background: rgba(255, 193, 7, 0.15);\\n  color: #ffc107;\\n  border: 1px solid rgba(255, 193, 7, 0.3);\\n}\\n\\n.score-badge.fame {\\n  background: rgba(156, 39, 176, 0.15);\\n  color: #ce93d8;\\n  border: 1px solid rgba(156, 39, 176, 0.3);\\n}\\n\\n.score-value {\\n  font-size: 16px;\\n  font-weight: 700;\\n}\\n\\n.score-label {\\n  font-size: 10px;\\n  text-transform: uppercase;\\n  letter-spacing: 0.3px;\\n  opacity: 0.8;\\n  margin-top: 3px;\\n}\\n\\n.expand-btn {\\n  background: none;\\n  border: none;\\n  color: var(--lines-text-muted);\\n  cursor: pointer;\\n  padding: 6px 12px;\\n  font-size: 13px;\\n  transition: all 0.2s;\\n  border-radius: 6px;\\n}\\n\\n.expand-btn:hover {\\n  color: var(--lines-primary);\\n  background: var(--lines-glow);\\n}\\n\\n.work-details {\\n  padding: 16px 20px 20px 56px;\\n  border-top: 1px solid var(--lines-border);\\n  background: var(--lines-bg-dark);\\n}\\n\\n.work-path {\\n  color: var(--lines-text-muted);\\n  font-size: 12px;\\n  font-family: monospace;\\n  word-break: break-all;\\n}\\n\\n/* Analysis Config Section */\\n.analysis-config {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 12px;\\n  padding: 28px;\\n}\\n\\n.analysis-config h4 {\\n  margin: 0 0 8px 0;\\n  color: var(--lines-primary);\\n  font-size: 15px;\\n  text-transform: uppercase;\\n  font-weight: 700;\\n  letter-spacing: 1px;\\n}\\n\\n/* Sampling Mode Selector */\\n.sampling-selector {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.radio-label {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 14px;\\n  cursor: pointer;\\n  padding: 16px 20px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 10px;\\n  transition: all 0.2s;\\n}\\n\\n.radio-label:hover {\\n  background: var(--lines-glow);\\n  border-color: rgba(32, 178, 170, 0.4);\\n}\\n\\n.radio-label.selected {\\n  background: var(--lines-glow);\\n  border-color: var(--lines-primary);\\n  box-shadow: 0 0 20px var(--lines-glow);\\n}\\n\\n.radio-label input[type=\\\"radio\\\"] {\\n  width: 20px;\\n  height: 20px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n  flex-shrink: 0;\\n  margin-top: 2px;\\n}\\n\\n.radio-text {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 6px;\\n}\\n\\n.radio-title {\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  font-weight: 600;\\n}\\n\\n.radio-desc {\\n  color: var(--lines-text-muted);\\n  font-size: 12px;\\n  line-height: 1.5;\\n}\\n\\n/* Target Lines Slider */\\n.target-slider {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n\\n.slider-container {\\n  display: flex;\\n  align-items: center;\\n  gap: 20px;\\n}\\n\\n.slider-container input[type=\\\"range\\\"] {\\n  flex: 1;\\n  height: 8px;\\n  background: var(--lines-border);\\n  border-radius: 4px;\\n  outline: none;\\n  -webkit-appearance: none;\\n  cursor: pointer;\\n}\\n\\n.slider-container input[type=\\\"range\\\"]::-webkit-slider-thumb {\\n  -webkit-appearance: none;\\n  width: 24px;\\n  height: 24px;\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border-radius: 50%;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n  box-shadow: 0 2px 8px rgba(32, 178, 170, 0.4);\\n}\\n\\n.slider-container input[type=\\\"range\\\"]::-webkit-slider-thumb:hover {\\n  transform: scale(1.15);\\n  box-shadow: 0 4px 12px rgba(32, 178, 170, 0.5);\\n}\\n\\n.slider-value {\\n  color: var(--lines-primary);\\n  font-size: 24px;\\n  font-weight: 700;\\n  min-width: 40px;\\n  text-align: center;\\n}\\n\\n.slider-labels {\\n  display: flex;\\n  justify-content: space-between;\\n  font-size: 12px;\\n  color: var(--lines-text-muted);\\n}\\n\\n/* Focus Guidance */\\n.focus-guidance {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 10px;\\n}\\n\\n/* Start Analysis Button */\\n.start-analysis-btn {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  padding: 18px 36px;\\n  border-radius: 12px;\\n  font-weight: 700;\\n  font-size: 16px;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  text-transform: uppercase;\\n  letter-spacing: 1px;\\n  align-self: flex-start;\\n  margin-top: 16px;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.start-analysis-btn:hover:not(:disabled) {\\n  transform: translateY(-3px);\\n  box-shadow: 0 8px 25px rgba(32, 178, 170, 0.5);\\n}\\n\\n.start-analysis-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n  transform: none;\\n}\\n\\n/* Analysis Progress View */\\n.corpus-analysis {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 32px;\\n}\\n\\n/* Current status message - prominent display */\\n.current-status-message {\\n  margin-bottom: 16px;\\n}\\n\\n.current-status-message p {\\n  padding: 18px 24px;\\n  border-radius: 12px;\\n  margin: 0;\\n  font-size: 15px;\\n  font-weight: 500;\\n}\\n\\n.current-status-message .status-running {\\n  background: linear-gradient(135deg, rgba(32, 178, 170, 0.2) 0%, rgba(32, 178, 170, 0.1) 100%);\\n  border: 2px solid var(--lines-primary);\\n  color: var(--lines-primary-light);\\n  animation: pulse-bg 2s infinite;\\n  box-shadow: 0 4px 20px rgba(32, 178, 170, 0.2);\\n}\\n\\n.current-status-message .status-failed {\\n  background: linear-gradient(135deg, rgba(255, 67, 67, 0.2) 0%, rgba(255, 67, 67, 0.1) 100%);\\n  border: 2px solid #ff4343;\\n  color: #ff6b6b;\\n  box-shadow: 0 4px 20px rgba(255, 67, 67, 0.15);\\n}\\n\\n.current-status-message .status-failed-container {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 14px;\\n  align-items: center;\\n}\\n\\n.current-status-message .retry-button {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  padding: 14px 28px;\\n  border-radius: 10px;\\n  font-size: 15px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  transition: all 0.3s ease;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.current-status-message .retry-button:hover {\\n  background: linear-gradient(135deg, var(--lines-primary-light) 0%, var(--lines-primary) 100%);\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n.current-status-message .status-waiting {\\n  background: linear-gradient(135deg, rgba(181, 52, 58, 0.2) 0%, rgba(181, 52, 58, 0.1) 100%);\\n  border: 2px solid #b5343a;\\n  color: #b5343a;\\n  box-shadow: 0 4px 20px rgba(181, 52, 58, 0.15);\\n}\\n\\n@keyframes pulse-bg {\\n  0%, 100% { opacity: 1; }\\n  50% { opacity: 0.7; }\\n}\\n\\n.stage-progress {\\n  display: flex;\\n  gap: 14px;\\n  align-items: center;\\n  flex-wrap: wrap;\\n}\\n\\n.stage-item {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  min-width: 100px;\\n  padding: 20px 16px;\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 12px;\\n  transition: all 0.3s;\\n  position: relative;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\\n}\\n\\n.stage-item:hover {\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);\\n}\\n\\n.stage-item.completed {\\n  border-color: #4caf50;\\n  background: linear-gradient(135deg, rgba(76, 175, 80, 0.15) 0%, rgba(76, 175, 80, 0.05) 100%);\\n}\\n\\n.stage-item.running {\\n  border-color: var(--lines-primary);\\n  background: linear-gradient(135deg, rgba(32, 178, 170, 0.2) 0%, rgba(32, 178, 170, 0.08) 100%);\\n  animation: stage-pulse 1.5s infinite;\\n}\\n\\n.stage-item.pending {\\n  opacity: 0.5;\\n}\\n\\n.stage-item.failed {\\n  border-color: #ff4343;\\n  background: linear-gradient(135deg, rgba(255, 67, 67, 0.15) 0%, rgba(255, 67, 67, 0.05) 100%);\\n}\\n\\n@keyframes stage-pulse {\\n  0%, 100% { box-shadow: 0 0 0 0 rgba(32, 178, 170, 0.4); }\\n  50% { box-shadow: 0 0 0 12px rgba(32, 178, 170, 0); }\\n}\\n\\n.stage-number {\\n  width: 40px;\\n  height: 40px;\\n  border-radius: 50%;\\n  background: var(--lines-border);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  font-weight: 700;\\n  font-size: 16px;\\n  color: var(--lines-text-muted);\\n  margin-bottom: 10px;\\n  transition: all 0.3s;\\n}\\n\\n.stage-item.completed .stage-number {\\n  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);\\n  color: white;\\n  box-shadow: 0 2px 8px rgba(76, 175, 80, 0.4);\\n}\\n\\n.stage-item.running .stage-number {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  color: white;\\n  box-shadow: 0 2px 8px rgba(32, 178, 170, 0.4);\\n}\\n\\n.stage-item.failed .stage-number {\\n  background: linear-gradient(135deg, #ff4343 0%, #e53935 100%);\\n  color: white;\\n  box-shadow: 0 2px 8px rgba(255, 67, 67, 0.4);\\n}\\n\\n.stage-name {\\n  font-size: 12px;\\n  color: var(--lines-text-muted);\\n  text-align: center;\\n  text-transform: uppercase;\\n  letter-spacing: 0.5px;\\n  font-weight: 500;\\n}\\n\\n.stage-item.completed .stage-name,\\n.stage-item.running .stage-name {\\n  color: var(--lines-text);\\n}\\n\\n.stage-connector {\\n  flex: 0 0 40px;\\n  height: 3px;\\n  background: var(--lines-border);\\n  position: relative;\\n  border-radius: 2px;\\n}\\n\\n.stage-connector.completed {\\n  background: linear-gradient(90deg, #4caf50 0%, #66bb6a 100%);\\n}\\n\\n/* Analysis Stats */\\n.analysis-stats-grid {\\n  display: grid;\\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\\n  gap: 20px;\\n}\\n\\n.analysis-stat {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  background: var(--lines-bg-card);\\n  padding: 24px 20px;\\n  border-radius: 12px;\\n  border: 2px solid var(--lines-border);\\n  transition: all 0.3s ease;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\\n}\\n\\n.analysis-stat:hover {\\n  border-color: var(--lines-primary);\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(32, 178, 170, 0.15);\\n}\\n\\n.analysis-stat-value {\\n  font-size: 36px;\\n  font-weight: 700;\\n  color: var(--lines-primary);\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-light) 100%);\\n  -webkit-background-clip: text;\\n  -webkit-text-fill-color: transparent;\\n  background-clip: text;\\n}\\n\\n.analysis-stat-label {\\n  font-size: 12px;\\n  color: var(--lines-text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 0.6px;\\n  margin-top: 8px;\\n  font-weight: 500;\\n}\\n\\n/* Corpus Error */\\n.corpus-error {\\n  background: linear-gradient(135deg, rgba(255, 67, 67, 0.2) 0%, rgba(255, 67, 67, 0.1) 100%);\\n  border: 2px solid #ff4343;\\n  color: #ff6b6b;\\n  padding: 18px 24px;\\n  border-radius: 12px;\\n  font-size: 14px;\\n  box-shadow: 0 4px 20px rgba(255, 67, 67, 0.15);\\n}\\n\\n/* Analysis Complete */\\n.analysis-complete {\\n  background: linear-gradient(135deg, rgba(76, 175, 80, 0.2) 0%, rgba(76, 175, 80, 0.08) 100%);\\n  border: 2px solid #4caf50;\\n  color: #a5d6a7;\\n  padding: 28px 32px;\\n  border-radius: 16px;\\n  text-align: center;\\n  box-shadow: 0 4px 20px rgba(76, 175, 80, 0.15);\\n}\\n\\n.analysis-complete p {\\n  margin: 0 0 18px 0;\\n  font-size: 16px;\\n  font-weight: 500;\\n}\\n\\n.view-results-btn {\\n  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);\\n  border: none;\\n  color: white;\\n  padding: 16px 32px;\\n  border-radius: 10px;\\n  font-weight: 600;\\n  font-size: 15px;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);\\n}\\n\\n.view-results-btn:hover {\\n  background: linear-gradient(135deg, #66bb6a 0%, #4caf50 100%);\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);\\n}\\n\\n/* Themes Review View */\\n.corpus-themes {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 28px;\\n}\\n\\n.themes-header {\\n  background: linear-gradient(135deg, rgba(32, 178, 170, 0.1) 0%, rgba(32, 178, 170, 0.03) 100%);\\n  border: 2px solid var(--lines-primary);\\n  border-radius: 14px;\\n  padding: 24px 28px;\\n}\\n\\n.themes-header h3 {\\n  margin: 0 0 10px 0;\\n  color: var(--lines-primary);\\n  font-size: 18px;\\n  font-weight: 600;\\n}\\n\\n.themes-header p {\\n  margin: 0;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  line-height: 1.5;\\n}\\n\\n.themes-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n\\n.theme-card {\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 12px;\\n  overflow: hidden;\\n  transition: all 0.3s;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\\n}\\n\\n.theme-card:hover {\\n  border-color: var(--lines-primary);\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(32, 178, 170, 0.15);\\n}\\n\\n.theme-card.selected {\\n  border-color: var(--lines-primary);\\n  background: linear-gradient(135deg, rgba(32, 178, 170, 0.1) 0%, rgba(32, 178, 170, 0.03) 100%);\\n  box-shadow: 0 0 20px rgba(32, 178, 170, 0.15);\\n}\\n\\n.theme-header {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 16px;\\n  padding: 20px;\\n  cursor: pointer;\\n}\\n\\n.theme-header input[type=\\\"checkbox\\\"] {\\n  width: 22px;\\n  height: 22px;\\n  cursor: pointer;\\n  accent-color: var(--lines-primary);\\n  flex-shrink: 0;\\n  margin-top: 2px;\\n}\\n\\n.theme-info {\\n  flex: 1;\\n}\\n\\n.theme-title {\\n  margin: 0 0 8px 0;\\n  color: var(--lines-text);\\n  font-size: 16px;\\n  font-weight: 600;\\n}\\n\\n.theme-description {\\n  margin: 0;\\n  color: var(--lines-text-muted);\\n  font-size: 13px;\\n  line-height: 1.5;\\n}\\n\\n.theme-relevance {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  padding: 12px 16px;\\n  background: linear-gradient(135deg, rgba(255, 193, 7, 0.2) 0%, rgba(255, 193, 7, 0.1) 100%);\\n  border-radius: 10px;\\n  flex-shrink: 0;\\n  border: 1px solid rgba(255, 193, 7, 0.3);\\n}\\n\\n.relevance-value {\\n  font-size: 20px;\\n  font-weight: 700;\\n  color: #ffc107;\\n}\\n\\n.relevance-label {\\n  font-size: 10px;\\n  color: #ffc107;\\n  text-transform: uppercase;\\n  letter-spacing: 0.4px;\\n  opacity: 0.9;\\n}\\n\\n.theme-citations {\\n  padding: 0 20px 20px 58px;\\n}\\n\\n.theme-citations details {\\n  color: var(--lines-text-muted);\\n  font-size: 13px;\\n}\\n\\n.theme-citations summary {\\n  color: var(--lines-primary);\\n  font-weight: 600;\\n  cursor: pointer;\\n  padding: 8px 0;\\n  user-select: none;\\n  transition: color 0.2s;\\n}\\n\\n.theme-citations summary:hover {\\n  color: var(--lines-primary-light);\\n}\\n\\n.citation-item {\\n  margin-top: 14px;\\n  padding: 16px;\\n  background: rgba(0, 0, 0, 0.3);\\n  border-radius: 10px;\\n  border-left: 3px solid var(--lines-primary);\\n}\\n\\n.citation-quote {\\n  margin: 0;\\n  color: var(--lines-text-muted);\\n  font-style: italic;\\n  line-height: 1.6;\\n}\\n\\n.citation-source {\\n  margin: 10px 0 0 0;\\n  font-size: 12px;\\n  color: var(--lines-primary);\\n  font-weight: 500;\\n}\\n\\n/* Themes Actions */\\n.themes-actions {\\n  display: flex;\\n  gap: 16px;\\n  padding-top: 20px;\\n  border-top: 2px solid var(--lines-border);\\n  align-items: center;\\n}\\n\\n.advance-btn {\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  padding: 16px 32px;\\n  border-radius: 10px;\\n  font-weight: 600;\\n  font-size: 15px;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.advance-btn:hover:not(:disabled) {\\n  background: linear-gradient(135deg, var(--lines-primary-light) 0%, var(--lines-primary) 100%);\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n.advance-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n  transform: none;\\n  box-shadow: none;\\n}\\n\\n.selected-count {\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  display: flex;\\n  align-items: center;\\n  font-weight: 500;\\n}\\n\\n/* Responsive */\\n@media (max-width: 900px) {\\n  .lines-panel {\\n    padding: 24px 32px;\\n  }\\n\\n  .corpus-view {\\n    padding: 24px 32px;\\n  }\\n\\n  .stats-grid {\\n    grid-template-columns: repeat(2, 1fr);\\n  }\\n\\n  .corpus-stats-dashboard {\\n    grid-template-columns: repeat(2, 1fr);\\n    padding: 16px 24px;\\n    gap: 12px;\\n  }\\n\\n  .stat-card {\\n    padding: 14px 10px;\\n  }\\n\\n  .stat-value {\\n    font-size: 24px;\\n  }\\n\\n  .filter-controls {\\n    justify-content: center;\\n    flex-wrap: wrap;\\n  }\\n\\n  .export-btn {\\n    margin-left: 0;\\n    width: 100%;\\n  }\\n\\n  /* Corpus responsive */\\n  .corpus-stats {\\n    flex-direction: column;\\n    gap: 12px;\\n  }\\n\\n  .stat-item {\\n    width: 100%;\\n    flex-direction: row;\\n    justify-content: space-between;\\n    padding: 14px 18px;\\n  }\\n\\n  .work-scores {\\n    flex-direction: column;\\n    gap: 6px;\\n  }\\n\\n  .analysis-stats-grid {\\n    grid-template-columns: repeat(2, 1fr);\\n  }\\n}\\n\\n@media (max-width: 600px) {\\n  .lines-panel {\\n    padding: 16px 20px;\\n  }\\n\\n  .corpus-view {\\n    padding: 16px 20px;\\n  }\\n\\n  .stage-progress {\\n    flex-direction: column;\\n    align-items: stretch;\\n  }\\n\\n  .stage-item {\\n    flex-direction: row;\\n    min-width: auto;\\n    padding: 14px 18px;\\n    gap: 16px;\\n  }\\n\\n  .stage-number {\\n    margin-bottom: 0;\\n  }\\n\\n  .stage-connector {\\n    display: none;\\n  }\\n\\n  .themes-actions {\\n    flex-direction: column;\\n    gap: 12px;\\n  }\\n\\n  .advance-btn {\\n    width: 100%;\\n    text-align: center;\\n  }\\n}\\n\\n/* ============= WORK SELECTION PRESETS ============= */\\n\\n.works-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 16px;\\n}\\n\\n.works-header h4 {\\n  margin: 0;\\n  color: var(--lines-primary);\\n  font-size: 16px;\\n  font-weight: 600;\\n}\\n\\n.preset-controls {\\n  display: flex;\\n  gap: 12px;\\n  align-items: center;\\n}\\n\\n.preset-dropdown {\\n  padding: 10px 14px;\\n  font-size: 14px;\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-border);\\n  color: var(--lines-text);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  min-width: 180px;\\n  transition: all 0.2s;\\n}\\n\\n.preset-dropdown:hover {\\n  border-color: var(--lines-primary);\\n}\\n\\n.preset-dropdown:focus {\\n  outline: none;\\n  border-color: var(--lines-primary);\\n  box-shadow: 0 0 0 3px rgba(32, 178, 170, 0.2);\\n}\\n\\n.save-preset-btn {\\n  padding: 10px 18px;\\n  font-size: 14px;\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  transition: all 0.3s;\\n  box-shadow: 0 2px 8px rgba(32, 178, 170, 0.25);\\n}\\n\\n.save-preset-btn:hover {\\n  background: linear-gradient(135deg, var(--lines-primary-light) 0%, var(--lines-primary) 100%);\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.35);\\n}\\n\\n.selection-indicator {\\n  padding: 12px 16px;\\n  background: linear-gradient(135deg, rgba(32, 178, 170, 0.15) 0%, rgba(32, 178, 170, 0.08) 100%);\\n  border: 2px solid rgba(32, 178, 170, 0.3);\\n  border-radius: 10px;\\n  color: var(--lines-primary);\\n  font-size: 14px;\\n  font-weight: 500;\\n  margin-bottom: 16px;\\n}\\n\\n/* Save Preset Modal */\\n.save-preset-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.85);\\n  backdrop-filter: blur(4px);\\n  z-index: 2000;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n}\\n\\n.save-preset-modal {\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-primary);\\n  border-radius: 16px;\\n  padding: 32px;\\n  max-width: 460px;\\n  width: 90%;\\n  box-shadow:\\n    0 0 60px rgba(32, 178, 170, 0.3),\\n    0 25px 50px rgba(0, 0, 0, 0.5);\\n}\\n\\n.save-preset-modal h4 {\\n  margin: 0 0 10px 0;\\n  color: var(--lines-primary);\\n  font-size: 20px;\\n  font-weight: 600;\\n}\\n\\n.save-preset-modal > p {\\n  margin: 0 0 20px 0;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  line-height: 1.5;\\n}\\n\\n.preset-error {\\n  padding: 14px 16px;\\n  background: linear-gradient(135deg, rgba(220, 53, 69, 0.2) 0%, rgba(220, 53, 69, 0.1) 100%);\\n  border: 2px solid rgba(220, 53, 69, 0.4);\\n  border-radius: 10px;\\n  color: #ff6b6b;\\n  font-size: 14px;\\n  margin-bottom: 20px;\\n}\\n\\n.preset-form {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 20px;\\n  margin-bottom: 28px;\\n}\\n\\n.preset-form .form-group {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n}\\n\\n.preset-form label {\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  font-weight: 500;\\n}\\n\\n.preset-form input,\\n.preset-form textarea {\\n  padding: 14px 16px;\\n  background: var(--lines-bg-dark);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 10px;\\n  color: var(--lines-text);\\n  font-size: 15px;\\n  font-family: inherit;\\n  transition: all 0.2s;\\n}\\n\\n.preset-form input:focus,\\n.preset-form textarea:focus {\\n  outline: none;\\n  border-color: var(--lines-primary);\\n  box-shadow: 0 0 0 3px rgba(32, 178, 170, 0.2);\\n}\\n\\n.preset-form textarea {\\n  resize: vertical;\\n  min-height: 80px;\\n}\\n\\n.save-preset-modal .modal-buttons {\\n  display: flex;\\n  gap: 14px;\\n  justify-content: flex-end;\\n}\\n\\n.save-confirm-btn {\\n  padding: 14px 28px;\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 10px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 15px;\\n  transition: all 0.3s;\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.3);\\n}\\n\\n.save-confirm-btn:hover:not(:disabled) {\\n  background: linear-gradient(135deg, var(--lines-primary-light) 0%, var(--lines-primary) 100%);\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(32, 178, 170, 0.4);\\n}\\n\\n.save-confirm-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n  transform: none;\\n  box-shadow: none;\\n}\\n\\n.save-cancel-btn {\\n  padding: 14px 28px;\\n  background: transparent;\\n  border: 2px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  border-radius: 10px;\\n  cursor: pointer;\\n  font-size: 15px;\\n  font-weight: 500;\\n  transition: all 0.3s;\\n}\\n\\n.save-cancel-btn:hover:not(:disabled) {\\n  border-color: #ff6b6b;\\n  color: #ff6b6b;\\n}\\n\\n.save-cancel-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n/* ===== EXISTING ANALYSES SECTION ===== */\\n\\n.existing-analyses-section {\\n  margin-bottom: 28px;\\n}\\n\\n.existing-analyses-section h4 {\\n  color: var(--lines-primary);\\n  margin: 0 0 10px 0;\\n  font-size: 18px;\\n  font-weight: 600;\\n}\\n\\n.existing-analyses-section .hint {\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  margin: 0 0 20px 0;\\n  line-height: 1.5;\\n}\\n\\n.existing-analyses-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n\\n.existing-analysis-card {\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 12px;\\n  padding: 20px;\\n  transition: all 0.3s;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\\n}\\n\\n.existing-analysis-card:hover {\\n  border-color: var(--lines-primary);\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 16px rgba(32, 178, 170, 0.15);\\n}\\n\\n.existing-analysis-card.status-running {\\n  border-left: 4px solid #f39c12;\\n}\\n\\n.existing-analysis-card.status-completed {\\n  border-left: 4px solid #27ae60;\\n}\\n\\n.existing-analysis-card.status-failed {\\n  border-left: 4px solid #e74c3c;\\n}\\n\\n.existing-analysis-card.status-pending {\\n  border-left: 4px solid var(--lines-text-muted);\\n}\\n\\n.analysis-card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 12px;\\n}\\n\\n.analysis-card-header .thinker-name {\\n  font-weight: 600;\\n  color: var(--lines-text);\\n  font-size: 17px;\\n}\\n\\n.status-badge {\\n  font-size: 12px;\\n  padding: 5px 12px;\\n  border-radius: 16px;\\n  text-transform: capitalize;\\n  font-weight: 600;\\n}\\n\\n.status-badge.running {\\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.25) 0%, rgba(243, 156, 18, 0.15) 100%);\\n  color: #f39c12;\\n  border: 1px solid rgba(243, 156, 18, 0.3);\\n}\\n\\n.status-badge.completed {\\n  background: linear-gradient(135deg, rgba(39, 174, 96, 0.25) 0%, rgba(39, 174, 96, 0.15) 100%);\\n  color: #27ae60;\\n  border: 1px solid rgba(39, 174, 96, 0.3);\\n}\\n\\n.status-badge.failed {\\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.25) 0%, rgba(231, 76, 60, 0.15) 100%);\\n  color: #e74c3c;\\n  border: 1px solid rgba(231, 76, 60, 0.3);\\n}\\n\\n.status-badge.pending {\\n  background: linear-gradient(135deg, rgba(136, 136, 136, 0.25) 0%, rgba(136, 136, 136, 0.15) 100%);\\n  color: var(--lines-text-muted);\\n  border: 1px solid rgba(136, 136, 136, 0.3);\\n}\\n\\n.analysis-card-details {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  font-size: 14px;\\n  color: var(--lines-text-muted);\\n  margin-bottom: 14px;\\n}\\n\\n.analysis-card-details .separator {\\n  color: var(--lines-border);\\n}\\n\\n.analysis-error-preview {\\n  font-size: 13px;\\n  color: #e74c3c;\\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.15) 0%, rgba(231, 76, 60, 0.08) 100%);\\n  padding: 12px 14px;\\n  border-radius: 8px;\\n  margin-bottom: 14px;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n  border-left: 3px solid #e74c3c;\\n}\\n\\n.resume-btn {\\n  padding: 12px 24px;\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-dark) 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 14px;\\n  transition: all 0.3s;\\n  box-shadow: 0 2px 8px rgba(32, 178, 170, 0.25);\\n}\\n\\n.resume-btn:hover {\\n  background: linear-gradient(135deg, var(--lines-primary-light) 0%, var(--lines-primary) 100%);\\n  transform: translateY(-2px);\\n  box-shadow: 0 4px 15px rgba(32, 178, 170, 0.35);\\n}\\n\\n.section-divider {\\n  border: none;\\n  border-top: 2px solid var(--lines-border);\\n  margin: 28px 0;\\n}\\n\\n.loading-state {\\n  color: var(--lines-text-muted);\\n  font-size: 15px;\\n  padding: 24px;\\n  text-align: center;\\n}\\n\\n/* ===== GROUPED CORPUS ANALYSIS VIEW ===== */\\n\\n.corpus-groups-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n}\\n\\n.corpus-group {\\n  border-radius: 12px;\\n  overflow: hidden;\\n  background: var(--lines-bg-card);\\n  border: 2px solid var(--lines-border);\\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);\\n  transition: all 0.3s;\\n}\\n\\n.corpus-group:hover {\\n  border-color: rgba(32, 178, 170, 0.3);\\n  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);\\n}\\n\\n/* Best Analysis Card - Prominent display */\\n.best-analysis-card {\\n  background: linear-gradient(135deg, var(--lines-bg-elevated) 0%, var(--lines-bg-card) 100%);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 12px;\\n  padding: 24px;\\n  transition: all 0.3s;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\\n}\\n\\n.best-analysis-card:hover {\\n  border-color: var(--lines-primary);\\n  box-shadow: 0 4px 20px rgba(32, 178, 170, 0.2);\\n  transform: translateY(-2px);\\n}\\n\\n.best-analysis-card.status-running {\\n  border-left: 5px solid #f39c12;\\n  background: linear-gradient(135deg, rgba(243, 156, 18, 0.08) 0%, var(--lines-bg-card) 100%);\\n}\\n\\n.best-analysis-card.status-completed {\\n  border-left: 5px solid #27ae60;\\n  background: linear-gradient(135deg, rgba(39, 174, 96, 0.08) 0%, var(--lines-bg-card) 100%);\\n}\\n\\n.best-analysis-card.status-failed {\\n  border-left: 5px solid #e74c3c;\\n  background: linear-gradient(135deg, rgba(231, 76, 60, 0.08) 0%, var(--lines-bg-card) 100%);\\n}\\n\\n.best-analysis-card.status-pending {\\n  border-left: 5px solid var(--lines-text-muted);\\n}\\n\\n/* Stage Progress Dots */\\n.stage-progress {\\n  display: flex;\\n  gap: 10px;\\n  margin: 16px 0;\\n  padding: 14px 0;\\n}\\n\\n.stage-dot {\\n  width: 38px;\\n  height: 38px;\\n  border-radius: 50%;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  font-size: 13px;\\n  font-weight: 700;\\n  transition: all 0.3s;\\n  border: 2px solid transparent;\\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);\\n}\\n\\n.stage-dot.completed {\\n  background: linear-gradient(135deg, #27ae60, #2ecc71);\\n  color: white;\\n  border-color: rgba(39, 174, 96, 0.5);\\n  box-shadow: 0 2px 8px rgba(39, 174, 96, 0.3);\\n}\\n\\n.stage-dot.current {\\n  background: linear-gradient(135deg, #f39c12, #f1c40f);\\n  color: #1a1a1a;\\n  border-color: rgba(243, 156, 18, 0.5);\\n  box-shadow:\\n    0 0 12px rgba(243, 156, 18, 0.5),\\n    0 2px 8px rgba(0, 0, 0, 0.3);\\n  animation: pulse-current 2s infinite;\\n}\\n\\n.stage-dot.pending {\\n  background: var(--lines-bg-elevated);\\n  color: var(--lines-text-muted);\\n  border-color: var(--lines-border);\\n}\\n\\n.stage-dot.failed {\\n  background: linear-gradient(135deg, #e74c3c, #c0392b);\\n  color: white;\\n  border-color: rgba(231, 76, 60, 0.5);\\n  box-shadow: 0 2px 8px rgba(231, 76, 60, 0.3);\\n}\\n\\n@keyframes pulse-current {\\n  0%, 100% { transform: scale(1); }\\n  50% { transform: scale(1.08); }\\n}\\n\\n.current-stage-label {\\n  color: var(--lines-text);\\n  font-weight: 600;\\n  font-size: 14px;\\n}\\n\\n/* Card Actions */\\n.analysis-card-actions {\\n  display: flex;\\n  gap: 14px;\\n  margin-top: 18px;\\n}\\n\\n.resume-btn.primary {\\n  flex: 1;\\n  padding: 14px 24px;\\n  background: linear-gradient(135deg, var(--lines-primary) 0%, var(--lines-primary-light) 100%);\\n  border: none;\\n  border-radius: 10px;\\n  color: white;\\n  font-weight: 700;\\n  font-size: 15px;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  box-shadow: 0 2px 8px rgba(32, 178, 170, 0.3);\\n}\\n\\n.resume-btn.primary:hover {\\n  background: linear-gradient(135deg, var(--lines-primary-light) 0%, #b5343a 100%);\\n  transform: translateY(-3px);\\n  box-shadow:\\n    0 6px 20px rgba(32, 178, 170, 0.4),\\n    0 0 30px rgba(32, 178, 170, 0.2);\\n}\\n\\n.expand-btn {\\n  padding: 14px 20px;\\n  background: var(--lines-bg-elevated);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 10px;\\n  color: var(--lines-text-muted);\\n  font-size: 14px;\\n  font-weight: 500;\\n  cursor: pointer;\\n  transition: all 0.3s;\\n  white-space: nowrap;\\n}\\n\\n.expand-btn:hover {\\n  border-color: var(--lines-primary);\\n  color: var(--lines-primary);\\n  background: rgba(32, 178, 170, 0.1);\\n}\\n\\n/* Previous Attempts (Collapsed by default) */\\n.previous-attempts {\\n  background: var(--lines-bg-dark);\\n  border: 2px solid var(--lines-border);\\n  border-top: none;\\n  border-radius: 0 0 12px 12px;\\n  padding: 18px;\\n  margin-top: -10px;\\n}\\n\\n.previous-attempts-header {\\n  font-size: 11px;\\n  color: var(--lines-text-muted);\\n  text-transform: uppercase;\\n  letter-spacing: 1px;\\n  font-weight: 600;\\n  margin-bottom: 14px;\\n  padding-bottom: 10px;\\n  border-bottom: 1px solid var(--lines-border);\\n}\\n\\n.previous-analysis-card {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 14px 16px;\\n  background: var(--lines-bg-elevated);\\n  border-radius: 8px;\\n  margin-bottom: 10px;\\n  border-left: 4px solid var(--lines-border);\\n  transition: all 0.2s;\\n}\\n\\n.previous-analysis-card:hover {\\n  background: var(--lines-bg-card);\\n}\\n\\n.previous-analysis-card:last-child {\\n  margin-bottom: 0;\\n}\\n\\n.previous-analysis-card.status-running {\\n  border-left-color: #f39c12;\\n  background: rgba(243, 156, 18, 0.05);\\n}\\n\\n.previous-analysis-card.status-completed {\\n  border-left-color: #27ae60;\\n  background: rgba(39, 174, 96, 0.05);\\n}\\n\\n.previous-analysis-card.status-failed {\\n  border-left-color: #e74c3c;\\n  background: rgba(231, 76, 60, 0.05);\\n}\\n\\n.prev-card-info {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  flex: 1;\\n  font-size: 13px;\\n  color: var(--lines-text-muted);\\n}\\n\\n.prev-card-info .date {\\n  color: var(--lines-text-muted);\\n  opacity: 0.7;\\n}\\n\\n.prev-error-preview {\\n  font-size: 11px;\\n  color: #e74c3c;\\n  max-width: 200px;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n  white-space: nowrap;\\n  padding: 4px 8px;\\n  background: rgba(231, 76, 60, 0.1);\\n  border-radius: 4px;\\n}\\n\\n.status-badge.small {\\n  font-size: 10px;\\n  padding: 4px 8px;\\n  border-radius: 4px;\\n}\\n\\n.resume-btn.small {\\n  padding: 8px 14px;\\n  font-size: 12px;\\n  font-weight: 500;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  border-radius: 6px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.resume-btn.small:hover {\\n  border-color: var(--lines-primary);\\n  color: var(--lines-primary);\\n  background: rgba(32, 178, 170, 0.1);\\n}\\n\\n/* ============= MULTI-ROUND / ROUND 2 STYLES ============= */\\n\\n/* Round 2 button in analysis cards */\\n.round2-btn {\\n  padding: 10px 16px;\\n  font-size: 13px;\\n  font-weight: 600;\\n  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.round2-btn:hover {\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(155, 89, 182, 0.4);\\n}\\n\\n/* Re-synthesize button in analysis cards */\\n.resynth-btn {\\n  padding: 10px 16px;\\n  font-size: 13px;\\n  font-weight: 600;\\n  background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.resynth-btn:hover {\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(230, 126, 34, 0.4);\\n}\\n\\n/* Auto-accept checkbox in Round 1 form */\\n.auto-accept-group {\\n  margin-top: 20px;\\n  padding-top: 20px;\\n  border-top: 1px solid var(--lines-border);\\n}\\n\\n.checkbox-label {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  cursor: pointer;\\n}\\n\\n.checkbox-label input[type=\\\"checkbox\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  margin-top: 2px;\\n  accent-color: var(--lines-primary);\\n}\\n\\n.checkbox-text {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.checkbox-text strong {\\n  color: var(--lines-text);\\n}\\n\\n.checkbox-hint {\\n  font-size: 13px;\\n  color: var(--lines-text-muted);\\n}\\n\\n/* Round 2 Modal */\\n.round2-modal-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.8);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  z-index: 3000;\\n  padding: 20px;\\n}\\n\\n.round2-modal {\\n  background: var(--lines-bg-card);\\n  border-radius: 16px;\\n  width: 100%;\\n  max-width: 700px;\\n  max-height: 90vh;\\n  display: flex;\\n  flex-direction: column;\\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.round2-modal-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 24px 28px;\\n  border-bottom: 1px solid var(--lines-border);\\n}\\n\\n.round2-modal-header h3 {\\n  margin: 0;\\n  font-size: 20px;\\n  color: var(--lines-text);\\n}\\n\\n.round2-modal-header .close-btn {\\n  width: 36px;\\n  height: 36px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 50%;\\n  color: var(--lines-text-muted);\\n  font-size: 20px;\\n  cursor: pointer;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  transition: all 0.2s;\\n}\\n\\n.round2-modal-header .close-btn:hover {\\n  background: var(--lines-border);\\n  color: var(--lines-text);\\n}\\n\\n.round2-modal-body {\\n  flex: 1;\\n  overflow-y: auto;\\n  padding: 24px 28px;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n}\\n\\n.round2-info {\\n  background: var(--lines-bg-elevated);\\n  padding: 16px 20px;\\n  border-radius: 10px;\\n  border-left: 4px solid #9b59b6;\\n}\\n\\n.round2-info p {\\n  margin: 0;\\n  color: var(--lines-text);\\n}\\n\\n.round2-hint {\\n  margin-top: 8px !important;\\n  font-size: 14px;\\n  color: var(--lines-text-muted) !important;\\n}\\n\\n.round2-error {\\n  padding: 14px 18px;\\n  background: rgba(231, 76, 60, 0.15);\\n  border: 1px solid rgba(231, 76, 60, 0.3);\\n  border-radius: 8px;\\n  color: #e74c3c;\\n  font-size: 14px;\\n}\\n\\n/* Focus Mode Section */\\n.focus-mode-section h4 {\\n  margin: 0 0 16px 0;\\n  font-size: 16px;\\n  color: var(--lines-text);\\n}\\n\\n.focus-mode-options {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.focus-mode-option {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 14px;\\n  padding: 16px 18px;\\n  background: var(--lines-bg-elevated);\\n  border: 2px solid var(--lines-border);\\n  border-radius: 10px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.focus-mode-option:hover {\\n  border-color: rgba(155, 89, 182, 0.4);\\n}\\n\\n.focus-mode-option.selected {\\n  border-color: #9b59b6;\\n  background: rgba(155, 89, 182, 0.1);\\n}\\n\\n.focus-mode-option input[type=\\\"radio\\\"] {\\n  width: 18px;\\n  height: 18px;\\n  margin-top: 3px;\\n  accent-color: #9b59b6;\\n}\\n\\n.focus-mode-content {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.focus-mode-title {\\n  font-weight: 600;\\n  color: var(--lines-text);\\n}\\n\\n.focus-mode-desc {\\n  font-size: 13px;\\n  color: var(--lines-text-muted);\\n}\\n\\n.combine-inputs-checkbox {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  margin-top: 12px;\\n  padding: 12px 16px;\\n  background: rgba(155, 89, 182, 0.1);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-size: 14px;\\n  color: var(--lines-text);\\n}\\n\\n.combine-inputs-checkbox input[type=\\\"checkbox\\\"] {\\n  width: 16px;\\n  height: 16px;\\n  accent-color: #9b59b6;\\n}\\n\\n/* Work Selection for Round 2 */\\n.round2-work-selection h4 {\\n  margin: 0 0 8px 0;\\n  font-size: 16px;\\n  color: var(--lines-text);\\n}\\n\\n.work-selection-hint {\\n  margin: 0 0 16px 0;\\n  font-size: 13px;\\n  color: var(--lines-text-muted);\\n}\\n\\n.round2-works-list {\\n  max-height: 200px;\\n  overflow-y: auto;\\n  display: flex;\\n  flex-direction: column;\\n  gap: 8px;\\n  padding: 4px;\\n  border: 1px solid var(--lines-border);\\n  border-radius: 10px;\\n  background: var(--lines-bg-dark);\\n}\\n\\n.round2-work-item {\\n  display: flex;\\n  align-items: center;\\n  gap: 12px;\\n  padding: 12px 14px;\\n  background: var(--lines-bg-card);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.round2-work-item:hover {\\n  border-color: rgba(155, 89, 182, 0.4);\\n}\\n\\n.round2-work-item.selected {\\n  border-color: #9b59b6;\\n  background: rgba(155, 89, 182, 0.1);\\n}\\n\\n.round2-work-item input[type=\\\"checkbox\\\"] {\\n  width: 16px;\\n  height: 16px;\\n  accent-color: #9b59b6;\\n}\\n\\n.round2-work-item .work-title {\\n  flex: 1;\\n  font-size: 14px;\\n  color: var(--lines-text);\\n  white-space: nowrap;\\n  overflow: hidden;\\n  text-overflow: ellipsis;\\n}\\n\\n.round2-work-item .work-tokens {\\n  font-size: 12px;\\n  color: var(--lines-text-muted);\\n  background: var(--lines-bg-elevated);\\n  padding: 4px 8px;\\n  border-radius: 4px;\\n}\\n\\n/* Round 2 Additional Folder Section */\\n.round2-folder-section {\\n  background: linear-gradient(135deg, rgba(52, 152, 219, 0.1) 0%, rgba(155, 89, 182, 0.05) 100%);\\n  border: 1px solid rgba(52, 152, 219, 0.3);\\n  border-radius: 12px;\\n  padding: 16px 20px;\\n}\\n\\n.round2-folder-section h4 {\\n  margin: 0 0 8px 0;\\n  color: var(--lines-text);\\n  font-size: 15px;\\n}\\n\\n.round2-folder-section .folder-hint {\\n  margin: 0 0 12px 0;\\n  font-size: 13px;\\n  color: var(--lines-text-muted);\\n}\\n\\n.folder-input-row {\\n  display: flex;\\n  gap: 10px;\\n  align-items: center;\\n}\\n\\n.folder-path-input {\\n  flex: 1;\\n  padding: 10px 14px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 8px;\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  font-family: 'SF Mono', 'Consolas', monospace;\\n}\\n\\n.folder-path-input:focus {\\n  outline: none;\\n  border-color: #b5343a;\\n}\\n\\n.folder-path-input:disabled {\\n  opacity: 0.6;\\n}\\n\\n.discover-btn {\\n  padding: 10px 16px;\\n  background: linear-gradient(135deg, #b5343a 0%, #b5343a 100%);\\n  color: white;\\n  border: none;\\n  border-radius: 8px;\\n  font-size: 14px;\\n  font-weight: 600;\\n  cursor: pointer;\\n  white-space: nowrap;\\n  transition: all 0.2s ease;\\n}\\n\\n.discover-btn:hover:not(:disabled) {\\n  background: linear-gradient(135deg, #b5343a 0%, #b5343a 100%);\\n  transform: translateY(-1px);\\n}\\n\\n.discover-btn:disabled {\\n  background: #5a6b75;\\n  cursor: not-allowed;\\n  opacity: 0.7;\\n}\\n\\n.folder-result {\\n  margin: 12px 0 0 0;\\n  padding: 8px 12px;\\n  background: rgba(46, 204, 113, 0.1);\\n  border: 1px solid rgba(46, 204, 113, 0.3);\\n  border-radius: 6px;\\n  color: #2ecc71;\\n  font-size: 13px;\\n}\\n\\n/* No works available message */\\n.round2-no-works-available {\\n  padding: 20px;\\n  background: rgba(243, 156, 18, 0.1);\\n  border: 1px solid rgba(243, 156, 18, 0.3);\\n  border-radius: 8px;\\n  text-align: center;\\n}\\n\\n.round2-no-works-available p {\\n  margin: 0 0 8px 0;\\n  color: #f39c12;\\n  font-size: 14px;\\n}\\n\\n.round2-no-works-available p:last-child {\\n  margin-bottom: 0;\\n  color: #aaa;\\n  font-size: 13px;\\n}\\n\\n/* Already used works section */\\n.round2-already-used {\\n  margin-top: 16px;\\n  padding-top: 16px;\\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\\n}\\n\\n.round2-already-used h5 {\\n  margin: 0 0 10px 0;\\n  color: #757575;\\n  font-size: 13px;\\n  font-weight: 500;\\n}\\n\\n.round2-works-list.disabled {\\n  opacity: 0.6;\\n}\\n\\n.round2-work-item.already-used {\\n  background: rgba(100, 100, 100, 0.2) !important;\\n  cursor: not-allowed;\\n}\\n\\n.round2-work-item.already-used input {\\n  cursor: not-allowed;\\n}\\n\\n.work-badge {\\n  padding: 2px 8px;\\n  background: rgba(52, 152, 219, 0.3);\\n  border-radius: 4px;\\n  color: #b5343a;\\n  font-size: 11px;\\n  font-weight: 600;\\n  margin-left: auto;\\n}\\n\\n/* Round 2 Options */\\n.round2-options {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 16px;\\n}\\n\\n.target-lines-option label {\\n  display: block;\\n  margin-bottom: 8px;\\n  font-size: 14px;\\n  color: var(--lines-text);\\n}\\n\\n.target-lines-option input[type=\\\"range\\\"] {\\n  width: 100%;\\n  accent-color: #9b59b6;\\n}\\n\\n.auto-accept-checkbox {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n  cursor: pointer;\\n  font-size: 14px;\\n  color: var(--lines-text);\\n}\\n\\n.auto-accept-checkbox input[type=\\\"checkbox\\\"] {\\n  width: 16px;\\n  height: 16px;\\n  accent-color: #9b59b6;\\n}\\n\\n.focus-guidance-option label {\\n  display: block;\\n  margin-bottom: 8px;\\n  font-size: 14px;\\n  color: var(--lines-text);\\n}\\n\\n.focus-guidance-option textarea {\\n  width: 100%;\\n  padding: 12px 14px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  border-radius: 8px;\\n  color: var(--lines-text);\\n  font-size: 14px;\\n  resize: vertical;\\n}\\n\\n.focus-guidance-option textarea:focus {\\n  outline: none;\\n  border-color: #9b59b6;\\n}\\n\\n/* Round 2 Modal Footer */\\n.round2-modal-footer {\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 12px;\\n  padding: 20px 28px;\\n  border-top: 1px solid var(--lines-border);\\n}\\n\\n.round2-start-btn {\\n  padding: 12px 24px;\\n  font-size: 15px;\\n  font-weight: 600;\\n  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.round2-start-btn:hover:not(:disabled) {\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(155, 89, 182, 0.4);\\n}\\n\\n.round2-start-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.round2-cancel-btn {\\n  padding: 12px 20px;\\n  font-size: 14px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.round2-cancel-btn:hover:not(:disabled) {\\n  border-color: var(--lines-text-muted);\\n  color: var(--lines-text);\\n}\\n\\n.round2-cancel-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n/* ============= RE-SYNTHESIS MODAL ============= */\\n\\n.resynth-modal-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.7);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  z-index: 2000;\\n  backdrop-filter: blur(4px);\\n}\\n\\n.resynth-modal {\\n  background: var(--lines-bg);\\n  border-radius: 16px;\\n  width: 90%;\\n  max-width: 520px;\\n  max-height: 90vh;\\n  overflow: hidden;\\n  display: flex;\\n  flex-direction: column;\\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.resynth-modal-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 20px 28px;\\n  border-bottom: 1px solid var(--lines-border);\\n}\\n\\n.resynth-modal-header h3 {\\n  margin: 0;\\n  font-size: 1.3rem;\\n  color: var(--lines-text);\\n}\\n\\n.resynth-modal-header .close-btn {\\n  background: none;\\n  border: none;\\n  font-size: 24px;\\n  color: var(--lines-text-muted);\\n  cursor: pointer;\\n  padding: 4px 8px;\\n  border-radius: 4px;\\n  transition: all 0.2s;\\n}\\n\\n.resynth-modal-header .close-btn:hover {\\n  background: var(--lines-bg-elevated);\\n  color: var(--lines-text);\\n}\\n\\n.resynth-modal-body {\\n  padding: 24px 28px;\\n  overflow-y: auto;\\n  flex: 1;\\n}\\n\\n.resynth-info {\\n  margin-bottom: 24px;\\n}\\n\\n.resynth-info p {\\n  margin: 0 0 8px 0;\\n  color: var(--lines-text);\\n}\\n\\n.resynth-hint {\\n  color: var(--lines-text-muted) !important;\\n  font-size: 0.9rem;\\n  line-height: 1.5;\\n}\\n\\n.resynth-error {\\n  background: rgba(231, 76, 60, 0.15);\\n  border: 1px solid rgba(231, 76, 60, 0.4);\\n  color: #e74c3c;\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  margin-bottom: 20px;\\n  font-size: 0.9rem;\\n}\\n\\n.resynth-options {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 24px;\\n}\\n\\n.resynth-options .target-lines-option {\\n  background: var(--lines-bg-elevated);\\n  padding: 20px;\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.resynth-options .target-lines-option label {\\n  display: block;\\n  margin-bottom: 12px;\\n  color: var(--lines-text);\\n  font-weight: 500;\\n}\\n\\n.resynth-options .target-lines-option input[type=\\\"range\\\"] {\\n  width: 100%;\\n  margin-bottom: 8px;\\n  accent-color: #e67e22;\\n}\\n\\n.resynth-options .range-labels {\\n  display: flex;\\n  justify-content: space-between;\\n  color: var(--lines-text-muted);\\n  font-size: 0.85rem;\\n}\\n\\n.resynth-options .focus-guidance-option {\\n  background: var(--lines-bg-elevated);\\n  padding: 20px;\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.resynth-options .focus-guidance-option label {\\n  display: block;\\n  margin-bottom: 12px;\\n  color: var(--lines-text);\\n  font-weight: 500;\\n}\\n\\n.resynth-options .focus-guidance-option textarea {\\n  width: 100%;\\n  padding: 12px;\\n  border: 1px solid var(--lines-border);\\n  border-radius: 8px;\\n  background: var(--lines-bg);\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  resize: vertical;\\n  min-height: 100px;\\n  font-family: inherit;\\n}\\n\\n.resynth-options .focus-guidance-option textarea::placeholder {\\n  color: var(--lines-text-muted);\\n}\\n\\n.resynth-options .focus-guidance-option textarea:focus {\\n  outline: none;\\n  border-color: #e67e22;\\n  box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.15);\\n}\\n\\n.resynth-options .include-summary-option {\\n  background: var(--lines-bg-elevated);\\n  padding: 16px 20px;\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.resynth-options .include-summary-option:has(input:checked) {\\n  border-color: #9b59b6;\\n  background: rgba(155, 89, 182, 0.08);\\n}\\n\\n.summary-checkbox-label {\\n  display: flex;\\n  align-items: flex-start;\\n  gap: 12px;\\n  cursor: pointer;\\n}\\n\\n.summary-checkbox-label input[type=\\\"checkbox\\\"] {\\n  width: 20px;\\n  height: 20px;\\n  accent-color: #9b59b6;\\n  margin-top: 2px;\\n  flex-shrink: 0;\\n}\\n\\n.summary-checkbox-text {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 4px;\\n}\\n\\n.summary-checkbox-text strong {\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n}\\n\\n.summary-checkbox-hint {\\n  color: var(--lines-text-muted);\\n  font-size: 0.85rem;\\n}\\n\\n/* Summary Selection Dropdown for Re-synthesis */\\n.summary-selection-option {\\n  background: var(--lines-bg-elevated);\\n  padding: 16px 20px;\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.summary-select-label {\\n  display: block;\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  font-weight: 600;\\n  margin-bottom: 8px;\\n}\\n\\n.summary-select {\\n  width: 100%;\\n  padding: 10px 12px;\\n  border: 1px solid var(--lines-border);\\n  border-radius: 8px;\\n  background: var(--lines-surface);\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  cursor: pointer;\\n}\\n\\n.summary-select:focus {\\n  outline: none;\\n  border-color: var(--lines-accent);\\n  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);\\n}\\n\\n.summary-select option {\\n  padding: 8px;\\n}\\n\\n.summary-select-hint {\\n  display: block;\\n  margin-top: 6px;\\n  color: var(--lines-text-muted);\\n  font-size: 0.85rem;\\n}\\n\\n/* Outline Summary Selection - provides Benanav context */\\n.outline-summary-option {\\n  background: var(--lines-bg-elevated);\\n  padding: 16px 20px;\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n  margin-top: 16px;\\n}\\n\\n.outline-summary-label {\\n  display: block;\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  font-weight: 600;\\n  margin-bottom: 8px;\\n}\\n\\n.outline-summary-select {\\n  width: 100%;\\n  padding: 10px 12px;\\n  border: 1px solid var(--lines-border);\\n  border-radius: 8px;\\n  background: var(--lines-surface);\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  cursor: pointer;\\n}\\n\\n.outline-summary-select:focus {\\n  outline: none;\\n  border-color: var(--lines-accent);\\n  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);\\n}\\n\\n.outline-summary-select:disabled {\\n  opacity: 0.6;\\n  cursor: wait;\\n}\\n\\n.outline-summary-select option {\\n  padding: 8px;\\n  background: var(--lines-bg-card);\\n  color: var(--lines-text);\\n}\\n\\n.outline-summary-hint {\\n  display: block;\\n  margin-top: 6px;\\n  color: var(--lines-text-muted);\\n  font-size: 0.85rem;\\n}\\n\\n/* Field hints for form fields */\\n.field-hint {\\n  display: block;\\n  margin-top: 6px;\\n  color: var(--lines-text-muted);\\n  font-size: 0.85rem;\\n}\\n\\n.resynth-modal-footer {\\n  display: flex;\\n  gap: 12px;\\n  justify-content: flex-end;\\n  padding: 20px 28px;\\n  border-top: 1px solid var(--lines-border);\\n}\\n\\n.resynth-start-btn {\\n  padding: 12px 24px;\\n  font-size: 15px;\\n  font-weight: 600;\\n  background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);\\n  border: none;\\n  color: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.resynth-start-btn:hover:not(:disabled) {\\n  transform: translateY(-1px);\\n  box-shadow: 0 4px 12px rgba(230, 126, 34, 0.4);\\n}\\n\\n.resynth-start-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n\\n.resynth-cancel-btn {\\n  padding: 12px 20px;\\n  font-size: 14px;\\n  background: var(--lines-bg-elevated);\\n  border: 1px solid var(--lines-border);\\n  color: var(--lines-text-muted);\\n  border-radius: 8px;\\n  cursor: pointer;\\n  transition: all 0.2s;\\n}\\n\\n.resynth-cancel-btn:hover:not(:disabled) {\\n  border-color: var(--lines-text-muted);\\n  color: var(--lines-text);\\n}\\n\\n.resynth-cancel-btn:disabled {\\n  opacity: 0.5;\\n  cursor: not-allowed;\\n}\\n\\n/* ============= SUMMARIZE BUTTON ============= */\\n\\n.summarize-btn {\\n  background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);\\n  border: none;\\n  color: white;\\n  padding: 10px 20px;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-weight: 600;\\n  font-size: 13px;\\n  transition: all 0.2s;\\n}\\n\\n.summarize-btn:hover:not(:disabled) {\\n  transform: translateY(-2px);\\n  box-shadow: 0 6px 20px rgba(155, 89, 182, 0.4);\\n}\\n\\n.summarize-btn:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n  transform: none;\\n}\\n\\n/* ============= SUMMARY MODAL ============= */\\n\\n.summary-modal-overlay {\\n  position: fixed;\\n  top: 0;\\n  left: 0;\\n  right: 0;\\n  bottom: 0;\\n  background: rgba(0, 0, 0, 0.7);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  z-index: 2000;\\n  backdrop-filter: blur(4px);\\n}\\n\\n.summary-modal {\\n  background: var(--lines-bg);\\n  border-radius: 16px;\\n  width: 90%;\\n  max-width: 700px;\\n  max-height: 90vh;\\n  overflow: hidden;\\n  display: flex;\\n  flex-direction: column;\\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\\n  border: 1px solid var(--lines-border);\\n}\\n\\n.summary-modal-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  padding: 20px 28px;\\n  border-bottom: 1px solid var(--lines-border);\\n}\\n\\n.summary-modal-header h3 {\\n  margin: 0;\\n  font-size: 1.3rem;\\n  color: var(--lines-text);\\n}\\n\\n.summary-modal-header .close-btn {\\n  background: none;\\n  border: none;\\n  font-size: 24px;\\n  color: var(--lines-text-muted);\\n  cursor: pointer;\\n  padding: 4px 8px;\\n  border-radius: 4px;\\n  transition: all 0.2s;\\n}\\n\\n.summary-modal-header .close-btn:hover {\\n  background: var(--lines-bg-elevated);\\n  color: var(--lines-text);\\n}\\n\\n.summary-modal-body {\\n  padding: 24px 28px;\\n  overflow-y: auto;\\n  flex: 1;\\n}\\n\\n.summary-info {\\n  margin-bottom: 20px;\\n}\\n\\n.summary-info p {\\n  margin: 0 0 8px 0;\\n  color: var(--lines-text);\\n}\\n\\n.summary-hint {\\n  color: var(--lines-text-muted) !important;\\n  font-size: 0.9rem;\\n  line-height: 1.5;\\n}\\n\\n.summary-selection-count {\\n  background: var(--lines-bg-elevated);\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  border: 1px solid var(--lines-border);\\n  margin-bottom: 20px;\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n}\\n\\n.summary-selection-count strong {\\n  color: #9b59b6;\\n}\\n\\n.summary-error {\\n  background: rgba(231, 76, 60, 0.15);\\n  border: 1px solid rgba(231, 76, 60, 0.4);\\n  color: #e74c3c;\\n  padding: 12px 16px;\\n  border-radius: 8px;\\n  margin-bottom: 20px;\\n  font-size: 0.9rem;\\n}\\n\\n.summary-content {\\n  background: var(--lines-bg-elevated);\\n  border-radius: 12px;\\n  border: 1px solid var(--lines-border);\\n  padding: 24px;\\n  margin-bottom: 20px;\\n}\\n\\n.summary-content h4 {\\n  margin: 0 0 16px 0;\\n  color: #9b59b6;\\n  font-size: 1rem;\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n}\\n\\n.summary-text {\\n  color: var(--lines-text);\\n  font-size: 0.95rem;\\n  line-height: 1.7;\\n  white-space: pre-wrap;\\n}\\n\\n.summary-generating {\\n  text-align: center;\\n  padding: 40px 20px;\\n 