untime.js\");\n\nconst DOSSIER_TRANSIENT_COMPOSE_REQUEST = {\n  workflow_key: 'anxiety_of_influence_thematic_single_thinker',\n  consumer_key: 'the-critic',\n  user_intent: 'Compose a compact AOI briefing page that first establishes the high-level thematic synthesis and then closes with the structured report.',\n  prose_sections: [{\n    engine_key: 'aoi_thematic_synthesis',\n    title: 'Thematic Synthesis',\n    prose: '{\"themes\": [{\"theme_name\": \"Calculation Without Prices\", \"overview\": \"Benanav leans on Neurath\\'s insistence that planning can coordinate production without market prices.\", \"key_claims\": [\"Planning can orient production without market-clearing signals.\", \"Material coordination can be treated as an information design problem.\"], \"philosophical_commitments\": [\"Economic rationality is not exhausted by price signals.\"], \"argumentative_moves\": [\"Recasts socialist calculation as a coordination problem rather than a scarcity-pricing puzzle.\"], \"source_documents\": [\"Through War Economy to Economy in Kind\", \"Economic Plan and Calculation in Kind\"]}, {\"theme_name\": \"Planning as Public Knowledge\", \"overview\": \"Benanav partially echoes Neurath\\'s view that planning depends on public knowledge infrastructures and civic intelligibility.\", \"key_claims\": [\"Planning requires transparent social knowledge rather than hidden market revelation.\"], \"philosophical_commitments\": [\"Democratic coordination depends on shared intelligibility.\"], \"argumentative_moves\": [\"Turns epistemic planning into a public-capacity argument.\"], \"source_documents\": [\"International Planning for Freedom\"]}], \"overall_synthesis\": \"The dossier fixture concentrates on one dominant Neurathian planning theme with a secondary civic-intelligibility theme.\"}'\n  }, {\n    engine_key: 'aoi_thematic_report',\n    title: 'AOI Report',\n    prose: '{\"report_sections\": {\"summary\": \"Benanav\\'s AOI pattern is dominated by one planning theme, with a secondary civic-intelligibility strand that stays visible but subordinate.\", \"engagement_pattern\": \"The engagement is strongest when Benanav reframes Neurath\\'s planning arguments as contemporary coordination problems and weaker when Neurath\\'s democratic epistemology would need to be foregrounded.\", \"key_divergences\": [{\"title\": \"Planning becomes infrastructural coordination\", \"subtitle\": \"Calculation Without Prices\", \"description\": \"Benanav preserves the anti-price premise but redescribes it as infrastructural coordination.\", \"badge\": \"high\"}, {\"title\": \"Democratic pedagogy is compressed\", \"subtitle\": \"Planning as Public Knowledge\", \"description\": \"Neurath\\'s public-education emphasis appears only as a secondary implication.\", \"badge\": \"medium\"}], \"sin_distribution\": [{\"sin_type\": \"Appropriation\", \"count\": 2, \"description\": \"Two findings show strong borrowing with updated language.\"}, {\"sin_type\": \"Misreading\", \"count\": 1, \"description\": \"One finding compresses Neurath\\'s accounting doctrine into computational administration.\"}], \"reading_implications\": \"The dossier case reads Benanav as leaning heavily on one Neurathian planning strand while trimming the democratic and bureaucratic thickness that made the original view distinctive.\"}}'\n  }]\n};\nconst COMPARISON_TRANSIENT_COMPOSE_REQUEST = {\n  workflow_key: 'anxiety_of_influence_thematic_single_thinker',\n  consumer_key: 'the-critic',\n  user_intent: 'Compose a structured AOI comparison page that foregrounds the engagement map, then the sin findings, and ends with the report closeout.',\n  prose_sections: [{\n    engine_key: 'aoi_engagement_mapping',\n    title: 'Engagement Mapping',\n    prose: '{\"engagement_pattern\": \"Benanav draws on several Neurathian strands without allowing any one of them to monopolize the reading.\", \"engagements\": [{\"theme_id\": \"theme_calculation_without_prices\", \"theme_name\": \"Calculation Without Prices\", \"engagement_level\": \"partial\", \"benanav_position\": \"Uses non-price calculation as one strand of a broader coordination argument.\", \"divergence_description\": \"The theme is present but not dominant.\", \"divergence_type\": \"partial uptake\", \"severity\": \"medium\", \"severity_rationale\": \"The borrowing is real but distributed.\"}, {\"theme_id\": \"theme_administrative_coordination\", \"theme_name\": \"Administrative Coordination\", \"engagement_level\": \"partial\", \"benanav_position\": \"Administrative reasoning appears in logistics language.\", \"divergence_description\": \"Administrative coordination is invoked without Neurath\\'s full institutional imagination.\", \"divergence_type\": \"compression\", \"severity\": \"medium\", \"severity_rationale\": \"The theme is recognizable but thinned.\"}, {\"theme_id\": \"theme_public_accounting\", \"theme_name\": \"Public Accounting\", \"engagement_level\": \"partial\", \"benanav_position\": \"Accounting appears as a background requirement rather than a foreground doctrine.\", \"divergence_description\": \"The accounting strand remains visible but secondary.\", \"divergence_type\": \"backgrounding\", \"severity\": \"low\", \"severity_rationale\": \"This is omission by de-emphasis, not by denial.\"}, {\"theme_id\": \"theme_international_planning\", \"theme_name\": \"International Planning\", \"engagement_level\": \"engaged\", \"benanav_position\": \"Benanav treats planning as a cross-border coordination question.\", \"divergence_description\": \"The international horizon is explicit but adapted to contemporary logistics.\", \"divergence_type\": \"reframing\", \"severity\": \"medium\", \"severity_rationale\": \"The scale is preserved while the vocabulary changes.\"}]}'\n  }, {\n    engine_key: 'aoi_sin_findings',\n    title: 'SIN Findings',\n    prose: '{\"findings\": [{\"theme_id\": \"theme_calculation_without_prices\", \"theme_name\": \"Calculation Without Prices\", \"sin_type\": \"appropriation\", \"severity\": \"medium\", \"title\": \"Non-price coordination remains a live option\", \"summary\": \"Benanav keeps Neurath\\'s anti-price premise in circulation.\", \"target_document_label\": \"Beyond Capitalism 2\", \"target_quote\": \"Prices are not the only way to coordinate complexity.\", \"source_work_title\": \"Economic Plan and Calculation in Kind\", \"source_quote\": \"Economic planning can proceed in kind.\", \"discrepancy_analysis\": \"The idea is reused but detached from Neurath\\'s accounting apparatus.\", \"implication_for_argument\": \"It broadens the conceptual space beyond market coordination.\"}, {\"theme_id\": \"theme_administrative_coordination\", \"theme_name\": \"Administrative Coordination\", \"sin_type\": \"misreading\", \"severity\": \"medium\", \"title\": \"Administration becomes logistics\", \"summary\": \"A thicker administrative vision is translated into logistics language.\", \"target_document_label\": \"Beyond Capitalism 2\", \"target_quote\": \"Coordination depends on logistical capabilities.\", \"source_work_title\": \"Through War Economy to Economy in Kind\", \"source_quote\": \"War economy required detailed administrative coordination.\", \"discrepancy_analysis\": \"The institutional thickness is simplified into a logistics metaphor.\", \"implication_for_argument\": \"That simplification makes the planning case easier to transpose.\"}, {\"theme_id\": \"theme_public_accounting\", \"theme_name\": \"Public Accounting\", \"sin_type\": \"omission\", \"severity\": \"low\", \"title\": \"Accounting remains backgrounded\", \"summary\": \"Public accounting appears as an unelaborated premise.\", \"target_document_label\": \"Beyond Capitalism 2\", \"target_quote\": \"Coordination requires usable social information.\", \"source_work_title\": \"Socialist Utility Calculation and Capitalist Profit Calculation\", \"source_quote\": \"Socialist utility calculation depends on public accounting practices.\", \"discrepancy_analysis\": \"The accounting dimension is present but underdeveloped.\", \"implication_for_argument\": \"The result is more schematic than Neurath\\'s original account.\"}, {\"theme_id\": \"theme_international_planning\", \"theme_name\": \"International Planning\", \"sin_type\": \"appropriation\", \"severity\": \"medium\", \"title\": \"International coordination is carried forward\", \"summary\": \"Benanav keeps Neurath\\'s international planning horizon alive.\", \"target_document_label\": \"Beyond Capitalism 2\", \"target_quote\": \"Coordination must scale beyond national containers.\", \"source_work_title\": \"International Planning for Freedom\", \"source_quote\": \"Planning must be international if freedom is to be real.\", \"discrepancy_analysis\": \"The global horizon is retained but routed through contemporary supply-chain language.\", \"implication_for_argument\": \"It prevents the planning case from collapsing into national developmentalism.\"}]}'\n  }, {\n    engine_key: 'aoi_thematic_report',\n    title: 'AOI Report',\n    prose: '{\"report_sections\": {\"summary\": \"Benanav\\'s AOI relation to Neurath is distributed across several themes rather than centered on a single dominant borrowing.\", \"engagement_pattern\": \"The report evidence is broad enough to sustain a comparative review: planning, administration, accounting, and internationalism all remain active strands.\", \"key_divergences\": [{\"title\": \"Planning without prices is preserved but modernized\", \"subtitle\": \"Calculation Without Prices\", \"description\": \"The anti-price premise survives, but as a contemporary coordination argument.\", \"badge\": \"medium\"}, {\"title\": \"Administrative thickness is simplified\", \"subtitle\": \"Administrative Coordination\", \"description\": \"Logistics displaces a fuller account of administrative form.\", \"badge\": \"medium\"}, {\"title\": \"Accounting remains backgrounded\", \"subtitle\": \"Public Accounting\", \"description\": \"Accounting survives mostly as an unstated infrastructure.\", \"badge\": \"low\"}, {\"title\": \"International planning survives as planetary logistics\", \"subtitle\": \"International Planning\", \"description\": \"Neurath\\'s internationalism is recoded in supply-chain terms.\", \"badge\": \"medium\"}, {\"title\": \"Civic pedagogy is present but secondary\", \"description\": \"The public-education dimension remains visible but never becomes the organizing frame.\"}], \"sin_distribution\": [{\"sin_type\": \"Appropriation\", \"count\": 2, \"description\": \"Two findings preserve major Neurathian premises with updated language.\"}, {\"sin_type\": \"Misreading\", \"count\": 1, \"description\": \"One finding simplifies administrative coordination into logistics.\"}, {\"sin_type\": \"Omission\", \"count\": 1, \"description\": \"One finding backgrounds public accounting.\"}], \"reading_implications\": \"The comparison case is best read as a distributed AOI pattern: Benanav draws from multiple Neurathian strands, but each arrives in a transformed register.\"}}'\n  }]\n};\nfunction cloneTransientComposeRequest(request) {\n  return JSON.parse(JSON.stringify(request));\n}\nfunction getTransientComposeExample(key) {\n  return cloneTransientComposeRequest(key === 'comparison' ? COMPARISON_TRANSIENT_COMPOSE_REQUEST : DOSSIER_TRANSIENT_COMPOSE_REQUEST);\n}\n\nconst $ReactRefreshModuleId$ = __webpack_require__.$Refresh$.moduleId;\nconst $ReactRefreshCurrentExports$ = __react_refresh_utils__.getModuleExports(\n\t$ReactRefreshModuleId$\n);\n\nfunction $ReactRefreshModuleRuntime$(exports) {\n\tif (true) {\n\t\tlet errorOverlay;\n\t\tif (true) {\n\t\t\terrorOverlay = false;\n\t\t}\n\t\tlet testMode;\n\t\tif (typeof __react_refresh_test__ !== 'undefined') {\n\t\t\ttestMode = __react_refresh_test__;\n\t\t}\n\t\treturn __react_refresh_utils__.executeRuntime(\n\t\t\texports,\n\t\t\t$ReactRefreshModuleId$,\n\t\t\tmodule.hot,\n\t\t\terrorOverlay,\n\t\t\ttestMode\n\t\t);\n\t}\n}\n\nif (typeof Promise !== 'undefined' && $ReactRefreshCu