[module.id, `/* ThemeNavigator Styles */\n\n.theme-navigator {\n  background: var(--card-bg, #ffffff);\n  border-radius: 8px;\n  padding: 16px;\n  border: 1px solid var(--border-color, #e0ddd8);\n}\n\n.theme-navigator.loading,\n.theme-navigator.empty {\n  min-height: 200px;\n}\n\n.navigator-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--border-color, #e0ddd8);\n}\n\n.navigator-header h3 {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n}\n\n.total-count {\n  font-size: 12px;\n  color: var(--text-secondary, #757575);\n  background: var(--bg-tertiary, #f5f3f0);\n  padding: 4px 8px;\n  border-radius: 4px;\n}\n\n.loading-text {\n  font-size: 12px;\n  color: var(--text-secondary, #757575);\n  animation: pulse 1.5s ease-in-out infinite;\n}\n\n@keyframes pulse {\n  0%, 100% { opacity: 0.5; }\n  50% { opacity: 1; }\n}\n\n.empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 32px;\n  text-align: center;\n}\n\n.empty-state p {\n  color: var(--text-secondary, #757575);\n  margin-bottom: 16px;\n}\n\n.run-synthesis-btn {\n  background: var(--accent-color, #b5343a);\n  color: white;\n  border: none;\n  padding: 10px 20px;\n  border-radius: 6px;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background 0.2s ease;\n}\n\n.run-synthesis-btn:hover {\n  background: var(--accent-hover, #9a2c31);\n}\n\n.theme-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.theme-group {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.group-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 6px 0 6px 12px;\n  border-left: 3px solid;\n  margin-bottom: 4px;\n}\n\n.group-label {\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: var(--text-secondary, #757575);\n}\n\n.group-count {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n}\n\n.theme-items {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding-left: 4px;\n}\n\n.theme-item {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 12px;\n  background: var(--bg-secondary, #f5f3f0);\n  border: 1px solid var(--border-color, #e0ddd8);\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  text-align: left;\n  width: 100%;\n}\n\n.theme-item:hover {\n  background: var(--bg-tertiary, #e0ddd8);\n  border-color: var(--accent-color, #b5343a);\n}\n\n.theme-item.selected {\n  background: var(--bg-tertiary, #e0ddd8);\n  border-color: var(--accent-color, #b5343a);\n  box-shadow: 0 0 0 1px var(--accent-color, #b5343a);\n}\n\n.theme-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 8px;\n}\n\n.theme-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--text-primary, #1a1a1a);\n  line-height: 1.4;\n  flex: 1 1;\n}\n\n.findings-badge {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-secondary, #757575);\n  background: var(--bg-primary, #ffffff);\n  padding: 2px 8px;\n  border-radius: 10px;\n  flex-shrink: 0;\n}\n\n.theme-item.selected .findings-badge {\n  background: var(--accent-color, #b5343a);\n  color: white;\n}\n\n.theme-description {\n  font-size: 12px;\n  color: var(--text-secondary, #757575);\n  line-height: 1.5;\n}\n\n.theme-engagement {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.engagement-badge {\n  font-size: 10px;\n  font-weight: 600;\n  color: white;\n  padding: 3px 8px;\n  border-radius: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.divergence-note {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n  font-style: italic;\n}\n\n.theme-claims {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding-top: 4px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.claims-label {\n  font-size: 10px;\n  font-weight: 500;\n  color: var(--text-tertiary, #9a9a9a);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n\n.claims-preview {\n  font-size: 11px;\n  color: var(--text-secondary, #757575);\n  line-height: 1.4;\n}\n\n.navigator-legend {\n  margin-top: 16px;\n  padding-top: 12px;\n  border-top: 1px solid var(--border-color, #e0ddd8);\n}\n\n.legend-title {\n  font-size: 11px;\n  color: var(--text-tertiary, #9a9a9a);\n  margin-bottom: 8px;\n}\n\n.legend-items {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: var(--text-secondary, #757575);\n}\n\n.engagement-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influence/ThemeNavigator.css\"],\"names\":[],\"mappings\":\"AAAA,0BAA0B;;AAE1B;EACE,mCAAmC;EACnC,kBAAkB;EAClB,aAAa;EACb,8CAA8C;AAChD;;AAEA;;EAEE,iBAAiB;AACnB;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAmB;EACnB,oBAAoB;EACpB,qDAAqD;AACvD;;AAEA;EACE,SAAS;EACT,eAAe;EACf,gBAAgB;EAChB,mCAAmC;AACrC;;AAEA;EACE,eAAe;EACf,qCAAqC;EACrC,uCAAuC;EACvC,gBAAgB;EAChB,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,qCAAqC;EACrC,0CAA0C;AAC5C;;AAEA;EACE,WAAW,YAAY,EAAE;EACzB,MAAM,UAAU,EAAE;AACpB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,uBAAuB;EACvB,aAAa;EACb,kBAAkB;AACpB;;AAEA;EACE,qCAAqC;EACrC,mBAAmB;AACrB;;AAEA;EACE,wCAAwC;EACxC,YAAY;EACZ,YAAY;EACZ,kBAAkB;EAClB,kBAAkB;EAClB,eAAe;EACf,gBAAgB;EAChB,eAAe;EACf,gCAAgC;AAClC;;AAEA;EACE,wCAAwC;AAC1C;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,uBAAuB;EACvB,sBAAsB;EACtB,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,yBAAyB;EACzB,qBAAqB;EACrB,qCAAqC;AACvC;;AAEA;EACE,eAAe;EACf,oCAAoC;AACtC;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;EACR,iBAAiB;AACnB;;A