: 12px;\n  padding: 60px;\n  color: #8a8578;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n}\n\n.loading-spinner {\n  width: 20px;\n  height: 20px;\n  border: 2px solid #d4cfc7;\n  border-top-color: #b5343a;\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Header */\n.projects-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  margin-bottom: 40px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid #d4cfc7;\n}\n\n.projects-title h1 {\n  font-family: 'Playfair Display', 'Georgia', serif;\n  font-size: 32px;\n  font-weight: 700;\n  color: #1a1a1a;\n  margin: 0 0 6px;\n}\n\n.projects-title p {\n  color: #8a8578;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n  font-size: 15px;\n  margin: 0;\n}\n\n.create-project-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 10px 20px;\n  background: #b5343a;\n  border: none;\n  border-radius: 6px;\n  color: white;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  white-space: nowrap;\n}\n\n.create-project-btn:hover {\n  background: #9a2c31;\n  box-shadow: 0 2px 8px rgba(181, 52, 58, 0.25);\n}\n\n.create-project-btn span {\n  font-size: 18px;\n  font-weight: 400;\n  line-height: 1;\n}\n\n/* Projects List */\n.projects-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.project-card {\n  position: relative;\n  background: #ffffff;\n  border: 1px solid #d4cfc7;\n  border-radius: 8px;\n  padding: 24px;\n  transition: all 0.15s ease;\n}\n\n.project-card:hover {\n  border-color: #b5a899;\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);\n}\n\n.project-card.active {\n  border-color: #b5343a;\n  border-left: 3px solid #b5343a;\n}\n\n.project-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.project-card-header h3 {\n  font-family: 'Playfair Display', 'Georgia', serif;\n  font-size: 20px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0;\n}\n\n.current-badge {\n  padding: 2px 10px;\n  background: transparent;\n  border: 1px solid #b5343a;\n  border-radius: 3px;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 11px;\n  font-weight: 500;\n  color: #b5343a;\n  letter-spacing: 0.02em;\n}\n\n.project-card-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin-bottom: 12px;\n}\n\n.meta-item {\n  display: flex;\n  gap: 8px;\n  font-size: 14px;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n}\n\n.meta-label {\n  color: #8a8578;\n}\n\n.meta-value {\n  color: #3a3a3a;\n}\n\n.project-card-description {\n  color: #6b6560;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n  font-size: 14px;\n  line-height: 1.5;\n  margin: 0 0 12px;\n  font-style: italic;\n}\n\n.project-card-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-top: 12px;\n  border-top: 1px solid #e8e4de;\n  margin-bottom: 14px;\n}\n\n.project-id {\n  font-family: 'IBM Plex Mono', 'Monaco', monospace;\n  font-size: 12px;\n  color: #8a8578;\n}\n\n.project-date {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 12px;\n  color: #8a8578;\n}\n\n.project-card-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.btn-select {\n  flex: 1 1;\n  padding: 8px 16px;\n  background: #faf8f5;\n  border: 1px solid #d4cfc7;\n  border-radius: 6px;\n  color: #3a3a3a;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-select:hover {\n  background: #f0ede8;\n  border-color: #b5a899;\n  color: #1a1a1a;\n}\n\n.btn-manage {\n  padding: 8px 16px;\n  background: #faf8f5;\n  border: 1px solid #d4cfc7;\n  border-radius: 6px;\n  color: #3a3a3a;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-manage:hover {\n  background: #f0ede8;\n  border-color: #b5a899;\n}\n\n.btn-delete {\n  padding: 8px 16px;\n  background: transparent;\n  border: 1px solid #d4cfc7;\n  border-radius: 6px;\n  color: #8a8578;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-delete:hover:not(:disabled) {\n  background: #fdf2f2;\n  border-color: #e5a0a0;\n  color: #b5343a;\n}\n\n.btn-delete:disabled {\n  opacity: 0.35;\n  cursor: not-allowed;\n}\n\n/* Delete Confirmation */\n.delete-confirm {\n  position: absolute;\n  inset: 0;\n  background: rgba(250, 248, 245, 0.97);\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  padding: 24px;\n  z-index: 10;\n}\n\n.delete-confirm p {\n  color: #1a1a1a;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n  text-align: center;\n  margin: 0;\n}\n\n.confirm-actions {\n  display: flex;\n  gap: 12px;\n}\n\n.btn-cancel-sm {\n  padding: 8px 16px;\n  background: transparent;\n  border: 1px solid #d4cfc7;\n  border-radius: 6px;\n  color: #6b6560;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.btn-cancel-sm:hover {\n  border-color: #b5a899;\n  color: #3a3a3a;\n}\n\n.btn-confirm-delete {\n  padding: 8px 16px;\n  background: #b5343a;\n  border: none;\n  border-radius: 6px;\n  color: white;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  cursor: pointer;\n  transition: background 0.15s ease;\n}\n\n.btn-confirm-delete:hover {\n  background: #9a2c31;\n}\n\n.btn-confirm-delete:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n/* Empty State */\n.projects-empty {\n  text-align: center;\n  padding: 60px;\n  color: #8a8578;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n}\n\n/* Modal */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.4);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  padding: 24px;\n}\n\n.modal-content {\n  background: #faf8f5;\n  border: 1px solid #d4cfc7;\n  border-radius: 10px;\n  padding: 32px;\n  width: 100%;\n  max-width: 500px;\n  max-height: 90vh;\n  overflow-y: auto;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);\n}\n\n.modal-content h2 {\n  font-family: 'Playfair Display', 'Georgia', serif;\n  font-size: 22px;\n  font-weight: 600;\n  color: #1a1a1a;\n  margin: 0 0 24px;\n}\n\n.form-group {\n  margin-bottom: 20px;\n}\n\n.form-group label {\n  display: block;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  font-weight: 500;\n  color: #6b6560;\n  margin-bottom: 6px;\n}\n\n.form-group input,\n.form-group textarea {\n  width: 100%;\n  padding: 10px 14px;\n  background: #ffffff;\n  border: 1px solid #d4cfc7;\n  border-radius: 6px;\n  color: #1a1a1a;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n  font-size: 15px;\n  transition: border-color 0.15s ease;\n  box-sizing: border-box;\n}\n\n.form-group input:focus,\n.form-group textarea:focus {\n  outline: none;\n  border-color: #b5343a;\n}\n\n.form-group input::placeholder,\n.form-group textarea::placeholder {\n  color: #b5a899;\n}\n\n.form-group small {\n  display: block;\n  margin-top: 4px;\n  font-size: 12px;\n  color: #8a8578;\n  font-family: 'IBM Plex Sans', sans-serif;\n}\n\n.form-error {\n  padding: 10px 14px;\n  background: #fdf2f2;\n  border: 1px solid #e5a0a0;\n  border-radius: 6px;\n  color: #b5343a;\n  font-size: 14px;\n  margin-bottom: 20px;\n}\n\n.form-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n  margin-top: 24px;\n}\n\n.btn-cancel {\n  padding: 10px 20px;\n  background: transparent;\n  border: 1px solid #d4cfc7;\n  border-radius: 6px;\n  color: #6b6560;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-cancel:hover {\n  border-color: #b5a899;\n  color: #3a3a3a;\n}\n\n.btn-create {\n  padding: 10px 20px;\n  background: #b5343a;\n  border: none;\n  border-radius: 6px;\n  color: white;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-create:hover:not(:disabled) {\n  background: #9a2c31;\n  box-shadow: 0 2px 8px rgba(181, 52, 58, 0.25);\n}\n\n.btn-create:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n/* ========== Document Management ========== */\n\n.project-card.expanded {\n  border-color: #b5a899;\n}\n\n.project-card.expanded.active {\n  border-color: #b5343a;\n}\n\n.project-card-main {\n  /* Container for main card content */\n}\n\n/* Document Management Panel */\n.project-documents {\n  margin-top: 20px;\n  padding-top: 20px;\n  border-top: 1px solid #e8e4de;\n}\n\n.docs-loading {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 20px;\n  color: #8a8578;\n  justify-content: center;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n}\n\n.loading-spinner.small {\n  width: 16px;\n  height: 16px;\n}\n\n/* Document Sections */\n.doc-section {\n  margin-bottom: 16px;\n  padding: 16px;\n  background: #faf8f5;\n  border: 1px solid #e8e4de;\n  border-radius: 6px;\n}\n\n.doc-section:last-of-type {\n  margin-bottom: 0;\n}\n\n.doc-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n\n.doc-section-header h4 {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  font-weight: 600;\n  color: #3a3a3a;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.doc-type-icon {\n  font-size: 15px;\n}\n\n.doc-count {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 20px;\n  height: 20px;\n  padding: 0 6px;\n  background: #e8e4de;\n  border-radius: 10px;\n  font-size: 11px;\n  font-weight: 600;\n  color: #6b6560;\n}\n\n.required-badge {\n  margin-left: 8px;\n  padding: 2px 8px;\n  background: #fdf8ed;\n  border: 1px solid #e8d5a0;\n  border-radius: 3px;\n  font-size: 10px;\n  font-weight: 500;\n  color: #a07830;\n  text-transform: none;\n  letter-spacing: normal;\n}\n\n.btn-add-doc {\n  padding: 5px 12px;\n  background: transparent;\n  border: 1px solid #d4cfc7;\n  border-radius: 4px;\n  color: #6b6560;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-add-doc:hover:not(:disabled) {\n  background: #f0ede8;\n  border-color: #b5a899;\n  color: #3a3a3a;\n}\n\n.btn-add-doc:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Document List */\n.doc-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.doc-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 12px;\n  background: #ffffff;\n  border: 1px solid #e8e4de;\n  border-radius: 4px;\n  position: relative;\n}\n\n.doc-name {\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n  font-size: 13px;\n  color: #3a3a3a;\n  flex: 1 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.btn-remove-doc {\n  width: 24px;\n  height: 24px;\n  padding: 0;\n  background: transparent;\n  border: none;\n  border-radius: 4px;\n  color: #b5a899;\n  font-size: 18px;\n  line-height: 1;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.btn-remove-doc:hover {\n  background: #fdf2f2;\n  color: #b5343a;\n}\n\n.no-docs {\n  margin: 0;\n  padding: 10px;\n  text-align: center;\n  font-family: 'Source Serif Pro', 'Georgia', serif;\n  font-size: 13px;\n  color: #8a8578;\n  font-style: italic;\n}\n\n/* Document Delete Confirmation */\n.doc-delete-confirm {\n  position: absolute;\n  right: 8px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 8px;\n  background: #ffffff;\n  border: 1px solid #d4cfc7;\n  border-radius: 4px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n  z-index: 10;\n}\n\n.doc-delete-confirm span {\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 12px;\n  color: #6b6560;\n}\n\n.doc-delete-confirm button {\n  padding: 3px 10px;\n  border: none;\n  border-radius: 3px;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.doc-delete-confirm button:first-of-type {\n  background: #b5343a;\n  color: white;\n}\n\n.doc-delete-confirm button:last-of-type {\n  background: #e8e4de;\n  color: #3a3a3a;\n}\n\n/* Upload Indicator */\n.upload-indicator {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 14px;\n  background: #fdf8ed;\n  border: 1px solid #e8d5a0;\n  border-radius: 6px;\n  color: #6b6560;\n  font-family: 'IBM Plex Sans', sans-serif;\n  font-size: 13px;\n  margin-top: 12px;\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/pages/ProjectsPage.css\"],\"names\":[],\"mappings\":\"AAAA,0CAA0C;;AAE1C;EACE,gBAAgB;EAChB,cAAc;EACd,kBAAkB;AACpB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,SAAS;EACT,aAAa;EACb,cAAc;EACd,iDAAiD;AACnD;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,yBAAyB;EACzB,yBAAyB;EACzB,kBAAkB;EAClB,kCAAkC;AACpC;;AAEA;EACE,KAAK,yBAAyB,EAAE;AAClC;;AAEA,WAAW;AACX;EACE,aAAa;EACb,8BAA8B;EAC9B,qBAAqB;EACrB,mBAAmB;EACnB,oBAAoB;EACpB,gCAAgC;AAClC;;AAEA;EACE,iDAAiD;EACjD,eAAe;EACf,gBAAgB;EAChB,cAAc;EACd,eAAe;AACjB;;AAEA;EACE,cAAc;EACd,iDAAiD;EACjD,eAAe;EACf,SAAS;AACX;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,kBAAkB;EAClB,mBAAmB;EACnB,YAAY;EACZ,kBAAkB;EAClB,YAAY;EACZ,wCAAwC;EACxC,eAAe;EACf,gBAAgB;EAChB,eAAe;EACf,0BAA0B;EAC1B,mBAAmB;AACrB;;AAEA;EACE,mBAAmB;EACnB,6CAA6C;AAC/C;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,cAAc;AAChB;;AAEA,kBAAkB;AAClB;EACE,aAAa;EACb,sBAAsB;EACtB,SAAS;AACX;;AAEA;EACE,kBAAkB;EAClB,mBAAmB;EACnB,yBAAyB;EACzB,kBAAkB;EAClB,aAAa;EACb,0BAA0B;AAC5B;;AAEA;EACE,qBAAqB;EACrB,0CAA0C;AAC5C;;AAEA;EACE,qBAAqB;EACrB,8BAA8B;AAChC;;AAEA;EACE,aAAa;EACb,8BAA8B;EAC9B,mBAAmB;EACnB,mBAAm