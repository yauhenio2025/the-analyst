p-main {\n  padding: 0;\n}\n\n.app-main.landing {\n  overflow: auto;\n}\n\n/* App Header */\n.app-header {\n  background: var(--bg-surface);\n  border-bottom: 1px solid var(--border-color);\n  padding: 0.875rem 2rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}\n\n.app-header-left {\n  display: flex;\n  align-items: center;\n  gap: 1.5rem;\n}\n\n/* Project selector spacing in header */\n.app-header-left .project-selector {\n  margin-left: 0.5rem;\n  padding-left: 1.5rem;\n  border-left: 1px solid var(--border-color);\n}\n\n.app-logo {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  text-decoration: none;\n  color: inherit;\n  transition: opacity 0.2s ease;\n}\n\n.app-logo:hover {\n  opacity: 0.7;\n}\n\n.logo-icon {\n  display: none; /* Hide emoji icon */\n}\n\n.logo-text h1 {\n  font-family: var(--font-headline);\n  font-size: var(--text-xl);\n  font-weight: 700;\n  letter-spacing: -0.01em;\n  margin: 0;\n  color: var(--text-primary);\n}\n\n.logo-subtitle {\n  font-family: var(--font-ui);\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n  font-weight: 400;\n  margin: 0;\n}\n\n/* Navigation */\n.app-nav {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.nav-btn {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.5rem 0.875rem;\n  border: none;\n  border-radius: 0;\n  background: transparent;\n  color: var(--text-secondary);\n  text-decoration: none;\n  font-family: var(--font-ui);\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: color 0.15s ease;\n  position: relative;\n}\n\n.nav-btn::after {\n  content: '';\n  position: absolute;\n  bottom: -0.875rem;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: transparent;\n  transition: background 0.15s ease;\n}\n\n.nav-btn:hover {\n  color: var(--text-primary);\n}\n\n.nav-btn.active {\n  color: var(--accent-primary);\n}\n\n.nav-btn.active::after {\n  background: var(--accent-primary);\n}\n\n/* Simplified nav - dropdown groups handle their own styling */\n.nav-arsenal.active {\n  color: var(--accent-primary);\n}\n\n.nav-arsenal.active::after {\n  background: var(--accent-primary);\n}\n\n.nav-arsenal:hover {\n  color: var(--text-primary);\n}\n\n.nav-label {\n  font-size: var(--text-sm);\n}\n\n/* Main Content Area */\n.app-main {\n  flex: 1 1;\n  min-height: 0; /* Allow flex child to shrink below content size */\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;  /* Scroll internally — enables position:sticky for descendants */\n  overflow-x: hidden; /* Prevent horizontal scrollbar */\n  background: var(--bg-paper);\n}\n\n/* Page Context Breadcrumb (optional) */\n.page-context {\n  padding: 0.5rem 2rem;\n  background: var(--bg-surface);\n  border-bottom: 1px solid var(--border-subtle);\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-family: var(--font-ui);\n  font-size: var(--text-sm);\n  color: var(--text-muted);\n}\n\n.page-context-separator {\n  color: var(--text-caption);\n}\n\n.page-context-current {\n  color: var(--text-primary);\n  font-weight: 500;\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n  .app-header {\n    padding: 0.75rem 1rem;\n    flex-direction: column;\n    gap: 0.75rem;\n  }\n\n  .app-header-left {\n    width: 100%;\n    justify-content: center;\n  }\n\n  .app-nav {\n    width: 100%;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 0.125rem;\n  }\n\n  .logo-text h1 {\n    font-size: var(--text-lg);\n  }\n\n  .logo-subtitle {\n    font-size: var(--text-xs);\n  }\n\n  .nav-btn {\n    padding: 0.5rem 0.75rem;\n    font-size: var(--text-xs);\n  }\n\n  .nav-btn::after {\n    bottom: -0.75rem;\n  }\n}\n\n@media (max-width: 600px) {\n  .app-header {\n    padding: 0.5rem;\n  }\n\n  .logo-subtitle {\n    display: none;\n  }\n\n  .nav-label {\n    font-size: var(--text-xs);\n  }\n\n  .nav-btn {\n    padding: 0.375rem 0.5rem;\n  }\n}\n