und: #faf8f5;\n  border-radius: 6px;\n  border-left: 3px solid #888;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.attribution-badge:hover {\n  background: #f5f3f0;\n}\n\n.attribution-badge .badge-header {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.attribution-badge .badge-icon {\n  font-size: 14px;\n  font-weight: 700;\n}\n\n.attribution-badge .badge-label {\n  font-size: 11px;\n  color: #757575;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.attribution-badge .badge-version {\n  font-size: 12px;\n  font-weight: 600;\n  color: #4a4a4a;\n}\n\n.attribution-badge .badge-sin-type {\n  font-size: 12px;\n  font-weight: 500;\n  margin-top: 4px;\n  text-transform: capitalize;\n}\n\n.attribution-badge .badge-summary {\n  font-size: 11px;\n  color: #757575;\n  margin-top: 4px;\n  line-height: 1.4;\n}\n\n/* Compact variant */\n.attribution-badge.compact {\n  flex-direction: row;\n  align-items: center;\n  padding: 3px 8px;\n  gap: 4px;\n  border-left: none;\n  border: 1px solid;\n  border-radius: 12px;\n  background: rgba(26, 26, 46, 0.8);\n}\n\n.attribution-badge.compact .badge-icon {\n  font-size: 11px;\n}\n\n.attribution-badge.compact .badge-version {\n  font-size: 10px;\n}\n\n/* Attribution type variants */\n.attribution-badge.originated {\n  background: rgba(34, 197, 94, 0.1);\n}\n\n.attribution-badge.originated.compact {\n  background: rgba(34, 197, 94, 0.15);\n}\n\n.attribution-badge.enhanced {\n  background: rgba(59, 130, 246, 0.1);\n}\n\n.attribution-badge.enhanced.compact {\n  background: rgba(59, 130, 246, 0.15);\n}\n\n.attribution-badge.severity_change {\n  background: rgba(239, 68, 68, 0.1);\n}\n\n.attribution-badge.severity_change.compact {\n  background: rgba(239, 68, 68, 0.15);\n}\n\n.attribution-badge.new_evidence {\n  background: rgba(234, 179, 8, 0.1);\n}\n\n.attribution-badge.new_evidence.compact {\n  background: rgba(234, 179, 8, 0.15);\n}\n`, \"\",{\"version\":3,\"sources\":[\"webpack://./src/components/influ