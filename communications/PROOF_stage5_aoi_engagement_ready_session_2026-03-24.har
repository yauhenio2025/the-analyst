-dropdown-item.active {\\n  background: var(--accent-subtle);\\n  color: var(--accent-primary);\\n}\\n\\n/* Responsive adjustments */\\n@media (max-width: 1024px) {\\n  .nav-dropdown-trigger {\\n    padding: 0.5rem 0.75rem;\\n    font-size: var(--text-xs);\\n  }\\n\\n  .nav-dropdown-trigger::after {\\n    bottom: -0.75rem;\\n  }\\n\\n  .nav-dropdown-menu {\\n    top: calc(100% + 0.75rem);\\n    min-width: 160px;\\n  }\\n\\n  .nav-dropdown-item {\\n    padding: 0.5rem 0.875rem;\\n    font-size: var(--text-xs);\\n  }\\n}\\n\\n@media (max-width: 600px) {\\n  .nav-dropdown-trigger {\\n    padding: 0.375rem 0.5rem;\\n  }\\n\\n  .nav-dropdown-menu {\\n    min-width: 140px;\\n    left: 0;\\n    transform: none;\\n  }\\n\\n  @keyframes dropdownFadeIn {\\n    from {\\n      opacity: 0;\\n      transform: translateY(-4px);\\n    }\\n    to {\\n      opacity: 1;\\n      transform: translateY(0);\\n    }\\n  }\\n}\\n\"],\"sourceRoot\":\"\"}]);\n// Exports\n___CSS_LOADER_EXPORT___.locals = {};\n/* harmony default export */ const __WEBPACK_DEFAULT_EXPORT__ = (___CSS_LOADER_EXPORT___);\n\n\n/***/ },\n\n/***/ \"./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/PipelineVisualization.css\"\n/*!*********************************************************************************************************************************************************************************************************************************************************!*\\\n  !*** ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[1].oneOf[5].use[2]!./node_modules/source-map-loader/dist/cjs.js!./src/components/PipelineVisualization.css ***!\n  \\*****************************************************************************************************************************