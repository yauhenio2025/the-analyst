{
  "key": "referee.seed-title-resolve",
  "organ": "the-referee",
  "name": "Resolve a title to its canonical Scholar record and seed it",
  "when": [
    "citation_shift.unexamined",
    "citation_shift.first_cited",
    "oeuvre_position_memo.read_next",
    "work.identity_unknown",
    "work.named"
  ],
  "inputs": [
    "work_title",
    "work_author?",
    "work_year?",
    "query_id"
  ],
  "route": "POST /api/seeds/resolve-title {title, author?, year?, query_id?} → POST /api/cross-citations/queries/{query_id}/seeds/add",
  "cost": "cents",
  "cost_note": "2 Scholar probes + 1 advanced reasoning call",
  "side_effects": "a seed on the query (after the add); practice evidence for quoted-title-plus-plain-title",
  "gated_by": "none",
  "yields": "best_scholar_id, ranked candidates with reasons",
  "owner": "the-referee",
  "version": "2026-09-07",
  "evidence": [],
  "note": ""
}
