{
  "key": "referee.thinker-exists",
  "organ": "the-referee",
  "name": "Check whether a thinker exists in the Referee",
  "when": [
    "citation_shift.unexamined",
    "citation_shift.first_cited",
    "citation_shift.anomaly",
    "oeuvre_position_memo.read_next",
    "cited_author.unknown",
    "cohort.member",
    "person.named"
  ],
  "inputs": [
    "thinker_name"
  ],
  "route": "POST /api/thinkers/resolve {names[≤200]} (batch) · GET /api/thinkers/search?q= (one name)",
  "cost": "none",
  "cost_note": "DB read; no model, no Scholar",
  "side_effects": "none",
  "gated_by": "none",
  "yields": "thinker_id + confidence exact|strong|ambiguous|none + candidates with status, works_harvested, total_citations",
  "owner": "the-referee",
  "version": "2026-09-07",
  "evidence": [],
  "note": ""
}
