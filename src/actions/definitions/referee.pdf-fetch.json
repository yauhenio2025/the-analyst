{
  "key": "referee.pdf-fetch",
  "organ": "the-referee",
  "name": "Fetch the PDF of a cited work",
  "when": [
    "citation_shift.unexamined",
    "epistemic_rupture.test",
    "oeuvre_position_memo.read_next",
    "work.not-held"
  ],
  "inputs": [
    "work_title",
    "work_author",
    "work_year",
    "corpus_result_id",
    "query_id"
  ],
  "route": "POST /api/cross-citations/queries/{id}/fetch-pdfs {enabled, auto_extract_references?} · POST /api/fetch-pool/{corpus_result_id}/claim|prepare|upload · POST /api/thinker-studies/{study_id}/phase3/acquire",
  "cost": "cents",
  "cost_note": "the collector's nominal tariff; the local fetch agent free",
  "side_effects": "a PDF on the corpus row, identity-audited",
  "yields": "pdf-url",
  "owner": "the-referee",
  "gated_by": "",
  "version": "2026-09-07",
  "evidence": [],
  "note": ""
}
